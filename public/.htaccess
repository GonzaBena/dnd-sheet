# Caché del sitio servido por LiteSpeed (Hostinger).
#
# Cada deploy cambia los nombres de los JS/CSS de /_astro/ (llevan hash) y borra los anteriores.
# Si el navegador reutiliza un HTML viejo, pide archivos que ya no existen y la app queda "cargando".
# Por eso:
#   - HTML: siempre se revalida con el servidor (con ETag es una respuesta 304 liviana).
#   - /_astro/* con hash: nunca cambian, se cachean un año.
# Equivale a lo que hace server.js, que en Hostinger no atiende los archivos estáticos.

<IfModule mod_headers.c>
  <FilesMatch "\.html?$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  <FilesMatch "\.[A-Za-z0-9_-]{8}\.(js|css)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "^manifest\.webmanifest$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>
