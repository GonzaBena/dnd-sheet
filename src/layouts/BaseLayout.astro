---
import '../styles/global.css';
import AuthGate from '../components/auth/AuthGate.astro';
import MilestoneCelebrationModal from '../components/modals/MilestoneCelebrationModal.astro';
import DiceRollerModal from '../components/modals/DiceRollerModal.astro';
import ParchmentEnvelope from '../components/ui/ParchmentEnvelope.astro';

interface Props {
  title?: string;
  description?: string;
  splash?: 'home' | 'sheet' | 'party' | 'none';
}

const {
  title = "Crónicas del Aventurero — Grimorio de Campaña",
  description = "Hoja de personaje y bitácora interactiva de campaña D&D 5e",
  splash = "none"
} = Astro.props;
---

<!DOCTYPE html>
<html lang="es" class="dark scroll-smooth">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, interactive-widget=resizes-content" />
    <meta name="theme-color" content="#0a0d12" />
    <meta name="description" content={description} />

    <!-- Si un JS de /_astro/ no carga (HTML cacheado de un deploy anterior que apunta a archivos ya
         borrados), recarga la página una sola vez para traer el HTML nuevo. Va antes de cualquier script. -->
    <script is:inline>
      (function () {
        var KEY = 'dnd_stale_reload_at';
        function reloadOnce() {
          try {
            var last = Number(sessionStorage.getItem(KEY) || 0);
            if (Date.now() - last < 30000) return;
            sessionStorage.setItem(KEY, String(Date.now()));
          } catch (e) {}
          location.reload();
        }
        window.addEventListener('error', function (e) {
          var el = e.target;
          var src = el && (el.src || el.href);
          if (src && /\/_astro\//.test(src) && (el.tagName === 'SCRIPT' || el.tagName === 'LINK')) reloadOnce();
        }, true);
        window.addEventListener('vite:preloadError', function (e) {
          e.preventDefault();
          reloadOnce();
        });
      })();
    </script>

    <!-- OpenGraph / Facebook / WhatsApp / Discord -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content="https://dnd.gonzabena.com.ar/og-preview.png" />
    <meta property="og:url" content="https://dnd.gonzabena.com.ar" />
    <meta property="og:locale" content="es_ES" />
    <meta property="og:site_name" content="Crónicas del Aventurero" />

    <!-- Twitter / X -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content="https://dnd.gonzabena.com.ar/og-preview.png" />

    <link rel="icon" href="/favicon.ico?v=2" sizes="any" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg?v=2" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png?v=2" />
    <link rel="icon" type="image/png" sizes="192x192" href="/icon-192.png?v=2" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png?v=2" />
    <link rel="manifest" href="/manifest.webmanifest?v=2" />
    <title>{title}</title>

    <!-- Google Fonts: Literata & Nunito Sans -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Literata:ital,opsz,wght@0,7..72,400..700;1,7..72,400..700&family=Nunito+Sans:ital,opsz,wght@0,6..12,300..800;1,6..12,300..800&display=swap"
      rel="stylesheet"
    />
    <!-- Material Symbols -->
    <link
      href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap"
      rel="stylesheet"
    />

    <!-- Critical CSS for Boot Splash (Spec 16) -->
    <style is:inline>
      #boot-splash {
        display: none;
      }
      html[data-booting] #boot-splash {
        display: flex;
      }
      html[data-booting] body {
        overflow: hidden !important;
      }
      @keyframes indeterminate-bar {
        0% { transform: translateX(-100%); }
        50% { transform: translateX(35%); }
        100% { transform: translateX(200%); }
      }
      .animate-boot-indeterminate {
        animation: indeterminate-bar 1.4s cubic-bezier(0.65, 0.815, 0.735, 0.395) infinite;
      }
      @media (prefers-reduced-motion: reduce) {
        .animate-boot-indeterminate {
          animation: none !important;
          transform: none !important;
          width: 100% !important;
        }
      }
    </style>

    <!-- Inline Decision Script (Spec 16: runs blocking before first paint, < 1KB) -->
    <script is:inline define:vars={{ splashPage: splash }}>
      (function() {
        var page = splashPage || 'none';
        if (page === 'none') return;
        try {
          var params = new URLSearchParams(window.location.search);
          var forceLanding = params.get('landing') === '1';
          var isDemo = params.get('demo') === '1' || (typeof localStorage !== 'undefined' && localStorage.getItem('dnd_demo_mode') === '1');
          var wasAuthed = typeof localStorage !== 'undefined' && localStorage.getItem('dnd_cloud_authed') === '1';

          var show = false;
          if (page === 'home') {
            show = !forceLanding && (wasAuthed || isDemo);
          } else {
            show = true; // 'sheet' y 'party' siempre esperan datos
          }

          if (show) {
            document.documentElement.setAttribute('data-booting', '');
            window.__bootSplashShownAt = performance.now();
            setTimeout(function() {
              if (document.documentElement.hasAttribute('data-booting')) {
                document.documentElement.removeAttribute('data-booting');
                var el = document.getElementById('boot-splash');
                if (el) el.style.display = 'none';
              }
            }, 12000);
          }
        } catch (_) {}
      })();
    </script>
  </head>
  <body class="bg-[#0a0d12] font-body text-[#f1f5f9] min-h-screen selection:bg-amber-500/30 selection:text-amber-200 antialiased overflow-x-hidden">
    <!-- Boot Splash Screen (Spec 16) -->
    <div
      id="boot-splash"
      class="fixed inset-0 z-[100] bg-[#0a0d12] flex-col items-center justify-center select-none"
      role="status"
      aria-live="polite"
    >
      <div class="relative flex flex-col items-center justify-center gap-4 text-center max-w-sm px-6">
        <div class="relative w-16 h-16 rounded-2xl bg-gradient-to-br from-[#18202e] to-[#0e141f] border border-amber-500/40 p-2.5 shadow-[0_0_30px_rgba(245,158,11,0.25)] flex items-center justify-center">
          <img src="/favicon.svg" alt="Crónicas del Aventurero" class="w-full h-full object-contain filter drop-shadow-[0_0_8px_rgba(245,158,11,0.5)]" />
        </div>
        <div class="space-y-1">
          <h1 class="text-base sm:text-lg font-headline font-bold text-[#f1f5f9] tracking-tight">Crónicas del Aventurero</h1>
          <p id="boot-splash-phrase" class="text-xs text-amber-400 font-label font-semibold tracking-wide">
            Tirando iniciativa…
          </p>
        </div>
        <div class="w-32 h-1 bg-[#18202e] rounded-full overflow-hidden mt-1 border border-[#222f42]">
          <div class="h-full bg-gradient-to-r from-amber-600 via-amber-400 to-amber-600 rounded-full w-1/2 animate-boot-indeterminate"></div>
        </div>
      </div>
    </div>

    <slot />
    <AuthGate />
    <MilestoneCelebrationModal />
    <DiceRollerModal />
    <ParchmentEnvelope />
  </body>
</html>

<script>
  import { bootSplash } from '../scripts/ui/bootSplash.ts';
  import { campaignStore } from '../scripts/state/campaignStore.ts';
  import { characterStore } from '../scripts/state/characterStore.ts';
  import { userStore } from '../scripts/state/userStore.ts';
  import type { DmEvent } from '../scripts/models/campaign.ts';
  import { telemetry } from '../scripts/analytics/telemetry.ts';

  import { startGroupRestSync } from '../scripts/state/groupRestSync.ts';
  import { startEffectsRoundSync } from '../scripts/state/effectsRoundSync.ts';
  import { cloudSession } from '../scripts/data/cloudSync.ts';

  // Inicializar telemetría de producto y capturas de error
  telemetry.init();
  startGroupRestSync();

  // Descuento de rondas de los efectos: en todas las páginas, no solo en la hoja.
  // En modo nube espera la sesión; sin sesión no arranca (igual que antes en campaigns.astro).
  cloudSession.ready().then(() => {
    if (cloudSession.isCloud() && cloudSession.state === 'signed-out') return;
    startEffectsRoundSync();
  });

  const handledInitiativeEventIds = new Set<string>();

  // Escucha solicitudes de iniciativa en tiempo real del DM
  window.addEventListener('dm-event-received', ((e: CustomEvent<DmEvent>) => {
    const event = e.detail;
    if (!event || event.type !== 'request_initiative') return;

    if (event.id && handledInitiativeEventIds.has(event.id)) return;
    if (event.id) handledInitiativeEventIds.add(event.id);

    // 1. Si el usuario actual es el DM de la campaña, ignorar (fue quien lo pidió)
    const isDm = campaignStore.isCurrentUserDm(event.campaignId);
    if (isDm) return;

    // 2. Verificar pertenencia a la campaña
    const currentUser = userStore.getCurrentUser();
    const camp = campaignStore.getCampaign(event.campaignId);
    const activeCampId = campaignStore.getActiveCampaignId();
    const currentChar = characterStore.get();
    const isMember = (camp?.memberUserIds && camp.memberUserIds.includes(currentUser.id)) ||
                     activeCampId === event.campaignId ||
                     currentChar?.campaignId === event.campaignId;

    if (!isMember) return;

    // 3. Obtener el personaje del jugador en esta campaña
    const myChar = campaignStore.getMyCharacterForCampaign(event.campaignId) || currentChar;
    if (!myChar) return;

    // 4. Calcular el bono de iniciativa (+DEX / iniciativa)
    const mod = typeof myChar.initiativeBonus === 'number'
      ? myChar.initiativeBonus
      : (myChar.stats?.dex?.modifier ?? 0);

    // 5. Despachar la apertura del modal bloqueado en d20
    window.dispatchEvent(
      new CustomEvent('open-dice-roller', {
        detail: {
          die: 20,
          count: 1,
          modifier: mod,
          label: `Iniciativa (${myChar.name})`,
          tag: '#Combate',
          lockDie: true,
          lockCount: true,
          isInitiative: true,
          characterId: myChar.id,
          campaignId: event.campaignId,
          authorName: myChar.name,
        },
      })
    );
  }) as EventListener);
</script>
