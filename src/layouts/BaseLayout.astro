---
import '../styles/global.css';
import AuthGate from '../components/auth/AuthGate.astro';
import MilestoneCelebrationModal from '../components/modals/MilestoneCelebrationModal.astro';
import DiceRollerModal from '../components/modals/DiceRollerModal.astro';
import ParchmentEnvelope from '../components/ui/ParchmentEnvelope.astro';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Crónicas del Aventurero — Grimorio de Campaña",
  description = "Hoja de personaje y bitácora interactiva de campaña D&D 5e"
} = Astro.props;
---

<!DOCTYPE html>
<html lang="es" class="dark scroll-smooth">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, interactive-widget=resizes-content" />
    <meta name="theme-color" content="#0a0d12" />
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.ico?v=2" sizes="any" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg?v=2" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png?v=2" />
    <link rel="icon" type="image/png" sizes="192x192" href="/icon-192.png?v=2" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png?v=2" />
    <link rel="manifest" href="/manifest.webmanifest?v=2" />
    <title>{title}</title>

    <!-- Google Fonts: Literata & Nunito Sans -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Literata:ital,opsz,wght@0,7..72,400..700;1,7..72,400..700&family=Nunito+Sans:ital,opsz,wght@0,6..12,300..800;1,6..12,300..800&display=swap"
      rel="stylesheet"
    />
    <!-- Material Symbols -->
    <link
      href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="bg-[#0a0d12] font-body text-[#f1f5f9] min-h-screen selection:bg-amber-500/30 selection:text-amber-200 antialiased overflow-x-hidden">
    <slot />
    <AuthGate />
    <MilestoneCelebrationModal />
    <DiceRollerModal />
    <ParchmentEnvelope />
  </body>
</html>

<script>
  import { campaignStore } from '../scripts/state/campaignStore.ts';
  import { characterStore } from '../scripts/state/characterStore.ts';
  import { userStore } from '../scripts/state/userStore.ts';
  import type { DmEvent } from '../scripts/models/campaign.ts';

  import { startGroupRestSync } from '../scripts/state/groupRestSync.ts';
  import { startEffectsRoundSync } from '../scripts/state/effectsRoundSync.ts';
  import { cloudSession } from '../scripts/data/cloudSync.ts';
  startGroupRestSync();

  // Descuento de rondas de los efectos: en todas las páginas, no solo en la hoja.
  // En modo nube espera la sesión; sin sesión no arranca (igual que antes en campaigns.astro).
  cloudSession.ready().then(() => {
    if (cloudSession.isCloud() && cloudSession.state === 'signed-out') return;
    startEffectsRoundSync();
  });

  const handledInitiativeEventIds = new Set<string>();

  // Escucha solicitudes de iniciativa en tiempo real del DM
  window.addEventListener('dm-event-received', ((e: CustomEvent<DmEvent>) => {
    const event = e.detail;
    if (!event || event.type !== 'request_initiative') return;

    if (event.id && handledInitiativeEventIds.has(event.id)) return;
    if (event.id) handledInitiativeEventIds.add(event.id);

    // 1. Si el usuario actual es el DM de la campaña, ignorar (fue quien lo pidió)
    const isDm = campaignStore.isCurrentUserDm(event.campaignId);
    if (isDm) return;

    // 2. Verificar pertenencia a la campaña
    const currentUser = userStore.getCurrentUser();
    const camp = campaignStore.getCampaign(event.campaignId);
    const activeCampId = campaignStore.getActiveCampaignId();
    const currentChar = characterStore.get();
    const isMember = (camp?.memberUserIds && camp.memberUserIds.includes(currentUser.id)) ||
                     activeCampId === event.campaignId ||
                     currentChar?.campaignId === event.campaignId;

    if (!isMember) return;

    // 3. Obtener el personaje del jugador en esta campaña
    const myChar = campaignStore.getMyCharacterForCampaign(event.campaignId) || currentChar;
    if (!myChar) return;

    // 4. Calcular el bono de iniciativa (+DEX / iniciativa)
    const mod = typeof myChar.initiativeBonus === 'number'
      ? myChar.initiativeBonus
      : (myChar.stats?.dex?.modifier ?? 0);

    // 5. Despachar la apertura del modal bloqueado en d20
    window.dispatchEvent(
      new CustomEvent('open-dice-roller', {
        detail: {
          die: 20,
          count: 1,
          modifier: mod,
          label: `Iniciativa (${myChar.name})`,
          tag: '#Combate',
          lockDie: true,
          lockCount: true,
          isInitiative: true,
          characterId: myChar.id,
          campaignId: event.campaignId,
          authorName: myChar.name,
        },
      })
    );
  }) as EventListener);
</script>
