---
// src/pages/campaigns.astro
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/layout/Header.astro';
import SessionBanner from '../components/layout/SessionBanner.astro';
import StatusBanner from '../components/party/StatusBanner.astro';
import ClassTabsNav from '../components/navigation/ClassTabsNav.astro';
import HeroCard from '../components/character/HeroCard.astro';
import VitalsGrid from '../components/character/VitalsGrid.astro';
import ActiveEffectsPanel from '../components/character/ActiveEffectsPanel.astro';
import ResourcesSection from '../components/character/ResourcesSection.astro';
import AbilitiesGrid from '../components/character/AbilitiesGrid.astro';
import SavingThrows from '../components/character/SavingThrows.astro';
import SkillsList from '../components/character/SkillsList.astro';
import FeaturesFeats from '../components/character/FeaturesFeats.astro';
import WildShapePanel from '../components/character/WildShapePanel.astro';
import WeaponActionCard from '../components/combat/WeaponActionCard.astro';
import BackpackGrid from '../components/inventory/BackpackGrid.astro';
import ArmorSection from '../components/inventory/ArmorSection.astro';
import SpellcastingPanel from '../components/combat/SpellcastingPanel.astro';
import QuickJournalFab from '../components/journal/QuickJournalFab.astro';
import JournalModal from '../components/journal/JournalModal.astro';

import EditCharacterModal from '../components/modals/EditCharacterModal.astro';
import EditCurrencyModal from '../components/modals/EditCurrencyModal.astro';
import EditSkillsModal from '../components/modals/EditSkillsModal.astro';
import AddItemModal from '../components/modals/AddItemModal.astro';
import AddSpellModal from '../components/modals/AddSpellModal.astro';
import AddWeaponModal from '../components/modals/AddWeaponModal.astro';
import ConfigurePanelsModal from '../components/modals/ConfigurePanelsModal.astro';
import ResetConfirmModal from '../components/modals/ResetConfirmModal.astro';
import EditCampaignModal from '../components/modals/EditCampaignModal.astro';
import EditAttunedModal from '../components/modals/EditAttunedModal.astro';
import EditProficienciesModal from '../components/modals/EditProficienciesModal.astro';
import AcBreakdownModal from '../components/modals/AcBreakdownModal.astro';
import EditFeaturesModal from '../components/modals/EditFeaturesModal.astro';
import ConfirmDeleteModal from '../components/modals/ConfirmDeleteModal.astro';
import RestModal from '../components/modals/RestModal.astro';
import NewMilestoneModal from '../components/modals/NewMilestoneModal.astro';
import CampaignRosterModal from '../components/campaigns/CampaignRosterModal.astro';
import CloneCharacterModal from '../components/campaigns/CloneCharacterModal.astro';
import DmPanelModal from '../components/dm/DmPanelModal.astro';
import DmControlGrimoire from '../components/dm/DmControlGrimoire.astro';
import CompendiumModal from '../components/modals/CompendiumModal.astro';
import ItemDetailModal from '../components/modals/ItemDetailModal.astro';
import SpellDetailModal from '../components/modals/SpellDetailModal.astro';
import TurnNotifier from '../components/party/TurnNotifier.astro';
---

<BaseLayout>
  <!-- Global Modal Backdrop -->
  <div id="modal-backdrop" class="hidden fixed inset-0 bg-black/80 backdrop-blur-xs z-50 transition-opacity"></div>

  <!-- Sticky Top Header (Cleaned of internal links) -->
  <Header />

  <!-- Main Viewport Area -->
  <main class="w-full pt-20 sm:pt-24 pb-16 bg-[#0a0d12] min-h-screen">
    <!-- Atmospheric Ambient Lighting Elements -->
    <div class="relative w-full overflow-hidden px-4 sm:px-6 lg:px-10 py-3 max-w-[1720px] mx-auto">
      <div class="absolute -top-32 left-1/4 w-96 h-96 bg-amber-500/10 rounded-full blur-[110px] pointer-events-none"></div>
      <div class="absolute top-96 right-10 w-96 h-96 bg-rose-600/10 rounded-full blur-[120px] pointer-events-none"></div>
      <div class="absolute top-1/2 left-10 w-72 h-72 bg-amber-600/5 rounded-full blur-[90px] pointer-events-none"></div>

      <!-- Top Slim Session Context Strip (Shown for player) -->
      <div id="session-banner-container" class="hidden">
        <SessionBanner />
      </div>
      <StatusBanner />

      <!-- Workspace Loading State (Prevents flash/flicker of wrong workspace) -->
      <div id="campaigns-workspace-loading" class="py-24 text-center space-y-4">
        <div class="w-10 h-10 mx-auto border-2 border-amber-500 border-t-transparent rounded-full animate-spin"></div>
        <div class="space-y-1">
          <p class="text-sm font-headline font-bold text-[#f1f5f9]">Conectando con el espacio de juego...</p>
          <p class="text-xs text-[#94a3b8] font-label">Sincronizando campaña y personajes</p>
        </div>
      </div>

      <!-- 1. GRIMORIO DEL CONTROL WORKSPACE (Active when user is DM) -->
      <div id="dm-control-workspace" class="hidden space-y-6">
        <DmControlGrimoire />
      </div>

      <!-- 2. PLAYER CHARACTER SHEET WORKSPACE (Active when user is player) -->
      <div id="player-sheet-workspace" class="hidden space-y-5">
        <!-- MAIN HERO & CHARACTER HEADER BANNER -->
        <section class="relative mb-5 rounded-xl bg-[#121721] border border-[#222f42] shadow-[0_8px_30px_rgba(0,0,0,0.5)] p-5 lg:p-6 overflow-hidden">
          <!-- Decorative background runes/rings -->
          <div class="absolute -right-20 -bottom-20 w-80 h-80 rounded-full bg-amber-500/5 blur-2xl pointer-events-none"></div>
          
          <HeroCard>
            <VitalsGrid />
          </HeroCard>
          <div class="relative z-10 grid grid-cols-1 md:grid-cols-2 gap-3 mt-4 pt-4 border-t border-[#222f42]/60">
            <ActiveEffectsPanel />
            <ResourcesSection />
          </div>
        </section>

        <!-- ADAPTABLE CLASS TABS NAVIGATION (Combate, Habilidades, Magia, Forma Salvaje, Mochila, Bitácora) -->
        <ClassTabsNav />

        <!-- MAIN 3-BLOCK CHARACTER SHEET WORKSPACE -->
        <div class="w-full space-y-6" id="sheet-blocks-wrapper">
          <!-- BLOQUE 1: STATS + SALVACIONES (IZQ) | HABILIDADES (DER) -->
          <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 items-start" id="workspace-grid">
            <!-- Columna 1: Stats y Tiradas de Salvación -->
            <div class="space-y-5" id="workspace-col-1">
              <div id="section-abilities" data-section-id="abilities" class="transition-all duration-200">
                <AbilitiesGrid />
              </div>
              <div id="section-saves" data-section-id="saves" class="transition-all duration-200">
                <SavingThrows />
              </div>
            </div>

            <!-- Columna 2: Habilidades (en móvil queda justo después de Salvaciones y antes de Armas) -->
            <div class="space-y-5" id="workspace-col-2">
              <div id="section-skills" data-section-id="skills" class="transition-all duration-200">
                <SkillsList />
              </div>
            </div>
          </div>

          <!-- BLOQUE 2: ARMAS A ANCHO COMPLETO (FILA CORTA EN GRILLA) + MOCHILA A ANCHO COMPLETO (EN 2 COLUMNAS AMPLIAS) -->
          <div class="space-y-6 w-full" id="sheet-block-2">
            <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 items-start" id="combat-row">
              <div id="section-weapons" data-section-id="weapons" class="transition-all duration-200 w-full">
                <WeaponActionCard />
              </div>
              <div id="section-armor" class="transition-all duration-200 w-full">
                <ArmorSection />
              </div>
            </div>
            <div id="section-backpack" data-section-id="backpack" class="transition-all duration-200 w-full">
              <BackpackGrid />
            </div>
          </div>

          <!-- BLOQUE 3: 2 COLUMNAS CON RASGOS Y HECHIZOS (+ FORMA SALVAJE) -->
          <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 items-start" id="sheet-block-3">
            <div class="space-y-5" id="sheet-block-3-col-1">
              <div id="section-features" data-section-id="features" class="transition-all duration-200">
                <FeaturesFeats />
              </div>
            </div>

            <div class="space-y-5" id="sheet-block-3-col-2">
              <div id="section-wildshape" data-section-id="wildshape" class="transition-all duration-200">
                <WildShapePanel />
              </div>
              <div id="section-spells" data-section-id="spells" class="transition-all duration-200">
                <SpellcastingPanel />
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </main>

  <!-- Floating Action Button (FAB) for Quick Notes Bottom-Right -->
  <QuickJournalFab />

  <!-- Full Journal Modal -->
  <JournalModal />

  <!-- Interactive Modals -->
  <EditCharacterModal />
  <EditCurrencyModal />
  <EditSkillsModal />
  <AddItemModal />
  <AddSpellModal />
  <AddWeaponModal />
  <ConfigurePanelsModal />
  <ResetConfirmModal />
  <EditCampaignModal />
  <EditAttunedModal />
  <EditProficienciesModal />
  <AcBreakdownModal />
  <EditFeaturesModal />
  <ConfirmDeleteModal />
  <RestModal />
  <NewMilestoneModal />
  <CampaignRosterModal />
  <CloneCharacterModal />
  <DmPanelModal />
  <CompendiumModal />
  <ItemDetailModal />
  <SpellDetailModal />
  <TurnNotifier />
</BaseLayout>

<script>
  import { showAlert } from '../scripts/ui/notify';
  import { cloudSession } from '../scripts/data/cloudSync';
  import { campaignStore } from '../scripts/state/campaignStore';
  import { characterStore } from '../scripts/state/characterStore';
  import { userStore } from '../scripts/state/userStore';
  import { congratulationBanner } from '../scripts/ui/congratulationBanner';
  import { reorderSectionsDOM, applyCollapseStates, setupSheetDragAndDrop } from '../scripts/ui/sectionOrganizer';

  // En modo nube espera la sesión y los primeros datos de Firestore; en modo local resuelve al instante.
  if (typeof window !== 'undefined') cloudSession.ready().then(() => {
    // Si no hay sesión en modo nube, AuthGate presentará el modal de ingreso sin forzar redirección
    if (cloudSession.isCloud() && cloudSession.state === 'signed-out') {
      return;
    }

    const params = new URLSearchParams(window.location.search);

    // Check if opened via campaign or character switcher
    const targetCamp = params.get('campaign');
    const targetChar = params.get('character');
    const activeCampId = targetCamp || campaignStore.getActiveCampaignId();
    const currentUser = userStore.getCurrentUser();
    const isDm = campaignStore.isCurrentUserDm(activeCampId || undefined);
    const myChars = campaignStore.getAllCharacters().filter(c => campaignStore.isCharacterOwner(c, currentUser.id));

    // If user has NO characters and is NOT DM of an active campaign, redirect to / (campaigns manager)
    // (sólo con los datos ya cargados: un store todavía vacío no significa "sin personajes").
    const dataLoaded = !cloudSession.isCloud() || (campaignStore.hasLoadedCampaigns() && campaignStore.hasLoadedCharacters());
    if (dataLoaded && !isDm && myChars.length === 0 && !targetChar) {
      window.location.href = '/';
    }

    if (targetCamp) {
      campaignStore.setActiveCampaign(targetCamp);
    }
    if (targetChar) {
      const char = campaignStore.getCharacter(targetChar);
      if (char) {
        if (campaignStore.isCharacterOwner(char, currentUser.id)) {
          characterStore.loadCharacter(char);
        } else {
          console.warn(`[Security] Usuario ${currentUser.name} (${currentUser.id}) intentó abrir personaje protegido ${char.name} (${char.id})`);
          showAlert(`La ficha de "${char.name}" pertenece a ${char.playerName || 'otro jugador'} y solo puede ser modificada por su propietario.`, { kind: 'error', title: 'Acceso denegado' })
            .then(() => { window.location.href = '/'; });
        }
      }
    } else {
      // If no character explicitly in URL, load character corresponding to the active campaign (if player)
      if (activeCampId && !isDm) {
        const myChar = campaignStore.getMyCharacterForCampaign(activeCampId, currentUser.id);
        if (myChar && characterStore.get().id !== myChar.id) {
          characterStore.loadCharacter(myChar);
        }
      } else if (!activeCampId && !isDm) {
        // Standalone character fallback
        const standalone = campaignStore.getMyStandaloneCharacters(currentUser.id);
        if (standalone.length > 0 && characterStore.get().id !== standalone[0].id) {
          characterStore.loadCharacter(standalone[0]);
        }
      }
    }

    // Determine Workspace Mode: Grimorio del Control (DM) vs Hoja de Personaje (Jugador)
    function updateWorkspaceMode() {
      const activeCampId = campaignStore.getActiveCampaignId();
      const isDm = campaignStore.isCurrentUserDm(activeCampId || undefined);
      const urlMode = new URLSearchParams(window.location.search).get('mode');

      const dmWorkspace = document.getElementById('dm-control-workspace');
      const playerWorkspace = document.getElementById('player-sheet-workspace');
      const sessionBannerContainer = document.getElementById('session-banner-container');
      const sessionBanner = document.getElementById('session-banner-root');
      const workspaceLoading = document.getElementById('campaigns-workspace-loading');

      // Dismiss loading state once mode is determined
      workspaceLoading?.classList.add('hidden');

      // If user is DM of active campaign and mode is not explicitly player
      const myCharInCamp = activeCampId ? campaignStore.getMyCharacterForCampaign(activeCampId, currentUser.id) : null;
      const shouldShowDm = isDm && (!myCharInCamp || urlMode !== 'player');

      if (shouldShowDm) {
        dmWorkspace?.classList.remove('hidden');
        playerWorkspace?.classList.add('hidden');
        sessionBannerContainer?.classList.add('hidden');
        sessionBanner?.classList.add('hidden');
        window.dispatchEvent(new CustomEvent('dm-grimoire-refresh'));
      } else {
        dmWorkspace?.classList.add('hidden');
        playerWorkspace?.classList.remove('hidden');
        sessionBannerContainer?.classList.remove('hidden');
        sessionBanner?.classList.remove('hidden');
      }
    }

    updateWorkspaceMode();

    const syncActiveCharacter = () => {
      const activeCampId = campaignStore.getActiveCampaignId();
      const currentUser = userStore.getCurrentUser();
      const isDm = campaignStore.isCurrentUserDm(activeCampId || undefined);
      if (activeCampId && !isDm) {
        const myChar = campaignStore.getMyCharacterForCampaign(activeCampId, currentUser.id);
        if (myChar && characterStore.get().id !== myChar.id) {
          characterStore.loadCharacter(myChar);
        }
      }
    };

    window.addEventListener('current-user-changed', updateWorkspaceMode);
    window.addEventListener('active-campaign-changed', () => {
      updateWorkspaceMode();
      syncActiveCharacter();
    });
    window.addEventListener('campaigns-updated', updateWorkspaceMode);
    window.addEventListener('all-characters-updated', syncActiveCharacter);

    // Dynamic Section Organization (Reorder & Collapse)
    const initSectionsOrganizer = () => {
      const char = characterStore.get();
      reorderSectionsDOM(char);
      applyCollapseStates(char);
      setupSheetDragAndDrop();
    };

    initSectionsOrganizer();

    window.addEventListener('character-updated', ((e: CustomEvent<any>) => {
      const char = e.detail?.character || characterStore.get();
      reorderSectionsDOM(char);
      applyCollapseStates(char);
    }) as EventListener);

    // Global collapse toggle clicks
    document.addEventListener('click', (e) => {
      const target = e.target as HTMLElement;
      const collapseBtn = target.closest<HTMLElement>('.section-collapse-btn');
      if (collapseBtn) {
        e.preventDefault();
        e.stopPropagation();
        const sectionCard = collapseBtn.closest<HTMLElement>('[data-section-id]');
        const secId = sectionCard?.getAttribute('data-section-id');
        if (secId) {
          characterStore.toggleSectionCollapsed(secId);
        }
      }
    });

    // Double-click on section header bar to collapse/expand
    document.addEventListener('dblclick', (e) => {
      const target = e.target as HTMLElement;
      if (target.closest('button, input, select, textarea, a, .stat-card')) return;
      const headerBar = target.closest<HTMLElement>('.section-header-bar');
      if (headerBar) {
        const sectionCard = headerBar.closest<HTMLElement>('[data-section-id]');
        const secId = sectionCard?.getAttribute('data-section-id');
        if (secId) {
          characterStore.toggleSectionCollapsed(secId);
        }
      }
    });
  });
</script>
