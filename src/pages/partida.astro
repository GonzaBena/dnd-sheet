---
// src/pages/partida.astro
// Vista compartida de la mesa de partida (VTT) para jugadores y DM.
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/layout/Header.astro';
import PartyView from '../components/party/PartyView.astro';
import QuickJournalFab from '../components/journal/QuickJournalFab.astro';
import JournalModal from '../components/journal/JournalModal.astro';
import CampaignRosterModal from '../components/campaigns/CampaignRosterModal.astro';
import TurnNotifier from '../components/party/TurnNotifier.astro';
---

<BaseLayout title="Mesa de Partida - D&D 5e">
  <!-- Backdrop global para modales -->
  <div id="modal-backdrop" class="hidden fixed inset-0 bg-black/80 backdrop-blur-xs z-50 transition-opacity"></div>

  <Header />

  <main class="w-full pt-20 sm:pt-24 pb-16 bg-[#0a0d12] min-h-screen">
    <PartyView />
  </main>

  <!-- Botones Flotantes (Índice y Bitácora) -->
  <QuickJournalFab />

  <!-- Modal Completo de Bitácora de Sesión -->
  <JournalModal />

  <!-- Modal de Miembros de Campaña -->
  <CampaignRosterModal />
  <TurnNotifier />
</BaseLayout>
