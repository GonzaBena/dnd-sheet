---
// src/pages/index.astro
import BaseLayout from '../layouts/BaseLayout.astro';
import CampaignRosterModal from '../components/campaigns/CampaignRosterModal.astro';
import CreateCampaignModal from '../components/campaigns/CreateCampaignModal.astro';
import CloneCharacterModal from '../components/campaigns/CloneCharacterModal.astro';
import DmPanelModal from '../components/dm/DmPanelModal.astro';
import CompendiumModal from '../components/modals/CompendiumModal.astro';
---

<BaseLayout>
  <!-- Global Modal Backdrop -->
  <div id="modal-backdrop" class="hidden fixed inset-0 bg-black/80 backdrop-blur-xs z-50 transition-opacity"></div>

  <!-- Header Navigation -->
  <header class="fixed top-0 w-full z-40 bg-[#0a0d12]/95 backdrop-blur-xl border-b border-[#222f42] shadow-[0_4px_25px_rgba(0,0,0,0.6)]">
    <div class="h-16 sm:h-20 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex items-center justify-between gap-3">
      <!-- Brand / Title -->
      <a href="/" data-app-title-link class="relative z-10 touch-manipulation min-h-[44px] flex items-center gap-2.5 sm:gap-3 shrink min-w-0 hover:opacity-90 transition-opacity">
        <div class="w-8 h-8 rounded-lg bg-gradient-to-br from-amber-500 to-amber-700 flex items-center justify-center shadow-[0_0_12px_rgba(245,158,11,0.5)] border border-amber-400/40 shrink-0">
          <span class="material-symbols-outlined text-[#0a0d12] text-xl font-bold">auto_stories</span>
        </div>
        <div class="flex flex-col min-w-0">
          <span class="text-xs sm:text-sm font-headline font-bold text-[#f1f5f9] leading-tight tracking-tight truncate">Crónicas del Aventurero</span>
          <span class="text-[9px] sm:text-[10px] font-label text-amber-500 uppercase tracking-wider font-semibold truncate">Gestor de Campañas</span>
        </div>
      </a>

      <!-- Desktop Quick Actions (>= 640px) -->
      <div class="hidden sm:flex items-center gap-2 shrink-0">
        <button
          type="button"
          id="btn-nav-compendium-top"
          class="w-9 h-9 rounded-lg bg-[#18202e] border border-amber-500/30 hover:border-amber-500/70 text-[#cbd5e1] hover:text-amber-300 transition-all flex items-center justify-center active:scale-95 cursor-pointer shadow-xs shrink-0"
          title="Explorar Compendio Oficial SRD D&D 5e (2024 / 2014)"
          aria-label="Explorar Compendio Oficial SRD D&D 5e"
        >
          <span class="material-symbols-outlined text-[18px] text-amber-400">menu_book</span>
        </button>

        <a
          href="/campaigns"
          id="btn-nav-active-sheet"
          class="w-9 h-9 rounded-lg bg-[#18202e] border border-amber-500/30 hover:border-amber-500/70 text-[#cbd5e1] hover:text-amber-300 transition-all flex items-center justify-center active:scale-95 cursor-pointer shadow-xs shrink-0"
          title="Abrir hoja de personaje o grimorio activo"
          aria-label="Abrir hoja de personaje o grimorio activo"
        >
          <span class="material-symbols-outlined text-[18px] text-amber-400" id="btn-nav-active-icon">badge</span>
          <span id="btn-nav-active-name" class="sr-only">Hoja de Personaje</span>
        </a>

        <button
          type="button"
          id="btn-join-campaign-top"
          class="hidden w-9 h-9 rounded-lg bg-[#18202e] border border-amber-500/30 hover:border-amber-500/70 text-[#cbd5e1] hover:text-amber-300 transition-all items-center justify-center active:scale-95 cursor-pointer shadow-xs shrink-0"
          title="Unirse a una campaña con código de invitación"
          aria-label="Unirse a una campaña con código de invitación"
        >
          <span class="material-symbols-outlined text-[18px] text-amber-400">group_add</span>
        </button>

        <button
          type="button"
          id="btn-create-campaign-top"
          class="w-9 h-9 rounded-lg bg-gradient-to-r from-amber-600 via-amber-500 to-amber-600 hover:from-amber-500 hover:to-amber-400 text-[#0a0d12] font-bold flex items-center justify-center shadow-[0_0_15px_rgba(245,158,11,0.35)] active:scale-95 transition-all cursor-pointer shrink-0"
          title="Nueva Campaña"
          aria-label="Nueva Campaña"
        >
          <span class="material-symbols-outlined text-[20px] font-bold">add</span>
        </button>

        <button
          type="button"
          id="btn-signout-top"
          class="hidden w-9 h-9 rounded-lg bg-[#18202e] border border-[#222f42] hover:border-rose-500/50 text-[#94a3b8] hover:text-rose-300 transition-all items-center justify-center active:scale-95 cursor-pointer shadow-xs shrink-0"
          title="Cerrar sesión"
          aria-label="Cerrar sesión"
        >
          <span class="material-symbols-outlined text-[18px]">logout</span>
        </button>
      </div>

      <!-- Mobile Quick Actions (< 640px) -->
      <div class="flex sm:hidden items-center gap-2 shrink-0">
        <!-- Direct Quick Link to Active Game / Create -->
        <a
          href="/campaigns"
          id="btn-nav-mobile-active-sheet"
          class="w-9 h-9 rounded-lg bg-[#18202e] border border-amber-500/30 text-[#cbd5e1] flex items-center justify-center active:scale-95 cursor-pointer shadow-xs shrink-0"
          title="Abrir hoja de personaje o grimorio activo"
          aria-label="Abrir hoja de personaje o grimorio activo"
        >
          <span class="material-symbols-outlined text-[18px] text-amber-400" id="btn-nav-mobile-active-icon">badge</span>
        </a>

        <!-- Hamburger Menu Button -->
        <button
          type="button"
          id="btn-nav-mobile-menu"
          class="w-9 h-9 rounded-lg bg-[#18202e] border border-[#222f42] hover:border-amber-500/50 text-[#cbd5e1] hover:text-amber-300 flex items-center justify-center transition-all active:scale-95 cursor-pointer shadow-xs shrink-0"
          title="Abrir menú de navegación"
          aria-label="Abrir menú de navegación"
        >
          <span class="material-symbols-outlined text-[20px]">menu</span>
        </button>
      </div>
    </div>
  </header>

  <!-- Main Viewport Area -->
  <main class="w-full pt-24 sm:pt-28 pb-20 bg-[#0a0d12] min-h-screen">
    <!-- Atmospheric Ambient Lighting Elements -->
    <div class="relative w-full overflow-hidden px-4 sm:px-6 lg:px-10 max-w-7xl mx-auto space-y-8">
      <div class="absolute -top-32 left-1/4 w-96 h-96 bg-amber-500/10 rounded-full blur-[110px] pointer-events-none"></div>
      <div class="absolute top-96 right-10 w-96 h-96 bg-rose-600/10 rounded-full blur-[120px] pointer-events-none"></div>

      <!-- Hero Banner -->
      <section class="relative rounded-2xl bg-[#121721] border border-[#222f42] p-6 lg:p-8 shadow-[0_8px_30px_rgba(0,0,0,0.5)] overflow-hidden">
        <div class="absolute -right-20 -bottom-20 w-80 h-80 rounded-full bg-amber-500/5 blur-3xl pointer-events-none"></div>
        <div class="relative z-10 flex flex-wrap items-center justify-between gap-6">
          <div class="space-y-1.5 max-w-2xl">
            <div class="flex items-center gap-2 text-xs uppercase tracking-wider font-bold text-amber-500 font-label">
              <span class="w-2.5 h-2.5 rounded-full bg-amber-500 shadow-[0_0_8px_rgba(245,158,11,0.8)] animate-pulse"></span>
              <span>Grimorio de Campañas Multi-Mesa</span>
            </div>
            <h1 class="text-2xl sm:text-3xl font-headline font-bold text-[#f1f5f9] tracking-tight">
              Tus Campañas y Mesas de Juego
            </h1>
            <p class="text-xs sm:text-sm text-[#94a3b8] leading-relaxed">
              Explora tus aventuras activas, consulta los aventureros con el botón "Ver Grupo", asume el mando como Dungeon Master o juega con tus personajes independientes.
            </p>
          </div>

          <!-- Quick Stats Chips -->
          <div class="flex items-center gap-3 font-label text-xs">
            <div class="px-4 py-3 rounded-xl bg-[#18202e] border border-[#222f42] text-center min-w-[90px]">
              <span class="text-[10px] uppercase font-bold text-[#64748b] block">Campañas</span>
              <strong id="stats-total-campaigns" class="text-lg font-headline font-bold text-amber-400">3</strong>
            </div>
            <div class="px-4 py-3 rounded-xl bg-[#18202e] border border-[#222f42] text-center min-w-[90px]">
              <span class="text-[10px] uppercase font-bold text-[#64748b] block">Aventureros</span>
              <strong id="stats-total-characters" class="text-lg font-headline font-bold text-[#cbd5e1]">10</strong>
            </div>
            <div class="px-4 py-3 rounded-xl bg-[#18202e] border border-[#222f42] text-center min-w-[90px]">
              <span class="text-[10px] uppercase font-bold text-[#64748b] block">Como DM</span>
              <strong id="stats-total-dm" class="text-lg font-headline font-bold text-amber-400">1</strong>
            </div>
          </div>
        </div>
      </section>

      <!-- CAMPAIGNS GRID SECTION -->
      <section class="space-y-4">
        <div class="flex items-center justify-between">
          <div class="flex items-center gap-2">
            <span class="material-symbols-outlined text-[20px] text-amber-500">castle</span>
            <h2 class="text-base font-headline font-bold text-[#f1f5f9]">Campañas Activas</h2>
          </div>
          <span class="text-xs text-[#94a3b8] font-label">Pulsa sobre cualquier card para cargar la ficha</span>
        </div>

        <!-- Dynamic Grid of Campaign Cards -->
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4" id="campaigns-grid-container">
          <!-- Populated via JavaScript -->
        </div>
      </section>

      <!-- STANDALONE CHARACTERS SECTION (SIN CAMPAÑA) -->
      <section class="space-y-4 pt-4 border-t border-[#222f42]">
        <div class="flex flex-wrap items-center justify-between gap-3">
          <div class="flex items-center gap-2">
            <span class="material-symbols-outlined text-[20px] text-amber-400">person_pin</span>
            <div>
              <h2 class="text-base font-headline font-bold text-[#f1f5f9]">Personajes Independientes (Sin Campaña)</h2>
              <span class="text-xs text-[#94a3b8]">Héroes libres para usar en cualquier partida o copiar entre campañas</span>
            </div>
          </div>
          <button
            type="button"
            id="btn-create-standalone-char"
            class="flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-[#18202e] border border-amber-500/30 text-amber-300 hover:bg-amber-500/10 text-xs font-bold font-label transition-colors cursor-pointer"
          >
            <span class="material-symbols-outlined text-[16px]">person_add</span>
            <span>Nuevo Personaje Independiente</span>
          </button>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-3.5" id="standalone-characters-container">
          <!-- Populated via JavaScript -->
        </div>
      </section>
    </div>
  </main>

  <!-- Mobile Navigation Drawer & Backdrop -->
  <div id="mobile-nav-backdrop" class="hidden fixed inset-0 bg-black/80 backdrop-blur-xs z-50 transition-opacity"></div>
  <aside
    id="mobile-nav-drawer"
    class="hidden fixed top-0 right-0 bottom-0 w-[85vw] max-w-xs bg-[#0e131b] border-l border-[#222f42] z-50 shadow-[-10px_0_40px_rgba(0,0,0,0.8)] flex flex-col justify-between overflow-y-auto"
    role="dialog"
    aria-modal="true"
    aria-label="Menú de Navegación"
  >
    <!-- Drawer Header -->
    <div class="p-4 border-b border-[#222f42] flex items-center justify-between gap-3 bg-[#121721]">
      <div class="flex items-center gap-2.5 min-w-0">
        <div class="w-8 h-8 rounded-lg bg-gradient-to-br from-amber-500 to-amber-700 flex items-center justify-center text-[#0a0d12] shadow-sm shrink-0 border border-amber-400/30">
          <span class="material-symbols-outlined text-lg font-bold">person</span>
        </div>
        <div class="min-w-0">
          <span class="text-xs font-headline font-bold text-[#f1f5f9] block truncate" id="drawer-user-name">Usuario</span>
          <span class="text-[10px] font-label font-semibold flex items-center gap-1 text-[#94a3b8]" id="drawer-user-status">
            <span class="w-1.5 h-1.5 rounded-full bg-slate-500"></span>
            <span id="drawer-user-status-text">Modo Local</span>
          </span>
        </div>
      </div>
      <button
        type="button"
        id="btn-close-mobile-drawer"
        class="w-8 h-8 rounded-lg bg-[#18202e] hover:bg-[#222f42] text-[#94a3b8] hover:text-[#f1f5f9] flex items-center justify-center transition-colors cursor-pointer shrink-0"
        aria-label="Cerrar menú"
      >
        <span class="material-symbols-outlined text-[18px]">close</span>
      </button>
    </div>

    <!-- Drawer Body -->
    <div class="p-3.5 space-y-2 flex-1 font-label text-xs">
      <!-- Active Sheet / Grimoire Highlight Card -->
      <a
        href="/campaigns"
        id="drawer-item-active-sheet"
        class="p-3 rounded-xl bg-gradient-to-r from-amber-500/15 via-[#18202e] to-transparent border border-amber-500/40 hover:border-amber-500/80 flex items-center gap-3 text-[#f1f5f9] transition-all cursor-pointer group shadow-xs"
      >
        <div class="w-9 h-9 rounded-lg bg-gradient-to-br from-amber-500 to-amber-600 text-[#0a0d12] flex items-center justify-center font-bold shadow-md shrink-0" id="drawer-active-icon-box">
          <span class="material-symbols-outlined text-[18px] text-[#0a0d12] font-bold" id="drawer-active-icon">crown</span>
        </div>
        <div class="min-w-0 flex-1">
          <span class="text-[9px] uppercase font-bold text-amber-400 block tracking-wider" id="drawer-active-type">Partida Activa</span>
          <strong class="text-xs text-[#f1f5f9] font-headline font-bold truncate block" id="drawer-active-title">Grimorio del Control</strong>
        </div>
        <span class="material-symbols-outlined text-[16px] text-amber-400/60 group-hover:translate-x-0.5 transition-transform">arrow_forward</span>
      </a>

      <div class="pt-2 pb-0.5 px-1">
        <span class="text-[10px] uppercase font-bold text-[#64748b] tracking-wider">Acciones Rápidas</span>
      </div>

      <!-- Nueva Campaña -->
      <button
        type="button"
        id="drawer-item-create-campaign"
        class="w-full text-left p-2.5 rounded-xl bg-[#121721] hover:bg-[#18202e] border border-[#222f42] hover:border-amber-500/40 flex items-center gap-3 transition-colors text-[#cbd5e1] hover:text-[#f1f5f9] cursor-pointer"
      >
        <div class="w-8 h-8 rounded-lg bg-amber-500/10 text-amber-400 flex items-center justify-center shrink-0 border border-amber-500/30">
          <span class="material-symbols-outlined text-[17px]">add_circle</span>
        </div>
        <div class="min-w-0 flex-1">
          <strong class="text-xs font-bold block text-[#f1f5f9]">Nueva Campaña</strong>
          <span class="text-[11px] text-[#94a3b8] block truncate">Comenzar una nueva aventura</span>
        </div>
      </button>

      <!-- Compendio SRD -->
      <button
        type="button"
        id="drawer-item-compendium"
        class="w-full text-left p-2.5 rounded-xl bg-[#121721] hover:bg-[#18202e] border border-[#222f42] hover:border-amber-500/40 flex items-center gap-3 transition-colors text-[#cbd5e1] hover:text-[#f1f5f9] cursor-pointer"
      >
        <div class="w-8 h-8 rounded-lg bg-[#18202e] text-amber-400 flex items-center justify-center shrink-0 border border-amber-500/30">
          <span class="material-symbols-outlined text-[17px]">menu_book</span>
        </div>
        <div class="min-w-0 flex-1">
          <strong class="text-xs font-bold block text-[#f1f5f9]">Compendio SRD 5e</strong>
          <span class="text-[11px] text-[#94a3b8] block truncate">Reglas, conjuros, monstruos y equipo</span>
        </div>
      </button>

      <!-- Unirse a Campaña (Cloud) -->
      <button
        type="button"
        id="drawer-item-join-campaign"
        class="hidden w-full text-left p-2.5 rounded-xl bg-[#121721] hover:bg-[#18202e] border border-[#222f42] hover:border-amber-500/40 items-center gap-3 transition-colors text-[#cbd5e1] hover:text-[#f1f5f9] cursor-pointer"
      >
        <div class="w-8 h-8 rounded-lg bg-[#18202e] text-amber-400 flex items-center justify-center shrink-0 border border-amber-500/30">
          <span class="material-symbols-outlined text-[17px]">group_add</span>
        </div>
        <div class="min-w-0 flex-1">
          <strong class="text-xs font-bold block text-[#f1f5f9]">Unirse a Campaña</strong>
          <span class="text-[11px] text-[#94a3b8] block truncate">Pegar código o link de invitación</span>
        </div>
      </button>
    </div>

    <!-- Drawer Footer -->
    <div class="p-3.5 border-t border-[#222f42] space-y-2.5 bg-[#10141d]">
      <!-- Cerrar Sesión (Cloud) -->
      <button
        type="button"
        id="drawer-item-signout"
        class="hidden w-full p-2.5 rounded-xl bg-rose-500/10 hover:bg-rose-500/20 border border-rose-500/30 text-rose-300 items-center justify-center gap-2 text-xs font-bold transition-colors cursor-pointer"
      >
        <span class="material-symbols-outlined text-[16px]">logout</span>
        <span>Cerrar Sesión</span>
      </button>

      <div class="text-center text-[10px] text-[#64748b]">
        Crónicas del Aventurero • D&D 5e
      </div>
    </div>
  </aside>

  <!-- Integrated Modals -->
  <CampaignRosterModal />
  <CreateCampaignModal />
  <CloneCharacterModal />
  <DmPanelModal />
  <CompendiumModal />
</BaseLayout>

<script>
  // Título: ya estamos en "/", así que el enlace sube al inicio en vez de parecer roto.
  document.querySelectorAll<HTMLAnchorElement>('[data-app-title-link]').forEach(link => {
    link.addEventListener('click', (e) => {
      e.preventDefault();
      window.scrollTo({ top: 0, behavior: 'smooth' });
    });
  });

  import { showAlert, showConfirm, showPrompt } from '../scripts/ui/notify';
  import { campaignStore } from '../scripts/state/campaignStore';
  import { characterStore } from '../scripts/state/characterStore';
  import { userStore } from '../scripts/state/userStore';
  import { cloudSession } from '../scripts/data/cloudSync';
  import { normalizeStatus } from '../scripts/vtt/sessionStatus';
  import { openSideDrawer, closeSideDrawer } from '../scripts/animations/modalAnimations';

  // Backwards compatibility: redirect explicit query parameters to /campaigns
  if (typeof window !== 'undefined') {
    const params = new URLSearchParams(window.location.search);
    if (params.get('character') || params.get('mode') === 'dm' || (params.get('campaign') && params.get('character'))) {
      window.location.href = `/campaigns${window.location.search}`;
    }
  }

  const gridContainer = document.getElementById('campaigns-grid-container');
  const standaloneContainer = document.getElementById('standalone-characters-container');
  const totalCampEl = document.getElementById('stats-total-campaigns');
  const totalCharEl = document.getElementById('stats-total-characters');
  const totalDmEl = document.getElementById('stats-total-dm');

  function renderView() {
    const campaigns = campaignStore.getCampaigns();
    const allChars = campaignStore.getAllCharacters();
    const standaloneChars = campaignStore.getStandaloneCharacters();
    const activeCampId = campaignStore.getActiveCampaignId();
    const activeCamp = activeCampId ? campaignStore.getCampaign(activeCampId) : null;
    const currentUser = userStore.getCurrentUser();

    const dmCount = campaigns.filter(c => campaignStore.isCurrentUserDm(c.id)).length;
    if (totalCampEl) totalCampEl.textContent = String(campaigns.length);
    if (totalCharEl) totalCharEl.textContent = String(allChars.length);
    if (totalDmEl) totalDmEl.textContent = String(dmCount);

    // Update active campaign action button in top header & mobile drawer:
    const activeBtn = document.getElementById('btn-nav-active-sheet') as HTMLAnchorElement;
    const activeIcon = document.getElementById('btn-nav-active-icon');
    const activeNameEl = document.getElementById('btn-nav-active-name');

    const mobileActiveBtn = document.getElementById('btn-nav-mobile-active-sheet') as HTMLAnchorElement;
    const mobileActiveIcon = document.getElementById('btn-nav-mobile-active-icon');

    const drawerActiveItem = document.getElementById('drawer-item-active-sheet') as HTMLAnchorElement;
    const drawerActiveIcon = document.getElementById('drawer-active-icon');
    const drawerActiveType = document.getElementById('drawer-active-type');
    const drawerActiveTitle = document.getElementById('drawer-active-title');

    const drawerUserName = document.getElementById('drawer-user-name');
    const drawerUserStatus = document.getElementById('drawer-user-status');
    const drawerUserStatusText = document.getElementById('drawer-user-status-text');

    if (drawerUserName) drawerUserName.textContent = currentUser.name || 'Aventurero';
    if (drawerUserStatus && drawerUserStatusText) {
      if (cloudSession.isCloud()) {
        drawerUserStatus.className = 'text-[10px] font-label font-semibold flex items-center gap-1 text-emerald-400';
        drawerUserStatusText.textContent = 'Nube Conectada';
        const dot = drawerUserStatus.querySelector('.rounded-full');
        if (dot) dot.className = 'w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse';
      } else {
        drawerUserStatus.className = 'text-[10px] font-label font-semibold flex items-center gap-1 text-[#94a3b8]';
        drawerUserStatusText.textContent = 'Modo Local';
        const dot = drawerUserStatus.querySelector('.rounded-full');
        if (dot) dot.className = 'w-1.5 h-1.5 rounded-full bg-slate-500';
      }
    }

    const isDmOfActive = campaignStore.isCurrentUserDm(activeCampId || undefined);

    if (activeBtn && activeNameEl && activeIcon) {
      if (isDmOfActive && activeCamp) {
        // Desktop
        activeBtn.className = 'w-9 h-9 rounded-lg bg-gradient-to-r from-amber-600 via-amber-500 to-amber-600 hover:from-amber-500 hover:to-amber-400 text-[#0a0d12] font-bold flex items-center justify-center shadow-[0_0_15px_rgba(245,158,11,0.35)] active:scale-95 transition-all cursor-pointer shrink-0';
        activeIcon.className = 'material-symbols-outlined text-[18px] text-[#0a0d12] font-bold';
        activeIcon.textContent = 'crown';
        activeNameEl.textContent = 'Grimorio del Control';
        activeBtn.title = `Abrir el Grimorio del Control de ${activeCamp.name}`;
        activeBtn.setAttribute('aria-label', activeBtn.title);
        activeBtn.href = `/campaigns?campaign=${encodeURIComponent(activeCamp.id)}&mode=dm`;
        activeBtn.onclick = null;

        // Mobile Top Button
        if (mobileActiveBtn && mobileActiveIcon) {
          mobileActiveBtn.className = 'w-9 h-9 rounded-lg bg-gradient-to-r from-amber-600 via-amber-500 to-amber-600 hover:from-amber-500 hover:to-amber-400 text-[#0a0d12] font-bold flex items-center justify-center shadow-[0_0_15px_rgba(245,158,11,0.35)] active:scale-95 transition-all cursor-pointer shrink-0';
          mobileActiveIcon.className = 'material-symbols-outlined text-[18px] text-[#0a0d12] font-bold';
          mobileActiveIcon.textContent = 'crown';
          mobileActiveBtn.title = `Grimorio del Control: ${activeCamp.name}`;
          mobileActiveBtn.setAttribute('aria-label', mobileActiveBtn.title);
          mobileActiveBtn.href = `/campaigns?campaign=${encodeURIComponent(activeCamp.id)}&mode=dm`;
          mobileActiveBtn.onclick = null;
        }

        // Drawer Active Card
        if (drawerActiveItem && drawerActiveIcon && drawerActiveType && drawerActiveTitle) {
          drawerActiveItem.classList.remove('hidden');
          drawerActiveItem.href = `/campaigns?campaign=${encodeURIComponent(activeCamp.id)}&mode=dm`;
          drawerActiveIcon.textContent = 'crown';
          drawerActiveType.textContent = 'Dungeon Master';
          drawerActiveTitle.textContent = `Grimorio: ${activeCamp.name}`;
          drawerActiveItem.onclick = () => closeNavDrawer();
        }
      } else if (activeCamp) {
        const myCharInActiveCamp = campaignStore.getMyCharacterForCampaign(activeCamp.id, currentUser.id);
        if (myCharInActiveCamp) {
          // Desktop
          activeBtn.className = 'w-9 h-9 rounded-lg bg-[#18202e] border border-amber-500/40 hover:border-amber-500 text-amber-300 hover:text-amber-200 transition-all flex items-center justify-center active:scale-95 cursor-pointer shadow-xs shrink-0';
          activeIcon.className = 'material-symbols-outlined text-[18px] text-amber-400';
          activeIcon.textContent = 'badge';
          activeNameEl.textContent = `Hoja (${myCharInActiveCamp.name.split(' ')[0]})`;
          activeBtn.title = `Abrir la ficha de ${myCharInActiveCamp.name} en ${activeCamp.name}`;
          activeBtn.setAttribute('aria-label', activeBtn.title);
          activeBtn.href = `/campaigns?campaign=${encodeURIComponent(activeCamp.id)}&character=${encodeURIComponent(myCharInActiveCamp.id)}`;
          activeBtn.onclick = null;

          // Mobile Top Button
          if (mobileActiveBtn && mobileActiveIcon) {
            mobileActiveBtn.className = 'w-9 h-9 rounded-lg bg-[#18202e] border border-amber-500/40 text-amber-300 flex items-center justify-center active:scale-95 cursor-pointer shadow-xs shrink-0';
            mobileActiveIcon.className = 'material-symbols-outlined text-[18px] text-amber-400';
            mobileActiveIcon.textContent = 'badge';
            mobileActiveBtn.title = `Hoja de ${myCharInActiveCamp.name}`;
            mobileActiveBtn.setAttribute('aria-label', mobileActiveBtn.title);
            mobileActiveBtn.href = `/campaigns?campaign=${encodeURIComponent(activeCamp.id)}&character=${encodeURIComponent(myCharInActiveCamp.id)}`;
            mobileActiveBtn.onclick = null;
          }

          // Drawer Active Card
          if (drawerActiveItem && drawerActiveIcon && drawerActiveType && drawerActiveTitle) {
            drawerActiveItem.classList.remove('hidden');
            drawerActiveItem.href = `/campaigns?campaign=${encodeURIComponent(activeCamp.id)}&character=${encodeURIComponent(myCharInActiveCamp.id)}`;
            drawerActiveIcon.textContent = 'badge';
            drawerActiveType.textContent = `Tu Personaje (${activeCamp.name})`;
            drawerActiveTitle.textContent = `${myCharInActiveCamp.name} (Nvl. ${myCharInActiveCamp.level})`;
            drawerActiveItem.onclick = () => closeNavDrawer();
          }
        } else {
          // Desktop: In this active campaign, user has NO character.
          activeBtn.className = 'w-9 h-9 rounded-lg bg-[#18202e] border border-[#222f42] hover:border-amber-500/40 text-[#94a3b8] hover:text-[#f1f5f9] transition-all flex items-center justify-center cursor-pointer shrink-0';
          activeIcon.className = 'material-symbols-outlined text-[18px] text-amber-500/70';
          activeIcon.textContent = 'group_add';
          activeNameEl.textContent = 'Unirse a la Campaña';
          activeBtn.title = `No tienes ficha en ${activeCamp.name}. Pulsa para copiar o crear un personaje.`;
          activeBtn.setAttribute('aria-label', activeBtn.title);
          activeBtn.href = '#';
          activeBtn.onclick = (e) => {
            e.preventDefault();
            window.dispatchEvent(new CustomEvent('open-clone-character-modal', {
              detail: { targetCampaignId: activeCamp.id }
            }));
          };

          // Mobile Top Button
          if (mobileActiveBtn && mobileActiveIcon) {
            mobileActiveBtn.className = 'w-9 h-9 rounded-lg bg-[#18202e] border border-[#222f42] text-[#94a3b8] flex items-center justify-center active:scale-95 cursor-pointer shadow-xs shrink-0';
            mobileActiveIcon.className = 'material-symbols-outlined text-[18px] text-amber-500/70';
            mobileActiveIcon.textContent = 'group_add';
            mobileActiveBtn.title = `Unirse a ${activeCamp.name}`;
            mobileActiveBtn.setAttribute('aria-label', mobileActiveBtn.title);
            mobileActiveBtn.href = '#';
            mobileActiveBtn.onclick = (e) => {
              e.preventDefault();
              window.dispatchEvent(new CustomEvent('open-clone-character-modal', {
                detail: { targetCampaignId: activeCamp.id }
              }));
            };
          }

          // Drawer Active Card
          if (drawerActiveItem && drawerActiveIcon && drawerActiveType && drawerActiveTitle) {
            drawerActiveItem.classList.remove('hidden');
            drawerActiveItem.href = '#';
            drawerActiveIcon.textContent = 'group_add';
            drawerActiveType.textContent = 'Campaña Activa';
            drawerActiveTitle.textContent = `Unirse a ${activeCamp.name}`;
            drawerActiveItem.onclick = (e) => {
              e.preventDefault();
              closeNavDrawer();
              window.dispatchEvent(new CustomEvent('open-clone-character-modal', {
                detail: { targetCampaignId: activeCamp.id }
              }));
            };
          }
        }
      } else {
        // Standalone characters
        const standaloneChars = campaignStore.getMyStandaloneCharacters(currentUser.id);
        if (standaloneChars.length > 0) {
          const firstChar = standaloneChars[0];
          // Desktop
          activeBtn.className = 'w-9 h-9 rounded-lg bg-[#18202e] border border-amber-500/30 hover:border-amber-500/70 text-[#cbd5e1] hover:text-amber-300 transition-all flex items-center justify-center active:scale-95 cursor-pointer shadow-xs shrink-0';
          activeIcon.className = 'material-symbols-outlined text-[18px] text-amber-400';
          activeIcon.textContent = 'badge';
          activeNameEl.textContent = `Hoja (${firstChar.name.split(' ')[0]})`;
          activeBtn.title = `Abrir ficha de ${firstChar.name}`;
          activeBtn.setAttribute('aria-label', activeBtn.title);
          activeBtn.href = `/campaigns?character=${encodeURIComponent(firstChar.id)}`;
          activeBtn.onclick = null;

          // Mobile Top Button
          if (mobileActiveBtn && mobileActiveIcon) {
            mobileActiveBtn.className = 'w-9 h-9 rounded-lg bg-[#18202e] border border-amber-500/30 text-[#cbd5e1] flex items-center justify-center active:scale-95 cursor-pointer shadow-xs shrink-0';
            mobileActiveIcon.className = 'material-symbols-outlined text-[18px] text-amber-400';
            mobileActiveIcon.textContent = 'badge';
            mobileActiveBtn.title = `Abrir ficha de ${firstChar.name}`;
            mobileActiveBtn.setAttribute('aria-label', mobileActiveBtn.title);
            mobileActiveBtn.href = `/campaigns?character=${encodeURIComponent(firstChar.id)}`;
            mobileActiveBtn.onclick = null;
          }

          // Drawer Active Card
          if (drawerActiveItem && drawerActiveIcon && drawerActiveType && drawerActiveTitle) {
            drawerActiveItem.classList.remove('hidden');
            drawerActiveItem.href = `/campaigns?character=${encodeURIComponent(firstChar.id)}`;
            drawerActiveIcon.textContent = 'badge';
            drawerActiveType.textContent = 'Personaje Independiente';
            drawerActiveTitle.textContent = `${firstChar.name} (Nvl. ${firstChar.level})`;
            drawerActiveItem.onclick = () => closeNavDrawer();
          }
        } else {
          // No active campaign, no standalone characters
          activeBtn.className = 'hidden';

          // Mobile button: '+' Nueva Campaña
          if (mobileActiveBtn && mobileActiveIcon) {
            mobileActiveBtn.className = 'w-9 h-9 rounded-lg bg-gradient-to-r from-amber-600 via-amber-500 to-amber-600 text-[#0a0d12] font-bold flex items-center justify-center shadow-[0_0_15px_rgba(245,158,11,0.35)] active:scale-95 cursor-pointer shrink-0';
            mobileActiveIcon.className = 'material-symbols-outlined text-[18px] font-bold text-[#0a0d12]';
            mobileActiveIcon.textContent = 'add';
            mobileActiveBtn.title = 'Nueva Campaña';
            mobileActiveBtn.setAttribute('aria-label', mobileActiveBtn.title);
            mobileActiveBtn.href = '#';
            mobileActiveBtn.onclick = (e) => {
              e.preventDefault();
              window.dispatchEvent(new CustomEvent('open-create-campaign-modal'));
            };
          }

          // Drawer card
          if (drawerActiveItem && drawerActiveIcon && drawerActiveType && drawerActiveTitle) {
            drawerActiveItem.classList.remove('hidden');
            drawerActiveItem.href = '#';
            drawerActiveIcon.textContent = 'add_circle';
            drawerActiveType.textContent = 'Primeros Pasos';
            drawerActiveTitle.textContent = 'Crear Primera Campaña';
            drawerActiveItem.onclick = (e) => {
              e.preventDefault();
              closeNavDrawer();
              window.dispatchEvent(new CustomEvent('open-create-campaign-modal'));
            };
          }
        }
      }
    }

    // 1. Render Campaigns Grid
    if (gridContainer) {
      gridContainer.innerHTML = '';
      if (campaigns.length === 0) {
        gridContainer.innerHTML = `
          <div class="col-span-full w-full py-12 px-6 rounded-2xl bg-[#121721] border border-[#222f42] text-center flex flex-col items-center justify-center gap-3">
            <div class="w-12 h-12 rounded-full bg-amber-500/10 border border-amber-500/30 flex items-center justify-center text-amber-400">
              <span class="material-symbols-outlined text-2xl">auto_stories</span>
            </div>
            <div>
              <h4 class="font-headline font-bold text-sm text-[#f1f5f9] mb-1">No hay campañas creadas</h4>
              <p class="text-xs text-[#94a3b8] max-w-sm mx-auto">Pulsa en "Nueva Campaña" para comenzar tu próxima aventura.</p>
            </div>
            <button
              type="button"
              id="btn-create-campaign-empty"
              class="mt-2 flex items-center gap-1.5 px-4 py-2 rounded-xl bg-gradient-to-r from-amber-600 to-amber-500 hover:from-amber-500 hover:to-amber-400 text-[#0a0d12] font-bold text-xs shadow-md transition-all active:scale-95 cursor-pointer"
            >
              <span class="material-symbols-outlined text-[16px]">add_circle</span>
              <span>Crear Primera Campaña</span>
            </button>
          </div>
        `;
        document.getElementById('btn-create-campaign-empty')?.addEventListener('click', () => {
          window.dispatchEvent(new CustomEvent('open-create-campaign-modal'));
        });
      } else {
        campaigns.forEach(camp => {
          const charsInCamp = campaignStore.getCharactersForCampaign(camp.id);
          const myCharInCamp = campaignStore.getMyCharacterForCampaign(camp.id, currentUser.id);
          const isActive = camp.id === activeCampId;
          const isDm = campaignStore.isCurrentUserDm(camp.id);
          const isCreator = camp.creatorId === currentUser.id;
          const status = normalizeStatus(camp.status);

          let statusBadgeHtml = '';
          if (status === 'active') {
            statusBadgeHtml = `
              <span class="px-2 py-0.5 rounded-full bg-emerald-500/25 backdrop-blur-md border border-emerald-500/50 text-emerald-300 text-[10px] font-bold uppercase flex items-center gap-1 shadow-xs">
                <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse"></span>
                <span>En Vivo</span>
              </span>
            `;
          } else if (status === 'paused') {
            statusBadgeHtml = `
              <span class="px-2 py-0.5 rounded-full bg-amber-500/25 backdrop-blur-md border border-amber-500/50 text-amber-300 text-[10px] font-bold uppercase flex items-center gap-1 shadow-xs">
                <span class="w-1.5 h-1.5 rounded-full bg-amber-400"></span>
                <span>Pausada</span>
              </span>
            `;
          } else {
            statusBadgeHtml = `
              <span class="px-2 py-0.5 rounded-full bg-rose-500/25 backdrop-blur-md border border-rose-500/50 text-rose-300 text-[10px] font-bold uppercase flex items-center gap-1 shadow-xs">
                <span class="w-1.5 h-1.5 rounded-full bg-rose-400"></span>
                <span>Finalizada</span>
              </span>
            `;
          }

          const card = document.createElement('div');
          card.className = `group relative rounded-2xl bg-[#121721] border ${isActive ? 'border-amber-500/80 shadow-[0_0_25px_rgba(245,158,11,0.2)] ring-1 ring-amber-500/40' : 'border-[#222f42]'} hover:border-amber-500/60 shadow-[0_8px_30px_rgba(0,0,0,0.5)] transition-all flex flex-col justify-between overflow-hidden cursor-pointer`;

          card.innerHTML = `
            <!-- Card Image Header -->
            <div class="relative h-44 w-full overflow-hidden bg-[#18202e]">
              <img src="${camp.imageUrl}" alt="${camp.name}" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" />
              <div class="absolute inset-0 bg-gradient-to-t from-[#121721] via-[#121721]/40 to-transparent"></div>

              <!-- Badges top row -->
              <div class="absolute top-3 left-3 right-3 flex flex-col gap-1.5">
                <div class="flex items-start justify-between gap-2">
                <div class="flex items-center gap-1.5 flex-wrap">
                  ${isCreator ? `
                    <span class="px-2 py-0.5 rounded-full bg-amber-500/20 backdrop-blur-md text-amber-300 text-[10px] font-bold border border-amber-500/40 uppercase tracking-wider flex items-center gap-1 shadow-xs">
                      <span>👑</span>
                      <span>Creador</span>
                    </span>
                  ` : ''}
                  ${isDm ? `
                    <span class="px-2 py-0.5 rounded-full bg-amber-500 text-[#0a0d12] text-[10px] font-bold uppercase tracking-wider flex items-center gap-1 shadow-md">
                      <span>👑</span>
                      <span>Eres el DM</span>
                    </span>
                  ` : `
                    <span class="px-2 py-0.5 rounded-full bg-[#10141d]/85 backdrop-blur-md text-[#cbd5e1] text-[10px] font-bold border border-[#222f42] uppercase tracking-wider">
                      Jugador (DM: ${camp.dmName})
                    </span>
                  `}
                </div>

                ${isActive ? `
                  <span class="px-2 py-0.5 rounded-full bg-amber-500/20 backdrop-blur-md border border-amber-500/50 text-amber-300 text-[10px] font-bold flex items-center gap-1">
                    <span class="w-1.5 h-1.5 rounded-full bg-amber-400 animate-pulse"></span>
                    <span>Activa</span>
                  </span>
                ` : ''}
                </div>

                <!-- Segunda fila: sesión y estado -->
                <div class="flex items-center gap-1.5 flex-wrap">
                  <span class="px-2 py-0.5 rounded-full bg-emerald-500/20 backdrop-blur-md border border-emerald-500/30 text-emerald-400 text-[10px] font-bold uppercase">
                    Sesión ${camp.sessionNumber}
                  </span>
                  ${statusBadgeHtml}
                </div>
              </div>

              <!-- Campaign Title on image bottom -->
              <div class="absolute bottom-3 left-4 right-4">
                <span class="text-[10px] font-label text-amber-400 uppercase tracking-wider font-semibold block">${camp.setting}</span>
                <h3 class="font-headline font-bold text-lg text-[#f1f5f9] leading-snug drop-shadow-md truncate">${camp.name}</h3>
              </div>
            </div>

            <!-- Card Content -->
            <div class="p-4 sm:p-5 flex-1 flex flex-col justify-between gap-4 font-label text-xs">
              <!-- Description -->
              <p class="text-[#94a3b8] text-xs line-clamp-2 leading-relaxed">
                ${camp.description}
              </p>

              <!-- Metadata Row (DM & My Character) -->
              <div class="p-2.5 rounded-xl bg-[#18202e] border border-[#222f42] flex items-center justify-between gap-2">
                <div class="flex items-center gap-2 min-w-0">
                  <span class="material-symbols-outlined text-[16px] text-amber-500 shrink-0">crown</span>
                  <div class="min-w-0">
                    <span class="text-[9px] text-[#64748b] uppercase block font-bold">Dungeon Master</span>
                    <span class="text-xs font-bold text-[#cbd5e1] truncate block">${camp.dmName} ${isDm ? '<span class="text-amber-400">(Tú)</span>' : ''}</span>
                  </div>
                </div>

                <div class="text-right shrink-0">
                  <span class="text-[9px] text-[#64748b] uppercase block font-bold">Tu Personaje</span>
                  <span class="text-xs font-bold ${myCharInCamp ? 'text-amber-400' : 'text-[#94a3b8]'} truncate block flex items-center justify-end gap-1">
                    ${myCharInCamp ? `<span>⭐</span><span>${myCharInCamp.name.split(' ')[0]}</span>` : (isDm ? '<span class="text-amber-300">👑 DM</span>' : '<span class="text-[#64748b]">Sin ficha</span>')}
                  </span>
                </div>
              </div>

              <!-- Action Buttons Row: una sola fila repartida; el DM no necesita "Ver Partida" (el Grimorio del Control ya la cubre) -->
              <div class="pt-2 border-t border-[#222f42] flex items-stretch gap-2">
                <button
                  type="button"
                  class="btn-view-roster flex-1 flex items-center justify-center gap-1 px-3 py-1.5 rounded-lg bg-[#10141d] border border-amber-500/40 hover:bg-amber-500/10 text-amber-300 font-bold transition-all text-xs active:scale-95 cursor-pointer shadow-xs"
                  data-id="${camp.id}"
                  title="Ver aventureros y miembros de la campaña"
                >
                  <span class="material-symbols-outlined text-[16px]">groups</span>
                  <span>Ver Grupo</span>
                </button>

                ${!isDm ? `
                  <button
                    type="button"
                    class="btn-view-partida flex-1 flex items-center justify-center gap-1 px-3 py-1.5 rounded-lg bg-[#18202e] border border-amber-500/30 hover:border-amber-400 text-amber-300 font-bold transition-all text-xs active:scale-95 cursor-pointer shadow-xs"
                    data-id="${camp.id}"
                    title="Abrir la mesa de partida compartida (VTT)"
                  >
                    <span class="material-symbols-outlined text-[16px]">table_restaurant</span>
                    <span>Ver Partida</span>
                  </button>
                ` : ''}

                ${isDm ? `
                  <button
                    type="button"
                    class="btn-open-dm flex-[2] flex items-center justify-center gap-1 px-3 py-1.5 rounded-lg bg-gradient-to-r from-amber-600 to-amber-500 text-[#0a0d12] font-bold text-xs hover:brightness-110 active:scale-95 transition-all cursor-pointer shadow-xs"
                    data-id="${camp.id}"
                    title="Abrir el Grimorio del Control para esta campaña"
                  >
                    <span class="material-symbols-outlined text-[15px]">crown</span>
                    <span>Grimorio del Control</span>
                  </button>
                ` : (myCharInCamp ? `
                  <button
                    type="button"
                    class="btn-open-char flex-[2] flex items-center justify-center gap-1 px-3 py-1.5 rounded-lg bg-gradient-to-r from-amber-600 to-amber-500 text-[#0a0d12] font-bold text-xs hover:brightness-110 active:scale-95 transition-all cursor-pointer shadow-xs"
                    data-id="${camp.id}"
                    title="Jugar con ${myCharInCamp.name}"
                  >
                    <span class="material-symbols-outlined text-[15px]">edit_document</span>
                    <span class="truncate">Jugar (${myCharInCamp.name.split(' ')[0]})</span>
                  </button>
                ` : `
                  <button
                    type="button"
                    class="btn-join-camp flex-1 flex items-center justify-center gap-1 px-2.5 py-1.5 rounded-lg bg-[#10141d] border border-[#222f42] hover:border-amber-500/40 text-[#94a3b8] hover:text-[#f1f5f9] transition-all text-xs font-medium cursor-pointer"
                    data-id="${camp.id}"
                    title="Copiar o crear un personaje para esta campaña"
                  >
                    <span class="material-symbols-outlined text-[15px] text-amber-400">group_add</span>
                    <span>Unirse</span>
                  </button>
                `)}

                <button
                  type="button"
                  class="btn-edit-camp w-9 shrink-0 rounded-lg bg-[#18202e] hover:bg-[#222f42] text-[#94a3b8] hover:text-[#f1f5f9] flex items-center justify-center transition-colors cursor-pointer"
                  data-id="${camp.id}"
                  title="Editar detalles de campaña"
                >
                  <span class="material-symbols-outlined text-[16px]">settings</span>
                </button>
              </div>
            </div>
          `;

          // Card click: ONLY selects the campaign as active!
          card.addEventListener('click', (e) => {
            const target = e.target as HTMLElement;
            if (target.closest('button')) return; // ignore button clicks inside card

            campaignStore.setActiveCampaign(camp.id);
            renderView();
          });

          // Ver Grupo button -> ONLY way the modal opens!
          card.querySelector('.btn-view-roster')?.addEventListener('click', (e) => {
            e.stopPropagation();
            window.dispatchEvent(new CustomEvent('open-campaign-roster', { detail: { campaignId: camp.id } }));
          });

          // Ver Partida button (VTT)
          card.querySelector('.btn-view-partida')?.addEventListener('click', (e) => {
            e.stopPropagation();
            campaignStore.setActiveCampaign(camp.id);
            window.location.href = `/partida?id=${encodeURIComponent(camp.id)}`;
          });

          // Grimorio del Control / Panel DM button
          card.querySelector('.btn-open-dm')?.addEventListener('click', (e) => {
            e.stopPropagation();
            campaignStore.setActiveCampaign(camp.id);
            window.location.href = `/campaigns?campaign=${encodeURIComponent(camp.id)}&mode=dm`;
          });

          // Jugar con personaje button
          card.querySelector('.btn-open-char')?.addEventListener('click', (e) => {
            e.stopPropagation();
            campaignStore.setActiveCampaign(camp.id);
            if (myCharInCamp) {
              characterStore.loadCharacter(myCharInCamp);
              window.location.href = `/campaigns?campaign=${encodeURIComponent(camp.id)}&character=${encodeURIComponent(myCharInCamp.id)}`;
            }
          });

          // Unirse a campaña button
          card.querySelector('.btn-join-camp')?.addEventListener('click', (e) => {
            e.stopPropagation();
            campaignStore.setActiveCampaign(camp.id);
            window.dispatchEvent(new CustomEvent('open-clone-character-modal', { detail: { targetCampaignId: camp.id } }));
          });

          // Edit Campaign button
          card.querySelector('.btn-edit-camp')?.addEventListener('click', (e) => {
            e.stopPropagation();
            window.dispatchEvent(new CustomEvent('open-edit-campaign-modal', { detail: { campaignId: camp.id } }));
          });

          gridContainer.appendChild(card);
        });
      }
    }

    // 2. Render Standalone Characters
    if (standaloneContainer) {
      standaloneContainer.innerHTML = '';
      if (standaloneChars.length === 0) {
        standaloneContainer.innerHTML = `
          <div class="col-span-full w-full py-6 text-center text-xs text-[#64748b]">
            No tienes personajes independientes. Puedes crear uno nuevo o desvincular una copia de una campaña.
          </div>
        `;
      } else {
        standaloneChars.forEach(char => {
          const isMine = campaignStore.isCharacterOwner(char, currentUser.id);
          const charCard = document.createElement('div');
          charCard.className = `p-3.5 rounded-xl bg-[#121721] border ${isMine ? 'border-[#222f42] hover:border-amber-500/50' : 'border-[#1b2434] opacity-80'} transition-all flex items-center justify-between gap-3 text-xs font-label shadow-sm`;

          charCard.innerHTML = `
            <div class="flex items-center gap-3 min-w-0">
              <div class="w-11 h-11 rounded-xl overflow-hidden shrink-0 border border-amber-500/30 bg-[#18202e]">
                <img src="${char.avatarUrl || '/characters/ch-1.avif'}" alt="${char.name}" class="w-full h-full object-cover" onerror="this.onerror=null;this.src='/characters/ch-1.avif';" />
              </div>
              <div class="min-w-0">
                <div class="flex items-center gap-1.5 flex-wrap">
                  <h4 class="font-headline font-bold text-sm text-[#f1f5f9] truncate">${char.name}</h4>
                  ${isMine 
                    ? '<span class="px-1.5 py-0.2 rounded bg-amber-500/20 text-amber-300 text-[9px] font-bold uppercase border border-amber-500/40">Tu Ficha</span>'
                    : '<span class="px-1.5 py-0.2 rounded bg-[#10141d] text-[#64748b] text-[9px] font-bold uppercase border border-[#222f42]">🔒 Protegida</span>'
                  }
                </div>
                <div class="text-[11px] text-[#94a3b8] truncate">
                  <span>${char.race}</span> • <strong class="text-amber-400">${char.className} Nvl. ${char.level}</strong>
                </div>
                <span class="text-[10px] text-[#64748b]">Jugador: <strong class="${isMine ? 'text-amber-300' : 'text-[#94a3b8]'}">${char.playerName || (isMine ? currentUser.name : 'Otro')}</strong></span>
              </div>
            </div>

            <div class="flex items-center gap-1.5 shrink-0">
              <button
                type="button"
                class="btn-clone-standalone px-2.5 py-1.5 rounded-lg bg-[#18202e] border border-[#222f42] hover:border-amber-500/50 text-[#cbd5e1] hover:text-amber-300 font-bold transition-all text-xs cursor-pointer"
                data-id="${char.id}"
                title="Copiar este personaje a una campaña"
              >
                <span class="material-symbols-outlined text-[15px]">content_copy</span>
              </button>

              ${isMine ? `
                <button
                  type="button"
                  class="btn-play-standalone px-3 py-1.5 rounded-lg bg-gradient-to-r from-amber-600 to-amber-500 text-[#0a0d12] font-bold transition-all text-xs hover:brightness-110 active:scale-95 cursor-pointer shadow-xs"
                  data-id="${char.id}"
                >
                  Jugar
                </button>
                <button
                  type="button"
                  class="btn-delete-standalone w-8 h-8 rounded-lg bg-[#18202e] hover:bg-rose-500/20 text-[#64748b] hover:text-rose-400 border border-[#222f42] hover:border-rose-500/40 flex items-center justify-center transition-colors cursor-pointer"
                  data-id="${char.id}"
                  title="Eliminar este personaje"
                >
                  <span class="material-symbols-outlined text-[15px]">delete</span>
                </button>
              ` : `
                <div class="px-2.5 py-1.5 rounded-lg bg-[#10141d] border border-[#222f42] text-[#64748b] text-[10px] font-bold flex items-center gap-1 select-none" title="Solo el propietario puede abrir esta ficha">
                  <span class="material-symbols-outlined text-[13px]">lock</span>
                  <span>Protegida</span>
                </div>
              `}
            </div>
          `;

          // Clone standalone
          charCard.querySelector('.btn-clone-standalone')?.addEventListener('click', () => {
            window.dispatchEvent(new CustomEvent('open-clone-character-modal', {
              detail: { sourceCharacterId: char.id }
            }));
          });

          // Play standalone (only if mine)
          if (isMine) {
            charCard.querySelector('.btn-play-standalone')?.addEventListener('click', () => {
              campaignStore.setActiveCampaign(null);
              characterStore.loadCharacter(char);
              window.location.href = `/campaigns?character=${encodeURIComponent(char.id)}`;
            });

            charCard.querySelector('.btn-delete-standalone')?.addEventListener('click', async () => {
              if (await showConfirm('Esta acción no se puede deshacer.', {
                title: `¿Eliminar a "${char.name}"?`, confirmText: 'Eliminar', danger: true,
              })) {
                campaignStore.deleteCharacter(char.id);
                renderView();
              }
            });
          }

          standaloneContainer.appendChild(charCard);
        });
      }
    }
  }

  // Top "+ Nueva Campaña" trigger
  document.getElementById('btn-create-campaign-top')?.addEventListener('click', () => {
    window.dispatchEvent(new CustomEvent('open-create-campaign-modal'));
  });

  // Top "Compendio SRD" trigger
  document.getElementById('btn-nav-compendium-top')?.addEventListener('click', () => {
    window.dispatchEvent(new CustomEvent('open-compendium-modal'));
  });

  // "+ Nuevo Personaje Independiente"
  document.getElementById('btn-create-standalone-char')?.addEventListener('click', () => {
    const newChar = campaignStore.createCharacter({ name: 'Nuevo Aventurero Independiente' }, null);
    renderView();
    showAlert(`¡Personaje independiente creado para ${userStore.getCurrentUser().name}! ID: [${newChar.id}]`, { kind: 'success', title: 'Personaje creado' });
  });

  // Sesión en la nube: unirse con código y cerrar sesión
  const joinBtn = document.getElementById('btn-join-campaign-top');
  const signOutBtn = document.getElementById('btn-signout-top');
  const drawerJoinBtn = document.getElementById('drawer-item-join-campaign');
  const drawerSignOutBtn = document.getElementById('drawer-item-signout');

  if (cloudSession.isCloud()) {
    [joinBtn, signOutBtn, drawerJoinBtn, drawerSignOutBtn].forEach(btn => {
      btn?.classList.remove('hidden');
      btn?.classList.add('flex');
    });
  }
  signOutBtn?.addEventListener('click', () => cloudSession.signOut());

  // Mobile Navigation Drawer interactions
  const mobileMenuBtn = document.getElementById('btn-nav-mobile-menu');
  const mobileDrawer = document.getElementById('mobile-nav-drawer');
  const mobileBackdrop = document.getElementById('mobile-nav-backdrop');
  const closeDrawerBtn = document.getElementById('btn-close-mobile-drawer');

  function openNavDrawer() {
    if (mobileDrawer && mobileBackdrop) openSideDrawer(mobileDrawer, mobileBackdrop);
  }
  function closeNavDrawer() {
    if (mobileDrawer && mobileBackdrop) closeSideDrawer(mobileDrawer, mobileBackdrop);
  }

  mobileMenuBtn?.addEventListener('click', openNavDrawer);
  closeDrawerBtn?.addEventListener('click', closeNavDrawer);
  mobileBackdrop?.addEventListener('click', closeNavDrawer);
  window.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && mobileDrawer && !mobileDrawer.classList.contains('hidden')) {
      closeNavDrawer();
    }
  });

  // Drawer Action Items
  document.getElementById('drawer-item-create-campaign')?.addEventListener('click', () => {
    closeNavDrawer();
    window.dispatchEvent(new CustomEvent('open-create-campaign-modal'));
  });

  document.getElementById('drawer-item-compendium')?.addEventListener('click', () => {
    closeNavDrawer();
    window.dispatchEvent(new CustomEvent('open-compendium-modal'));
  });

  drawerJoinBtn?.addEventListener('click', () => {
    closeNavDrawer();
    joinBtn?.click();
  });

  drawerSignOutBtn?.addEventListener('click', () => {
    closeNavDrawer();
    cloudSession.signOut();
  });

  async function joinWithCode(code: string) {
    try {
      const { campaignId, alreadyMember } = await cloudSession.joinByInvite(code);
      campaignStore.setActiveCampaign(campaignId);
      const camp = campaignStore.getCampaign(campaignId);
      window.dispatchEvent(new CustomEvent('cloud-toast', {
        detail: { message: alreadyMember ? `Ya eras parte de "${camp?.name || 'la campaña'}".` : `¡Te uniste a "${camp?.name || 'la campaña'}"! Copiá un personaje a la campaña para jugar.` }
      }));
    } catch (err: any) {
      window.dispatchEvent(new CustomEvent('cloud-toast', {
        detail: { message: err?.code === 'permission-denied' ? 'El código no es válido para esa campaña.' : (err?.message || 'No se pudo unir a la campaña.'), kind: 'error' }
      }));
    }
  }

  joinBtn?.addEventListener('click', async () => {
    const code = await showPrompt('Pegá el código o el link que te pasó el DM.', {
      title: 'Unirse a una campaña', placeholder: 'ABC2345', required: true, confirmText: 'Unirme',
    });
    if (!code || !code.trim()) return;
    // También acepta el link completo (…/?join=CODIGO).
    const fromLink = code.match(/[?&]join=([^&\s]+)/);
    joinWithCode(fromLink ? decodeURIComponent(fromLink[1]) : code);
  });

  // Link de invitación: /?join=CODIGO
  cloudSession.ready().then(() => {
    const joinCode = new URLSearchParams(window.location.search).get('join');
    if (joinCode && cloudSession.isCloud()) {
      window.history.replaceState({}, document.title, window.location.pathname);
      joinWithCode(joinCode);
    }
  });

  // Initial render
  renderView();

  // Listen to store updates
  window.addEventListener('campaigns-updated', () => renderView());
  window.addEventListener('all-characters-updated', () => renderView());
  window.addEventListener('current-user-changed', () => renderView());
  window.addEventListener('active-campaign-changed', () => renderView());
</script>
