---
// src/components/modals/EditProficienciesModal.astro
// Spec 08, Fase C: competencias de armadura y arma cargadas a mano. Cada cambio se aplica al instante
// (una escritura por acción con `setProficiencies`). No se derivan del SRD ni de la clase (FC-2).
---

<div id="edit-proficiencies-modal" class="hidden fixed inset-0 z-50 flex items-center justify-center p-4">
  <div class="modal-content w-full max-w-lg rounded-2xl bg-[#121721] border border-[#222f42] shadow-[0_20px_60px_rgba(0,0,0,0.9)] overflow-hidden flex flex-col">
    <div class="p-4 bg-[#18202e] border-b border-[#222f42] flex items-center justify-between">
      <div class="flex items-center gap-2">
        <div class="w-8 h-8 rounded-lg bg-sky-500/20 text-sky-400 flex items-center justify-center border border-sky-500/30">
          <span class="material-symbols-outlined text-[18px]">verified_user</span>
        </div>
        <div>
          <h3 class="font-headline font-bold text-base text-[#f1f5f9]">Competencias de equipo</h3>
          <span class="text-[10px] text-[#94a3b8]">Tilda todo lo que tu personaje sabe usar; la hoja avisa, no bloquea</span>
        </div>
      </div>
      <button id="prof-modal-close-btn" class="w-7 h-7 rounded-lg bg-[#10141d] border border-[#222f42] hover:border-rose-500/50 text-[#94a3b8] hover:text-rose-400 flex items-center justify-center text-xs transition-colors cursor-pointer">
        <span class="material-symbols-outlined text-[16px]">close</span>
      </button>
    </div>

    <div class="p-5 space-y-4 text-xs font-label overflow-y-auto max-h-[70vh]">
      <section>
        <h4 class="text-[10px] uppercase tracking-wider text-[#94a3b8] mb-2">Armaduras</h4>
        <div id="prof-armor-container" class="grid grid-cols-2 gap-2"></div>
      </section>
      <section>
        <h4 class="text-[10px] uppercase tracking-wider text-[#94a3b8] mb-2">Armas</h4>
        <div id="prof-weapons-container" class="grid grid-cols-2 gap-2"></div>
        <div id="prof-custom-list" class="flex flex-wrap gap-1.5 mt-3"></div>
        <form id="prof-custom-form" class="flex gap-2 mt-2">
          <input id="prof-custom-input" type="text" maxlength="60" placeholder="Arma concreta (p. ej. Espada larga)" class="flex-1 px-3 py-2 rounded-lg bg-[#10141d] border border-[#222f42] text-[#f1f5f9] placeholder:text-[#64748b]" />
          <button type="submit" class="px-3 py-2 rounded-lg bg-[#10141d] border border-[#222f42] text-[#94a3b8] hover:text-[#f1f5f9] cursor-pointer">Agregar</button>
        </form>
      </section>
    </div>

    <div class="p-4 bg-[#18202e] border-t border-[#222f42] flex justify-end">
      <button type="button" id="prof-modal-cancel-btn" class="px-4 py-2 rounded-xl bg-[#121721] border border-[#222f42] text-[#94a3b8] hover:text-[#f1f5f9] cursor-pointer">
        Cerrar
      </button>
    </div>
  </div>
</div>

<script>
  import { characterStore } from '../../scripts/state/characterStore';
  import { closeModal, openModal } from '../../scripts/animations/modalAnimations';
  import { slugify } from '../../scripts/dnd/compat';

  const ARMOR_OPTIONS = [
    ['light', 'Ligera'], ['medium', 'Media'], ['heavy', 'Pesada'], ['shield', 'Escudos'],
  ] as const;
  const WEAPON_OPTIONS = [['simple', 'Simples'], ['martial', 'Marciales']] as const;
  const CATEGORIES = new Set<string>(WEAPON_OPTIONS.map(([v]) => v));

  const modal = document.getElementById('edit-proficiencies-modal');
  const backdrop = document.getElementById('modal-backdrop');
  const armorBox = document.getElementById('prof-armor-container');
  const weaponsBox = document.getElementById('prof-weapons-container');
  const customList = document.getElementById('prof-custom-list');
  const form = document.getElementById('prof-custom-form') as HTMLFormElement | null;
  const input = document.getElementById('prof-custom-input') as HTMLInputElement | null;

  const current = () => {
    const p = characterStore.get().proficiencies;
    return { armor: [...(p?.armor ?? [])], weapons: [...(p?.weapons ?? [])] };
  };

  function toggle(list: 'armor' | 'weapons', value: string, on: boolean) {
    const p = current();
    const set = new Set(p[list]);
    if (on) set.add(value); else set.delete(value);
    p[list] = [...set];
    characterStore.setProficiencies(p);
  }

  function checkbox(list: 'armor' | 'weapons', value: string, label: string, checked: boolean) {
    const row = document.createElement('label');
    row.className = 'flex items-center gap-2 p-2.5 rounded-lg bg-[#10141d] border border-[#222f42] cursor-pointer';
    const box = document.createElement('input');
    box.type = 'checkbox';
    box.checked = checked;
    box.className = 'w-4 h-4 accent-sky-500 shrink-0';
    box.addEventListener('change', () => toggle(list, value, box.checked));
    const text = document.createElement('span');
    text.className = 'text-[#f1f5f9]';
    text.textContent = label;
    row.append(box, text);
    return row;
  }

  function render() {
    const p = current();
    armorBox?.replaceChildren(...ARMOR_OPTIONS.map(([v, l]) => checkbox('armor', v, l, p.armor.includes(v))));
    weaponsBox?.replaceChildren(...WEAPON_OPTIONS.map(([v, l]) => checkbox('weapons', v, l, p.weapons.includes(v))));

    const chips = p.weapons.filter((w) => !CATEGORIES.has(w)).map((w) => {
      const chip = document.createElement('button');
      chip.type = 'button';
      chip.className = 'px-2 py-1 rounded-full bg-sky-500/10 border border-sky-500/30 text-sky-300 cursor-pointer';
      chip.title = 'Quitar';
      chip.textContent = `${w} ×`;
      chip.addEventListener('click', () => toggle('weapons', w, false));
      return chip;
    });
    customList?.replaceChildren(...chips);
  }

  form?.addEventListener('submit', (e) => {
    e.preventDefault();
    const index = slugify(input?.value ?? '');
    if (!index) return;
    toggle('weapons', index, true);
    if (input) input.value = '';
  });

  window.addEventListener('open-proficiencies-modal', () => {
    render();
    if (modal && backdrop) openModal(modal, backdrop);
  });
  window.addEventListener('character-updated', () => {
    if (modal && !modal.classList.contains('hidden')) render();
  });

  const close = () => { if (modal && backdrop) closeModal(modal, backdrop); };
  document.getElementById('prof-modal-close-btn')?.addEventListener('click', close);
  document.getElementById('prof-modal-cancel-btn')?.addEventListener('click', close);
</script>
