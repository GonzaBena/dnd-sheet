---
// src/components/modals/EditAttunedModal.astro
---

<div id="edit-attuned-modal" class="hidden fixed inset-0 z-50 flex items-center justify-center p-4">
  <div class="modal-content w-full max-w-lg rounded-2xl bg-[#121721] border border-[#222f42] shadow-[0_20px_60px_rgba(0,0,0,0.9)] overflow-hidden flex flex-col">
    <!-- Header -->
    <div class="p-4 bg-[#18202e] border-b border-[#222f42] flex items-center justify-between">
      <div class="flex items-center gap-2">
        <div class="w-8 h-8 rounded-lg bg-amber-500/20 text-amber-400 flex items-center justify-center border border-amber-500/30">
          <span class="material-symbols-outlined text-[18px]">stars</span>
        </div>
        <div>
          <h3 class="font-headline font-bold text-base text-[#f1f5f9]">Objetos Mágicos Sintonizados</h3>
          <span class="text-[10px] text-[#94a3b8]">Regla D&D 5e: Máximo 3 objetos sintonizados a la vez</span>
        </div>
      </div>
      <button id="attuned-modal-close-btn" class="w-7 h-7 rounded-lg bg-[#10141d] border border-[#222f42] hover:border-rose-500/50 text-[#94a3b8] hover:text-rose-400 flex items-center justify-center text-xs transition-colors cursor-pointer">
        <span class="material-symbols-outlined text-[16px]">close</span>
      </button>
    </div>

    <!-- Body: 3 Slots -->
    <div class="p-5 space-y-4 text-xs font-label overflow-y-auto max-h-[70vh]" id="attuned-slots-form-container">
      <!-- Generated by JS for the 3 slots -->
    </div>

    <!-- Footer -->
    <div class="p-4 bg-[#18202e] border-t border-[#222f42] flex items-center justify-between">
      <span class="text-[11px] text-[#94a3b8]" id="attuned-count-summary">2 / 3 Ranuras Ocupadas</span>
      <div class="flex items-center gap-2">
        <button type="button" id="attuned-modal-cancel-btn" class="px-4 py-2 rounded-xl bg-[#121721] border border-[#222f42] text-[#94a3b8] hover:text-[#f1f5f9] cursor-pointer">
          Cancelar
        </button>
        <button type="button" id="attuned-modal-save-btn" class="px-5 py-2 rounded-xl bg-gradient-to-r from-amber-600 to-amber-500 text-[#0a0d12] font-bold shadow-[0_0_12px_rgba(245,158,11,0.3)] hover:brightness-110 active:scale-95 transition-all cursor-pointer">
          Guardar Sintonizaciones
        </button>
      </div>
    </div>
  </div>
</div>

<script>
  import { characterStore } from '../../scripts/state/characterStore';
  import { closeModal, openModal } from '../../scripts/animations/modalAnimations';

  const modal = document.getElementById('edit-attuned-modal');
  const backdrop = document.getElementById('modal-backdrop');
  const closeBtn = document.getElementById('attuned-modal-close-btn');
  const cancelBtn = document.getElementById('attuned-modal-cancel-btn');
  const saveBtn = document.getElementById('attuned-modal-save-btn');
  const container = document.getElementById('attuned-slots-form-container');
  const countSummary = document.getElementById('attuned-count-summary');

  let currentSlots: { name: string; description: string; icon: string }[] = [];

  function loadData() {
    const char = characterStore.get();
    currentSlots = JSON.parse(JSON.stringify(char.attunedItems || []));
    // Ensure 3 slots
    while (currentSlots.length < 3) {
      currentSlots.push({ name: 'Ranura Libre', description: 'Disponible para nuevo objeto mágico', icon: 'lock_open' });
    }
    renderSlots();
  }

  function renderSlots() {
    if (!container) return;
    container.innerHTML = '';

    const char = characterStore.get();
    const inventoryMagical = char.inventory || [];

    let occupied = 0;

    currentSlots.forEach((slot, index) => {
      const isFree = slot.name.includes('Libre') || !slot.name.trim();
      if (!isFree) occupied++;

      const slotBox = document.createElement('div');
      slotBox.className = `p-3.5 rounded-xl bg-[#18202e] border ${isFree ? 'border-dashed border-[#222f42]' : 'border-amber-500/40'} space-y-2.5`;

      slotBox.innerHTML = `
        <div class="flex items-center justify-between">
          <div class="flex items-center gap-2">
            <span class="w-5 h-5 rounded-md bg-amber-500/20 text-amber-300 flex items-center justify-center text-[10px] font-bold">${index + 1}</span>
            <span class="font-headline font-bold text-sm ${isFree ? 'text-[#64748b]' : 'text-[#f1f5f9]'}">Ranura ${index + 1}: ${isFree ? 'Libre' : slot.name}</span>
          </div>
          ${!isFree ? `
            <button type="button" class="clear-slot-btn text-[10px] text-rose-400 hover:text-rose-300 font-bold bg-rose-500/10 px-2 py-0.5 rounded border border-rose-500/30 cursor-pointer" data-index="${index}">
              Liberar Ranura
            </button>
          ` : ''}
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-2">
          <div>
            <label class="text-[#94a3b8] text-[10px] block mb-1">Nombre del Objeto Mágico</label>
            <input
              type="text"
              class="slot-name-inp w-full p-2 rounded-lg bg-[#10141d] border border-[#222f42] text-[#f1f5f9] focus:border-amber-500 focus:outline-none"
              placeholder="ej: Anillo de Protección, Capa Élfica..."
              value="${isFree ? '' : slot.name}"
              data-index="${index}"
            />
          </div>
          <div>
            <label class="text-[#94a3b8] text-[10px] block mb-1">O elegir de la Mochila</label>
            <select class="slot-quick-pick w-full p-2 rounded-lg bg-[#10141d] border border-[#222f42] text-[#cbd5e1] focus:border-amber-500 focus:outline-none" data-index="${index}">
              <option value="">-- Seleccionar de mochila --</option>
              ${inventoryMagical.map((item: any) => `<option value="${item.name}">${item.name}</option>`).join('')}
            </select>
          </div>
        </div>

        <div>
          <label class="text-[#94a3b8] text-[10px] block mb-1">Propiedad o Efecto Mágico</label>
          <input
            type="text"
            class="slot-desc-inp w-full p-2 rounded-lg bg-[#10141d] border border-[#222f42] text-[#cbd5e1] focus:border-amber-500 focus:outline-none"
            placeholder="ej: +1 a todas las tiradas de salvación y a la CA"
            value="${isFree ? '' : slot.description}"
            data-index="${index}"
          />
        </div>
      `;

      // Clear button
      slotBox.querySelector('.clear-slot-btn')?.addEventListener('click', () => {
        currentSlots[index] = { name: 'Ranura Libre', description: 'Disponible para nuevo objeto mágico', icon: 'lock_open' };
        renderSlots();
      });

      // Name input
      const nameInput = slotBox.querySelector('.slot-name-inp') as HTMLInputElement;
      nameInput?.addEventListener('input', () => {
        const val = nameInput.value.trim();
        if (val) {
          currentSlots[index].name = val;
          currentSlots[index].icon = 'stars';
        } else {
          currentSlots[index] = { name: 'Ranura Libre', description: 'Disponible para nuevo objeto mágico', icon: 'lock_open' };
        }
        updateCount();
      });

      // Quick pick from inventory
      const quickPick = slotBox.querySelector('.slot-quick-pick') as HTMLSelectElement;
      quickPick?.addEventListener('change', () => {
        const selName = quickPick.value;
        if (selName) {
          const invItem = inventoryMagical.find((i: any) => i.name === selName);
          currentSlots[index] = {
            name: selName,
            description: invItem?.description || 'Objeto sintonizado desde la mochila',
            icon: 'stars'
          };
          renderSlots();
        }
      });

      // Desc input
      const descInput = slotBox.querySelector('.slot-desc-inp') as HTMLInputElement;
      descInput?.addEventListener('input', () => {
        currentSlots[index].description = descInput.value.trim();
      });

      container.appendChild(slotBox);
    });

    updateCount();
  }

  function updateCount() {
    if (!countSummary) return;
    const occ = currentSlots.filter(s => !s.name.includes('Libre') && s.name.trim()).length;
    countSummary.textContent = `${occ} / 3 Ranuras Ocupadas`;
  }

  window.addEventListener('open-attuned-modal', () => {
    loadData();
    if (modal && backdrop) openModal(modal, backdrop);
  });

  closeBtn?.addEventListener('click', () => {
    if (modal && backdrop) closeModal(modal, backdrop);
  });
  cancelBtn?.addEventListener('click', () => {
    if (modal && backdrop) closeModal(modal, backdrop);
  });

  saveBtn?.addEventListener('click', () => {
    // Clean slots
    const finalSlots = currentSlots.map(s => {
      if (!s.name.trim() || s.name.includes('Libre')) {
        return { name: 'Ranura Libre', description: 'Disponible para nuevo objeto mágico', icon: 'lock_open' };
      }
      return {
        name: s.name.trim(),
        description: s.description.trim() || 'Objeto sintonizado',
        icon: 'stars'
      };
    });

    characterStore.updateAttunedItems(finalSlots);
    if (modal && backdrop) closeModal(modal, backdrop);
  });
</script>
