---
// src/components/modals/EditAttunedModal.astro
// Spec 08, Fase A: la sintonización vive en el inventario (`attuned`). Cada interruptor se aplica al
// instante (una escritura por acción) y el tope de 3 lo valida `attuneItem`.
---

<div id="edit-attuned-modal" class="hidden fixed inset-0 z-50 flex items-center justify-center p-4">
  <div class="modal-content w-full max-w-lg rounded-2xl bg-[#121721] border border-[#222f42] shadow-[0_20px_60px_rgba(0,0,0,0.9)] overflow-hidden flex flex-col">
    <!-- Header -->
    <div class="p-4 bg-[#18202e] border-b border-[#222f42] flex items-center justify-between">
      <div class="flex items-center gap-2">
        <div class="w-8 h-8 rounded-lg bg-amber-500/20 text-amber-400 flex items-center justify-center border border-amber-500/30">
          <span class="material-symbols-outlined text-[18px]">stars</span>
        </div>
        <div>
          <h3 class="font-headline font-bold text-base text-[#f1f5f9]">Objetos Mágicos Sintonizados</h3>
          <span class="text-[10px] text-[#94a3b8]">Regla D&D 5e: Máximo 3 objetos sintonizados a la vez</span>
        </div>
      </div>
      <button id="attuned-modal-close-btn" class="w-7 h-7 rounded-lg bg-[#10141d] border border-[#222f42] hover:border-rose-500/50 text-[#94a3b8] hover:text-rose-400 flex items-center justify-center text-xs transition-colors cursor-pointer">
        <span class="material-symbols-outlined text-[16px]">close</span>
      </button>
    </div>

    <!-- Body: objetos sintonizables del inventario -->
    <div class="p-5 space-y-2 text-xs font-label overflow-y-auto max-h-[70vh]" id="attuned-slots-form-container"></div>
    <p id="attuned-error" class="hidden px-5 pb-3 text-[11px] text-rose-300"></p>

    <!-- Footer -->
    <div class="p-4 bg-[#18202e] border-t border-[#222f42] flex items-center justify-between">
      <span class="text-[11px] text-[#94a3b8]" id="attuned-count-summary">0/3</span>
      <button type="button" id="attuned-modal-cancel-btn" class="px-4 py-2 rounded-xl bg-[#121721] border border-[#222f42] text-[#94a3b8] hover:text-[#f1f5f9] cursor-pointer">
        Cerrar
      </button>
    </div>
  </div>
</div>

<script>
  import { characterStore } from '../../scripts/state/characterStore';
  import { closeModal, openModal } from '../../scripts/animations/modalAnimations';
  import { MAX_ATTUNED } from '../../scripts/dnd/equipment';

  const modal = document.getElementById('edit-attuned-modal');
  const backdrop = document.getElementById('modal-backdrop');
  const closeBtn = document.getElementById('attuned-modal-close-btn');
  const cancelBtn = document.getElementById('attuned-modal-cancel-btn');
  const container = document.getElementById('attuned-slots-form-container');
  const countSummary = document.getElementById('attuned-count-summary');
  const errorEl = document.getElementById('attuned-error');

  function showError(msg: string) {
    if (!errorEl) return;
    errorEl.textContent = msg;
    errorEl.classList.toggle('hidden', !msg);
  }

  function render() {
    if (!container) return;
    const inv = characterStore.get().inventory || [];
    const items = inv.filter((i) => i.requiresAttunement || i.attuned);
    const count = inv.filter((i) => i.attuned).length;
    if (countSummary) countSummary.textContent = `${count}/${MAX_ATTUNED} sintonizados`;

    container.replaceChildren();
    if (items.length === 0) {
      const empty = document.createElement('p');
      empty.className = 'text-[#64748b] text-center py-4';
      empty.textContent = 'Ningún objeto del inventario requiere sintonización. Márcalo al editar el objeto.';
      container.appendChild(empty);
      return;
    }

    items.forEach((item) => {
      const row = document.createElement('label');
      row.className = 'flex items-center gap-3 p-2.5 rounded-lg bg-[#10141d] border border-[#222f42] cursor-pointer';

      const input = document.createElement('input');
      input.type = 'checkbox';
      input.checked = !!item.attuned;
      input.className = 'w-4 h-4 accent-amber-500 shrink-0';
      input.addEventListener('change', () => {
        showError('');
        if (!input.checked) {
          characterStore.unattuneItem(item.id);
          return;
        }
        const res = characterStore.attuneItem(item.id);
        if (res.error) {
          input.checked = false;
          showError(res.error);
        }
      });

      const icon = document.createElement('span');
      icon.className = 'material-symbols-outlined text-[18px] text-amber-400 shrink-0';
      icon.textContent = item.icon || 'stars';

      const text = document.createElement('div');
      text.className = 'min-w-0 flex-1';
      const name = document.createElement('div');
      name.className = 'text-[#f1f5f9] font-medium truncate';
      name.textContent = item.name;
      text.appendChild(name);
      if (item.description) {
        const desc = document.createElement('div');
        desc.className = 'text-[10px] text-[#64748b] truncate';
        desc.textContent = item.description;
        text.appendChild(desc);
      }

      row.append(input, icon, text);
      container.appendChild(row);
    });
  }

  window.addEventListener('open-attuned-modal', () => {
    showError('');
    render();
    if (modal && backdrop) openModal(modal, backdrop);
  });
  window.addEventListener('character-updated', () => {
    if (modal && !modal.classList.contains('hidden')) render();
  });

  const close = () => { if (modal && backdrop) closeModal(modal, backdrop); };
  closeBtn?.addEventListener('click', close);
  cancelBtn?.addEventListener('click', close);
</script>
