---
// src/components/modals/EditCampaignModal.astro
---

<div id="edit-campaign-modal" class="hidden fixed inset-0 z-50 flex items-center justify-center p-4">
  <div class="modal-content w-full max-w-md rounded-2xl bg-[#121721] border border-[#222f42] shadow-[0_20px_60px_rgba(0,0,0,0.9)] overflow-hidden flex flex-col">
    <!-- Header -->
    <div class="p-4 bg-[#18202e] border-b border-[#222f42] flex items-center justify-between">
      <div class="flex items-center gap-2">
        <div class="w-8 h-8 rounded-lg bg-amber-500/20 text-amber-400 flex items-center justify-center border border-amber-500/30">
          <span class="material-symbols-outlined text-[18px]">explore</span>
        </div>
        <div>
          <h3 class="font-headline font-bold text-base text-[#f1f5f9]">Configuración de Campaña</h3>
          <span class="text-[10px] text-[#94a3b8]">Detalles de la sesión, clima y entorno</span>
        </div>
      </div>
      <button id="campaign-modal-close-btn" class="w-7 h-7 rounded-lg bg-[#10141d] border border-[#222f42] hover:border-rose-500/50 text-[#94a3b8] hover:text-rose-400 flex items-center justify-center text-xs transition-colors cursor-pointer">
        <span class="material-symbols-outlined text-[16px]">close</span>
      </button>
    </div>

    <!-- Body -->
    <form id="edit-campaign-form" class="p-5 space-y-4 text-xs font-label">
      <!-- Nombre de Campaña -->
      <div>
        <label class="text-[#94a3b8] block mb-1 font-bold">Nombre de la Campaña</label>
        <input
          type="text"
          id="campaign-name-input"
          placeholder="ej: La Maldición de Strahd"
          class="w-full p-2.5 rounded-lg bg-[#18202e] border border-[#222f42] text-[#f1f5f9] focus:border-amber-500 focus:outline-none"
          required
        />
      </div>

      <!-- Número de Sesión -->
      <div>
        <label class="text-[#94a3b8] block mb-1 font-bold">Número de Sesión</label>
        <input
          type="number"
          id="campaign-session-input"
          min="1"
          placeholder="ej: 15"
          class="w-full p-2.5 rounded-lg bg-[#18202e] border border-[#222f42] text-[#f1f5f9] focus:border-amber-500 focus:outline-none"
          required
        />
      </div>

      <!-- Clima / Atmósfera -->
      <div>
        <label class="text-[#94a3b8] block mb-1 font-bold">Clima y Atmósfera</label>
        <input
          type="text"
          id="campaign-weather-input"
          placeholder="ej: Niebla Espesa / Anochecer, -2°C"
          class="w-full p-2.5 rounded-lg bg-[#18202e] border border-[#222f42] text-[#f1f5f9] focus:border-amber-500 focus:outline-none"
          required
        />
      </div>

      <!-- Ubicación Actual -->
      <div>
        <label class="text-[#94a3b8] block mb-1 font-bold">Ubicación Actual</label>
        <input
          type="text"
          id="campaign-location-input"
          placeholder="ej: Valle de Barovia - Castillo Ravenloft"
          class="w-full p-2.5 rounded-lg bg-[#18202e] border border-[#222f42] text-[#f1f5f9] focus:border-amber-500 focus:outline-none"
          required
        />
      </div>

      <!-- Footer Buttons -->
      <div class="pt-3 border-t border-[#222f42] flex items-center justify-end gap-2.5">
        <button type="button" id="campaign-modal-cancel-btn" class="px-4 py-2 rounded-xl bg-[#121721] border border-[#222f42] text-[#94a3b8] hover:text-[#f1f5f9] cursor-pointer">
          Cancelar
        </button>
        <button type="submit" class="px-5 py-2 rounded-xl bg-gradient-to-r from-amber-600 to-amber-500 text-[#0a0d12] font-bold shadow-[0_0_12px_rgba(245,158,11,0.3)] hover:brightness-110 active:scale-95 transition-all cursor-pointer">
          Guardar Cambios
        </button>
      </div>
    </form>
  </div>
</div>

<script>
  import { characterStore } from '../../scripts/state/characterStore';
  import { closeModal, openModal } from '../../scripts/animations/modalAnimations';

  const modal = document.getElementById('edit-campaign-modal');
  const backdrop = document.getElementById('modal-backdrop');
  const closeBtn = document.getElementById('campaign-modal-close-btn');
  const cancelBtn = document.getElementById('campaign-modal-cancel-btn');
  const form = document.getElementById('edit-campaign-form') as HTMLFormElement;

  const nameInp = document.getElementById('campaign-name-input') as HTMLInputElement;
  const sessInp = document.getElementById('campaign-session-input') as HTMLInputElement;
  const weatherInp = document.getElementById('campaign-weather-input') as HTMLInputElement;
  const locInp = document.getElementById('campaign-location-input') as HTMLInputElement;

  function loadData() {
    const char = characterStore.get();
    if (!char.sessionContext) return;
    if (nameInp) nameInp.value = char.sessionContext.campaignName || '';
    if (sessInp) sessInp.value = String(char.sessionContext.sessionNumber || 1);
    if (weatherInp) weatherInp.value = char.sessionContext.weather || '';
    if (locInp) locInp.value = char.sessionContext.location || '';
  }

  window.addEventListener('open-campaign-modal', () => {
    loadData();
    if (modal && backdrop) openModal(modal, backdrop);
  });

  closeBtn?.addEventListener('click', () => {
    if (modal && backdrop) closeModal(modal, backdrop);
  });
  cancelBtn?.addEventListener('click', () => {
    if (modal && backdrop) closeModal(modal, backdrop);
  });

  form?.addEventListener('submit', (e) => {
    e.preventDefault();
    const campaignName = nameInp.value.trim() || 'Campaña';
    const sessionNumber = parseInt(sessInp.value || '1') || 1;
    const weather = weatherInp.value.trim() || 'Despejado';
    const location = locInp.value.trim() || 'Desconocido';

    characterStore.updateSessionContext({
      campaignName,
      sessionNumber,
      weather,
      location
    });

    if (modal && backdrop) closeModal(modal, backdrop);
  });
</script>
