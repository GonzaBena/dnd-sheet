---
// src/components/modals/EditFeaturesModal.astro
---

<div id="edit-features-modal" class="hidden fixed inset-0 z-50 flex items-center justify-center p-4">
  <div class="modal-content w-full max-w-lg rounded-2xl bg-[#121721] border border-[#222f42] shadow-[0_20px_60px_rgba(0,0,0,0.9)] overflow-hidden flex flex-col">
    <!-- Header -->
    <div class="p-4 bg-[#18202e] border-b border-[#222f42] flex items-center justify-between">
      <div class="flex items-center gap-2">
        <div class="w-8 h-8 rounded-lg bg-amber-500/20 text-amber-400 flex items-center justify-center border border-amber-500/30">
          <span class="material-symbols-outlined text-[18px]">psychology</span>
        </div>
        <div>
          <h3 class="font-headline font-bold text-base text-[#f1f5f9]">Rasgos de Clase y Dotes</h3>
          <span class="text-[10px] text-[#94a3b8]">Configura, añade o activa/desactiva tus habilidades especiales</span>
        </div>
      </div>
      <button id="features-modal-close-btn" class="w-7 h-7 rounded-lg bg-[#10141d] border border-[#222f42] hover:border-rose-500/50 text-[#94a3b8] hover:text-rose-400 flex items-center justify-center text-xs transition-colors cursor-pointer">
        <span class="material-symbols-outlined text-[16px]">close</span>
      </button>
    </div>

    <!-- Body: Features list with add button -->
    <div id="features-modal-body" class="p-5 space-y-4 text-xs font-label overflow-y-auto max-h-[65vh]">
      <div class="flex items-center justify-between flex-wrap gap-2">
        <span class="text-xs text-[#94a3b8] font-bold uppercase tracking-wider">Lista de Rasgos Registrados</span>
        <div class="flex items-center gap-2">
          <button
            type="button"
            id="features-open-compendium-btn"
            class="text-[10px] text-amber-400 hover:text-amber-300 font-bold bg-amber-500/10 hover:bg-amber-500/20 px-2.5 py-1 rounded-lg border border-amber-500/30 flex items-center gap-1 cursor-pointer transition-colors"
            title="Explorar dotes y habilidades oficiales del SRD (2024 / 2014)"
          >
            <span class="material-symbols-outlined text-[13px]">menu_book</span>
            <span>Buscar Dote en SRD</span>
          </button>
          <button
            type="button"
            id="add-new-feat-btn"
            class="text-[10px] text-amber-400 hover:text-amber-300 font-bold bg-amber-500/10 hover:bg-amber-500/20 px-2.5 py-1 rounded-lg border border-amber-500/30 flex items-center gap-1 cursor-pointer transition-colors"
          >
            <span class="material-symbols-outlined text-[13px]">add</span>
            <span>Añadir Nuevo Rasgo</span>
          </button>
        </div>
      </div>

      <div class="space-y-3" id="features-edit-list-container">
        <!-- Rendered by JS -->
      </div>
    </div>

    <!-- Footer -->
    <div class="p-4 bg-[#18202e] border-t border-[#222f42] flex items-center justify-end gap-2.5">
      <button type="button" id="features-modal-cancel-btn" class="px-4 py-2 rounded-xl bg-[#121721] border border-[#222f42] text-[#94a3b8] hover:text-[#f1f5f9] cursor-pointer">
        Cancelar
      </button>
      <button type="button" id="features-modal-save-btn" class="px-5 py-2 rounded-xl bg-gradient-to-r from-amber-600 to-amber-500 text-[#0a0d12] font-bold shadow-[0_0_12px_rgba(245,158,11,0.3)] hover:brightness-110 active:scale-95 transition-all cursor-pointer">
        Guardar Rasgos
      </button>
    </div>
  </div>
</div>

<script>
  import { characterStore } from '../../scripts/state/characterStore';
  import { closeModal, openModal } from '../../scripts/animations/modalAnimations';
  import { showForm, showAlert } from '../../scripts/ui/notify';
  import { escapeHtml, parseEffectsText, effectsToText } from '../../scripts/dnd/catalog';
  import { customBadgeHtml } from '../../scripts/ui/customBadge';
  import { FEAT_TYPE_LABELS, type FeatType } from '../../scripts/models/catalog';

  const modal = document.getElementById('edit-features-modal');
  const backdrop = document.getElementById('modal-backdrop');
  const closeBtn = document.getElementById('features-modal-close-btn');
  const cancelBtn = document.getElementById('features-modal-cancel-btn');
  const saveBtn = document.getElementById('features-modal-save-btn');
  const addBtn = document.getElementById('add-new-feat-btn');
  const listContainer = document.getElementById('features-edit-list-container');
  const modalBody = document.getElementById('features-modal-body');

  interface TempFeature {
    id: string;
    title: string;
    description: string;
    uses?: string;
    enabled: boolean;
    featType?: FeatType;
    resourceId?: string;
    effects?: any[];
    effectsText?: string;
    effectsError?: string;
    custom?: boolean;
  }
  let tempFeatures: TempFeature[] = [];

  function loadData() {
    const char = characterStore.get();
    tempFeatures = (char.features || []).map((f: any, idx: number) => ({
      id: f.id || `feat-${idx + 1}-${Date.now()}`,
      title: f.title || '',
      description: f.description || '',
      uses: f.uses || '',
      enabled: f.enabled !== false,
      // Se conservan los campos del catálogo para no perderlos al guardar (Spec 07, Fase C).
      featType: f.featType,
      resourceId: f.resourceId,
      effects: f.effects,
      effectsText: effectsToText(f.effects),
      custom: f.custom
    }));
    renderList();
  }

  function renderList() {
    if (!listContainer) return;
    listContainer.innerHTML = '';

    if (tempFeatures.length === 0) {
      listContainer.innerHTML = `
        <div class="py-6 text-center text-xs text-[#64748b]">
          No hay rasgos registrados. Pulsa "Añadir Nuevo Rasgo" para crear uno.
        </div>
      `;
      return;
    }

    tempFeatures.forEach((feat, index) => {
      const card = document.createElement('div');
      card.className = `p-3 rounded-xl bg-[#18202e] border ${feat.enabled ? 'border-[#222f42]' : 'border-[#222f42] opacity-60 bg-[#10141d]'} space-y-2.5`;

      card.innerHTML = `
        <div class="flex items-center justify-between gap-2">
          <label class="flex items-center gap-2 cursor-pointer">
            ${customBadgeHtml(feat)}
            <input type="checkbox" class="feat-toggle rounded bg-[#10141d] border-[#222f42] text-amber-500 focus:ring-amber-500/40" ${feat.enabled ? 'checked' : ''} data-index="${index}" />
            <span class="text-xs font-headline font-bold ${feat.enabled ? 'text-amber-300' : 'text-[#64748b]'}">
              ${feat.enabled ? 'Activo' : 'Inactivo'}
            </span>
          </label>
          <button type="button" class="del-feat-btn text-[10px] text-rose-400 hover:text-rose-300 font-bold hover:underline cursor-pointer" data-index="${index}">
            Eliminar
          </button>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-3 gap-2">
          <div class="sm:col-span-2">
            <label class="text-[#94a3b8] text-[10px] block mb-0.5">Título del Rasgo / Dote</label>
            <input
              type="text"
              class="feat-title-inp w-full p-2 rounded-lg bg-[#10141d] border border-[#222f42] text-[#f1f5f9] focus:border-amber-500 focus:outline-none"
              value="${escapeHtml(feat.title)}"
              placeholder="ej: Emboscador Umbrío"
              data-index="${index}"
            />
          </div>
          <div>
            <label class="text-[#94a3b8] text-[10px] block mb-0.5">Usos / Frecuencia</label>
            <input
              type="text"
              class="feat-uses-inp w-full p-2 rounded-lg bg-[#10141d] border border-[#222f42] text-[#f1f5f9] focus:border-amber-500 focus:outline-none"
              value="${escapeHtml(feat.uses || '')}"
              placeholder="ej: 2 / descanso"
              data-index="${index}"
            />
          </div>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-2">
          <div>
            <label class="text-[#94a3b8] text-[10px] block mb-0.5">Tipo de rasgo</label>
            <select class="feat-type-sel w-full p-2 rounded-lg bg-[#10141d] border border-[#222f42] text-[#f1f5f9] focus:border-amber-500 focus:outline-none">
              ${(Object.keys(FEAT_TYPE_LABELS) as FeatType[]).map((t) => `<option value="${t}" ${(feat.featType ?? 'passive') === t ? 'selected' : ''}>${FEAT_TYPE_LABELS[t]}</option>`).join('')}
            </select>
          </div>
          <div>
            <label class="text-[#94a3b8] text-[10px] block mb-0.5">Recurso vinculado (opcional)</label>
            <select class="feat-resource-sel w-full p-2 rounded-lg bg-[#10141d] border border-[#222f42] text-[#f1f5f9] focus:border-amber-500 focus:outline-none">
              <option value="">Sin recurso</option>
              ${(characterStore.get().resources || []).map((r: any) => `<option value="${escapeHtml(r.id)}" ${feat.resourceId === r.id ? 'selected' : ''}>${escapeHtml(r.name)} (${r.max - r.used}/${r.max})</option>`).join('')}
              <option value="__new__">+ Crear recurso nuevo…</option>
            </select>
          </div>
        </div>

        <div>
          <label class="text-[#94a3b8] text-[10px] block mb-0.5">Efectos al activar (opcional, una línea por modificador: objetivo operación valor)</label>
          <textarea
            rows="2"
            class="feat-effects-inp w-full p-2 rounded-lg bg-[#10141d] border border-[#222f42] text-[#cbd5e1] font-mono focus:border-amber-500 focus:outline-none resize-none"
            placeholder="ac add 2&#10;save.dex advantage"
          >${escapeHtml(feat.effectsText || '')}</textarea>
          <p class="feat-effects-error text-[10px] text-rose-400 mt-0.5 ${feat.effectsError ? '' : 'hidden'}">${escapeHtml(feat.effectsError || '')}</p>
        </div>

        <div>
          <label class="text-[#94a3b8] text-[10px] block mb-0.5">Descripción y Reglas</label>
          <textarea
            rows="2"
            class="feat-desc-inp w-full p-2 rounded-lg bg-[#10141d] border border-[#222f42] text-[#cbd5e1] focus:border-amber-500 focus:outline-none resize-none"
            placeholder="Detalles y efecto mecánico del rasgo..."
            data-index="${index}"
          >${escapeHtml(feat.description)}</textarea>
        </div>
      `;

      // Event listeners
      card.querySelector('.feat-toggle')?.addEventListener('change', (e: any) => {
        feat.enabled = e.target.checked;
        renderList();
      });

      card.querySelector('.feat-type-sel')?.addEventListener('change', (e: any) => {
        feat.featType = e.target.value as FeatType;
      });

      card.querySelector('.feat-resource-sel')?.addEventListener('change', async (e: any) => {
        const value = e.target.value as string;
        if (value !== '__new__') {
          feat.resourceId = value || undefined;
          return;
        }
        const res = await showForm([
          { name: 'name', label: 'Nombre del recurso', type: 'text', value: feat.title, required: true },
          { name: 'max', label: 'Usos máximos', type: 'number', value: 1, min: 1, required: true },
          {
            name: 'rechargeOn', label: 'Se recupera con', type: 'select', value: 'longRest',
            options: [
              { value: 'shortRest', label: 'Descanso corto' },
              { value: 'longRest', label: 'Descanso largo' },
              { value: 'turn', label: 'Cada turno' },
              { value: 'manual', label: 'A mano' }
            ]
          }
        ], { title: 'Crear recurso nuevo', confirmText: 'Crear' });
        if (res) {
          // Se guarda de inmediato en el personaje (el registro de recursos es independiente de "Guardar Rasgos").
          const created = characterStore.addResource({
            name: (res.name || '').trim() || feat.title || 'Recurso',
            max: Math.max(1, parseInt(res.max) || 1),
            rechargeOn: (res.rechargeOn as any) || 'longRest',
            source: 'custom'
          });
          feat.resourceId = created.id;
        }
        renderList();
      });

      card.querySelector('.feat-effects-inp')?.addEventListener('input', (e: any) => {
        feat.effectsText = e.target.value;
        const parsed = parseEffectsText(feat.effectsText || '');
        const errEl = card.querySelector('.feat-effects-error') as HTMLElement | null;
        if (Array.isArray(parsed)) {
          feat.effects = parsed.length ? parsed : undefined;
          feat.effectsError = undefined;
        } else {
          feat.effectsError = parsed.error;
        }
        if (errEl) {
          errEl.textContent = feat.effectsError ?? '';
          errEl.classList.toggle('hidden', !feat.effectsError);
        }
      });

      card.querySelector('.feat-title-inp')?.addEventListener('input', (e: any) => {
        feat.title = e.target.value;
      });

      card.querySelector('.feat-uses-inp')?.addEventListener('input', (e: any) => {
        feat.uses = e.target.value;
      });

      card.querySelector('.feat-desc-inp')?.addEventListener('input', (e: any) => {
        feat.description = e.target.value;
      });

      card.querySelector('.del-feat-btn')?.addEventListener('click', () => {
        tempFeatures.splice(index, 1);
        renderList();
      });

      listContainer.appendChild(card);
    });
  }

  addBtn?.addEventListener('click', () => {
    tempFeatures.unshift({
      id: `feat-${Date.now()}-${Math.random().toString(36).substr(2, 4)}`,
      title: 'Nuevo Rasgo',
      description: 'Descripción del rasgo o dote.',
      uses: 'Pasivo',
      enabled: true,
      featType: 'passive',
      custom: true
    });
    renderList();

    if (modalBody) {
      modalBody.scrollTo({ top: 0, behavior: 'smooth' });
    }

    const firstTitleInput = listContainer?.querySelector<HTMLInputElement>('.feat-title-inp');
    if (firstTitleInput) {
      firstTitleInput.focus();
      firstTitleInput.select();
    }
  });

  document.getElementById('features-open-compendium-btn')?.addEventListener('click', () => {
    if (modal && backdrop) closeModal(modal, backdrop);
    window.dispatchEvent(new CustomEvent('open-compendium-modal', {
      detail: { scope: 'feats', category: 'feats', targetModal: 'edit-features' }
    }));
  });

  window.addEventListener('open-features-modal', () => {
    loadData();
    if (modal && backdrop) openModal(modal, backdrop);
  });

  closeBtn?.addEventListener('click', () => {
    if (modal && backdrop) closeModal(modal, backdrop);
  });
  cancelBtn?.addEventListener('click', () => {
    if (modal && backdrop) closeModal(modal, backdrop);
  });

  saveBtn?.addEventListener('click', () => {
    const bad = tempFeatures.find(f => f.title.trim() && f.effectsError);
    if (bad) {
      showAlert(`Corrige los efectos de "${bad.title}": ${bad.effectsError}`, { kind: 'warning' });
      return;
    }
    const valid = tempFeatures
      .filter(f => f.title.trim())
      .map(({ effectsText, effectsError, ...f }) => ({ ...f, featType: f.featType ?? 'passive' }));
    characterStore.updateFeatures(valid);
    if (modal && backdrop) closeModal(modal, backdrop);
  });
</script>
