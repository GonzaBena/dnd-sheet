---
// src/components/modals/AddWeaponModal.astro
---

<div id="add-weapon-modal" class="hidden fixed inset-0 z-50 flex items-center justify-center p-4">
  <div class="modal-content w-full max-w-lg rounded-2xl bg-[#121721] border border-[#222f42] shadow-[0_20px_60px_rgba(0,0,0,0.9)] overflow-hidden flex flex-col max-h-[90vh]">
    <!-- Header -->
    <div class="p-4 bg-[#18202e] border-b border-[#222f42] flex items-center justify-between shrink-0">
      <div class="flex items-center gap-2">
        <div class="w-8 h-8 rounded-lg bg-amber-500/20 text-amber-400 flex items-center justify-center border border-amber-500/30">
          <span class="material-symbols-outlined text-[20px]" id="weapon-modal-icon">swords</span>
        </div>
        <div>
          <h3 class="font-headline font-bold text-base text-[#f1f5f9]" id="weapon-modal-title">Añadir Arma o Ataque</h3>
          <span class="text-[10px] text-[#94a3b8]" id="weapon-modal-subtitle">Configura armas equipadas y modificadores dinámicos</span>
        </div>
      </div>
      <button id="add-weapon-close-btn" class="w-7 h-7 rounded-lg bg-[#10141d] border border-[#222f42] hover:border-rose-500/50 text-[#94a3b8] hover:text-rose-400 flex items-center justify-center text-xs transition-colors cursor-pointer">
        <span class="material-symbols-outlined text-[16px]">close</span>
      </button>
    </div>

    <!-- Body -->
    <form id="add-weapon-form" class="p-5 space-y-3.5 text-xs font-label overflow-y-auto flex-1">
      <input type="hidden" id="weapon-edit-id" value="" />

      <div>
        <div class="flex items-center justify-between mb-1">
          <label class="text-[#94a3b8]">Nombre del Arma / Acción</label>
          <button
            type="button"
            id="weapon-open-compendium-btn"
            class="text-[10px] text-amber-400 hover:text-amber-300 font-bold flex items-center gap-1 bg-amber-500/10 hover:bg-amber-500/20 px-2 py-0.5 rounded-lg border border-amber-500/30 transition-all cursor-pointer"
            title="Buscar en la base de datos oficial del SRD (2024 o 2014)"
          >
            <span class="material-symbols-outlined text-[13px]">menu_book</span>
            <span>Buscar Arma en SRD</span>
          </button>
        </div>
        <input
          type="text"
          id="weapon-name-input"
          required
          placeholder="ej: Arco Largo Élfico, Espada Corta de Plata..."
          class="w-full p-2.5 rounded-lg bg-[#18202e] border border-[#222f42] text-[#f1f5f9] focus:border-amber-500 focus:outline-none"
        />
      </div>

      <div class="grid grid-cols-2 gap-3">
        <div>
          <label class="text-[#94a3b8] block mb-1">Tipo de Ataque</label>
          <select id="weapon-type-select" class="w-full p-2.5 rounded-lg bg-[#18202e] border border-[#222f42] text-[#f1f5f9] focus:border-amber-500 focus:outline-none">
            <option value="Cuerpo a cuerpo">Cuerpo a cuerpo</option>
            <option value="A distancia">A distancia</option>
            <option value="Mágico">Ataque Mágico</option>
          </select>
        </div>

        <div>
          <label class="text-[#94a3b8] block mb-1">Tipo de Daño</label>
          <select id="weapon-damage-type-select" class="w-full p-2.5 rounded-lg bg-[#18202e] border border-[#222f42] text-[#f1f5f9] focus:border-amber-500 focus:outline-none">
            <option value="Perforante">Perforante</option>
            <option value="Cortante">Cortante</option>
            <option value="Contundente">Contundente</option>
            <option value="Fuego">Fuego</option>
            <option value="Frío">Frío</option>
            <option value="Veneno">Veneno</option>
            <option value="Radiante">Radiante</option>
            <option value="Necrótico">Necrótico</option>
            <option value="Fuerza">Fuerza</option>
            <option value="Psíquico">Psíquico</option>
            <option value="Ácido">Ácido</option>
            <option value="Trueno">Trueno</option>
          </select>
        </div>
      </div>

      <!-- Mode Selector: Auto vs Manual -->
      <div class="p-3 rounded-xl bg-[#10141d] border border-[#222f42] space-y-3">
        <div class="flex items-center justify-between">
          <span class="font-bold text-[#cbd5e1] text-[11px] flex items-center gap-1.5">
            <span class="material-symbols-outlined text-amber-500 text-[16px]">tune</span>
            <span>Modo de Modificadores</span>
          </span>
          <div class="flex items-center gap-1 bg-[#18202e] p-0.5 rounded-lg border border-[#222f42]">
            <button
              type="button"
              id="mode-auto-btn"
              class="px-2.5 py-1 rounded text-[10px] font-bold bg-amber-500/20 text-amber-400 border border-amber-500/40 cursor-pointer transition-all"
            >
              Automático D&D 5e
            </button>
            <button
              type="button"
              id="mode-manual-btn"
              class="px-2.5 py-1 rounded text-[10px] font-bold text-[#64748b] hover:text-[#94a3b8] cursor-pointer transition-all"
            >
              Manual
            </button>
          </div>
        </div>

        <!-- Automatic Mode Section -->
        <div id="weapon-auto-section" class="space-y-3">
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
            <div>
              <label class="text-[#94a3b8] block mb-1">Atributo Base</label>
              <select id="weapon-ability-select" class="w-full p-2 rounded-lg bg-[#18202e] border border-[#222f42] text-[#f1f5f9] focus:border-amber-500 focus:outline-none">
                <option value="dex">Destreza (DEX)</option>
                <option value="str">Fuerza (STR)</option>
                <option value="wis">Sabiduría (WIS)</option>
                <option value="int">Inteligencia (INT)</option>
                <option value="cha">Carisma (CHA)</option>
                <option value="con">Constitución (CON)</option>
                <option value="none">Sin Atributo (+0)</option>
              </select>
            </div>

            <div>
              <label class="text-[#94a3b8] block mb-1">Dado Base de Daño</label>
              <select id="weapon-damage-dice-select" class="w-full p-2 rounded-lg bg-[#18202e] border border-[#222f42] text-[#f1f5f9] focus:border-amber-500 focus:outline-none">
                <option value="1d4">1d4 (Daga, Garrote)</option>
                <option value="1d6">1d6 (Espada corta, Arco corto)</option>
                <option value="1d8" selected>1d8 (Arco largo, Estoque)</option>
                <option value="1d10">1d10 (Ballesta pesada, Alabarda)</option>
                <option value="1d12">1d12 (Gran hacha)</option>
                <option value="2d6">2d6 (Espadón, Mandoble)</option>
              </select>
            </div>
          </div>

          <div class="grid grid-cols-2 gap-3">
            <div>
              <label class="text-[#94a3b8] block mb-1">Bono Mágico / Extra Impacto</label>
              <input
                type="number"
                id="weapon-atk-bonus-mod"
                value="0"
                placeholder="ej: +1"
                class="w-full p-2 rounded-lg bg-[#18202e] border border-[#222f42] text-[#f1f5f9] focus:border-amber-500 focus:outline-none"
              />
            </div>
            <div>
              <label class="text-[#94a3b8] block mb-1">Bono Mágico / Extra Daño</label>
              <input
                type="number"
                id="weapon-dmg-bonus-mod"
                value="0"
                placeholder="ej: +1"
                class="w-full p-2 rounded-lg bg-[#18202e] border border-[#222f42] text-[#f1f5f9] focus:border-amber-500 focus:outline-none"
              />
            </div>
          </div>

          <div class="flex flex-wrap items-center gap-4 pt-1">
            <label class="flex items-center gap-2 cursor-pointer select-none">
              <input type="checkbox" id="weapon-proficient-check" checked class="w-4 h-4 rounded border-[#222f42] text-amber-500 focus:ring-amber-500/20 bg-[#18202e]" />
              <span class="text-[#cbd5e1] text-[11px]">Competente con el arma (añade bono de competencia)</span>
            </label>
            <label class="flex items-center gap-2 cursor-pointer select-none">
              <input type="checkbox" id="weapon-add-ability-dmg-check" checked class="w-4 h-4 rounded border-[#222f42] text-amber-500 focus:ring-amber-500/20 bg-[#18202e]" />
              <span class="text-[#cbd5e1] text-[11px]">Sumar atributo al daño</span>
            </label>
          </div>

          <!-- Live Preview Box -->
          <div class="p-2.5 rounded-lg bg-amber-500/10 border border-amber-500/30 flex items-center justify-between text-xs">
            <span class="text-amber-400 font-bold flex items-center gap-1.5">
              <span class="material-symbols-outlined text-[15px]">calculate</span>
              <span>Cálculo dinámico:</span>
            </span>
            <div class="flex items-center gap-2 font-headline font-bold">
              <span id="preview-atk" class="text-[#f1f5f9] bg-[#18202e] px-2 py-0.5 rounded border border-[#222f42]">+6 al Impacto</span>
              <span id="preview-dmg" class="text-amber-300 bg-[#18202e] px-2 py-0.5 rounded border border-[#222f42]">1d8 + 3</span>
            </div>
          </div>
        </div>

        <!-- Manual Mode Section (Hidden by default) -->
        <div id="weapon-manual-section" class="space-y-3 hidden">
          <div class="grid grid-cols-2 gap-3">
            <div>
              <label class="text-[#94a3b8] block mb-1">Bono al Impacto Manual</label>
              <input
                type="text"
                id="weapon-bonus-input"
                value="+6 al Impacto"
                placeholder="ej: +6 al Impacto"
                class="w-full p-2 rounded-lg bg-[#18202e] border border-[#222f42] text-[#f1f5f9] focus:border-amber-500 focus:outline-none"
              />
            </div>
            <div>
              <label class="text-[#94a3b8] block mb-1">Fórmula de Daño Manual</label>
              <input
                type="text"
                id="weapon-damage-input"
                value="1d8 + 3"
                placeholder="ej: 1d8 + 3, 2d6 + 4"
                class="w-full p-2 rounded-lg bg-[#18202e] border border-[#222f42] text-[#f1f5f9] focus:border-amber-500 focus:outline-none"
              />
            </div>
          </div>
        </div>
      </div>

      <div>
        <label class="text-[#94a3b8] block mb-1">Propiedades / Etiquetas (separadas por coma)</label>
        <input
          type="text"
          id="weapon-tags-input"
          value="Sutil, Ligera"
          placeholder="ej: Sutil, Ligera, Plata, Rango 150/600"
          class="w-full p-2.5 rounded-lg bg-[#18202e] border border-[#222f42] text-[#f1f5f9] focus:border-amber-500 focus:outline-none"
        />
      </div>

      <!-- Notes / Special Effects / Activation Conditions -->
      <div>
        <label class="text-[#94a3b8] block mb-1 flex items-center justify-between">
          <span class="flex items-center gap-1">
            <span class="material-symbols-outlined text-amber-500 text-[14px]">auto_awesome</span>
            <span>Notas, Efectos Especiales o Condiciones de Activación</span>
          </span>
          <span class="text-[10px] text-[#64748b]">Opcional</span>
        </label>
        <textarea
          id="weapon-notes-input"
          rows="2"
          placeholder="ej: Daño adicional de 1d6 de fuego contra no-muertos. Crítico con 19-20..."
          class="w-full p-2.5 rounded-lg bg-[#18202e] border border-[#222f42] text-[#f1f5f9] focus:border-amber-500 focus:outline-none resize-none"
        ></textarea>
      </div>

      <!-- Footer -->
      <div class="pt-3 border-t border-[#222f42] flex items-center justify-end gap-2.5 shrink-0">
        <button type="button" id="add-weapon-cancel-btn" class="px-4 py-2 rounded-xl bg-[#121721] border border-[#222f42] text-[#94a3b8] hover:text-[#f1f5f9] cursor-pointer">
          Cancelar
        </button>
        <button type="submit" id="weapon-submit-btn" class="px-5 py-2 rounded-xl bg-gradient-to-r from-amber-600 to-amber-500 text-[#0a0d12] font-bold shadow-[0_0_12px_rgba(245,158,11,0.3)] hover:brightness-110 active:scale-95 transition-all cursor-pointer">
          Guardar Arma
        </button>
      </div>
    </form>
  </div>
</div>

<script>
  import { characterStore } from '../../scripts/state/characterStore';
  import { closeModal, openModal } from '../../scripts/animations/modalAnimations';

  const modal = document.getElementById('add-weapon-modal');
  const backdrop = document.getElementById('modal-backdrop');
  const form = document.getElementById('add-weapon-form') as HTMLFormElement;
  const closeBtn = document.getElementById('add-weapon-close-btn');
  const cancelBtn = document.getElementById('add-weapon-cancel-btn');
  const modalTitle = document.getElementById('weapon-modal-title');
  const modalSubtitle = document.getElementById('weapon-modal-subtitle');
  const submitBtn = document.getElementById('weapon-submit-btn');

  const editIdInp = document.getElementById('weapon-edit-id') as HTMLInputElement;
  const nameInp = document.getElementById('weapon-name-input') as HTMLInputElement;
  const typeSel = document.getElementById('weapon-type-select') as HTMLSelectElement;
  const dmgTypeSel = document.getElementById('weapon-damage-type-select') as HTMLSelectElement;
  const tagsInp = document.getElementById('weapon-tags-input') as HTMLInputElement;
  const notesInp = document.getElementById('weapon-notes-input') as HTMLTextAreaElement;

  // Mode toggles
  const modeAutoBtn = document.getElementById('mode-auto-btn');
  const modeManualBtn = document.getElementById('mode-manual-btn');
  const autoSection = document.getElementById('weapon-auto-section');
  const manualSection = document.getElementById('weapon-manual-section');

  // Auto calculation inputs
  const abilitySel = document.getElementById('weapon-ability-select') as HTMLSelectElement;
  const damageDiceSel = document.getElementById('weapon-damage-dice-select') as HTMLSelectElement;
  const atkBonusModInp = document.getElementById('weapon-atk-bonus-mod') as HTMLInputElement;
  const dmgBonusModInp = document.getElementById('weapon-dmg-bonus-mod') as HTMLInputElement;
  const proficientCheck = document.getElementById('weapon-proficient-check') as HTMLInputElement;
  const addAbilityDmgCheck = document.getElementById('weapon-add-ability-dmg-check') as HTMLInputElement;

  // Manual inputs
  const bonusInp = document.getElementById('weapon-bonus-input') as HTMLInputElement;
  const dmgInp = document.getElementById('weapon-damage-input') as HTMLInputElement;

  // Preview elements
  const previewAtk = document.getElementById('preview-atk');
  const previewDmg = document.getElementById('preview-dmg');

  let isAutoMode = true;

  function setMode(auto: boolean) {
    isAutoMode = auto;
    if (auto) {
      modeAutoBtn?.classList.add('bg-amber-500/20', 'text-amber-400', 'border-amber-500/40');
      modeAutoBtn?.classList.remove('text-[#64748b]');
      modeManualBtn?.classList.remove('bg-amber-500/20', 'text-amber-400', 'border-amber-500/40');
      modeManualBtn?.classList.add('text-[#64748b]');
      autoSection?.classList.remove('hidden');
      manualSection?.classList.add('hidden');
      updatePreview();
    } else {
      modeManualBtn?.classList.add('bg-amber-500/20', 'text-amber-400', 'border-amber-500/40');
      modeManualBtn?.classList.remove('text-[#64748b]');
      modeAutoBtn?.classList.remove('bg-amber-500/20', 'text-amber-400', 'border-amber-500/40');
      modeAutoBtn?.classList.add('text-[#64748b]');
      manualSection?.classList.remove('hidden');
      autoSection?.classList.add('hidden');
    }
  }

  modeAutoBtn?.addEventListener('click', () => setMode(true));
  modeManualBtn?.addEventListener('click', () => setMode(false));

  function updatePreview() {
    const char = characterStore.get();
    const ability = abilitySel.value as any;
    const statMod = (ability !== 'none' && char.stats && char.stats[ability]) ? char.stats[ability].modifier : 0;
    const profBonus = proficientCheck.checked ? (char.proficiencyBonus || 3) : 0;
    const atkFlat = parseInt(atkBonusModInp.value || '0') || 0;
    const totalAtk = profBonus + statMod + atkFlat;

    const baseDice = damageDiceSel.value || '1d8';
    const dmgStatMod = (addAbilityDmgCheck.checked && ability !== 'none') ? statMod : 0;
    const dmgFlat = parseInt(dmgBonusModInp.value || '0') || 0;
    const totalDmgMod = dmgStatMod + dmgFlat;

    let dmgStr = baseDice;
    if (totalDmgMod > 0) dmgStr += ` + ${totalDmgMod}`;
    else if (totalDmgMod < 0) dmgStr += ` - ${Math.abs(totalDmgMod)}`;

    if (previewAtk) previewAtk.textContent = `${totalAtk >= 0 ? '+' : ''}${totalAtk} al Impacto`;
    if (previewDmg) previewDmg.textContent = dmgStr;

    // Keep manual inputs synced as well
    if (bonusInp) bonusInp.value = `${totalAtk >= 0 ? '+' : ''}${totalAtk} al Impacto`;
    if (dmgInp) dmgInp.value = dmgStr;
  }

  [abilitySel, damageDiceSel, atkBonusModInp, dmgBonusModInp, proficientCheck, addAbilityDmgCheck].forEach(el => {
    el?.addEventListener('input', updatePreview);
    el?.addEventListener('change', updatePreview);
  });

  function resetForm() {
    editIdInp.value = '';
    nameInp.value = '';
    typeSel.value = 'Cuerpo a cuerpo';
    dmgTypeSel.value = 'Perforante';
    tagsInp.value = 'Sutil, Ligera';
    notesInp.value = '';
    abilitySel.value = 'dex';
    damageDiceSel.value = '1d8';
    atkBonusModInp.value = '0';
    dmgBonusModInp.value = '0';
    proficientCheck.checked = true;
    addAbilityDmgCheck.checked = true;
    bonusInp.value = '+6 al Impacto';
    dmgInp.value = '1d8 + 3';
    setMode(true);
    if (modalTitle) modalTitle.textContent = 'Añadir Arma o Ataque';
    if (modalSubtitle) modalSubtitle.textContent = 'Configura armas equipadas y modificadores dinámicos';
    if (submitBtn) submitBtn.textContent = 'Añadir Arma';
  }

  function loadWeaponForEdit(action: any) {
    editIdInp.value = action.id;
    nameInp.value = action.name || '';
    typeSel.value = action.type || 'Cuerpo a cuerpo';
    dmgTypeSel.value = action.damageType || 'Perforante';
    tagsInp.value = Array.isArray(action.tags) ? action.tags.join(', ') : '';
    notesInp.value = action.notes || '';

    if (action.isAuto !== false && (action.ability || action.damageDice || action.isAuto)) {
      setMode(true);
      abilitySel.value = action.ability || 'dex';
      damageDiceSel.value = action.damageDice || (action.damage?.match(/^(\d+d\d+)/)?.[1] || '1d8');
      atkBonusModInp.value = (action.attackBonusMod ?? 0).toString();
      dmgBonusModInp.value = (action.damageBonusMod ?? 0).toString();
      proficientCheck.checked = action.proficient !== false;
      addAbilityDmgCheck.checked = action.addAbilityToDamage !== false;
      updatePreview();
    } else {
      setMode(false);
      bonusInp.value = action.bonus || '+0';
      dmgInp.value = action.damage || '1d6';
    }

    if (modalTitle) modalTitle.textContent = 'Editar Arma o Ataque';
    if (modalSubtitle) modalSubtitle.textContent = `Ajustando propiedades de "${action.name}"`;
    if (submitBtn) submitBtn.textContent = 'Guardar Cambios';
  }

  // Open modal handlers
  window.addEventListener('open-add-weapon-modal', ((e: CustomEvent) => {
    resetForm();
    if (e.detail?.prefill) {
      loadWeaponForEdit(e.detail.prefill);
      editIdInp.value = '';
      if (modalTitle) modalTitle.textContent = 'Añadir Arma desde Compendio';
      if (modalSubtitle) modalSubtitle.textContent = 'Revisa y ajusta los datos antes de guardarla en tus acciones';
      if (submitBtn) submitBtn.textContent = 'Añadir Arma';
    }
    if (modal && backdrop) openModal(modal, backdrop);
  }) as EventListener);

  document.getElementById('weapon-open-compendium-btn')?.addEventListener('click', () => {
    const q = nameInp.value.trim();
    if (modal && backdrop) closeModal(modal, backdrop);
    window.dispatchEvent(new CustomEvent('open-compendium-modal', {
      detail: { scope: 'weapons', category: 'weapons', query: q, targetModal: 'add-weapon' }
    }));
  });

  window.addEventListener('open-edit-weapon-modal', ((e: CustomEvent) => {
    const act = e.detail?.action;
    if (act) {
      loadWeaponForEdit(act);
      if (modal && backdrop) openModal(modal, backdrop);
    }
  }) as EventListener);

  closeBtn?.addEventListener('click', () => {
    if (modal && backdrop) closeModal(modal, backdrop);
  });
  cancelBtn?.addEventListener('click', () => {
    if (modal && backdrop) closeModal(modal, backdrop);
  });

  form?.addEventListener('submit', (e) => {
    e.preventDefault();
    const name = nameInp.value.trim();
    if (!name) return;

    const rawTags = tagsInp.value.split(',').map(t => t.trim()).filter(Boolean);
    const editId = editIdInp.value.trim();

    let bonus = bonusInp.value.trim() || '+0';
    let damage = dmgInp.value.trim() || '1d6';

    const char = characterStore.get();
    const ability = abilitySel.value as any;
    const statMod = (ability !== 'none' && char.stats && char.stats[ability]) ? char.stats[ability].modifier : 0;
    const profBonus = proficientCheck.checked ? (char.proficiencyBonus || 3) : 0;
    const atkFlat = parseInt(atkBonusModInp.value || '0') || 0;
    const totalAtk = profBonus + statMod + atkFlat;

    const baseDice = damageDiceSel.value || '1d8';
    const dmgStatMod = (addAbilityDmgCheck.checked && ability !== 'none') ? statMod : 0;
    const dmgFlat = parseInt(dmgBonusModInp.value || '0') || 0;
    const totalDmgMod = dmgStatMod + dmgFlat;

    if (isAutoMode) {
      bonus = `${totalAtk >= 0 ? '+' : ''}${totalAtk} al Impacto`;
      damage = baseDice;
      if (totalDmgMod > 0) damage += ` + ${totalDmgMod}`;
      else if (totalDmgMod < 0) damage += ` - ${Math.abs(totalDmgMod)}`;
    }

    const payload = {
      name,
      type: typeSel.value,
      bonus,
      damage,
      damageType: dmgTypeSel.value,
      tags: rawTags.length > 0 ? rawTags : ['Equipada'],
      isAuto: isAutoMode,
      ability: isAutoMode ? ability : 'none',
      proficient: isAutoMode ? proficientCheck.checked : false,
      attackBonusMod: isAutoMode ? atkFlat : 0,
      damageDice: isAutoMode ? baseDice : undefined,
      damageBonusMod: isAutoMode ? dmgFlat : 0,
      addAbilityToDamage: isAutoMode ? addAbilityDmgCheck.checked : false,
      notes: notesInp.value.trim() || undefined
    };

    if (editId) {
      characterStore.updateAction(editId, payload);
    } else {
      characterStore.addAction(payload);
    }

    form.reset();
    if (modal && backdrop) closeModal(modal, backdrop);
  });
</script>
