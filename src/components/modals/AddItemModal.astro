---
// src/components/modals/AddItemModal.astro
import CustomEntryFields from '../ui/CustomEntryFields.astro';
---

<div id="add-item-modal" class="hidden fixed inset-0 z-50 flex items-center justify-center p-4">
  <div class="modal-content w-full max-w-lg rounded-2xl bg-[#121721] border border-[#222f42] shadow-[0_20px_60px_rgba(0,0,0,0.9)] overflow-hidden flex flex-col max-h-[90vh]">
    <!-- Header -->
    <div class="p-4 bg-[#18202e] border-b border-[#222f42] flex items-center justify-between shrink-0">
      <div class="flex items-center gap-2">
        <div class="w-8 h-8 rounded-lg bg-amber-500/20 text-amber-400 flex items-center justify-center border border-amber-500/30">
          <span class="material-symbols-outlined text-[20px]" id="item-modal-icon">backpack</span>
        </div>
        <div>
          <h3 class="font-headline font-bold text-base text-[#f1f5f9]" id="item-modal-title">Añadir Objeto a la Mochila</h3>
          <span class="text-[10px] text-[#94a3b8]" id="item-modal-subtitle">Pociones, equipo de viaje, armas o artefactos con notas</span>
        </div>
      </div>
      <button id="add-item-close-btn" class="w-7 h-7 rounded-lg bg-[#10141d] border border-[#222f42] hover:border-rose-500/50 text-[#94a3b8] hover:text-rose-400 flex items-center justify-center text-xs transition-colors cursor-pointer">
        <span class="material-symbols-outlined text-[16px]">close</span>
      </button>
    </div>

    <!-- Body -->
    <form id="add-item-form" class="p-5 space-y-3.5 text-xs font-label overflow-y-auto flex-1">
      <input type="hidden" id="item-edit-id" value="" />

      <div>
        <div class="flex items-center justify-between mb-1">
          <label class="text-[#94a3b8]">Nombre del Objeto</label>
          <button
            type="button"
            id="item-open-compendium-btn"
            class="text-[10px] text-amber-400 hover:text-amber-300 font-bold flex items-center gap-1 bg-amber-500/10 hover:bg-amber-500/20 px-2 py-0.5 rounded-lg border border-amber-500/30 transition-all cursor-pointer"
            title="Buscar en la base de datos oficial del SRD (2024 o 2014)"
          >
            <span class="material-symbols-outlined text-[13px]">menu_book</span>
            <span>Buscar en Compendio SRD</span>
          </button>
        </div>
        <input
          type="text"
          id="item-name-input"
          required
          placeholder="ej: Antorcha de fuego perpetuo, Raciones, Reliquia..."
          class="w-full p-2.5 rounded-lg bg-[#18202e] border border-[#222f42] text-[#f1f5f9] focus:border-amber-500 focus:outline-none"
        />
      </div>

      <div class="grid grid-cols-2 gap-3">
        <div>
          <label class="text-[#94a3b8] block mb-1">Categoría</label>
          <select id="item-category-select" class="w-full p-2.5 rounded-lg bg-[#18202e] border border-[#222f42] text-[#f1f5f9] focus:border-amber-500 focus:outline-none">
            <option value="gear">Equipo de aventura</option>
            <option value="potion">Poción o Consumible</option>
            <option value="treasure">Tesoro / Joya</option>
            <option value="weapon">Arma / Munición</option>
            <option value="armor">Armadura / Escudo</option>
          </select>
          <label class="flex items-center gap-1.5 mt-1.5 text-[11px] text-[#94a3b8] cursor-pointer">
            <input type="checkbox" id="item-requires-attunement" class="accent-amber-500" />
            Requiere sintonización
          </label>
        </div>

        <div>
          <label class="text-[#94a3b8] block mb-1">Cantidad</label>
          <input
            type="number"
            id="item-quantity-input"
            value="1"
            min="1"
            max="999"
            class="w-full p-2.5 rounded-lg bg-[#18202e] border border-[#222f42] text-[#f1f5f9] focus:border-amber-500 focus:outline-none"
          />
        </div>
      </div>

      <!-- Usable / Edible / Drinkable selector -->
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
        <div>
          <label class="text-[#94a3b8] block mb-1">Tipo de Uso</label>
          <select
            id="item-usable-select"
            class="w-full p-2.5 rounded-lg bg-[#18202e] border border-[#222f42] text-[#f1f5f9] focus:border-amber-500 focus:outline-none"
          >
            <option value="none">Normal (Equipo / Tesoro)</option>
            <option value="drinkable">Bebible (Poción, Brebaje, Elixir)</option>
            <option value="edible">Comestible (Raciones, Baya mágica)</option>
            <option value="usable">Usable (Varita, Pergamino, Objeto)</option>
          </select>
        </div>

        <div>
          <label class="text-[#94a3b8] block mb-1">Curación en PG (Opcional)</label>
          <input
            type="number"
            id="item-heal-input"
            value="0"
            min="0"
            placeholder="ej: 10"
            class="w-full p-2.5 rounded-lg bg-[#18202e] border border-[#222f42] text-[#f1f5f9] focus:border-amber-500 focus:outline-none"
          />
        </div>
      </div>

      <!-- Activation condition field -->
      <div>
        <label class="text-[#94a3b8] block mb-1 flex items-center justify-between">
          <span class="flex items-center gap-1">
            <span class="material-symbols-outlined text-amber-500 text-[14px]">timer</span>
            <span>Condición de Activación / Frecuencia</span>
          </span>
          <span class="text-[10px] text-[#64748b]">Opcional</span>
        </label>
        <input
          type="text"
          id="item-activation-input"
          placeholder="ej: 1 vez por descanso largo, Acción adicional, Al recibir daño..."
          class="w-full p-2.5 rounded-lg bg-[#18202e] border border-[#222f42] text-[#f1f5f9] focus:border-amber-500 focus:outline-none"
        />
      </div>

      <div>
        <label class="text-[#94a3b8] block mb-1">Descripción Breve</label>
        <input
          type="text"
          id="item-desc-input"
          placeholder="ej: Ilumina en un radio de 20 pies; no se apaga con agua..."
          class="w-full p-2.5 rounded-lg bg-[#18202e] border border-[#222f42] text-[#f1f5f9] focus:border-amber-500 focus:outline-none"
        />
      </div>

      <!-- Extended Notes / Special Effects -->
      <div>
        <label class="text-[#94a3b8] block mb-1 flex items-center justify-between">
          <span class="flex items-center gap-1">
            <span class="material-symbols-outlined text-amber-500 text-[14px]">auto_awesome</span>
            <span>Efectos Especiales y Notas Detalladas</span>
          </span>
          <span class="text-[10px] text-[#64748b]">Opcional</span>
        </label>
        <textarea
          id="item-notes-input"
          rows="3"
          placeholder="ej: Requiere sintonización. Otorga resistencia al frío y visión en la penumbra. Al romperse, libera una nube de humo de 10 pies..."
          class="w-full p-2.5 rounded-lg bg-[#18202e] border border-[#222f42] text-[#f1f5f9] focus:border-amber-500 focus:outline-none resize-none"
        ></textarea>
      </div>

      <CustomEntryFields prefix="item" />

      <!-- Footer -->
      <div class="pt-3 border-t border-[#222f42] flex items-center justify-end gap-2.5 shrink-0">
        <button type="button" id="add-item-cancel-btn" class="px-4 py-2 rounded-xl bg-[#121721] border border-[#222f42] text-[#94a3b8] hover:text-[#f1f5f9] cursor-pointer">
          Cancelar
        </button>
        <button type="submit" id="item-submit-btn" class="px-5 py-2 rounded-xl bg-gradient-to-r from-amber-600 to-amber-500 text-[#0a0d12] font-bold shadow-[0_0_12px_rgba(245,158,11,0.3)] hover:brightness-110 active:scale-95 transition-all cursor-pointer">
          Guardar Objeto
        </button>
      </div>
    </form>
  </div>
</div>

<script>
  import { characterStore } from '../../scripts/state/characterStore';
  import { closeModal, openModal } from '../../scripts/animations/modalAnimations';
  import { initCustomEntry } from '../../scripts/ui/customEntry';
  import { showAlert } from '../../scripts/ui/notify';

  const customEntry = initCustomEntry('item');

  const modal = document.getElementById('add-item-modal');
  const backdrop = document.getElementById('modal-backdrop');
  const form = document.getElementById('add-item-form') as HTMLFormElement;
  const closeBtn = document.getElementById('add-item-close-btn');
  const cancelBtn = document.getElementById('add-item-cancel-btn');
  const modalTitle = document.getElementById('item-modal-title');
  const modalSubtitle = document.getElementById('item-modal-subtitle');
  const submitBtn = document.getElementById('item-submit-btn');

  const editIdInp = document.getElementById('item-edit-id') as HTMLInputElement;
  const nameInp = document.getElementById('item-name-input') as HTMLInputElement;
  const catSel = document.getElementById('item-category-select') as HTMLSelectElement;
  const attuneChk = document.getElementById('item-requires-attunement') as HTMLInputElement;
  const qtyInp = document.getElementById('item-quantity-input') as HTMLInputElement;
  const usableSel = document.getElementById('item-usable-select') as HTMLSelectElement;
  const healInp = document.getElementById('item-heal-input') as HTMLInputElement;
  const activationInp = document.getElementById('item-activation-input') as HTMLInputElement;
  const descInp = document.getElementById('item-desc-input') as HTMLInputElement;
  const notesInp = document.getElementById('item-notes-input') as HTMLTextAreaElement;

  function resetForm() {
    editIdInp.value = '';
    nameInp.value = '';
    catSel.value = 'gear';
    attuneChk.checked = false;
    qtyInp.value = '1';
    usableSel.value = 'none';
    healInp.value = '0';
    activationInp.value = '';
    descInp.value = '';
    notesInp.value = '';
    customEntry.reset('new');
    if (modalTitle) modalTitle.textContent = 'Añadir Objeto a la Mochila';
    if (modalSubtitle) modalSubtitle.textContent = 'Pociones, equipo de viaje, armas o artefactos con notas';
    if (submitBtn) submitBtn.textContent = 'Guardar Objeto';
  }

  function loadItemForEdit(item: any) {
    editIdInp.value = item.id;
    nameInp.value = item.name || '';
    catSel.value = item.category || 'gear';
    attuneChk.checked = !!item.requiresAttunement;
    qtyInp.value = (item.quantity || 1).toString();
    usableSel.value = item.usableType || 'none';
    healInp.value = (item.healAmount || 0).toString();
    activationInp.value = item.activationCondition || '';
    descInp.value = item.description || '';
    notesInp.value = item.notes || '';

    if (modalTitle) modalTitle.textContent = 'Editar Objeto de la Mochila';
    if (modalSubtitle) modalSubtitle.textContent = `Ajustando propiedades y notas de "${item.name}"`;
    if (submitBtn) submitBtn.textContent = 'Guardar Cambios';
  }

  window.addEventListener('open-add-item-modal', ((e: CustomEvent) => {
    resetForm();
    if (e.detail?.prefill) {
      loadItemForEdit(e.detail.prefill);
      customEntry.reset('srd');
      editIdInp.value = '';
      if (modalTitle) modalTitle.textContent = 'Añadir Objeto desde Compendio';
      if (modalSubtitle) modalSubtitle.textContent = 'Revisa y ajusta los datos antes de guardarlo en tu mochila';
      if (submitBtn) submitBtn.textContent = 'Añadir Objeto';
    }
    if (modal && backdrop) openModal(modal, backdrop);
  }) as EventListener);

  document.getElementById('item-open-compendium-btn')?.addEventListener('click', () => {
    const q = nameInp.value.trim();
    if (modal && backdrop) closeModal(modal, backdrop);
    window.dispatchEvent(new CustomEvent('open-compendium-modal', {
      detail: { scope: 'inventory', category: 'equipment', query: q, targetModal: 'add-item' }
    }));
  });

  window.addEventListener('open-edit-item-modal', ((e: CustomEvent) => {
    const item = e.detail?.item;
    if (item) {
      loadItemForEdit(item);
      customEntry.reset('edit', item);
      if (modal && backdrop) openModal(modal, backdrop);
    }
  }) as EventListener);

  closeBtn?.addEventListener('click', () => {
    if (modal && backdrop) closeModal(modal, backdrop);
  });
  cancelBtn?.addEventListener('click', () => {
    if (modal && backdrop) closeModal(modal, backdrop);
  });

  form?.addEventListener('submit', (e) => {
    e.preventDefault();
    const name = nameInp.value.trim();
    if (!name) return;

    const editId = editIdInp.value.trim();
    let icon = 'inventory_2';
    const cat = catSel.value as any;
    const usableType = (usableSel?.value || 'none') as any;
    const healAmount = parseInt(healInp?.value || '0') || 0;

    if (usableType === 'drinkable' || cat === 'potion') icon = 'medication';
    else if (usableType === 'edible') icon = 'lunch_dining';
    else if (usableType === 'usable') icon = 'bolt';
    else if (cat === 'weapon') icon = 'swords';
    else if (cat === 'armor') icon = 'shield';
    else if (cat === 'treasure') icon = 'diamond';

    const custom = customEntry.read();
    if (!custom.ok) return; // el error ya se muestra en el formulario

    const payload = {
      ...custom.patch,
      name,
      category: cat,
      requiresAttunement: attuneChk.checked || undefined,
      quantity: parseInt(qtyInp.value || '1') || 1,
      description: descInp.value.trim(),
      icon,
      usableType,
      healAmount,
      activationCondition: activationInp.value.trim() || undefined,
      notes: notesInp.value.trim() || undefined
    };

    if (editId) {
      characterStore.updateInventoryItem(editId, payload);
    } else {
      characterStore.addInventoryItem(payload);
    }

    form.reset();
    if (modal && backdrop) closeModal(modal, backdrop);
    if (custom.imageRejected) {
      showAlert('La imagen se descartó: solo se admiten URLs https:// o data:image/ cortas. El objeto se guardó sin imagen.', { kind: 'warning', title: 'Imagen no válida' });
    }
  });
</script>
