---
// src/components/modals/AddItemModal.astro
// Alta y edición de objetos por pasos: los pasos cambian según la categoría y "Entrada propia" (ver scripts/ui/modalSteps.ts).
import CustomEntryToggle from '../ui/CustomEntryToggle.astro';
import CustomEntryPages from '../ui/CustomEntryPages.astro';
import StepRail from '../ui/StepRail.astro';

const inputCls =
  'w-full p-2.5 rounded-lg bg-[#18202e] border border-[#222f42] text-[#f1f5f9] focus:border-amber-500 focus:outline-none';
const lblCls = 'text-[#94a3b8] block mb-1 text-[12.5px] font-semibold';
---

<div id="add-item-modal" class="hidden fixed inset-0 z-50 flex items-center justify-center p-4">
  <div class="modal-content w-full max-w-xl rounded-2xl bg-[#121721] border border-[#222f42] shadow-[0_20px_60px_rgba(0,0,0,0.9)] overflow-hidden flex flex-col h-[min(680px,92vh)]">
    <!-- Header -->
    <div class="p-4 bg-[#18202e] border-b border-[#222f42] flex items-center justify-between shrink-0">
      <div class="flex items-center gap-3">
        <div class="w-9 h-9 rounded-lg bg-amber-500/20 text-amber-400 flex items-center justify-center border border-amber-500/30">
          <span class="material-symbols-outlined text-[20px]" id="item-modal-icon">backpack</span>
        </div>
        <div>
          <h3 class="font-headline font-semibold text-lg leading-tight text-[#f1f5f9]" id="item-modal-title">Añadir objeto a la mochila</h3>
          <span class="text-[12.5px] text-[#94a3b8]" id="item-modal-subtitle">Los pasos se ajustan a lo que elijas.</span>
        </div>
      </div>
      <button id="add-item-close-btn" type="button" aria-label="Cerrar" class="w-8 h-8 rounded-lg bg-[#10141d] border border-[#222f42] hover:border-rose-500/50 text-[#94a3b8] hover:text-rose-400 flex items-center justify-center transition-colors cursor-pointer">
        <span class="material-symbols-outlined text-[18px]">close</span>
      </button>
    </div>

    <form id="add-item-form" novalidate class="flex flex-col flex-1 min-h-0 font-label">
      <input type="hidden" id="item-edit-id" value="" />
      <StepRail />

      <div data-step-body class="flex-1 overflow-y-auto p-5 text-sm">
        <!-- Paso: lo básico -->
        <section data-page="basic" class="space-y-4">
          <div>
            <h4 class="font-headline font-semibold text-[17px] text-[#f1f5f9]">¿Qué estás guardando?</h4>
            <p class="text-[13px] text-[#94a3b8]">Nombre y tipo. Si es una armadura o un arma, te pediremos sus datos en un paso aparte.</p>
          </div>
          <div>
            <div class="flex items-center justify-between gap-2 mb-1">
              <label class={`${lblCls} !mb-0`} for="item-name-input">Nombre</label>
              <button
                type="button"
                id="item-open-compendium-btn"
                class="text-[12.5px] text-amber-400 hover:text-amber-300 font-bold flex items-center gap-1.5 bg-amber-500/10 hover:bg-amber-500/20 px-2.5 py-1 rounded-lg border border-amber-500/30 transition-all cursor-pointer"
                title="Buscar en la base de datos oficial del SRD (2024 o 2014)"
              >
                <span class="material-symbols-outlined text-[16px]">menu_book</span>
                <span>Buscar en el compendio</span>
              </button>
            </div>
            <input
              type="text"
              id="item-name-input"
              autocomplete="off"
              placeholder="Cota de malla, Poción de curación, Reliquia…"
              class={inputCls}
            />
          </div>

          <div class="grid grid-cols-2 gap-3 max-[420px]:grid-cols-1">
            <div>
              <label class={lblCls} for="item-category-select">Categoría</label>
              <select id="item-category-select" class={inputCls}>
                <option value="gear">Equipo de aventura</option>
                <option value="potion">Poción o consumible</option>
                <option value="treasure">Tesoro o joya</option>
                <option value="weapon">Arma o munición</option>
                <option value="armor">Armadura o escudo</option>
              </select>
            </div>
            <div>
              <label class={lblCls} for="item-quantity-input">Cantidad</label>
              <input type="number" id="item-quantity-input" value="1" min="1" max="999" class={inputCls} />
            </div>
          </div>

          <div class="border-t border-[#222f42] pt-4 space-y-3.5">
            <label class="flex items-start gap-3 cursor-pointer">
              <input type="checkbox" id="item-requires-attunement" class="mt-0.5 w-4 h-4 rounded accent-amber-500" />
              <span class="grid gap-0.5">
                <span class="text-[#f1f5f9] font-bold text-[13.5px]">Requiere sintonización</span>
                <span class="text-xs text-[#94a3b8]">Solo aplica sus efectos si está equipado y sintonizado.</span>
              </span>
            </label>
            <CustomEntryToggle prefix="item" />
          </div>
        </section>

        <!-- Paso: uso -->
        <section data-page="use" class="hidden space-y-4">
          <div>
            <h4 class="font-headline font-semibold text-[17px] text-[#f1f5f9]">Cómo se usa</h4>
            <p class="text-[13px] text-[#94a3b8]">Todo es opcional. Lo que escribas aparece en la ficha del objeto.</p>
          </div>
          <div class="grid grid-cols-2 gap-3 max-[420px]:grid-cols-1">
            <div>
              <label class={lblCls} for="item-usable-select">Tipo de uso</label>
              <select id="item-usable-select" class={inputCls}>
                <option value="none">Normal (equipo o tesoro)</option>
                <option value="drinkable">Bebible (poción, brebaje, elixir)</option>
                <option value="edible">Comestible (raciones, baya mágica)</option>
                <option value="usable">Usable (varita, pergamino, objeto)</option>
              </select>
            </div>
            <div>
              <label class={lblCls} for="item-heal-input">Cura (PG)</label>
              <input type="number" id="item-heal-input" value="0" min="0" placeholder="10" class={inputCls} />
            </div>
          </div>
          <div>
            <label class={lblCls} for="item-activation-input">Cuándo se activa</label>
            <input type="text" id="item-activation-input" placeholder="1 vez por descanso largo, acción adicional, al recibir daño…" class={inputCls} />
          </div>
          <div>
            <label class={lblCls} for="item-desc-input">Descripción breve</label>
            <input type="text" id="item-desc-input" placeholder="Ilumina en un radio de 20 pies; no se apaga con agua." class={inputCls} />
          </div>
          <div>
            <label class={lblCls} for="item-notes-input">Notas y efectos especiales <span class="font-normal">(opcional)</span></label>
            <textarea
              id="item-notes-input"
              rows="3"
              placeholder="Resistencia al frío y visión en la penumbra. Al romperse, libera una nube de humo de 10 pies."
              class={`${inputCls} resize-none`}
            ></textarea>
          </div>
        </section>

        <!-- Pasos de armadura, arma e imagen/efectos (se muestran según la categoría y "Entrada propia") -->
        <CustomEntryPages prefix="item" />

        <p data-step-error role="alert" class="hidden mt-4 text-[13px] text-rose-400"></p>
      </div>

      <!-- Footer -->
      <div class="px-5 py-3 border-t border-[#222f42] bg-[#18202e] flex items-center gap-2.5 shrink-0">
        <span data-step-count class="mr-auto text-[12.5px] text-[#94a3b8]"></span>
        <button type="button" id="add-item-cancel-btn" data-step-cancel class="px-4 py-2 rounded-xl text-[#94a3b8] hover:text-[#f1f5f9] hover:bg-[#121721] font-bold cursor-pointer transition-colors">
          Cancelar
        </button>
        <button type="button" data-step-back class="hidden px-4 py-2 rounded-xl text-[#94a3b8] hover:text-[#f1f5f9] hover:bg-[#121721] font-bold cursor-pointer transition-colors">
          Atrás
        </button>
        <button type="button" id="item-submit-btn" data-step-next class="px-5 py-2 rounded-xl bg-amber-500 hover:bg-amber-400 text-[#1a1204] font-extrabold active:scale-95 transition-all cursor-pointer">
          Siguiente
        </button>
      </div>
    </form>
  </div>
</div>

<script>
  import { characterStore } from '../../scripts/state/characterStore';
  import { closeModal, openModal } from '../../scripts/animations/modalAnimations';
  import { initCustomEntry } from '../../scripts/ui/customEntry';
  import { initSteps } from '../../scripts/ui/modalSteps';
  import { showAlert } from '../../scripts/ui/notify';

  const customEntry = initCustomEntry('item');

  const modal = document.getElementById('add-item-modal');
  const backdrop = document.getElementById('modal-backdrop');
  const form = document.getElementById('add-item-form') as HTMLFormElement;
  const closeBtn = document.getElementById('add-item-close-btn');
  const cancelBtn = document.getElementById('add-item-cancel-btn');
  const modalTitle = document.getElementById('item-modal-title');
  const modalSubtitle = document.getElementById('item-modal-subtitle');

  const editIdInp = document.getElementById('item-edit-id') as HTMLInputElement;
  const nameInp = document.getElementById('item-name-input') as HTMLInputElement;
  const catSel = document.getElementById('item-category-select') as HTMLSelectElement;
  const attuneChk = document.getElementById('item-requires-attunement') as HTMLInputElement;
  const qtyInp = document.getElementById('item-quantity-input') as HTMLInputElement;
  const usableSel = document.getElementById('item-usable-select') as HTMLSelectElement;
  const healInp = document.getElementById('item-heal-input') as HTMLInputElement;
  const activationInp = document.getElementById('item-activation-input') as HTMLInputElement;
  const descInp = document.getElementById('item-desc-input') as HTMLInputElement;
  const notesInp = document.getElementById('item-notes-input') as HTMLTextAreaElement;
  const customToggle = document.getElementById('item-custom-toggle') as HTMLInputElement | null;

  let finalLabel = 'Guardar objeto';

  // Los pasos que existen dependen de la categoría y de "Entrada propia".
  const steps = initSteps({
    form,
    labels: { basic: 'Lo básico', use: 'Uso', armor: 'Armadura', weapon: 'Arma', custom: 'Imagen y efectos' },
    pages: () =>
      ['basic', 'use', catSel.value === 'armor' ? 'armor' : catSel.value === 'weapon' ? 'weapon' : null,
        customEntry.isCustom() ? 'custom' : null].filter((id): id is string => !!id),
    finalLabel: () => finalLabel,
    validate: (id) =>
      id === 'basic' && !nameInp.value.trim()
        ? { message: 'Escribe un nombre para continuar.', focus: nameInp }
        : null,
  });

  function resetForm() {
    editIdInp.value = '';
    nameInp.value = '';
    catSel.value = 'gear';
    attuneChk.checked = false;
    qtyInp.value = '1';
    usableSel.value = 'none';
    healInp.value = '0';
    activationInp.value = '';
    descInp.value = '';
    notesInp.value = '';
    customEntry.reset('new');
    customEntry.setCategory(catSel.value);
    if (modalTitle) modalTitle.textContent = 'Añadir objeto a la mochila';
    if (modalSubtitle) modalSubtitle.textContent = 'Los pasos se ajustan a lo que elijas.';
    finalLabel = 'Guardar objeto';
  }

  function loadItemForEdit(item: any) {
    editIdInp.value = item.id;
    nameInp.value = item.name || '';
    catSel.value = item.category || 'gear';
    attuneChk.checked = !!item.requiresAttunement;
    qtyInp.value = (item.quantity || 1).toString();
    usableSel.value = item.usableType || 'none';
    healInp.value = (item.healAmount || 0).toString();
    activationInp.value = item.activationCondition || '';
    descInp.value = item.description || '';
    notesInp.value = item.notes || '';

    if (modalTitle) modalTitle.textContent = 'Editar objeto de la mochila';
    if (modalSubtitle) modalSubtitle.textContent = `Ajustando propiedades y notas de "${item.name}"`;
    finalLabel = 'Guardar cambios';
  }

  window.addEventListener('open-add-item-modal', ((e: CustomEvent) => {
    resetForm();
    if (e.detail?.prefill) {
      loadItemForEdit(e.detail.prefill);
      // Se pasa el objeto del compendio para conservar sus datos de armadura/arma (Spec 08, Fase B).
      customEntry.reset('srd', e.detail.prefill);
      customEntry.setCategory(catSel.value);
      editIdInp.value = '';
      if (modalTitle) modalTitle.textContent = 'Añadir objeto desde el compendio';
      if (modalSubtitle) modalSubtitle.textContent = 'Revisa y ajusta los datos antes de guardarlo en tu mochila';
      finalLabel = 'Añadir objeto';
    }
    steps.reset();
    if (modal && backdrop) openModal(modal, backdrop);
  }) as EventListener);

  document.getElementById('item-open-compendium-btn')?.addEventListener('click', () => {
    const q = nameInp.value.trim();
    if (modal && backdrop) closeModal(modal, backdrop);
    window.dispatchEvent(new CustomEvent('open-compendium-modal', {
      detail: { scope: 'inventory', category: 'equipment', query: q, targetModal: 'add-item' }
    }));
  });

  window.addEventListener('open-edit-item-modal', ((e: CustomEvent) => {
    const item = e.detail?.item;
    if (item) {
      loadItemForEdit(item);
      customEntry.reset('edit', item);
      customEntry.setCategory(catSel.value);
      steps.reset();
      if (modal && backdrop) openModal(modal, backdrop);
    }
  }) as EventListener);

  // Cambiar la categoría o activar "Entrada propia" suma o quita pasos.
  catSel.addEventListener('change', () => {
    customEntry.setCategory(catSel.value);
    steps.refresh();
  });
  customToggle?.addEventListener('change', () => steps.refresh());

  closeBtn?.addEventListener('click', () => {
    if (modal && backdrop) closeModal(modal, backdrop);
  });
  cancelBtn?.addEventListener('click', () => {
    if (modal && backdrop) closeModal(modal, backdrop);
  });

  form?.addEventListener('submit', (e) => {
    e.preventDefault();
    const name = nameInp.value.trim();
    if (!name) {
      steps.goTo('basic');
      steps.problem({ message: 'Escribe un nombre para continuar.', focus: nameInp });
      return;
    }

    const editId = editIdInp.value.trim();
    let icon = 'inventory_2';
    const cat = catSel.value as any;
    const usableType = (usableSel?.value || 'none') as any;
    const healAmount = parseInt(healInp?.value || '0') || 0;

    if (usableType === 'drinkable' || cat === 'potion') icon = 'medication';
    else if (usableType === 'edible') icon = 'lunch_dining';
    else if (usableType === 'usable') icon = 'bolt';
    else if (cat === 'weapon') icon = 'swords';
    else if (cat === 'armor') icon = 'shield';
    else if (cat === 'treasure') icon = 'diamond';

    const custom = customEntry.read();
    if (!custom.ok) {
      // El error ya se muestra en su paso; se lleva al usuario hasta allí.
      if (custom.page) steps.goTo(custom.page);
      return;
    }

    const payload = {
      ...custom.patch,
      name,
      category: cat,
      requiresAttunement: attuneChk.checked || undefined,
      quantity: parseInt(qtyInp.value || '1') || 1,
      description: descInp.value.trim(),
      icon,
      usableType,
      healAmount,
      activationCondition: activationInp.value.trim() || undefined,
      notes: notesInp.value.trim() || undefined
    };

    if (editId) {
      characterStore.updateInventoryItem(editId, payload);
    } else {
      characterStore.addInventoryItem(payload);
    }

    form.reset();
    if (modal && backdrop) closeModal(modal, backdrop);
    if (custom.imageRejected) {
      showAlert('La imagen se descartó: solo se admiten URLs https:// o data:image/ cortas. El objeto se guardó sin imagen.', { kind: 'warning', title: 'Imagen no válida' });
    }
  });
</script>
