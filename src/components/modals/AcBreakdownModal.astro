---
// src/components/modals/AcBreakdownModal.astro
// Spec 08, Fase D: desglose de la CA calculada (fórmula elegida, partes, fórmulas descartadas, avisos de
// compatibilidad y desventajas declaradas) y control del override manual. Todo texto va con textContent.
---

<div id="ac-breakdown-modal" class="hidden fixed inset-0 z-50 flex items-center justify-center p-4">
  <div class="modal-content w-full max-w-md rounded-2xl bg-[#121721] border border-[#222f42] shadow-[0_20px_60px_rgba(0,0,0,0.9)] overflow-hidden flex flex-col">
    <div class="p-4 bg-[#18202e] border-b border-[#222f42] flex items-center justify-between">
      <div class="flex items-center gap-2">
        <div class="w-8 h-8 rounded-lg bg-amber-500/20 text-amber-400 flex items-center justify-center border border-amber-500/30">
          <span class="material-symbols-outlined text-[18px]">shield</span>
        </div>
        <div>
          <h3 class="font-headline font-bold text-base text-[#f1f5f9]">Clase de Armadura <span id="ac-bd-total" class="text-amber-400"></span></h3>
          <span id="ac-bd-formula" class="text-[10px] text-[#94a3b8]"></span>
        </div>
      </div>
      <button id="ac-bd-close-btn" class="w-7 h-7 rounded-lg bg-[#10141d] border border-[#222f42] hover:border-rose-500/50 text-[#94a3b8] hover:text-rose-400 flex items-center justify-center text-xs transition-colors cursor-pointer">
        <span class="material-symbols-outlined text-[16px]">close</span>
      </button>
    </div>

    <div class="p-5 space-y-4 text-xs font-label overflow-y-auto max-h-[70vh]">
      <section>
        <h4 class="text-[10px] uppercase tracking-wider text-[#94a3b8] mb-2">Desglose</h4>
        <ul id="ac-bd-parts" class="space-y-1"></ul>
      </section>
      <section id="ac-bd-alt-section" class="hidden">
        <h4 class="text-[10px] uppercase tracking-wider text-[#94a3b8] mb-2">Fórmulas descartadas</h4>
        <ul id="ac-bd-alts" class="space-y-1 text-[#94a3b8]"></ul>
      </section>
      <section id="ac-bd-manual-section" class="hidden p-3 rounded-lg bg-amber-500/10 border border-amber-500/30">
        <p class="text-amber-300 mb-2">CA manual: el valor escrito a mano manda sobre el cálculo.</p>
        <button type="button" id="ac-bd-reset-btn" class="px-3 py-2 rounded-lg bg-[#10141d] border border-[#222f42] text-[#f1f5f9] hover:border-amber-500/50 cursor-pointer">
          Volver al cálculo
        </button>
      </section>
      <section id="ac-bd-warn-section" class="hidden">
        <h4 class="text-[10px] uppercase tracking-wider text-[#94a3b8] mb-2">Avisos de equipo</h4>
        <ul id="ac-bd-warnings" class="space-y-1 text-amber-300"></ul>
        <ul id="ac-bd-penalties" class="space-y-1 text-rose-300 mt-2"></ul>
      </section>
    </div>

    <div class="p-4 bg-[#18202e] border-t border-[#222f42] flex justify-end">
      <button type="button" id="ac-bd-cancel-btn" class="px-4 py-2 rounded-xl bg-[#121721] border border-[#222f42] text-[#94a3b8] hover:text-[#f1f5f9] cursor-pointer">
        Cerrar
      </button>
    </div>
  </div>
</div>

<script>
  import { characterStore } from '../../scripts/state/characterStore';
  import { closeModal, openModal } from '../../scripts/animations/modalAnimations';
  import { computeAc } from '../../scripts/dnd/ac';
  import { checkCompatibility } from '../../scripts/dnd/compat';
  import type { Modifier } from '../../scripts/models/effect';

  const modal = document.getElementById('ac-breakdown-modal');
  const backdrop = document.getElementById('modal-backdrop');
  const $ = (id: string) => document.getElementById(id);

  const signed = (n: number) => (n >= 0 ? `+${n}` : String(n));

  function li(text: string, value?: string) {
    const el = document.createElement('li');
    el.className = 'flex items-center justify-between gap-3';
    const left = document.createElement('span');
    left.textContent = text;
    el.append(left);
    if (value !== undefined) {
      const right = document.createElement('strong');
      right.className = 'font-headline text-[#f1f5f9]';
      right.textContent = value;
      el.append(right);
    }
    return el;
  }

  const TARGET_LABELS: Record<string, string> = {
    attack: 'ataques', 'save.str': 'salvaciones de FUE', 'save.dex': 'salvaciones de DES',
    'check.str': 'pruebas de FUE', 'check.dex': 'pruebas de DES', 'skill.stealth': 'Sigilo',
  };

  function describePenalty(m: Modifier): string | null {
    if (m.op === 'disadvantage') return `Desventaja en ${TARGET_LABELS[m.target] ?? m.target}`;
    if (m.target === 'spellcasting' && m.op === 'set' && m.value === 'blocked') return 'No puedes lanzar conjuros';
    if (m.target === 'speed' && m.op === 'add') return `Velocidad ${signed(Number(m.value))} pies`;
    return null;
  }

  function render() {
    const char = characterStore.get();
    const ac = computeAc(char);
    const set = (id: string, text: string) => { const el = $(id); if (el) el.textContent = text; };
    set('ac-bd-total', String(ac.total));
    set('ac-bd-formula', ac.manual ? 'CA manual' : `Fórmula: ${ac.formula}`);

    $('ac-bd-parts')?.replaceChildren(
      ...ac.parts.map((p) => li(p.label, ac.manual ? String(p.value) : signed(p.value))),
    );

    const alts = $('ac-bd-alts');
    alts?.replaceChildren(...ac.alternatives.map((a) => li(a.formula, String(a.total))));
    $('ac-bd-alt-section')?.classList.toggle('hidden', ac.alternatives.length === 0);
    $('ac-bd-manual-section')?.classList.toggle('hidden', !ac.manual);

    const compat = checkCompatibility(char);
    const penalties = compat.modifiers.map(describePenalty).filter((t): t is string => !!t);
    $('ac-bd-warnings')?.replaceChildren(...compat.warnings.map((w) => li(w.text)));
    $('ac-bd-penalties')?.replaceChildren(...penalties.map((t) => li(t)));
    $('ac-bd-warn-section')?.classList.toggle('hidden', compat.warnings.length === 0 && penalties.length === 0);
  }

  window.addEventListener('open-ac-breakdown-modal', () => {
    render();
    if (modal && backdrop) openModal(modal, backdrop);
  });
  window.addEventListener('character-updated', () => {
    if (modal && !modal.classList.contains('hidden')) render();
  });

  $('ac-bd-reset-btn')?.addEventListener('click', () => characterStore.setManualAc(undefined));

  const close = () => { if (modal && backdrop) closeModal(modal, backdrop); };
  $('ac-bd-close-btn')?.addEventListener('click', close);
  $('ac-bd-cancel-btn')?.addEventListener('click', close);
</script>
