---
// src/components/modals/DiceRollerModal.astro
// Modal de tirada de dados con ruleta animada, soporte de objetivos de combate y entrada de dados físicos en mesa.
---

<div id="dice-roller-modal" class="hidden fixed inset-0 z-50 flex items-center justify-center p-4">
  <div class="modal-content w-full max-w-md rounded-2xl bg-[#121721] border border-[#222f42] shadow-[0_15px_50px_rgba(0,0,0,0.9)] overflow-hidden flex flex-col">
    <!-- Modal Header -->
    <div class="p-4 bg-[#18202e] border-b border-[#222f42] flex items-center justify-between">
      <div class="flex items-center gap-2">
        <div class="w-8 h-8 rounded-lg bg-amber-500/20 text-amber-400 flex items-center justify-center border border-amber-500/30">
          <span class="material-symbols-outlined text-[20px]">casino</span>
        </div>
        <div>
          <h3 class="font-headline font-bold text-base text-[#f1f5f9]">Torre de Dados</h3>
          <span class="text-[10px] text-[#94a3b8]">Tiradas virtuales o dados físicos en mesa</span>
        </div>
      </div>
      <button id="dice-modal-close-btn" class="w-7 h-7 rounded-lg bg-[#10141d] border border-[#222f42] hover:border-rose-500/50 text-[#94a3b8] hover:text-rose-400 flex items-center justify-center text-xs transition-colors cursor-pointer">
        <span class="material-symbols-outlined text-[16px]">close</span>
      </button>
    </div>

    <!-- Modal Body (Compact & Ordered: Mode+Secret -> Display+Roll -> Dice+Count/Mod -> Target) -->
    <div class="p-4 space-y-3 max-h-[85vh] overflow-y-auto">
      <!-- Banner de Bloqueo de Dado (Iniciativa u Obligatorio) -->
      <div
        id="dice-locked-banner"
        class="hidden p-2 rounded-xl bg-amber-500/15 border border-amber-500/40 text-amber-300 text-xs font-bold flex items-center justify-between gap-2 shadow-xs"
      >
        <div class="flex items-center gap-2">
          <span class="material-symbols-outlined text-[16px] text-amber-400">lock</span>
          <span id="dice-locked-banner-text">Tirada de Iniciativa: Dado fijado en d20</span>
        </div>
        <span class="px-2 py-0.5 rounded bg-amber-500/30 text-amber-200 text-[10px] font-mono">1d20</span>
      </div>

      <!-- Banner de Tirada de Salvación del Enemigo (Conjuros / Efectos CD) -->
      <div
        id="dice-save-banner"
        class="hidden p-3 rounded-xl bg-sky-500/10 border border-sky-500/40 text-sky-200 text-xs space-y-2 shadow-xs"
      >
        <div class="flex items-center justify-between gap-2">
          <div class="flex items-center gap-1.5 font-bold text-sky-300">
            <span class="material-symbols-outlined text-[17px] text-sky-400">shield</span>
            <span id="dice-save-banner-title">El enemigo debe superar Salvación</span>
          </div>
          <span id="dice-save-dc-pill" class="px-2 py-0.5 rounded-lg bg-sky-500/25 border border-sky-400/50 text-sky-200 font-headline font-bold text-xs shrink-0">
            CD 13 DES
          </span>
        </div>
        <p id="dice-save-banner-sub" class="text-[11px] text-[#cbd5e1] leading-snug">
          Solicita al DM o tira la salvación del objetivo. Si falla, recibe el daño completo; si supera, aplica mitad de daño o el efecto indicado por el conjuro.
        </p>
        <div class="flex items-center gap-2 pt-0.5">
          <button
            type="button"
            id="dice-roll-enemy-save-btn"
            class="flex-1 py-1.5 px-2.5 rounded-lg bg-[#10141d] hover:bg-sky-500/20 border border-sky-500/40 text-sky-300 font-bold text-[11px] flex items-center justify-center gap-1 transition-all cursor-pointer"
          >
            <span class="material-symbols-outlined text-[14px]">casino</span>
            <span>Tirar Salvación del Enemigo (d20)</span>
          </button>
          <button
            type="button"
            id="dice-roll-save-dmg-btn"
            class="hidden flex-1 py-1.5 px-2.5 rounded-lg bg-amber-500/20 hover:bg-amber-500 hover:text-[#0a0d12] border border-amber-500/40 text-amber-300 font-bold text-[11px] flex items-center justify-center gap-1 transition-all cursor-pointer"
          >
            <span class="material-symbols-outlined text-[14px]">local_fire_department</span>
            <span id="dice-roll-save-dmg-label">Tirar Daño</span>
          </button>
        </div>
      </div>

      <!-- 1. Barra Superior Compacta: Modo (Virtual / Físico) + Toggle Tirada Secreta -->
      <div class="flex items-center justify-between gap-2">
        <div class="grid grid-cols-2 gap-1 p-1 bg-[#10141d] rounded-xl border border-[#222f42] text-[11px] font-bold font-label flex-1">
          <button
            type="button"
            id="dice-mode-virtual-btn"
            class="py-1.5 px-2 rounded-lg bg-amber-500/20 text-amber-300 border border-amber-500/40 text-center transition-all cursor-pointer flex items-center justify-center gap-1 shadow-xs"
          >
            <span class="material-symbols-outlined text-[15px]">casino</span>
            <span>Ruleta App</span>
          </button>
          <button
            type="button"
            id="dice-mode-physical-btn"
            class="py-1.5 px-2 rounded-lg text-[#94a3b8] hover:text-[#f1f5f9] text-center transition-all cursor-pointer flex items-center justify-center gap-1"
          >
            <span class="material-symbols-outlined text-[15px]">front_hand</span>
            <span>Dado Físico</span>
          </button>
        </div>

        <!-- Compact Secret Roll Pill -->
        <div
          id="dice-secret-toggle-card"
          class="px-2.5 py-1.5 rounded-xl bg-[#18202e] border border-[#222f42] hover:border-purple-500/40 transition-all flex items-center gap-2 select-none cursor-pointer shrink-0"
          title="Visible solo para ti y el DM (Nota privada en bitácora)"
        >
          <label for="dice-secret-checkbox" class="flex items-center gap-1.5 cursor-pointer">
            <div
              id="dice-secret-icon-wrap"
              class="w-6 h-6 rounded-md bg-[#10141d] border border-[#222f42] text-[#94a3b8] flex items-center justify-center shrink-0 transition-colors"
            >
              <span class="material-symbols-outlined text-[14px]" id="dice-secret-icon">visibility</span>
            </div>
            <span class="text-[11px] font-headline font-bold text-[#f1f5f9]">Secreta</span>
            <span
              id="dice-secret-badge"
              class="hidden px-1 py-0.2 rounded text-[8px] font-bold uppercase bg-purple-500/20 text-purple-300 border border-purple-500/40"
            >
              🔒
            </span>
            <span class="sr-only" id="dice-secret-desc">Visible solo para ti (y el DM)</span>
          </label>
          <input
            type="checkbox"
            id="dice-secret-checkbox"
            class="w-3.5 h-3.5 rounded bg-[#10141d] border-[#222f42] text-purple-500 focus:ring-purple-500/40 cursor-pointer accent-purple-500"
          />
        </div>
      </div>

      <!-- 2A. ÁREA VIRTUAL: Ruleta de Dados Animada (Protagonista arriba) -->
      <div id="dice-virtual-display-area" class="p-3 rounded-2xl bg-[#0a0d12] border-2 border-[#222f42] flex flex-col items-center justify-between shadow-inner min-h-[148px] relative overflow-hidden select-none">
        <div class="absolute inset-0 bg-gradient-to-b from-amber-500/5 via-transparent to-amber-500/5 pointer-events-none"></div>

        <!-- Reels Container (Anime.js target) -->
        <div id="jackpot-reels-container" class="min-h-[76px] py-1 flex items-center justify-center gap-2 z-10 flex-wrap">
          <div class="w-16 h-18 sm:w-18 sm:h-20 rounded-2xl bg-[#10141d] border-2 border-amber-500/40 flex items-center justify-center text-2xl sm:text-3xl font-headline font-bold text-amber-300 shadow-[inset_0_2px_12px_rgba(0,0,0,0.8)] shrink-0">
            d20
          </div>
        </div>

        <!-- Result Breakdown Summary -->
        <div id="jackpot-summary-text" class="min-h-[36px] w-full flex flex-col items-center justify-center text-xs font-label text-[#94a3b8] z-10 font-medium text-center leading-tight">
          Pulsa "¡Lanzar Dados!" para girar el tambor
        </div>
      </div>

      <!-- 2B. ÁREA FÍSICA: Input Grande y Elegante -->
      <div
        id="dice-physical-container"
        class="hidden p-3.5 rounded-2xl bg-[#0a0d12] border-2 border-amber-500/50 shadow-inner flex flex-col items-center justify-between space-y-2.5 select-none min-h-[148px]"
      >
        <div class="text-center">
          <div class="flex items-center justify-center gap-1.5 text-xs font-bold text-amber-300">
            <span class="material-symbols-outlined text-[16px]">front_hand</span>
            <span id="dice-physical-header-text">Dado Físico en Mesa (d20)</span>
          </div>
        </div>

        <!-- Ecuación Táctica Clara -->
        <div class="flex items-center justify-center gap-2.5 w-full">
          <!-- Input Principal del Dado Físico -->
          <div class="flex flex-col items-center">
            <span class="text-[9px] uppercase font-bold text-[#94a3b8] font-mono mb-0.5">Dado</span>
            <input
              type="number"
              id="dice-physical-input"
              placeholder="15"
              min="1"
              max="100"
              class="w-20 h-12 text-center text-xl font-headline font-bold rounded-xl bg-[#121721] border-2 border-amber-500/60 text-amber-300 focus:outline-hidden focus:border-amber-400 focus:ring-2 focus:ring-amber-500/30 shadow-[0_0_15px_rgba(245,158,11,0.2)] [appearance:textfield] [&::-webkit-outer-spin-button]:appearance-none [&::-webkit-inner-spin-button]:appearance-none"
            />
          </div>

          <div class="text-lg font-bold text-[#64748b] pt-3">+</div>

          <!-- Modificador -->
          <div class="flex flex-col items-center">
            <span class="text-[9px] uppercase font-bold text-[#94a3b8] font-mono mb-0.5">Mod</span>
            <div class="w-14 h-12 rounded-xl bg-[#121721] border border-[#222f42] flex items-center justify-center font-headline font-bold text-amber-400 text-base">
              <span id="dice-physical-mod-text">+3</span>
            </div>
          </div>

          <div class="text-lg font-bold text-[#64748b] pt-3">=</div>

          <!-- Total Calculado -->
          <div class="flex flex-col items-center">
            <span class="text-[9px] uppercase font-bold text-amber-300 font-mono mb-0.5">Total</span>
            <div class="w-16 h-12 rounded-xl bg-amber-500/20 border-2 border-amber-500/60 shadow-[0_0_15px_rgba(245,158,11,0.25)] flex items-center justify-center font-headline font-bold text-[#f1f5f9] text-lg">
              <span id="dice-physical-total-text">--</span>
            </div>
          </div>
        </div>

        <!-- Botones rápidos de números frecuentes para d20 -->
        <div id="dice-physical-presets" class="flex items-center gap-1.5 justify-center flex-wrap">
          <button type="button" class="phys-preset-btn px-2 py-0.5 rounded-lg bg-[#18202e] border border-[#222f42] hover:border-amber-500/50 text-[10px] font-bold text-[#cbd5e1] hover:text-amber-300 transition-colors cursor-pointer" data-val="1">1 (Pifia)</button>
          <button type="button" class="phys-preset-btn px-2 py-0.5 rounded-lg bg-[#18202e] border border-[#222f42] hover:border-amber-500/50 text-[10px] font-bold text-[#cbd5e1] hover:text-amber-300 transition-colors cursor-pointer" data-val="10">10</button>
          <button type="button" class="phys-preset-btn px-2 py-0.5 rounded-lg bg-[#18202e] border border-[#222f42] hover:border-amber-500/50 text-[10px] font-bold text-[#cbd5e1] hover:text-amber-300 transition-colors cursor-pointer" data-val="15">15</button>
          <button type="button" class="phys-preset-btn px-2 py-0.5 rounded-lg bg-[#18202e] border border-amber-500/40 hover:border-amber-400 text-[10px] font-bold text-amber-300 hover:text-amber-200 transition-colors cursor-pointer" data-val="20">20 (Crítico!)</button>
        </div>

        <!-- Dynamic Live Feedback Badge -->
        <div id="dice-physical-feedback" class="min-h-[18px] flex items-center justify-center text-xs font-bold text-center w-full"></div>
      </div>

      <!-- 3. Botón de Lanzar / Registrar inmediatamente debajo del visor -->
      <div class="flex gap-2">
        <button
          type="button"
          id="jackpot-roll-trigger-btn"
          class="flex-1 py-2.5 rounded-xl bg-gradient-to-r from-amber-600 via-amber-500 to-amber-400 text-[#0a0d12] text-sm font-bold shadow-[0_0_20px_rgba(245,158,11,0.4)] hover:brightness-110 active:scale-98 transition-all flex items-center justify-center gap-2 cursor-pointer font-headline"
        >
          <span class="material-symbols-outlined text-[19px]" id="roll-btn-icon">casino</span>
          <span id="roll-btn-label">¡Lanzar Dados!</span>
        </button>

        <button
          type="button"
          id="jackpot-log-btn"
          class="hidden px-3.5 py-2.5 rounded-xl bg-[#18202e] border border-amber-500/30 hover:border-amber-500 text-amber-400 text-xs font-bold active:scale-95 transition-all flex items-center gap-1 cursor-pointer"
          title="Guardar tirada en la Bitácora de la campaña"
        >
          <span class="material-symbols-outlined text-[16px]">bookmark_add</span>
          <span>Anotar</span>
        </button>
      </div>

      <!-- 3B. Contenedor de Encadenamiento de Daño tras Tirada de Ataque (d20 -> Daño) -->
      <div
        id="dice-followup-container"
        class="hidden p-2.5 rounded-xl bg-emerald-500/10 border border-emerald-500/40 flex flex-col gap-2"
      ></div>

      <!-- 4. Selector de Dado (6 dados principales en fila + d100) y Cantidad / Modificador -->
      <div class="p-3 rounded-xl bg-[#18202e]/60 border border-[#222f42] space-y-2.5">
        <div class="grid grid-cols-7 gap-1" id="dice-type-selector">
          <button type="button" class="die-select-btn py-1.5 rounded-lg bg-[#18202e] border border-[#222f42] hover:border-amber-500/50 flex items-center justify-center text-xs font-bold transition-all cursor-pointer" data-die="4">d4</button>
          <button type="button" class="die-select-btn py-1.5 rounded-lg bg-[#18202e] border border-[#222f42] hover:border-amber-500/50 flex items-center justify-center text-xs font-bold transition-all cursor-pointer" data-die="6">d6</button>
          <button type="button" class="die-select-btn py-1.5 rounded-lg bg-[#18202e] border border-[#222f42] hover:border-amber-500/50 flex items-center justify-center text-xs font-bold transition-all cursor-pointer" data-die="8">d8</button>
          <button type="button" class="die-select-btn py-1.5 rounded-lg bg-[#18202e] border border-[#222f42] hover:border-amber-500/50 flex items-center justify-center text-xs font-bold transition-all cursor-pointer" data-die="10">d10</button>
          <button type="button" class="die-select-btn py-1.5 rounded-lg bg-[#18202e] border border-[#222f42] hover:border-amber-500/50 flex items-center justify-center text-xs font-bold transition-all cursor-pointer" data-die="12">d12</button>
          <button type="button" class="die-select-btn active py-1.5 rounded-lg bg-amber-500/20 border-2 border-amber-500 text-amber-300 flex items-center justify-center text-xs font-bold transition-all cursor-pointer shadow-[0_0_10px_rgba(245,158,11,0.3)]" data-die="20">d20</button>
          <button type="button" class="die-select-btn py-1.5 rounded-lg bg-[#18202e] border border-[#222f42] hover:border-amber-500/50 flex items-center justify-center text-[11px] font-bold transition-all cursor-pointer" data-die="100" title="Dado porcentual (d100)">d100</button>
        </div>

        <div class="grid grid-cols-2 gap-2.5">
          <!-- Quantity -->
          <div id="dice-count-box" class="px-2.5 py-1.5 rounded-lg bg-[#121721] border border-[#222f42] flex items-center justify-between gap-2">
            <span class="text-[10px] uppercase font-bold text-[#94a3b8] tracking-wider">Cantidad</span>
            <div class="flex items-center gap-2">
              <button type="button" id="dice-count-dec" class="w-6 h-6 rounded bg-[#18202e] border border-[#222f42] text-amber-400 font-bold hover:bg-[#222f42] active:scale-90 transition-all cursor-pointer flex items-center justify-center">-</button>
              <span id="dice-count-display" class="text-sm font-headline font-bold text-[#f1f5f9] min-w-[16px] text-center">1</span>
              <button type="button" id="dice-count-inc" class="w-6 h-6 rounded bg-[#18202e] border border-[#222f42] text-amber-400 font-bold hover:bg-[#222f42] active:scale-90 transition-all cursor-pointer flex items-center justify-center">+</button>
            </div>
          </div>

          <!-- Modifier -->
          <div class="px-2.5 py-1.5 rounded-lg bg-[#121721] border border-[#222f42] flex items-center justify-between gap-2">
            <span class="text-[10px] uppercase font-bold text-[#94a3b8] tracking-wider">Mod (+/-)</span>
            <input
              type="number"
              id="dice-modifier-input"
              value="3"
              class="w-16 text-center text-sm font-headline font-bold py-0.5 px-1 rounded bg-[#18202e] border border-[#222f42] text-amber-400 focus:outline-hidden focus:border-amber-500"
            />
          </div>
        </div>
      </div>

      <!-- 5. Selector de Objetivo en Combate (solo si hay combate activo) -->
      <div id="dice-target-container" class="hidden p-2.5 rounded-xl bg-[#18202e] border border-[#222f42] space-y-1.5">
        <div class="flex items-center justify-between">
          <span class="text-[10px] uppercase font-bold text-[#94a3b8] tracking-wider flex items-center gap-1">
            <span class="material-symbols-outlined text-[14px] text-rose-400">my_location</span>
            <span>Objetivo del Ataque / Conjuro</span>
          </span>
          <span id="dice-target-ac-badge" class="hidden px-1.5 py-0.2 rounded bg-[#10141d] border border-[#222f42] text-[10px] font-mono text-amber-300">
            CA --
          </span>
        </div>
        <select
          id="dice-target-select"
          class="w-full px-2.5 py-1.5 rounded-lg bg-[#10141d] border border-[#222f42] text-xs text-[#f1f5f9] focus:outline-hidden focus:border-amber-500 cursor-pointer"
        >
          <option value="">Sin objetivo específico (Tirada general)</option>
        </select>
      </div>
    </div>
  </div>
</div>

<script>
  import { animateJackpotRoll, type RollResult } from '../../scripts/animations/diceJackpotAnimation';
  import { openModal, closeModal } from '../../scripts/animations/modalAnimations';
  import { journalStore } from '../../scripts/state/journalStore';
  import { campaignStore } from '../../scripts/state/campaignStore';
  import { characterStore } from '../../scripts/state/characterStore';
  import { getCurrentCombat } from '../../scripts/data/combatService';

  const modal = document.getElementById('dice-roller-modal');
  const backdrop = document.getElementById('modal-backdrop');
  const closeBtn = document.getElementById('dice-modal-close-btn');
  const rollBtn = document.getElementById('jackpot-roll-trigger-btn');
  const rollBtnLabel = document.getElementById('roll-btn-label');
  const rollBtnIcon = document.getElementById('roll-btn-icon');
  const logBtn = document.getElementById('jackpot-log-btn');
  const reelsContainer = document.getElementById('jackpot-reels-container');
  const summaryText = document.getElementById('jackpot-summary-text');
  const countDisplay = document.getElementById('dice-count-display');
  const countBox = document.getElementById('dice-count-box');
  const modInput = document.getElementById('dice-modifier-input') as HTMLInputElement;
  const secretCheckbox = document.getElementById('dice-secret-checkbox') as HTMLInputElement;
  const secretIcon = document.getElementById('dice-secret-icon');
  const secretBadge = document.getElementById('dice-secret-badge');
  const secretIconWrap = document.getElementById('dice-secret-icon-wrap');
  const secretCard = document.getElementById('dice-secret-toggle-card');

  // Modo físico y objetivos
  const modeVirtualBtn = document.getElementById('dice-mode-virtual-btn');
  const modePhysicalBtn = document.getElementById('dice-mode-physical-btn');
  const virtualDisplayArea = document.getElementById('dice-virtual-display-area');
  const physicalContainer = document.getElementById('dice-physical-container');
  const physicalHeader = document.getElementById('dice-physical-header-text');
  const physicalInput = document.getElementById('dice-physical-input') as HTMLInputElement;
  const physicalModText = document.getElementById('dice-physical-mod-text');
  const physicalTotalText = document.getElementById('dice-physical-total-text');
  const physicalFeedback = document.getElementById('dice-physical-feedback');
  const physicalPresets = document.getElementById('dice-physical-presets');

  const targetContainer = document.getElementById('dice-target-container');
  const targetSelect = document.getElementById('dice-target-select') as HTMLSelectElement;
  const targetAcBadge = document.getElementById('dice-target-ac-badge');
  const followUpContainer = document.getElementById('dice-followup-container');
  const saveBanner = document.getElementById('dice-save-banner');
  const saveBannerTitle = document.getElementById('dice-save-banner-title');
  const saveDcPill = document.getElementById('dice-save-dc-pill');
  const rollEnemySaveBtn = document.getElementById('dice-roll-enemy-save-btn');
  const rollSaveDmgBtn = document.getElementById('dice-roll-save-dmg-btn');
  const rollSaveDmgLabel = document.getElementById('dice-roll-save-dmg-label');

  interface FollowUpDamageSpec {
    count: number;
    die: number;
    modifier: number;
    damageType: string;
    weaponOrSpellName: string;
  }

  interface SaveInfoSpec {
    dc: number;
    ability: string;
    spellName: string;
    damageCount?: number;
    damageDie?: number;
    damageMod?: number;
    damageType?: string;
    isRollingEnemySave?: boolean;
  }

  let isPhysicalMode = false;
  let selectedDie = 20;
  let selectedCount = 1;
  let lastResult: RollResult | null = null;
  let rollContext: {
    label: string;
    tag: string;
    isDmRoll?: boolean;
    isSecret?: boolean;
    targetName?: string;
    targetAc?: number;
    authorName?: string;
    lockDie?: boolean;
    lockCount?: boolean;
    isInitiative?: boolean;
    characterId?: string;
    campaignId?: string;
    followUpDamage?: FollowUpDamageSpec;
    saveInfo?: SaveInfoSpec;
  } = { label: 'Tirada de dados', tag: '#Tirada', isDmRoll: false, isSecret: false };

  function applyLockState(lockDie: boolean, lockCount: boolean) {
    const banner = document.getElementById('dice-locked-banner');
    const dieButtons = document.querySelectorAll<HTMLButtonElement>('.die-select-btn');
    const decBtn = document.getElementById('dice-count-dec') as HTMLButtonElement | null;
    const incBtn = document.getElementById('dice-count-inc') as HTMLButtonElement | null;

    if (lockDie) {
      selectedDie = 20;
      updateActiveDieButtons();
      renderReelPlaceholders();
      updatePhysicalCalculations();

      dieButtons.forEach((btn) => {
        const val = btn.getAttribute('data-die');
        if (val !== '20') {
          btn.classList.add('pointer-events-none', 'opacity-25', 'grayscale', 'cursor-not-allowed');
          btn.setAttribute('tabindex', '-1');
        } else {
          btn.classList.remove('pointer-events-none', 'opacity-25', 'grayscale', 'cursor-not-allowed');
          btn.removeAttribute('tabindex');
        }
      });
      banner?.classList.remove('hidden');
    } else {
      dieButtons.forEach((btn) => {
        btn.classList.remove('pointer-events-none', 'opacity-25', 'grayscale', 'cursor-not-allowed');
        btn.removeAttribute('tabindex');
      });
      banner?.classList.add('hidden');
    }

    if (lockCount) {
      selectedCount = 1;
      if (countDisplay) countDisplay.textContent = '1';
      renderReelPlaceholders();
      decBtn?.classList.add('pointer-events-none', 'opacity-30', 'cursor-not-allowed');
      incBtn?.classList.add('pointer-events-none', 'opacity-30', 'cursor-not-allowed');
    } else {
      decBtn?.classList.remove('pointer-events-none', 'opacity-30', 'cursor-not-allowed');
      incBtn?.classList.remove('pointer-events-none', 'opacity-30', 'cursor-not-allowed');
    }
  }

  function setRollMode(physical: boolean) {
    isPhysicalMode = physical;
    if (physical) {
      modePhysicalBtn?.classList.add('bg-amber-500/20', 'text-amber-300', 'border', 'border-amber-500/40', 'shadow-xs');
      modePhysicalBtn?.classList.remove('text-[#94a3b8]');
      modeVirtualBtn?.classList.remove('bg-amber-500/20', 'text-amber-300', 'border', 'border-amber-500/40', 'shadow-xs');
      modeVirtualBtn?.classList.add('text-[#94a3b8]');

      // OCULTAR completamente el área de ruleta/lanzamiento automático
      virtualDisplayArea?.classList.add('hidden');
      // MOSTRAR el contenedor elegante de dados físicos
      physicalContainer?.classList.remove('hidden');

      if (rollBtnLabel) rollBtnLabel.textContent = 'Registrar Tirada Física en Bitácora';
      if (rollBtnIcon) rollBtnIcon.textContent = 'edit_note';

      updatePhysicalCalculations();
      setTimeout(() => physicalInput?.focus(), 60);
    } else {
      modeVirtualBtn?.classList.add('bg-amber-500/20', 'text-amber-300', 'border', 'border-amber-500/40', 'shadow-xs');
      modeVirtualBtn?.classList.remove('text-[#94a3b8]');
      modePhysicalBtn?.classList.remove('bg-amber-500/20', 'text-amber-300', 'border', 'border-amber-500/40', 'shadow-xs');
      modePhysicalBtn?.classList.add('text-[#94a3b8]');

      // MOSTRAR área virtual y OCULTAR contenedor físico
      virtualDisplayArea?.classList.remove('hidden');
      physicalContainer?.classList.add('hidden');

      if (rollBtnLabel) rollBtnLabel.textContent = '¡Lanzar Dados!';
      if (rollBtnIcon) rollBtnIcon.textContent = 'casino';
    }
  }

  modeVirtualBtn?.addEventListener('click', () => setRollMode(false));
  modePhysicalBtn?.addEventListener('click', () => setRollMode(true));

  // Presets rápidos (1, 10, 15, 20)
  document.querySelectorAll('.phys-preset-btn').forEach((btn) => {
    btn.addEventListener('click', () => {
      const val = btn.getAttribute('data-val');
      if (val && physicalInput) {
        physicalInput.value = val;
        updatePhysicalCalculations();
      }
    });
  });

  function updatePhysicalCalculations() {
    const mod = parseInt(modInput?.value || '0') || 0;
    if (physicalModText) {
      physicalModText.textContent = `${mod >= 0 ? '+' : ''}${mod}`;
    }
    if (physicalHeader) {
      physicalHeader.textContent = `Dado Físico en Mesa (d${selectedDie})`;
    }
    if (physicalPresets) {
      if (selectedDie === 20) {
        physicalPresets.classList.remove('hidden');
      } else {
        physicalPresets.classList.add('hidden');
      }
    }

    const val = parseInt(physicalInput?.value || '0');
    if (!isNaN(val) && val > 0) {
      const total = val + mod;
      if (physicalTotalText) physicalTotalText.textContent = String(total);

      // Feedback en vivo (Crítico, Pifia o Impacto)
      if (physicalFeedback) {
        if (selectedDie === 20 && val === 20) {
          physicalFeedback.innerHTML = '<span class="px-2.5 py-1 rounded-lg bg-amber-500/20 text-amber-300 border border-amber-500/40 font-bold animate-pulse">✨ ¡20 NATURAL! ¡GOLPE CRÍTICO! ✨</span>';
        } else if (selectedDie === 20 && val === 1) {
          physicalFeedback.innerHTML = '<span class="px-2.5 py-1 rounded-lg bg-rose-500/20 text-rose-400 border border-rose-500/40 font-bold">💀 ¡1 NATURAL! ¡PIFIA! 💀</span>';
        } else {
          const selectedTarget = targetSelect?.value || '';
          const targetOpt = targetSelect?.selectedOptions[0];
          const targetAc = targetOpt?.dataset.ac ? parseInt(targetOpt.dataset.ac) : null;

          if (selectedTarget && selectedDie === 20 && targetAc) {
            if (total >= targetAc) {
              physicalFeedback.innerHTML = `<span class="px-2.5 py-1 rounded-lg bg-emerald-500/20 text-emerald-300 border border-emerald-500/40 font-bold">🎯 ¡Impacta a ${selectedTarget}! (${total} vs CA ${targetAc})</span>`;
            } else {
              physicalFeedback.innerHTML = `<span class="px-2.5 py-1 rounded-lg bg-rose-500/20 text-rose-300 border border-rose-500/40 font-bold">🛡️ Falla contra ${selectedTarget} (${total} vs CA ${targetAc})</span>`;
            }
          } else {
            physicalFeedback.innerHTML = '';
          }
        }
      }
    } else {
      if (physicalTotalText) physicalTotalText.textContent = '--';
      if (physicalFeedback) physicalFeedback.innerHTML = '';
    }
  }

  physicalInput?.addEventListener('input', updatePhysicalCalculations);
  modInput?.addEventListener('input', updatePhysicalCalculations);

  function refreshCombatTargets(preselectedName?: string) {
    const activeCampId = campaignStore.getActiveCampaignId();
    const combat = activeCampId ? getCurrentCombat(activeCampId) : null;

    if (!targetSelect || !targetContainer) return;

    if (!combat || !combat.active || combat.combatants.length === 0) {
      targetContainer.classList.add('hidden');
      targetSelect.innerHTML = '<option value="">Sin objetivo específico (Tirada general)</option>';
      if (targetAcBadge) targetAcBadge.classList.add('hidden');
      return;
    }

    targetContainer.classList.remove('hidden');
    const currentChar = characterStore.get();
    const myName = currentChar?.name?.trim().toLowerCase();

    let optionsHtml = '<option value="">Sin objetivo específico (Tirada general)</option>';

    combat.combatants.forEach((c) => {
      // No seleccionarse a uno mismo por defecto
      if (myName && c.name.trim().toLowerCase() === myName) return;
      const isSelected = Boolean(preselectedName && c.name.trim().toLowerCase() === preselectedName.trim().toLowerCase());

      optionsHtml += `
        <option value="${c.name}" data-ac="${c.ac || ''}" ${isSelected ? 'selected' : ''}>
          ${c.isPlayer ? '🛡️ PJ: ' : '💀 '}${c.name} ${c.ac ? `(CA ${c.ac})` : ''}
        </option>
      `;
    });

    targetSelect.innerHTML = optionsHtml;
    updateTargetAcBadge();
  }

  function updateTargetAcBadge() {
    if (!targetSelect || !targetAcBadge) return;
    const opt = targetSelect.selectedOptions[0];
    const ac = opt ? opt.dataset.ac : null;
    if (ac) {
      targetAcBadge.textContent = `CA ${ac}`;
      targetAcBadge.classList.remove('hidden');
    } else {
      targetAcBadge.classList.add('hidden');
    }
    updatePhysicalCalculations();
  }

  targetSelect?.addEventListener('change', updateTargetAcBadge);

  function updateSecretUi(isSecret: boolean) {
    if (secretCheckbox) secretCheckbox.checked = isSecret;
    if (secretIcon) secretIcon.textContent = isSecret ? 'visibility_off' : 'visibility';
    if (secretBadge) {
      if (isSecret) secretBadge.classList.remove('hidden');
      else secretBadge.classList.add('hidden');
    }
    if (secretIconWrap) {
      if (isSecret) {
        secretIconWrap.className = 'w-8 h-8 rounded-lg bg-purple-500/20 border border-purple-500/50 text-purple-300 flex items-center justify-center shrink-0 transition-colors shadow-[0_0_10px_rgba(168,85,247,0.2)]';
      } else {
        secretIconWrap.className = 'w-8 h-8 rounded-lg bg-[#10141d] border border-[#222f42] text-[#94a3b8] flex items-center justify-center shrink-0 transition-colors';
      }
    }
    if (secretCard) {
      if (isSecret) {
        secretCard.className = 'p-2.5 rounded-xl bg-[#161a29] border-2 border-purple-500/60 shadow-[0_0_15px_rgba(168,85,247,0.15)] transition-all flex items-center justify-between gap-3 select-none cursor-pointer';
      } else {
        secretCard.className = 'p-2.5 rounded-xl bg-[#18202e] border border-[#222f42] hover:border-amber-500/40 transition-all flex items-center justify-between gap-3 select-none cursor-pointer';
      }
    }
  }

  secretCheckbox?.addEventListener('change', () => {
    rollContext.isSecret = secretCheckbox.checked;
    updateSecretUi(secretCheckbox.checked);
  });

  function updateActiveDieButtons() {
    document.querySelectorAll('.die-select-btn').forEach(b => {
      const dieVal = parseInt(b.getAttribute('data-die') || '20');
      if (dieVal === selectedDie) {
        b.className = 'die-select-btn active p-2 rounded-xl bg-amber-500/20 border-2 border-amber-500 text-amber-300 flex flex-col items-center justify-center text-xs font-bold transition-all cursor-pointer shadow-[0_0_10px_rgba(245,158,11,0.3)]';
      } else {
        b.className = 'die-select-btn p-2 rounded-xl bg-[#18202e] border border-[#222f42] hover:border-amber-500/50 flex flex-col items-center justify-center text-xs font-bold transition-all cursor-pointer';
      }
    });
  }

  function renderReelPlaceholders() {
    if (!reelsContainer) return;
    reelsContainer.innerHTML = '';
    for (let i = 0; i < selectedCount; i++) {
      const p = document.createElement('div');
      p.className = 'w-16 h-20 sm:w-20 sm:h-24 rounded-2xl bg-[#10141d] border-2 border-amber-500/40 flex items-center justify-center text-2xl sm:text-3xl font-headline font-bold text-amber-300 shadow-[inset_0_2px_12px_rgba(0,0,0,0.8)] shrink-0';
      p.textContent = `d${selectedDie}`;
      reelsContainer.appendChild(p);
    }
  }

  function executeRoll() {
    if (isPhysicalMode) {
      executePhysicalRoll();
    } else {
      executeVirtualRoll();
    }
  }

  function executePhysicalRoll() {
    const rawVal = parseInt(physicalInput?.value || '0');
    if (isNaN(rawVal) || rawVal < 1) {
      if (physicalInput) {
        physicalInput.focus();
        physicalInput.classList.add('border-rose-500', 'ring-2', 'ring-rose-500/50');
        setTimeout(() => physicalInput.classList.remove('border-rose-500', 'ring-2', 'ring-rose-500/50'), 1500);
      }
      return;
    }

    const mod = parseInt(modInput?.value || '0') || 0;
    const total = rawVal + mod;
    const isCrit = (selectedDie === 20 && rawVal === 20);
    const isFumble = (selectedDie === 20 && rawVal === 1);

    const res: RollResult = {
      total,
      rolls: [rawVal],
      modifier: mod,
      dieType: selectedDie,
      isCrit,
      isFumble,
    };

    lastResult = res;
    processRollResult(res, true, rawVal);
  }

  function executeVirtualRoll() {
    if (!reelsContainer || !summaryText) return;
    const mod = parseInt(modInput?.value || '0') || 0;

    rollBtn?.setAttribute('disabled', 'true');
    rollBtn?.classList.add('opacity-60', 'pointer-events-none');
    summaryText.innerHTML = '<span class="text-amber-400 font-bold animate-pulse">¡Los dados están girando...!</span>';

    animateJackpotRoll(reelsContainer, selectedDie, selectedCount, mod, (res) => {
      lastResult = res;
      rollBtn?.removeAttribute('disabled');
      rollBtn?.classList.remove('opacity-60', 'pointer-events-none');
      processRollResult(res, false);
    });
  }

  function triggerFollowUpDamage(isCritical: boolean) {
    const f = rollContext.followUpDamage;
    if (!f) return;

    const dmgCount = isCritical ? f.count * 2 : f.count;
    selectedDie = f.die;
    selectedCount = dmgCount;
    if (modInput) modInput.value = String(f.modifier ?? 0);
    if (countDisplay) countDisplay.textContent = String(selectedCount);

    rollContext.lockDie = false;
    rollContext.lockCount = false;
    rollContext.label = `${isCritical ? 'Daño Crítico' : 'Daño'}: ${f.weaponOrSpellName} (${f.damageType})`;
    rollContext.followUpDamage = undefined;

    applyLockState(false, false);
    updateActiveDieButtons();
    renderReelPlaceholders();
    updatePhysicalCalculations();
    followUpContainer?.classList.add('hidden');

    if (!isPhysicalMode) {
      executeRoll();
    } else if (physicalInput) {
      physicalInput.value = '';
      physicalInput.focus();
    }
  }

  function renderFollowUpAfterAttack(res: RollResult, targetAc: number | null) {
    if (!followUpContainer) return;
    const f = rollContext.followUpDamage;
    if (!f || res.dieType !== 20) {
      followUpContainer.classList.add('hidden');
      return;
    }

    const modStr = f.modifier !== 0 ? `${f.modifier >= 0 ? '+' : ''}${f.modifier}` : '';
    const normalFormula = `${f.count}d${f.die}${modStr}`;
    const critFormula = `${f.count * 2}d${f.die}${modStr}`;
    const missedTargetAc = !res.isCrit && (res.isFumble || (targetAc !== null && res.total < targetAc));

    if (res.isCrit) {
      followUpContainer.className = 'p-2.5 rounded-xl bg-amber-500/15 border-2 border-amber-500/60 flex flex-col gap-2 shadow-[0_0_20px_rgba(245,158,11,0.2)]';
      followUpContainer.innerHTML = `
        <div class="flex items-center justify-between text-xs text-amber-300 font-bold">
          <span>🔥 ¡20 Natural! Dados de daño duplicados</span>
          <span class="font-mono text-amber-200">${critFormula} ${f.damageType}</span>
        </div>
        <button
          type="button"
          id="dice-chain-dmg-btn"
          class="w-full py-2 px-3 rounded-lg bg-gradient-to-r from-rose-600 to-amber-500 hover:brightness-110 text-[#0a0d12] font-headline font-extrabold text-xs flex items-center justify-center gap-1.5 shadow-md cursor-pointer transition-all"
        >
          <span class="material-symbols-outlined text-[16px]">local_fire_department</span>
          <span>¡Lanzar Daño Crítico Ahora! (${critFormula})</span>
        </button>
      `;
    } else if (missedTargetAc) {
      followUpContainer.className = 'p-2 rounded-xl bg-[#18202e] border border-[#222f42] flex items-center justify-between gap-2 text-xs';
      followUpContainer.innerHTML = `
        <span class="text-[#94a3b8] text-[11px]">El ataque no superó la CA o fue pifia.</span>
        <button
          type="button"
          id="dice-chain-dmg-btn"
          class="px-2.5 py-1 rounded-lg bg-[#10141d] hover:bg-amber-500/20 border border-[#222f42] hover:border-amber-500/40 text-[#cbd5e1] hover:text-amber-300 font-bold text-[11px] shrink-0 cursor-pointer transition-colors"
        >
          Tirar daño igual (${normalFormula})
        </button>
      `;
    } else {
      followUpContainer.className = 'p-2.5 rounded-xl bg-emerald-500/10 border border-emerald-500/40 flex flex-col gap-2';
      followUpContainer.innerHTML = `
        <div class="flex items-center justify-between text-xs text-emerald-300 font-bold">
          <span>⚔️ Paso 2 del Ataque: Tirada de Daño</span>
          <span class="font-mono text-emerald-200">${normalFormula} ${f.damageType}</span>
        </div>
        <button
          type="button"
          id="dice-chain-dmg-btn"
          class="w-full py-2 px-3 rounded-lg bg-emerald-500 hover:bg-emerald-400 text-[#06120b] font-headline font-extrabold text-xs flex items-center justify-center gap-1.5 shadow-md cursor-pointer transition-all"
        >
          <span class="material-symbols-outlined text-[16px]">swords</span>
          <span>¡Lanzar Daño del Ataque! (${normalFormula} ${f.damageType})</span>
        </button>
      `;
    }

    followUpContainer.classList.remove('hidden');
    document.getElementById('dice-chain-dmg-btn')?.addEventListener('click', () => {
      triggerFollowUpDamage(res.isCrit);
    });
  }

  function processRollResult(res: RollResult, isPhysical: boolean, physicalVal?: number) {
    let rollDetails = isPhysical ? `${physicalVal}` : res.rolls.join(' + ');
    let modDetails = res.modifier !== 0 ? ` (${res.modifier >= 0 ? '+' : ''}${res.modifier})` : '';
    let specialTag = '';

    if (res.isCrit) {
      specialTag = '<span class="text-amber-400 font-bold block text-sm">✨ ¡20 NATURAL! ¡GOLPE CRÍTICO! ✨</span>';
    } else if (res.isFumble) {
      specialTag = '<span class="text-rose-500 font-bold block text-sm">💀 ¡1 NATURAL! ¡PIFIA! 💀</span>';
    }

    const isSecret = Boolean(secretCheckbox?.checked || rollContext.isSecret);
    rollContext.isSecret = isSecret;
    const isDm = Boolean(rollContext.isDmRoll);

    // Objetivo seleccionado
    const selectedTarget = targetSelect?.value || '';
    const targetOpt = targetSelect?.selectedOptions[0];
    const targetAc = targetOpt?.dataset.ac ? parseInt(targetOpt.dataset.ac) : null;

    let targetHitEvaluation = '';
    const saveInfo = rollContext.saveInfo;
    if (saveInfo && saveInfo.isRollingEnemySave && res.dieType === 20) {
      if (res.total >= saveInfo.dc) {
        targetHitEvaluation = `<span class="text-sky-300 font-bold block text-xs mt-0.5">🛡️ ¡El enemigo SUPERA la Salvación de ${saveInfo.ability}! (${res.total} vs CD ${saveInfo.dc}) → Mitad de daño / Efecto reducido</span>`;
      } else {
        targetHitEvaluation = `<span class="text-rose-400 font-bold block text-xs mt-0.5">💥 ¡El enemigo FALLA la Salvación de ${saveInfo.ability}! (${res.total} vs CD ${saveInfo.dc}) → ¡Recibe el Daño/Efecto Completo!</span>`;
      }
    } else if (selectedTarget && res.dieType === 20) {
      if (res.isCrit) {
        targetHitEvaluation = `<span class="text-amber-400 font-bold block text-xs mt-0.5">🎯 ¡Impacto Crítico contra ${selectedTarget}!</span>`;
      } else if (res.isFumble) {
        targetHitEvaluation = `<span class="text-rose-400 font-bold block text-xs mt-0.5">❌ Pifia contra ${selectedTarget}</span>`;
      } else if (targetAc) {
        if (res.total >= targetAc) {
          targetHitEvaluation = `<span class="text-emerald-400 font-bold block text-xs mt-0.5">🎯 ¡Impacta a ${selectedTarget}! (${res.total} vs CA ${targetAc})</span>`;
        } else {
          targetHitEvaluation = `<span class="text-rose-300 font-bold block text-xs mt-0.5">🛡️ No supera la CA de ${selectedTarget} (${res.total} vs CA ${targetAc})</span>`;
        }
      }
    }

    const halfDmgOnSaveHtml = saveInfo && !saveInfo.isRollingEnemySave && res.dieType !== 20
      ? `<div class="mt-1 px-2.5 py-1 rounded-lg bg-sky-500/15 border border-sky-500/30 text-[11px] text-sky-200 flex items-center justify-center gap-3">
           <span>💥 <strong>Si falla (CD ${saveInfo.dc} ${saveInfo.ability}):</strong> ${res.total} daño</span>
           <span>•</span>
           <span>🛡️ <strong>Si supera:</strong> ${Math.floor(res.total / 2)} daño (mitad)</span>
         </div>`
      : '';

    let badgeHtml = '';
    if (isDm) {
      if (isSecret) {
        badgeHtml = '<span class="px-2 py-0.5 rounded-full bg-rose-500/20 text-rose-300 text-[10px] font-bold border border-rose-500/40 inline-flex items-center gap-1 mb-1"><span>🔒</span><span>Tirada Secreta del DM</span></span>';
      } else {
        badgeHtml = '<span class="px-2 py-0.5 rounded-full bg-amber-500/20 text-amber-300 text-[10px] font-bold border border-amber-500/40 inline-flex items-center gap-1 mb-1"><span>👑</span><span>Tirada Pública del DM en Mesa</span></span>';
      }
    } else if (isSecret) {
      badgeHtml = '<span class="px-2 py-0.5 rounded-full bg-purple-500/20 text-purple-300 text-[10px] font-bold border border-purple-500/40 inline-flex items-center gap-1 mb-1"><span>🔒</span><span>Tirada Secreta (Privada)</span></span>';
    }

    const physicalBadge = isPhysical
      ? '<span class="px-1.5 py-0.2 rounded bg-amber-500/15 text-amber-300 border border-amber-500/30 text-[9px] font-bold inline-flex items-center gap-1 mr-1"><span>🖐️</span><span>Dado Físico</span></span>'
      : '';

    const targetLabel = selectedTarget ? `<span class="text-rose-300 font-bold"> ➜ ${selectedTarget}</span>` : '';

    if (summaryText && !isPhysical) {
      summaryText.innerHTML = `
        <div class="flex items-center gap-1 justify-center flex-wrap">
          ${badgeHtml}
          ${physicalBadge}
        </div>
        ${specialTag}
        ${targetHitEvaluation}
        <div class="mt-0.5">
          <span class="text-[#cbd5e1] text-xs">${rollContext.label}${targetLabel} [${rollDetails}]${modDetails} = </span>
          <strong class="text-xl font-headline font-bold ${res.isCrit ? 'text-amber-400' : 'text-[#f1f5f9]'}">${res.total}</strong>
        </div>
        ${halfDmgOnSaveHtml}
        <span class="${isSecret ? 'text-purple-300' : 'text-emerald-400'} block text-[11px] mt-1 font-bold flex items-center justify-center gap-1">
          <span class="material-symbols-outlined text-[13px]">${isSecret ? 'lock' : 'check_circle'}</span>
          <span>Registrado automáticamente en Bitácora</span>
        </span>
      `;
    }

    // Feedback en modo físico
    if (isPhysical && physicalFeedback) {
      physicalFeedback.innerHTML = `
        <div class="flex flex-col items-center gap-1">
          ${specialTag || targetHitEvaluation}
          ${halfDmgOnSaveHtml}
          <span class="text-emerald-400 font-bold text-xs flex items-center gap-1">
            <span class="material-symbols-outlined text-[14px]">check_circle</span>
            <span>¡Registrado en Bitácora con éxito! Total: ${res.total}</span>
          </span>
        </div>
      `;
    }

    // Mostrar encadenamiento de daño si era tirada de ataque con followUpDamage
    renderFollowUpAfterAttack(res, targetAc);

    // AUTOMATIC LOGGING TO JOURNAL
    const modStr = res.modifier !== 0 ? ` ${res.modifier >= 0 ? '+' : ''}${res.modifier}` : '';
    const formulaStr = `${isPhysical ? '1' : selectedCount}d${res.dieType}${modStr}`;
    const critFumbleText = res.isCrit ? ' ¡GOLPE CRÍTICO (20 Nat.)!' : res.isFumble ? ' ¡PIFIA (1 Nat.)!' : '';

    const tagsList = Array.from(new Set([
      rollContext.tag || '#Combate',
      '#Tirada',
      ...(isSecret ? ['#Privado'] : [])
    ]));

    const activeCampId = campaignStore.getActiveCampaignId();
    const activeCamp = activeCampId ? campaignStore.getCampaign(activeCampId) : null;
    const sessionNum = activeCamp?.sessionNumber || 1;
    const currentChar = characterStore.get();

    let targetLogText = '';
    if (saveInfo) {
      if (saveInfo.isRollingEnemySave && res.dieType === 20) {
        targetLogText = res.total >= saveInfo.dc
          ? ` (Salvación ${saveInfo.ability} vs CD ${saveInfo.dc}: ¡SUPERADA!)`
          : ` (Salvación ${saveInfo.ability} vs CD ${saveInfo.dc}: ¡FALLIDA!)`;
      } else if (!saveInfo.isRollingEnemySave && res.dieType !== 20) {
        targetLogText = ` (Exige Salvación ${saveInfo.ability} CD ${saveInfo.dc} • Daño completo: ${res.total} / Mitad si supera: ${Math.floor(res.total / 2)})`;
      }
    } else if (selectedTarget) {
      if (targetAc && res.dieType === 20) {
        if (res.isCrit) targetLogText = ` (Objetivo: ${selectedTarget} • ¡GOLPE CRÍTICO!)`;
        else if (res.isFumble) targetLogText = ` (Objetivo: ${selectedTarget} • ¡PIFIA!)`;
        else if (res.total >= targetAc) targetLogText = ` (Objetivo: ${selectedTarget} • ¡IMPACTA vs CA ${targetAc}!)`;
        else targetLogText = ` (Objetivo: ${selectedTarget} • Falla vs CA ${targetAc})`;
      } else {
        targetLogText = ` (Objetivo: ${selectedTarget})`;
      }
    }

    const physicalPrefix = isPhysical ? '🎲 [Dado Físico] ' : '';
    const rollTitle = isSecret
      ? `[Secreta] ${rollContext.label}${selectedTarget ? ` contra ${selectedTarget}` : ''}: ${res.total}`
      : `${physicalPrefix}${rollContext.label}${selectedTarget ? ` contra ${selectedTarget}` : ''}: ${res.total}`;

    const rollOriginDesc = isPhysical
      ? `Tirada física en mesa con resultado ${physicalVal}${modDetails} = ${res.total}`
      : `Tirada de ${formulaStr} con resultado ${res.total} (Dados: [${rollDetails}]${modDetails})`;

    journalStore.addEntry({
      sessionNumber: sessionNum,
      title: rollTitle,
      content: `${rollOriginDesc}.${critFumbleText}${targetLogText}`,
      tags: tagsList,
      isSecret: isSecret,
      isDmOnly: (isSecret && isDm) || undefined,
      isPlayerOnly: (isSecret && !isDm) || undefined,
      characterId: isDm ? undefined : currentChar?.id,
      authorName: rollContext.authorName || (isDm ? (activeCamp?.dmName || 'Dungeon Master') : (currentChar?.name || 'Aventurero')),
      campaignId: activeCampId || undefined,
      diceRoll: {
        formula: `${formulaStr} (${rollContext.label})`,
        result: res.total,
        breakdown: isPhysical ? `[Físico: ${physicalVal}]${modDetails}${critFumbleText}` : `[${rollDetails}]${modDetails}${critFumbleText}`
      }
    });

    // If DM public roll, broadcast event to campaign
    if (isDm && !isSecret && activeCampId) {
      campaignStore.sendDmEvent(activeCampId, {
        campaignId: activeCampId,
        type: 'dice_roll',
        dmName: activeCamp?.dmName || 'Dungeon Master',
        payload: {
          diceRoll: {
            formula: formulaStr,
            result: res.total,
            isSecret: false
          }
        }
      });
    }

    // Si era tirada de iniciativa solicitada, notificar con evento específico
    if (rollContext.isInitiative) {
      const initCampId = rollContext.campaignId || activeCampId;
      const initChar = characterStore.get();
      const initDetail = {
        campaignId: initCampId,
        characterId: rollContext.characterId || initChar?.id,
        characterName: rollContext.authorName || initChar?.name || 'Aventurero',
        initiativeTotal: res.total,
        rollValue: isPhysical ? physicalVal : res.rolls[0],
        modifier: res.modifier,
      };

      // Disparar en la ventana actual
      window.dispatchEvent(new CustomEvent('initiative-result', { detail: initDetail }));

      // Transmitir a otras pestañas / DM por BroadcastChannel
      if (typeof BroadcastChannel !== 'undefined') {
        try {
          const bc = new BroadcastChannel('dnd_campaign_bus_v1');
          bc.postMessage({ type: 'initiative-result', detail: initDetail });
          if (typeof (bc as any).unref === 'function') (bc as any).unref();
        } catch (_) {}
      }
    }

    window.dispatchEvent(new CustomEvent('journal-updated'));
    if (logBtn) logBtn.classList.add('hidden');
  }

  function updateSaveBannerUi(saveInfo?: SaveInfoSpec) {
    if (!saveBanner) return;
    if (!saveInfo) {
      saveBanner.classList.add('hidden');
      return;
    }
    saveBanner.classList.remove('hidden');
    if (saveBannerTitle) {
      saveBannerTitle.textContent = `Conjuro "${saveInfo.spellName}" exige Salvación`;
    }
    if (saveDcPill) {
      saveDcPill.textContent = `CD ${saveInfo.dc} ${saveInfo.ability}`;
    }
    if (rollSaveDmgBtn && rollSaveDmgLabel) {
      if (saveInfo.damageDie && saveInfo.damageCount) {
        const modStr = saveInfo.damageMod ? `${saveInfo.damageMod >= 0 ? '+' : ''}${saveInfo.damageMod}` : '';
        rollSaveDmgLabel.textContent = `Tirar Daño (${saveInfo.damageCount}d${saveInfo.damageDie}${modStr})`;
        rollSaveDmgBtn.classList.remove('hidden');
      } else {
        rollSaveDmgBtn.classList.add('hidden');
      }
    }
  }

  rollEnemySaveBtn?.addEventListener('click', () => {
    const s = rollContext.saveInfo;
    if (!s) return;
    s.isRollingEnemySave = true;
    selectedDie = 20;
    selectedCount = 1;
    if (modInput) modInput.value = '0';
    if (countDisplay) countDisplay.textContent = '1';
    rollContext.label = `Salvación de ${s.ability} del Enemigo (vs CD ${s.dc} - ${s.spellName})`;
    updateActiveDieButtons();
    renderReelPlaceholders();
    updatePhysicalCalculations();
    if (!isPhysicalMode) executeRoll();
  });

  rollSaveDmgBtn?.addEventListener('click', () => {
    const s = rollContext.saveInfo;
    if (!s || !s.damageDie || !s.damageCount) return;
    s.isRollingEnemySave = false;
    selectedDie = s.damageDie;
    selectedCount = s.damageCount;
    if (modInput) modInput.value = String(s.damageMod ?? 0);
    if (countDisplay) countDisplay.textContent = String(selectedCount);
    rollContext.label = `Daño de Conjuro: ${s.spellName} (${s.damageType || 'Mágico'})`;
    updateActiveDieButtons();
    renderReelPlaceholders();
    updatePhysicalCalculations();
    if (!isPhysicalMode) executeRoll();
  });

  // Window event for opening with rich context from any component
  window.addEventListener('open-dice-roller', ((e: CustomEvent) => {
    const detail = e.detail || {};
    const lockDie = Boolean(detail.lockDie || detail.isInitiative);
    const lockCount = Boolean(detail.lockCount || detail.isInitiative);

    selectedDie = lockDie ? 20 : (detail.die || 20);
    selectedCount = lockCount ? 1 : (detail.count || 1);
    if (modInput) modInput.value = String(detail.modifier ?? 0);
    const isSecretVal = Boolean(detail.isSecret);

    rollContext = {
      label: detail.label || 'Tirada de dados',
      tag: detail.tag || '#Tirada',
      isDmRoll: detail.isDmRoll || false,
      isSecret: isSecretVal,
      targetName: detail.targetName || detail.target,
      targetAc: detail.targetAc,
      authorName: detail.authorName,
      lockDie,
      lockCount,
      isInitiative: Boolean(detail.isInitiative),
      characterId: detail.characterId,
      campaignId: detail.campaignId,
      followUpDamage: detail.followUpDamage,
      saveInfo: detail.saveInfo ? { ...detail.saveInfo } : undefined,
    };

    if (followUpContainer) {
      const f = rollContext.followUpDamage;
      if (f) {
        const modStr = f.modifier !== 0 ? `${f.modifier >= 0 ? '+' : ''}${f.modifier}` : '';
        const normalFormula = `${f.count}d${f.die}${modStr}`;
        followUpContainer.className = 'p-2 rounded-xl bg-[#18202e] border border-[#222f42] flex items-center justify-between gap-2 text-xs';
        followUpContainer.innerHTML = `
          <span class="text-[#94a3b8] text-[11px] flex items-center gap-1">
            <span class="material-symbols-outlined text-[14px] text-amber-400">swords</span>
            <span>Paso 1: Impacto (d20) → Paso 2: <strong>${normalFormula} ${f.damageType}</strong></span>
          </span>
          <button
            type="button"
            id="dice-skip-to-dmg-btn"
            class="px-2.5 py-1 rounded-lg bg-[#10141d] hover:bg-amber-500/20 border border-[#222f42] hover:border-amber-500/40 text-amber-300 font-bold text-[11px] shrink-0 cursor-pointer transition-colors"
            title="Saltar la tirada de d20 y tirar directamente el daño del ataque"
          >
            Tirar solo Daño
          </button>
        `;
        followUpContainer.classList.remove('hidden');
        document.getElementById('dice-skip-to-dmg-btn')?.addEventListener('click', () => {
          triggerFollowUpDamage(false);
        });
      } else {
        followUpContainer.classList.add('hidden');
      }
    }
    updateSaveBannerUi(rollContext.saveInfo);
    applyLockState(lockDie, lockCount);

    if (countDisplay) countDisplay.textContent = String(selectedCount);
    updateActiveDieButtons();
    renderReelPlaceholders();
    updateSecretUi(isSecretVal);

    // Actualizar objetivos del combate
    refreshCombatTargets(rollContext.targetName);

    // Restablecer a modo virtual por defecto a menos que se indique físico
    setRollMode(Boolean(detail.isPhysical));
    if (physicalInput) physicalInput.value = '';

    if (summaryText) {
      const targetTxt = rollContext.targetName ? ` contra <strong class="text-rose-300">${rollContext.targetName}</strong>` : '';
      const followTxt = rollContext.followUpDamage
        ? ` <span class="text-emerald-400 font-bold"><br/>• Paso 1: Impacto (d20) → Paso 2: Daño (${rollContext.followUpDamage.count}d${rollContext.followUpDamage.die})</span>`
        : '';
      summaryText.innerHTML = `<span class="text-[#94a3b8] text-xs">Preparado para: <strong class="text-amber-300">${rollContext.label}</strong>${targetTxt}${followTxt} ${isSecretVal ? '<span class="text-purple-300 font-bold">(Secreta 🔒)</span>' : ''}</span>`;
    }

    if (modal && backdrop) openModal(modal, backdrop);

    if (detail.autoroll && !detail.isPhysical) {
      setTimeout(() => {
        executeRoll();
      }, 150);
    }
  }) as EventListener);

  // Close handlers
  closeBtn?.addEventListener('click', () => {
    if (modal && backdrop) closeModal(modal, backdrop);
  });

  // Die Type selection
  document.querySelectorAll('.die-select-btn').forEach((btn) => {
    btn.addEventListener('click', () => {
      selectedDie = parseInt(btn.getAttribute('data-die') || '20');
      updateActiveDieButtons();
      renderReelPlaceholders();
      updatePhysicalCalculations();
    });
  });

  // Count buttons
  document.getElementById('dice-count-dec')?.addEventListener('click', () => {
    if (selectedCount > 1) {
      selectedCount--;
      if (countDisplay) countDisplay.textContent = String(selectedCount);
      renderReelPlaceholders();
    }
  });
  document.getElementById('dice-count-inc')?.addEventListener('click', () => {
    if (selectedCount < 12) {
      selectedCount++;
      if (countDisplay) countDisplay.textContent = String(selectedCount);
      renderReelPlaceholders();
    }
  });

  // Roll trigger
  rollBtn?.addEventListener('click', executeRoll);
</script>
