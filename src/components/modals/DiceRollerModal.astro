---
// src/components/modals/DiceRollerModal.astro
---

<div id="dice-roller-modal" class="hidden fixed inset-0 z-50 flex items-center justify-center p-4">
  <div class="modal-content w-full max-w-md rounded-2xl bg-[#121721] border border-[#222f42] shadow-[0_15px_50px_rgba(0,0,0,0.9)] overflow-hidden flex flex-col">
    <!-- Modal Header -->
    <div class="p-4 bg-[#18202e] border-b border-[#222f42] flex items-center justify-between">
      <div class="flex items-center gap-2">
        <div class="w-8 h-8 rounded-lg bg-amber-500/20 text-amber-400 flex items-center justify-center border border-amber-500/30">
          <span class="material-symbols-outlined text-[20px]">casino</span>
        </div>
        <div>
          <h3 class="font-headline font-bold text-base text-[#f1f5f9]">Torre de Dados</h3>
          <span class="text-[10px] text-[#94a3b8]">Elige tus dados y gira el tambor</span>
        </div>
      </div>
      <button id="dice-modal-close-btn" class="w-7 h-7 rounded-lg bg-[#10141d] border border-[#222f42] hover:border-rose-500/50 text-[#94a3b8] hover:text-rose-400 flex items-center justify-center text-xs transition-colors cursor-pointer">
        <span class="material-symbols-outlined text-[16px]">close</span>
      </button>
    </div>

    <!-- Modal Body -->
    <div class="p-5 space-y-4">
      <!-- 1. Dice Selector Grid (d4, d6, d8, d10, d12, d20, d100) -->
      <div>
        <label class="text-xs font-headline font-bold text-[#94a3b8] uppercase tracking-wider block mb-2">Selecciona Tipo de Dado</label>
        <div class="grid grid-cols-4 sm:grid-cols-7 gap-1.5" id="dice-type-selector">
          <button type="button" class="die-select-btn p-2 rounded-xl bg-[#18202e] border border-[#222f42] hover:border-amber-500/50 flex flex-col items-center justify-center text-xs font-bold transition-all cursor-pointer" data-die="4">d4</button>
          <button type="button" class="die-select-btn p-2 rounded-xl bg-[#18202e] border border-[#222f42] hover:border-amber-500/50 flex flex-col items-center justify-center text-xs font-bold transition-all cursor-pointer" data-die="6">d6</button>
          <button type="button" class="die-select-btn p-2 rounded-xl bg-[#18202e] border border-[#222f42] hover:border-amber-500/50 flex flex-col items-center justify-center text-xs font-bold transition-all cursor-pointer" data-die="8">d8</button>
          <button type="button" class="die-select-btn p-2 rounded-xl bg-[#18202e] border border-[#222f42] hover:border-amber-500/50 flex flex-col items-center justify-center text-xs font-bold transition-all cursor-pointer" data-die="10">d10</button>
          <button type="button" class="die-select-btn p-2 rounded-xl bg-[#18202e] border border-[#222f42] hover:border-amber-500/50 flex flex-col items-center justify-center text-xs font-bold transition-all cursor-pointer" data-die="12">d12</button>
          <button type="button" class="die-select-btn active p-2 rounded-xl bg-amber-500/20 border-2 border-amber-500 text-amber-300 flex flex-col items-center justify-center text-xs font-bold transition-all cursor-pointer shadow-[0_0_10px_rgba(245,158,11,0.3)]" data-die="20">d20</button>
          <button type="button" class="die-select-btn p-2 rounded-xl bg-[#18202e] border border-[#222f42] hover:border-amber-500/50 flex flex-col items-center justify-center text-xs font-bold transition-all cursor-pointer" data-die="100">d100</button>
        </div>
      </div>

      <!-- 2. Controls: Quantity & Modifier -->
      <div class="grid grid-cols-2 gap-3">
        <!-- Quantity -->
        <div class="p-2.5 rounded-xl bg-[#18202e] border border-[#222f42] flex flex-col justify-between">
          <span class="text-[10px] uppercase font-bold text-[#94a3b8] tracking-wider mb-1">Cantidad de Dados</span>
          <div class="flex items-center justify-between">
            <button type="button" id="dice-count-dec" class="w-7 h-7 rounded-lg bg-[#10141d] border border-[#222f42] text-amber-400 font-bold hover:bg-[#222f42] active:scale-90 transition-all cursor-pointer">-</button>
            <span id="dice-count-display" class="text-base font-headline font-bold text-[#f1f5f9]">1</span>
            <button type="button" id="dice-count-inc" class="w-7 h-7 rounded-lg bg-[#10141d] border border-[#222f42] text-amber-400 font-bold hover:bg-[#222f42] active:scale-90 transition-all cursor-pointer">+</button>
          </div>
        </div>

        <!-- Modifier -->
        <div class="p-2.5 rounded-xl bg-[#18202e] border border-[#222f42] flex flex-col justify-between">
          <span class="text-[10px] uppercase font-bold text-[#94a3b8] tracking-wider mb-1">Modificador (+ / -)</span>
          <input
            type="number"
            id="dice-modifier-input"
            value="3"
            class="w-full text-center text-base font-headline font-bold p-1 rounded-lg bg-[#10141d] border border-[#222f42] text-amber-400 focus:outline-none focus:border-amber-500"
          />
        </div>
      </div>

      <!-- Secret Roll Option for Users & DM -->
      <div
        id="dice-secret-toggle-card"
        class="p-2.5 rounded-xl bg-[#18202e] border border-[#222f42] hover:border-amber-500/40 transition-all flex items-center justify-between gap-3 select-none cursor-pointer"
      >
        <label for="dice-secret-checkbox" class="flex items-center gap-2.5 cursor-pointer flex-1">
          <div
            id="dice-secret-icon-wrap"
            class="w-8 h-8 rounded-lg bg-[#10141d] border border-[#222f42] text-[#94a3b8] flex items-center justify-center shrink-0 transition-colors"
          >
            <span class="material-symbols-outlined text-[18px]" id="dice-secret-icon">visibility</span>
          </div>
          <div class="flex flex-col">
            <div class="flex items-center gap-1.5">
              <span class="text-xs font-headline font-bold text-[#f1f5f9]">Tirada Secreta</span>
              <span
                id="dice-secret-badge"
                class="hidden px-1.5 py-0.2 rounded text-[9px] font-bold uppercase tracking-wider bg-purple-500/20 text-purple-300 border border-purple-500/40 flex items-center gap-1"
              >
                <span>🔒</span>
                <span>Oculta</span>
              </span>
            </div>
            <span class="text-[10px] text-[#94a3b8]" id="dice-secret-desc">Visible solo para ti (y el DM) • Nota privada en bitácora</span>
          </div>
        </label>
        <input
          type="checkbox"
          id="dice-secret-checkbox"
          class="w-4 h-4 rounded bg-[#10141d] border-[#222f42] text-purple-500 focus:ring-purple-500/40 cursor-pointer accent-purple-500"
        />
      </div>

      <!-- 3. Jackpot Roulette Reel Display Area -->
      <div class="p-4 rounded-2xl bg-[#0a0d12] border-2 border-[#222f42] flex flex-col items-center justify-between shadow-inner h-[190px] relative overflow-hidden select-none">
        <!-- Ambient slot glow -->
        <div class="absolute inset-0 bg-gradient-to-b from-amber-500/5 via-transparent to-amber-500/5 pointer-events-none"></div>

        <!-- Reels Container (Anime.js target with stable height) -->
        <div id="jackpot-reels-container" class="h-20 sm:h-24 flex items-center justify-center gap-2.5 z-10 flex-wrap">
          <div class="w-16 h-20 sm:w-20 sm:h-24 rounded-2xl bg-[#10141d] border-2 border-amber-500/40 flex items-center justify-center text-2xl sm:text-3xl font-headline font-bold text-amber-300 shadow-[inset_0_2px_12px_rgba(0,0,0,0.8)] shrink-0">
            d20
          </div>
        </div>

        <!-- Result Breakdown Summary (Strict fixed height to eliminate layout shifts) -->
        <div id="jackpot-summary-text" class="h-14 w-full flex flex-col items-center justify-center text-xs font-label text-[#94a3b8] z-10 font-medium text-center leading-tight">
          Pulsa "Lanzar Dados" para girar el tambor
        </div>
      </div>

      <!-- 4. Action Buttons -->
      <div class="flex gap-2">
        <button
          type="button"
          id="jackpot-roll-trigger-btn"
          class="flex-1 py-3 rounded-xl bg-gradient-to-r from-amber-600 via-amber-500 to-amber-400 text-[#0a0d12] text-sm font-bold shadow-[0_0_20px_rgba(245,158,11,0.4)] hover:brightness-110 active:scale-98 transition-all flex items-center justify-center gap-2 cursor-pointer font-headline"
        >
          <span class="material-symbols-outlined text-[20px]">casino</span>
          <span>¡Lanzar Dados!</span>
        </button>

        <button
          type="button"
          id="jackpot-log-btn"
          class="hidden px-4 py-3 rounded-xl bg-[#18202e] border border-amber-500/30 hover:border-amber-500 text-amber-400 text-xs font-bold active:scale-95 transition-all flex items-center gap-1 cursor-pointer"
          title="Guardar tirada en la Bitácora de la campaña"
        >
          <span class="material-symbols-outlined text-[16px]">bookmark_add</span>
          <span>Anotar</span>
        </button>
      </div>
    </div>
  </div>
</div>

<script>
  import { animateJackpotRoll, type RollResult } from '../../scripts/animations/diceJackpotAnimation';
  import { openModal, closeModal } from '../../scripts/animations/modalAnimations';
  import { journalStore } from '../../scripts/state/journalStore';
  import { campaignStore } from '../../scripts/state/campaignStore';
  import { characterStore } from '../../scripts/state/characterStore';

  const modal = document.getElementById('dice-roller-modal');
  const backdrop = document.getElementById('modal-backdrop');
  const closeBtn = document.getElementById('dice-modal-close-btn');
  const rollBtn = document.getElementById('jackpot-roll-trigger-btn');
  const logBtn = document.getElementById('jackpot-log-btn');
  const reelsContainer = document.getElementById('jackpot-reels-container');
  const summaryText = document.getElementById('jackpot-summary-text');
  const countDisplay = document.getElementById('dice-count-display');
  const modInput = document.getElementById('dice-modifier-input') as HTMLInputElement;
  const secretCheckbox = document.getElementById('dice-secret-checkbox') as HTMLInputElement;
  const secretIcon = document.getElementById('dice-secret-icon');
  const secretBadge = document.getElementById('dice-secret-badge');
  const secretIconWrap = document.getElementById('dice-secret-icon-wrap');
  const secretCard = document.getElementById('dice-secret-toggle-card');

  let selectedDie = 20;
  let selectedCount = 1;
  let lastResult: RollResult | null = null;
  let rollContext: {
    label: string;
    tag: string;
    isDmRoll?: boolean;
    isSecret?: boolean;
  } = { label: 'Tirada de dados', tag: '#Tirada', isDmRoll: false, isSecret: false };

  function updateSecretUi(isSecret: boolean) {
    if (secretCheckbox) secretCheckbox.checked = isSecret;
    if (secretIcon) secretIcon.textContent = isSecret ? 'visibility_off' : 'visibility';
    if (secretBadge) {
      if (isSecret) secretBadge.classList.remove('hidden');
      else secretBadge.classList.add('hidden');
    }
    if (secretIconWrap) {
      if (isSecret) {
        secretIconWrap.className = 'w-8 h-8 rounded-lg bg-purple-500/20 border border-purple-500/50 text-purple-300 flex items-center justify-center shrink-0 transition-colors shadow-[0_0_10px_rgba(168,85,247,0.2)]';
      } else {
        secretIconWrap.className = 'w-8 h-8 rounded-lg bg-[#10141d] border border-[#222f42] text-[#94a3b8] flex items-center justify-center shrink-0 transition-colors';
      }
    }
    if (secretCard) {
      if (isSecret) {
        secretCard.className = 'p-2.5 rounded-xl bg-[#161a29] border-2 border-purple-500/60 shadow-[0_0_15px_rgba(168,85,247,0.15)] transition-all flex items-center justify-between gap-3 select-none cursor-pointer';
      } else {
        secretCard.className = 'p-2.5 rounded-xl bg-[#18202e] border border-[#222f42] hover:border-amber-500/40 transition-all flex items-center justify-between gap-3 select-none cursor-pointer';
      }
    }
  }

  secretCheckbox?.addEventListener('change', () => {
    rollContext.isSecret = secretCheckbox.checked;
    updateSecretUi(secretCheckbox.checked);
  });

  function updateActiveDieButtons() {
    document.querySelectorAll('.die-select-btn').forEach(b => {
      const dieVal = parseInt(b.getAttribute('data-die') || '20');
      if (dieVal === selectedDie) {
        b.className = 'die-select-btn active p-2 rounded-xl bg-amber-500/20 border-2 border-amber-500 text-amber-300 flex flex-col items-center justify-center text-xs font-bold transition-all cursor-pointer shadow-[0_0_10px_rgba(245,158,11,0.3)]';
      } else {
        b.className = 'die-select-btn p-2 rounded-xl bg-[#18202e] border border-[#222f42] hover:border-amber-500/50 flex flex-col items-center justify-center text-xs font-bold transition-all cursor-pointer';
      }
    });
  }

  function renderReelPlaceholders() {
    if (!reelsContainer) return;
    reelsContainer.innerHTML = '';
    for (let i = 0; i < selectedCount; i++) {
      const p = document.createElement('div');
      p.className = 'w-16 h-20 sm:w-20 sm:h-24 rounded-2xl bg-[#10141d] border-2 border-amber-500/40 flex items-center justify-center text-2xl sm:text-3xl font-headline font-bold text-amber-300 shadow-[inset_0_2px_12px_rgba(0,0,0,0.8)] shrink-0';
      p.textContent = `d${selectedDie}`;
      reelsContainer.appendChild(p);
    }
  }

  function executeRoll() {
    if (!reelsContainer || !summaryText) return;
    const mod = parseInt(modInput?.value || '0') || 0;
    
    rollBtn?.setAttribute('disabled', 'true');
    rollBtn?.classList.add('opacity-60', 'pointer-events-none');
    summaryText.innerHTML = '<span class="text-amber-400 font-bold animate-pulse">¡Los dados están girando...!</span>';

    animateJackpotRoll(reelsContainer, selectedDie, selectedCount, mod, (res) => {
      lastResult = res;
      rollBtn?.removeAttribute('disabled');
      rollBtn?.classList.remove('opacity-60', 'pointer-events-none');

      let rollDetails = res.rolls.join(' + ');
      let modDetails = res.modifier !== 0 ? ` (${res.modifier >= 0 ? '+' : ''}${res.modifier})` : '';
      let specialTag = '';

      if (res.isCrit) {
        specialTag = '<span class="text-amber-400 font-bold block text-sm">✨ ¡20 NATURAL! ¡GOLPE CRÍTICO! ✨</span>';
      } else if (res.isFumble) {
        specialTag = '<span class="text-rose-500 font-bold block text-sm">💀 ¡1 NATURAL! ¡PIFIA! 💀</span>';
      }

      const isSecret = Boolean(secretCheckbox?.checked || rollContext.isSecret);
      rollContext.isSecret = isSecret;
      const isDm = Boolean(rollContext.isDmRoll);

      let badgeHtml = '';
      if (isDm) {
        if (isSecret) {
          badgeHtml = '<span class="px-2 py-0.5 rounded-full bg-rose-500/20 text-rose-300 text-[10px] font-bold border border-rose-500/40 inline-flex items-center gap-1 mb-1"><span>🔒</span><span>Tirada Secreta del DM</span></span>';
        } else {
          badgeHtml = '<span class="px-2 py-0.5 rounded-full bg-amber-500/20 text-amber-300 text-[10px] font-bold border border-amber-500/40 inline-flex items-center gap-1 mb-1"><span>👑</span><span>Tirada Pública del DM en Mesa</span></span>';
        }
      } else if (isSecret) {
        badgeHtml = '<span class="px-2 py-0.5 rounded-full bg-purple-500/20 text-purple-300 text-[10px] font-bold border border-purple-500/40 inline-flex items-center gap-1 mb-1"><span>🔒</span><span>Tirada Secreta (Privada)</span></span>';
      }

      summaryText.innerHTML = `
        ${badgeHtml}
        ${specialTag}
        <div class="mt-0.5">
          <span class="text-[#cbd5e1] text-xs">${rollContext.label} [${rollDetails}]${modDetails} = </span>
          <strong class="text-xl font-headline font-bold ${res.isCrit ? 'text-amber-400' : 'text-[#f1f5f9]'}">${res.total}</strong>
        </div>
        <span class="${isSecret ? 'text-purple-300' : 'text-emerald-400'} block text-[11px] mt-1 font-bold flex items-center justify-center gap-1">
          <span class="material-symbols-outlined text-[13px]">${isSecret ? 'lock' : 'check_circle'}</span>
          <span>Registrado automáticamente en Bitácora ${isSecret ? '(Privada)' : ''}</span>
        </span>
      `;

      // AUTOMATIC LOGGING TO JOURNAL
      const modStr = res.modifier !== 0 ? ` ${res.modifier >= 0 ? '+' : ''}${res.modifier}` : '';
      const formulaStr = `${selectedCount}d${res.dieType}${modStr}`;
      const critFumbleText = res.isCrit ? ' ¡GOLPE CRÍTICO (20 Nat.)!' : res.isFumble ? ' ¡PIFIA (1 Nat.)!' : '';
      
      const tagsList = Array.from(new Set([
        rollContext.tag,
        '#Tirada',
        ...(isSecret ? ['#Privado'] : [])
      ]));

      const activeCampId = campaignStore.getActiveCampaignId();
      const activeCamp = activeCampId ? campaignStore.getCampaign(activeCampId) : null;
      const sessionNum = activeCamp?.sessionNumber || 1;
      const currentChar = characterStore.get();
      const rollTitle = isSecret ? `[Secreta] ${rollContext.label}: ${res.total}` : `${rollContext.label}: ${res.total}`;

      journalStore.addEntry({
        sessionNumber: sessionNum,
        title: rollTitle,
        content: `Tirada de ${formulaStr} con resultado ${res.total} (Dados: [${rollDetails}]${modDetails}).${critFumbleText}`,
        tags: tagsList,
        isSecret: isSecret,
        isPrivate: isSecret,
        characterId: currentChar?.id,
        authorName: isDm ? (activeCamp?.dmName || 'Dungeon Master') : (currentChar?.name || 'Aventurero'),
        diceRoll: {
          formula: `${formulaStr} (${rollContext.label})`,
          result: res.total,
          breakdown: `[${rollDetails}]${modDetails}${critFumbleText}`
        }
      });

      // If DM public roll, broadcast event to campaign
      if (isDm && !isSecret && activeCampId) {
        campaignStore.sendDmEvent(activeCampId, {
          campaignId: activeCampId,
          type: 'dice_roll',
          dmName: activeCamp?.dmName || 'Dungeon Master',
          payload: {
            diceRoll: {
              formula: formulaStr,
              result: res.total,
              isSecret: false
            }
          }
        });
      }

      window.dispatchEvent(new CustomEvent('journal-updated'));

      if (logBtn) logBtn.classList.add('hidden');
    });
  }

  // Window event for opening with rich context from any component
  window.addEventListener('open-dice-roller', ((e: CustomEvent) => {
    const detail = e.detail || {};
    selectedDie = detail.die || 20;
    selectedCount = detail.count || 1;
    if (modInput) modInput.value = String(detail.modifier ?? 0);
    const isSecretVal = Boolean(detail.isSecret);
    rollContext = {
      label: detail.label || 'Tirada de dados',
      tag: detail.tag || '#Tirada',
      isDmRoll: detail.isDmRoll || false,
      isSecret: isSecretVal,
    };
    if (countDisplay) countDisplay.textContent = String(selectedCount);
    updateActiveDieButtons();
    renderReelPlaceholders();
    updateSecretUi(isSecretVal);
    if (summaryText) {
      summaryText.innerHTML = `<span class="text-[#94a3b8] text-xs">Preparado para: <strong class="text-amber-300">${rollContext.label}</strong> ${isSecretVal ? '<span class="text-purple-300 font-bold">(Secreta 🔒)</span>' : ''}</span>`;
    }
    if (modal && backdrop) openModal(modal, backdrop);

    if (detail.autoroll) {
      setTimeout(() => {
        executeRoll();
      }, 150);
    }
  }) as EventListener);

  // Close handlers
  closeBtn?.addEventListener('click', () => {
    if (modal && backdrop) closeModal(modal, backdrop);
  });

  // Die Type selection
  document.querySelectorAll('.die-select-btn').forEach((btn) => {
    btn.addEventListener('click', () => {
      selectedDie = parseInt(btn.getAttribute('data-die') || '20');
      updateActiveDieButtons();
      renderReelPlaceholders();
    });
  });

  // Count buttons
  document.getElementById('dice-count-dec')?.addEventListener('click', () => {
    if (selectedCount > 1) {
      selectedCount--;
      if (countDisplay) countDisplay.textContent = String(selectedCount);
      renderReelPlaceholders();
    }
  });
  document.getElementById('dice-count-inc')?.addEventListener('click', () => {
    if (selectedCount < 4) {
      selectedCount++;
      if (countDisplay) countDisplay.textContent = String(selectedCount);
      renderReelPlaceholders();
    }
  });

  // Roll trigger
  rollBtn?.addEventListener('click', executeRoll);
</script>
