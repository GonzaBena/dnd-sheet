---
// src/components/modals/CompendiumModal.astro
---

<div id="compendium-modal" class="hidden fixed inset-0 z-50 flex items-center justify-center p-2 sm:p-4">
  <div class="modal-content w-full max-w-4xl max-h-[92vh] rounded-2xl bg-[#121721] border border-[#222f42] shadow-[0_25px_70px_rgba(0,0,0,0.95)] overflow-hidden flex flex-col">
    <!-- Header -->
    <div class="p-3 sm:p-4 bg-[#18202e] border-b border-[#222f42] flex flex-wrap items-center justify-between gap-3 shrink-0">
      <div class="flex items-center gap-2.5">
        <div class="w-9 h-9 rounded-xl bg-amber-500/20 text-amber-400 flex items-center justify-center border border-amber-500/30 shrink-0">
          <span class="material-symbols-outlined text-[20px]">menu_book</span>
        </div>
        <div>
          <div class="flex items-center gap-2">
            <h3 class="font-headline font-bold text-sm sm:text-base text-[#f1f5f9]" id="compendium-modal-title">Compendio Oficial D&D 5e</h3>
            <span id="compendium-cache-pill" class="text-[9px] px-2 py-0.5 rounded-full bg-emerald-500/10 text-emerald-400 border border-emerald-500/30 font-bold uppercase tracking-wider flex items-center gap-1">
              <span class="w-1.5 h-1.5 rounded-full bg-emerald-400"></span>
              <span>Caché Local Listo</span>
            </span>
          </div>
          <span class="text-[10px] text-[#94a3b8]" id="compendium-modal-subtitle">Explora el SRD, filtra por edición y añade elementos a tu ficha con un clic</span>
        </div>
      </div>

      <!-- Edition Selector & Close Button -->
      <div class="flex items-center gap-2">
        <div class="flex items-center bg-[#10141d] p-0.5 rounded-xl border border-[#222f42]" id="compendium-edition-toggle">
          <button
            type="button"
            data-edition="2024"
            id="compendium-edition-2024"
            class="px-2.5 py-1 rounded-lg text-xs font-bold transition-all bg-amber-500/20 text-amber-400 border border-amber-500/40 cursor-pointer"
          >
            2024 (Nuevo)
          </button>
          <button
            type="button"
            data-edition="2014"
            id="compendium-edition-2014"
            class="px-2.5 py-1 rounded-lg text-xs font-bold transition-all text-[#94a3b8] hover:text-[#f1f5f9] cursor-pointer"
          >
            2014 (Clásico)
          </button>
        </div>

        <button
          type="button"
          id="compendium-close-btn"
          class="w-8 h-8 rounded-lg bg-[#10141d] border border-[#222f42] hover:border-rose-500/50 text-[#94a3b8] hover:text-rose-400 flex items-center justify-center transition-colors cursor-pointer"
          aria-label="Cerrar compendio"
        >
          <span class="material-symbols-outlined text-[18px]">close</span>
        </button>
      </div>
    </div>

    <!-- Category Tabs Navigation -->
    <div class="px-4 py-2 bg-[#10141d] border-b border-[#222f42] flex items-center gap-1.5 overflow-x-auto no-scrollbar shrink-0" id="compendium-tabs">
      <button
        type="button"
        data-cat="spells"
        class="compendium-tab-btn px-3 py-1.5 rounded-lg text-xs font-headline font-bold flex items-center gap-1.5 shrink-0 bg-amber-500/20 text-amber-300 border border-amber-500/30"
      >
        <span class="material-symbols-outlined text-[15px]">auto_fix_high</span>
        <span>Hechizos</span>
      </button>

      <button
        type="button"
        data-cat="equipment"
        class="compendium-tab-btn px-3 py-1.5 rounded-lg text-xs font-headline font-bold flex items-center gap-1.5 shrink-0 text-[#94a3b8] hover:bg-[#18202e] hover:text-[#f1f5f9]"
      >
        <span class="material-symbols-outlined text-[15px]">backpack</span>
        <span>Equipo y Consumibles</span>
      </button>

      <button
        type="button"
        data-cat="weapons"
        class="compendium-tab-btn px-3 py-1.5 rounded-lg text-xs font-headline font-bold flex items-center gap-1.5 shrink-0 text-[#94a3b8] hover:bg-[#18202e] hover:text-[#f1f5f9]"
      >
        <span class="material-symbols-outlined text-[15px]">swords</span>
        <span>Armas</span>
      </button>

      <button
        type="button"
        data-cat="armor"
        class="compendium-tab-btn px-3 py-1.5 rounded-lg text-xs font-headline font-bold flex items-center gap-1.5 shrink-0 text-[#94a3b8] hover:bg-[#18202e] hover:text-[#f1f5f9]"
      >
        <span class="material-symbols-outlined text-[15px]">shield</span>
        <span>Armaduras</span>
      </button>

      <button
        type="button"
        data-cat="magic-items"
        class="compendium-tab-btn px-3 py-1.5 rounded-lg text-xs font-headline font-bold flex items-center gap-1.5 shrink-0 text-[#94a3b8] hover:bg-[#18202e] hover:text-[#f1f5f9]"
      >
        <span class="material-symbols-outlined text-[15px]">auto_awesome</span>
        <span>Objetos Mágicos</span>
      </button>

      <button
        type="button"
        data-cat="feats"
        class="compendium-tab-btn px-3 py-1.5 rounded-lg text-xs font-headline font-bold flex items-center gap-1.5 shrink-0 text-[#94a3b8] hover:bg-[#18202e] hover:text-[#f1f5f9]"
      >
        <span class="material-symbols-outlined text-[15px]">psychology</span>
        <span>Dotes</span>
      </button>

      <button
        type="button"
        data-cat="classes"
        class="compendium-tab-btn px-3 py-1.5 rounded-lg text-xs font-headline font-bold flex items-center gap-1.5 shrink-0 text-[#94a3b8] hover:bg-[#18202e] hover:text-[#f1f5f9]"
      >
        <span class="material-symbols-outlined text-[15px]">badge</span>
        <span>Clases y Especies</span>
      </button>
    </div>

    <!-- Search & Filters Toolbar -->
    <div class="p-3 bg-[#141b27] border-b border-[#222f42] flex flex-wrap items-center gap-2.5 shrink-0">
      <div class="relative flex-1 min-w-[200px]">
        <span class="material-symbols-outlined absolute left-3 top-1/2 -translate-y-1/2 text-[18px] text-[#64748b]">search</span>
        <input
          type="text"
          id="compendium-search-input"
          placeholder="Buscar por nombre, traducción en español, descripción..."
          class="w-full pl-9 pr-8 py-2 rounded-xl bg-[#18202e] border border-[#222f42] text-xs text-[#f1f5f9] placeholder-[#64748b] focus:border-amber-500 focus:outline-none"
        />
        <button
          type="button"
          id="compendium-search-clear"
          class="hidden absolute right-2.5 top-1/2 -translate-y-1/2 text-[#64748b] hover:text-[#cbd5e1] text-xs"
        >
          <span class="material-symbols-outlined text-[16px]">close</span>
        </button>
      </div>

      <!-- Filters Row (Dynamic based on Category) -->
      <div class="flex items-center gap-2 flex-wrap text-xs" id="compendium-filter-container">
        <!-- Spells Level Filter -->
        <select
          id="compendium-spell-level"
          class="px-2.5 py-2 rounded-xl bg-[#18202e] border border-[#222f42] text-[#cbd5e1] text-xs focus:border-amber-500 focus:outline-none cursor-pointer"
        >
          <option value="">Todos los Niveles</option>
          <option value="0">Truco (Nvl 0)</option>
          <option value="1">Nivel 1</option>
          <option value="2">Nivel 2</option>
          <option value="3">Nivel 3</option>
          <option value="4">Nivel 4</option>
          <option value="5">Nivel 5</option>
          <option value="6">Nivel 6</option>
          <option value="7">Nivel 7</option>
          <option value="8">Nivel 8</option>
          <option value="9">Nivel 9</option>
        </select>

        <!-- Spells School Filter -->
        <select
          id="compendium-spell-school"
          class="px-2.5 py-2 rounded-xl bg-[#18202e] border border-[#222f42] text-[#cbd5e1] text-xs focus:border-amber-500 focus:outline-none cursor-pointer"
        >
          <option value="">Todas las Escuelas</option>
          <option value="Evocación">Evocación</option>
          <option value="Abjuración">Abjuración</option>
          <option value="Adivinación">Adivinación</option>
          <option value="Conjuración">Conjuración</option>
          <option value="Encantamiento">Encantamiento</option>
          <option value="Ilusión">Ilusión</option>
          <option value="Nigromancia">Nigromancia</option>
          <option value="Transmutación">Transmutación</option>
        </select>

        <!-- Weapons Type Filter -->
        <select
          id="compendium-weapon-type"
          class="hidden px-2.5 py-2 rounded-xl bg-[#18202e] border border-[#222f42] text-[#cbd5e1] text-xs focus:border-amber-500 focus:outline-none cursor-pointer"
        >
          <option value="">Todos los Tipos de Arma</option>
          <option value="Cuerpo a cuerpo">Cuerpo a cuerpo</option>
          <option value="A distancia">A distancia</option>
        </select>

        <!-- Magic Item Rarity Filter -->
        <select
          id="compendium-magic-rarity"
          class="hidden px-2.5 py-2 rounded-xl bg-[#18202e] border border-[#222f42] text-[#cbd5e1] text-xs focus:border-amber-500 focus:outline-none cursor-pointer"
        >
          <option value="">Todas las Rarezas</option>
          <option value="Común">Común</option>
          <option value="Poco Común">Poco Común</option>
          <option value="Rara">Rara</option>
          <option value="Muy Rara">Muy Rara</option>
          <option value="Legendaria">Legendaria</option>
        </select>
      </div>

      <!-- Total count indicator -->
      <div class="text-[11px] text-[#64748b] font-label ml-auto">
        <span id="compendium-results-count">0</span> resultados
      </div>
    </div>

    <!-- Body: Dual-Pane Layout -->
    <div class="flex-1 flex flex-col md:flex-row min-h-0 overflow-hidden">
      <!-- Left Column: Results List -->
      <div class="w-full md:w-5/12 border-b md:border-b-0 md:border-r border-[#222f42] flex flex-col min-h-0 bg-[#0f141d]">
        <div class="flex-1 overflow-y-auto p-2 space-y-1.5 divide-y divide-[#1e293b]/40" id="compendium-items-list">
          <!-- Rendered via JS -->
        </div>
      </div>

      <!-- Right Column: Detail Preview Card -->
      <div class="w-full md:w-7/12 flex flex-col min-h-0 bg-[#121721] overflow-hidden" id="compendium-detail-pane">
        <!-- Scrollable Detail Body -->
        <div class="flex-1 overflow-y-auto p-4 sm:p-6 space-y-4 text-xs font-label" id="compendium-detail-content">
          <div class="flex flex-col items-center justify-center h-full text-center py-16 text-[#64748b]">
            <span class="material-symbols-outlined text-4xl mb-2 text-amber-500/40">touch_app</span>
            <p class="font-bold text-sm text-[#94a3b8]">Selecciona un elemento de la lista</p>
            <p class="text-[11px] mt-1">Explora sus estadísticas oficiales, maestrías y reglas en detalle</p>
          </div>
        </div>

        <!-- Sticky Detail Action Footer -->
        <div class="p-3 sm:p-4 bg-[#18202e] border-t border-[#222f42] flex items-center justify-between gap-2 shrink-0 hidden" id="compendium-action-footer">
          <button
            type="button"
            id="compendium-edit-before-add-btn"
            class="px-3.5 py-2 rounded-xl bg-[#121721] border border-[#222f42] hover:border-amber-500/50 text-[#cbd5e1] hover:text-[#f1f5f9] text-xs font-bold transition-all flex items-center gap-1.5 cursor-pointer"
            title="Abre el formulario manual con los datos pre-rellenados para ajustarlos"
          >
            <span class="material-symbols-outlined text-[16px] text-amber-400">edit_note</span>
            <span>Editar antes de Guardar</span>
          </button>

          <button
            type="button"
            id="compendium-add-direct-btn"
            class="px-4 py-2 rounded-xl bg-gradient-to-r from-amber-600 to-amber-500 hover:brightness-110 active:scale-95 text-[#0a0d12] text-xs font-bold font-headline shadow-[0_0_15px_rgba(245,158,11,0.35)] transition-all flex items-center gap-1.5 cursor-pointer"
          >
            <span class="material-symbols-outlined text-[16px]">add_circle</span>
            <span id="compendium-add-btn-text">Añadir a mi Ficha</span>
          </button>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  import { dndApiService, type UnifiedSpell, type UnifiedEquipment, type UnifiedMagicItem, type UnifiedFeat, type UnifiedClass, type UnifiedSpecies } from '../../scripts/api/dndApiService';
  import { srdCacheManager, type SrdEdition } from '../../scripts/api/srdCacheManager';
  import { characterStore } from '../../scripts/state/characterStore';
  import { openModal, closeModal } from '../../scripts/animations/modalAnimations';

  const modal = document.getElementById('compendium-modal');
  const backdrop = document.getElementById('modal-backdrop');
  const closeBtn = document.getElementById('compendium-close-btn');
  const edition2024Btn = document.getElementById('compendium-edition-2024');
  const edition2014Btn = document.getElementById('compendium-edition-2014');
  const tabsContainer = document.getElementById('compendium-tabs');
  const searchInput = document.getElementById('compendium-search-input') as HTMLInputElement;
  const searchClear = document.getElementById('compendium-search-clear');
  const itemsList = document.getElementById('compendium-items-list');
  const detailContent = document.getElementById('compendium-detail-content');
  const actionFooter = document.getElementById('compendium-action-footer');
  const addDirectBtn = document.getElementById('compendium-add-direct-btn');
  const addBtnText = document.getElementById('compendium-add-btn-text');
  const editBeforeAddBtn = document.getElementById('compendium-edit-before-add-btn');
  const resultsCount = document.getElementById('compendium-results-count');
  const filterContainer = document.getElementById('compendium-filter-container');
  const spellLevelSel = document.getElementById('compendium-spell-level') as HTMLSelectElement;
  const spellSchoolSel = document.getElementById('compendium-spell-school') as HTMLSelectElement;
  const weaponTypeSel = document.getElementById('compendium-weapon-type') as HTMLSelectElement;
  const magicRaritySel = document.getElementById('compendium-magic-rarity') as HTMLSelectElement;
  const modalTitle = document.getElementById('compendium-modal-title');
  const modalSubtitle = document.getElementById('compendium-modal-subtitle');

  const SCOPE_CONFIG: Record<string, {
    allowedCategories: string[];
    defaultCategory: string;
    title: string;
    subtitle: string;
    placeholder: string;
  }> = {
    spells: {
      allowedCategories: ['spells'],
      defaultCategory: 'spells',
      title: 'Compendio de Hechizos y Conjuros',
      subtitle: 'Explora trucos y conjuros del SRD (2024 / 2014)',
      placeholder: 'Buscar conjuro por nombre, escuela o efecto...'
    },
    inventory: {
      allowedCategories: ['equipment', 'weapons', 'armor', 'magic-items'],
      defaultCategory: 'equipment',
      title: 'Compendio de Mochila y Equipo',
      subtitle: 'Pociones, equipo de viaje, armaduras, armas y objetos mágicos',
      placeholder: 'Buscar objeto, poción, armadura o equipo...'
    },
    weapons: {
      allowedCategories: ['weapons'],
      defaultCategory: 'weapons',
      title: 'Compendio de Armas de Combate',
      subtitle: 'Armas cuerpo a cuerpo, a distancia y maestrías (2024 / 2014)',
      placeholder: 'Buscar arma por nombre, tipo de daño o maestría...'
    },
    feats: {
      allowedCategories: ['feats'],
      defaultCategory: 'feats',
      title: 'Compendio de Dotes y Rasgos',
      subtitle: 'Habilidades especiales y dotes oficiales (2024 / 2014)',
      placeholder: 'Buscar dote o habilidad...'
    },
    classes: {
      allowedCategories: ['classes'],
      defaultCategory: 'classes',
      title: 'Compendio de Clases y Especies',
      subtitle: 'Arquetipos de personaje, dados de golpe y rasgos raciales',
      placeholder: 'Buscar clase o especie...'
    },
    all: {
      allowedCategories: ['spells', 'equipment', 'weapons', 'armor', 'magic-items', 'feats', 'classes'],
      defaultCategory: 'spells',
      title: 'Compendio Oficial D&D 5e',
      subtitle: 'Explora el SRD completo, filtra por edición y añade elementos a tu ficha',
      placeholder: 'Buscar por nombre, traducción en español, descripción...'
    }
  };

  let activeEdition: SrdEdition = '2024';
  let activeCategory = 'spells';
  let currentScope = 'all';
  let selectedItem: any = null;
  let currentResults: any[] = [];
  let targetModalOnSelect: string | null = null;

  // Initialize edition from active character or default
  function syncEditionWithCharacter() {
    const char = characterStore.get();
    if (char && char.rulesEdition) {
      activeEdition = char.rulesEdition;
    }
    updateEditionButtons();
  }

  function updateEditionButtons() {
    if (activeEdition === '2024') {
      edition2024Btn?.classList.add('bg-amber-500/20', 'text-amber-400', 'border', 'border-amber-500/40');
      edition2024Btn?.classList.remove('text-[#94a3b8]');
      edition2014Btn?.classList.remove('bg-amber-500/20', 'text-amber-400', 'border', 'border-amber-500/40');
      edition2014Btn?.classList.add('text-[#94a3b8]');
    } else {
      edition2014Btn?.classList.add('bg-amber-500/20', 'text-amber-400', 'border', 'border-amber-500/40');
      edition2014Btn?.classList.remove('text-[#94a3b8]');
      edition2024Btn?.classList.remove('bg-amber-500/20', 'text-amber-400', 'border', 'border-amber-500/40');
      edition2024Btn?.classList.add('text-[#94a3b8]');
    }
  }

  edition2024Btn?.addEventListener('click', () => {
    if (activeEdition !== '2024') {
      activeEdition = '2024';
      updateEditionButtons();
      loadActiveCategoryData();
    }
  });

  edition2014Btn?.addEventListener('click', () => {
    if (activeEdition !== '2014') {
      activeEdition = '2014';
      updateEditionButtons();
      loadActiveCategoryData();
    }
  });

  function updateFilterBarVisibility() {
    if (spellLevelSel) {
      if (activeCategory === 'spells') spellLevelSel.classList.remove('hidden');
      else spellLevelSel.classList.add('hidden');
    }
    if (spellSchoolSel) {
      if (activeCategory === 'spells') spellSchoolSel.classList.remove('hidden');
      else spellSchoolSel.classList.add('hidden');
    }
    if (weaponTypeSel) {
      if (activeCategory === 'weapons') weaponTypeSel.classList.remove('hidden');
      else weaponTypeSel.classList.add('hidden');
    }
    if (magicRaritySel) {
      if (activeCategory === 'magic-items') magicRaritySel.classList.remove('hidden');
      else magicRaritySel.classList.add('hidden');
    }

    if (filterContainer) {
      const hasVisibleFilters = activeCategory === 'spells' || activeCategory === 'weapons' || activeCategory === 'magic-items';
      if (hasVisibleFilters) filterContainer.classList.remove('hidden');
      else filterContainer.classList.add('hidden');
    }
  }

  // Tab switching
  tabsContainer?.addEventListener('click', (e) => {
    const btn = (e.target as HTMLElement).closest('.compendium-tab-btn') as HTMLElement;
    if (!btn) return;
    const cat = btn.getAttribute('data-cat');
    const config = SCOPE_CONFIG[currentScope] || SCOPE_CONFIG.all;
    if (!cat || cat === activeCategory || !config.allowedCategories.includes(cat)) return;

    activeCategory = cat;
    document.querySelectorAll('.compendium-tab-btn').forEach(b => {
      b.classList.remove('bg-amber-500/20', 'text-amber-300', 'border', 'border-amber-500/30');
      b.classList.add('text-[#94a3b8]');
    });
    btn.classList.add('bg-amber-500/20', 'text-amber-300', 'border', 'border-amber-500/30');
    btn.classList.remove('text-[#94a3b8]');

    updateFilterBarVisibility();

    selectedItem = null;
    hideDetailPane();
    loadActiveCategoryData();
  });

  // Search input listeners
  searchInput?.addEventListener('input', () => {
    if (searchInput.value) searchClear?.classList.remove('hidden');
    else searchClear?.classList.add('hidden');
    filterAndRenderResults();
  });

  searchClear?.addEventListener('click', () => {
    searchInput.value = '';
    searchClear.classList.add('hidden');
    filterAndRenderResults();
  });

  spellLevelSel?.addEventListener('change', filterAndRenderResults);
  spellSchoolSel?.addEventListener('change', filterAndRenderResults);
  weaponTypeSel?.addEventListener('change', filterAndRenderResults);
  magicRaritySel?.addEventListener('change', filterAndRenderResults);

  async function loadActiveCategoryData() {
    if (!itemsList) return;
    itemsList.innerHTML = `
      <div class="flex items-center justify-center p-8 text-amber-400 gap-2 text-xs">
        <span class="material-symbols-outlined animate-spin text-[18px]">progress_activity</span>
        <span>Cargando datos del SRD (${activeEdition})...</span>
      </div>
    `;

    try {
      if (activeCategory === 'spells') {
        currentResults = await dndApiService.searchSpells(activeEdition);
      } else if (activeCategory === 'equipment') {
        currentResults = await dndApiService.searchEquipment(activeEdition, { category: 'gear' });
      } else if (activeCategory === 'weapons') {
        currentResults = await dndApiService.searchEquipment(activeEdition, { category: 'weapon' });
      } else if (activeCategory === 'armor') {
        currentResults = await dndApiService.searchEquipment(activeEdition, { category: 'armor' });
      } else if (activeCategory === 'magic-items') {
        currentResults = await dndApiService.searchMagicItems(activeEdition);
      } else if (activeCategory === 'feats') {
        currentResults = await dndApiService.getFeats(activeEdition);
      } else if (activeCategory === 'classes') {
        const classes = await dndApiService.getClasses(activeEdition);
        const species = await dndApiService.getSpeciesOrRaces(activeEdition);
        currentResults = [...classes, ...species];
      }
    } catch (e) {
      console.error('Error fetching SRD category:', e);
      currentResults = [];
    }

    filterAndRenderResults();
  }

  function filterAndRenderResults() {
    if (!itemsList) return;
    const query = searchInput?.value.trim().toLowerCase() || '';
    const levelVal = spellLevelSel?.value !== '' ? parseInt(spellLevelSel.value) : undefined;
    const schoolVal = spellSchoolSel?.value || '';

    let filtered = currentResults;

    if (activeCategory === 'spells') {
      filtered = filtered.filter((sp: UnifiedSpell) => {
        if (levelVal !== undefined && sp.level !== levelVal) return false;
        if (schoolVal && sp.schoolEs !== schoolVal) return false;
        if (query) {
          const combined = `${sp.name} ${sp.nameEs} ${sp.school} ${sp.schoolEs} ${sp.description}`.toLowerCase();
          if (!combined.includes(query)) return false;
        }
        return true;
      });
    } else if (activeCategory === 'weapons') {
      const weaponTypeVal = weaponTypeSel?.value || '';
      filtered = filtered.filter((w: UnifiedEquipment) => {
        if (weaponTypeVal && w.attackType !== weaponTypeVal) return false;
        if (query) {
          const combined = `${w.name} ${w.nameEs} ${w.description || ''} ${w.mastery || ''} ${(w.properties || []).join(' ')}`.toLowerCase();
          if (!combined.includes(query)) return false;
        }
        return true;
      });
    } else if (activeCategory === 'magic-items') {
      const rarityVal = magicRaritySel?.value || '';
      filtered = filtered.filter((mi: UnifiedMagicItem) => {
        if (rarityVal && mi.rarityEs !== rarityVal) return false;
        if (query) {
          const combined = `${mi.name} ${mi.nameEs || ''} ${mi.description || ''} ${mi.rarity || ''} ${mi.rarityEs || ''}`.toLowerCase();
          if (!combined.includes(query)) return false;
        }
        return true;
      });
    } else {
      if (query) {
        filtered = filtered.filter(item => {
          const combined = `${item.name} ${item.nameEs || ''} ${item.description || ''} ${item.rarity || ''}`.toLowerCase();
          return combined.includes(query);
        });
      }
    }

    if (resultsCount) resultsCount.textContent = String(filtered.length);

    if (filtered.length === 0) {
      itemsList.innerHTML = `
        <div class="p-8 text-center text-[#64748b] text-xs">
          <span class="material-symbols-outlined text-3xl mb-1 text-[#475569]">search_off</span>
          <p>No se encontraron elementos coincidentes.</p>
          <p class="text-[10px] mt-1 text-[#94a3b8]">¿Es un objeto personalizado? Puedes añadirlo manualmente.</p>
        </div>
      `;
      return;
    }

    itemsList.innerHTML = filtered.map((item, index) => {
      const isSelected = selectedItem && (selectedItem.index === item.index || selectedItem.name === item.name);
      return renderItemRow(item, index, isSelected);
    }).join('');

    // Attach row click handlers
    itemsList.querySelectorAll('[data-item-idx]').forEach(el => {
      el.addEventListener('click', () => {
        const idx = parseInt(el.getAttribute('data-item-idx') || '0');
        const item = filtered[idx];
        if (item) selectItem(item);
      });
    });
  }

  function renderItemRow(item: any, idx: number, isSelected: boolean): string {
    const activeClass = isSelected
      ? 'bg-amber-500/15 border-amber-500/50 shadow-sm'
      : 'bg-[#141b27]/60 hover:bg-[#18202e] border-transparent hover:border-[#222f42]';

    let badges = '';
    let subtitle = '';

    if (activeCategory === 'spells') {
      const lvlText = item.level === 0 ? 'Truco' : `Nvl ${item.level}`;
      badges = `
        <span class="text-[9px] px-1.5 py-0.5 rounded bg-amber-500/10 text-amber-400 border border-amber-500/30 font-bold">${lvlText}</span>
        <span class="text-[9px] px-1.5 py-0.5 rounded bg-[#1e293b] text-[#94a3b8]">${item.schoolEs}</span>
      `;
      subtitle = `${item.castingTimeEs} • ${item.range}`;
    } else if (activeCategory === 'weapons') {
      badges = `
        <span class="text-[9px] px-1.5 py-0.5 rounded bg-rose-500/10 text-rose-400 border border-rose-500/30 font-bold">${item.damageDice || 'Arma'}</span>
        ${item.mastery ? `<span class="text-[9px] px-1.5 py-0.5 rounded bg-amber-500/10 text-amber-300 border border-amber-500/30">🎯 ${item.mastery}</span>` : ''}
      `;
      subtitle = `${item.attackType || 'Cuerpo a cuerpo'} • ${item.cost || 'Común'}`;
    } else if (activeCategory === 'armor') {
      badges = `
        <span class="text-[9px] px-1.5 py-0.5 rounded bg-sky-500/10 text-sky-400 border border-sky-500/30 font-bold">${item.armorClass || 'Armadura'}</span>
      `;
      subtitle = `${item.cost || ''} • ${item.weight ? `${item.weight} lb` : ''}`;
    } else if (activeCategory === 'magic-items') {
      badges = `
        <span class="text-[9px] px-1.5 py-0.5 rounded bg-purple-500/10 text-purple-400 border border-purple-500/30 font-bold">${item.rarityEs || 'Mágico'}</span>
      `;
      subtitle = item.category || 'Objeto';
    } else {
      subtitle = item.equipmentType || item.prerequisites || '';
    }

    const displayName = item.nameEs && item.nameEs !== item.name ? `${item.nameEs}` : item.name;
    const originalSub = item.nameEs && item.nameEs !== item.name ? `<span class="text-[10px] text-[#64748b]">(${item.name})</span>` : '';

    return `
      <div
        data-item-idx="${idx}"
        class="p-2.5 rounded-xl border transition-all cursor-pointer flex items-center justify-between gap-2.5 ${activeClass}"
      >
        <div class="min-w-0 flex-1">
          <div class="flex items-center gap-1.5 flex-wrap">
            <span class="font-headline font-bold text-xs text-[#f1f5f9] truncate">${displayName}</span>
            ${originalSub}
          </div>
          <div class="text-[10px] text-[#94a3b8] mt-0.5 truncate">${subtitle}</div>
        </div>
        <div class="flex items-center gap-1 shrink-0">
          ${badges}
        </div>
      </div>
    `;
  }

  function selectItem(item: any) {
    selectedItem = item;
    // Highlight in list
    filterAndRenderResults();
    renderDetailPane(item);
  }

  function hideDetailPane() {
    if (detailContent) {
      detailContent.innerHTML = `
        <div class="flex flex-col items-center justify-center h-full text-center py-16 text-[#64748b]">
          <span class="material-symbols-outlined text-4xl mb-2 text-amber-500/40">touch_app</span>
          <p class="font-bold text-sm text-[#94a3b8]">Selecciona un elemento de la lista</p>
          <p class="text-[11px] mt-1">Explora sus estadísticas oficiales, maestrías y reglas en detalle</p>
        </div>
      `;
    }
    actionFooter?.classList.add('hidden');
  }

  function renderDetailPane(item: any) {
    if (!detailContent) return;
    actionFooter?.classList.remove('hidden');

    let metaHtml = '';
    let mainBadge = '';

    if (activeCategory === 'spells') {
      const sp = item as UnifiedSpell;
      mainBadge = sp.level === 0 ? 'Truco Mágico' : `Conjuro de Nivel ${sp.level}`;
      if (addBtnText) addBtnText.textContent = 'Añadir al Grimorio';

      metaHtml = `
        <div class="grid grid-cols-2 sm:grid-cols-4 gap-2 p-3 rounded-xl bg-[#10141d] border border-[#222f42] text-xs">
          <div><span class="text-[#64748b] block text-[10px]">Tiempo:</span><span class="font-bold text-[#f1f5f9]">${sp.castingTimeEs}</span></div>
          <div><span class="text-[#64748b] block text-[10px]">Alcance:</span><span class="font-bold text-[#f1f5f9]">${sp.range}</span></div>
          <div><span class="text-[#64748b] block text-[10px]">Duración:</span><span class="font-bold text-[#f1f5f9]">${sp.duration}</span></div>
          <div><span class="text-[#64748b] block text-[10px]">Componentes:</span><span class="font-bold text-[#f1f5f9]">${sp.components}</span></div>
        </div>

        ${sp.damageDice ? `
          <div class="p-3 rounded-xl bg-amber-500/10 border border-amber-500/30 flex items-center justify-between">
            <span class="text-xs text-amber-300 font-bold flex items-center gap-1.5">
              <span class="material-symbols-outlined text-[16px]">flare</span>
              <span>Daño Base (${sp.damageTypeEs || 'Mágico'})</span>
            </span>
            <span class="font-headline font-bold text-base text-amber-400">${sp.damageDice}</span>
          </div>
        ` : ''}

        ${sp.material ? `
          <div class="text-[11px] text-[#94a3b8] italic bg-[#10141d] p-2 rounded-lg border border-[#222f42]/60">
            <strong>Material:</strong> ${sp.material}
          </div>
        ` : ''}
      `;
    } else if (activeCategory === 'weapons') {
      const eq = item as UnifiedEquipment;
      mainBadge = eq.attackType || 'Arma';
      if (addBtnText) addBtnText.textContent = 'Añadir a mis Armas';

      metaHtml = `
        <div class="grid grid-cols-2 sm:grid-cols-4 gap-2 p-3 rounded-xl bg-[#10141d] border border-[#222f42] text-xs">
          <div><span class="text-[#64748b] block text-[10px]">Daño:</span><span class="font-bold text-rose-400">${eq.damageDice} ${eq.damageTypeEs || ''}</span></div>
          <div><span class="text-[#64748b] block text-[10px]">Coste:</span><span class="font-bold text-[#f1f5f9]">${eq.cost || '—'}</span></div>
          <div><span class="text-[#64748b] block text-[10px]">Peso:</span><span class="font-bold text-[#f1f5f9]">${eq.weight ? `${eq.weight} lb` : '—'}</span></div>
          <div><span class="text-[#64748b] block text-[10px]">Propiedades:</span><span class="font-bold text-[#cbd5e1]">${(eq.properties || []).join(', ') || 'Ninguna'}</span></div>
        </div>

        ${eq.mastery ? `
          <div class="p-3 rounded-xl bg-amber-500/10 border border-amber-500/40 space-y-1">
            <div class="flex items-center gap-1.5 text-amber-400 font-bold text-xs">
              <span class="material-symbols-outlined text-[16px]">military_tech</span>
              <span>Maestría de Armas 2024: ${eq.mastery}</span>
            </div>
            <p class="text-[11px] text-[#cbd5e1] leading-relaxed">${eq.masteryDesc}</p>
          </div>
        ` : ''}
      `;
    } else if (activeCategory === 'magic-items') {
      const mi = item as UnifiedMagicItem;
      mainBadge = mi.rarityEs;
      if (addBtnText) addBtnText.textContent = 'Añadir a la Mochila';

      metaHtml = `
        <div class="flex items-center gap-2">
          <span class="text-xs px-2.5 py-1 rounded-lg bg-purple-500/20 text-purple-300 border border-purple-500/40 font-bold">
            ${mi.rarityEs}
          </span>
          ${mi.attunement ? `
            <span class="text-xs px-2.5 py-1 rounded-lg bg-amber-500/20 text-amber-300 border border-amber-500/40 font-bold">
              Requiere Sintonización
            </span>
          ` : ''}
        </div>
      `;
    } else {
      if (addBtnText) addBtnText.textContent = 'Añadir a la Ficha';
    }

    const titleEs = item.nameEs && item.nameEs !== item.name ? item.nameEs : item.name;
    const titleEn = item.nameEs && item.nameEs !== item.name ? `<span class="text-xs text-[#94a3b8] font-normal">(${item.name})</span>` : '';

    detailContent.innerHTML = `
      <div class="space-y-4">
        <!-- Title & Badges -->
        <div class="border-b border-[#222f42] pb-3">
          <div class="flex items-center gap-2 mb-1">
            <span class="text-[10px] px-2 py-0.5 rounded bg-amber-500/20 text-amber-400 font-bold uppercase tracking-wider">${activeEdition} SRD</span>
            <span class="text-[10px] text-[#64748b] uppercase tracking-wider">• ${mainBadge}</span>
          </div>
          <h2 class="font-headline font-bold text-xl text-[#f1f5f9] flex items-baseline gap-2">
            <span>${titleEs}</span>
            ${titleEn}
          </h2>
        </div>

        <!-- Meta Grid -->
        ${metaHtml}

        <!-- Description -->
        <div class="space-y-2">
          <h4 class="text-xs font-bold text-amber-400 uppercase tracking-wider">Descripción y Reglas</h4>
          <div class="p-3.5 rounded-xl bg-[#10141d] border border-[#222f42] text-xs text-[#cbd5e1] leading-relaxed whitespace-pre-line space-y-2">
            ${item.description || 'Sin descripción adicional registrada en el SRD.'}
          </div>
        </div>

        ${item.higherLevel ? `
          <div class="space-y-1 p-3 rounded-xl bg-[#141b27] border border-[#222f42]">
            <h5 class="text-[11px] font-bold text-amber-300 uppercase tracking-wider">A niveles superiores:</h5>
            <p class="text-xs text-[#94a3b8]">${item.higherLevel}</p>
          </div>
        ` : ''}
      </div>
    `;
  }

  // Action Button: Direct Add to Sheet
  addDirectBtn?.addEventListener('click', () => {
    if (!selectedItem) return;

    if (activeCategory === 'spells') {
      const payload = dndApiService.toSpellPayload(selectedItem);
      characterStore.addSpell(payload);
      showToast(`✓ Conjuro "${selectedItem.nameEs || selectedItem.name}" añadido al Grimorio`);
    } else if (activeCategory === 'weapons') {
      if (currentScope === 'inventory' || targetModalOnSelect === 'add-item') {
        const payload = dndApiService.toInventoryPayload(selectedItem);
        characterStore.addInventoryItem(payload as any);
        showToast(`✓ "${selectedItem.nameEs || selectedItem.name}" añadido a tu Mochila`);
      } else {
        const payload = dndApiService.toAttackPayload(selectedItem);
        characterStore.addAction(payload);
        showToast(`✓ Arma "${selectedItem.nameEs || selectedItem.name}" añadida a tus Acciones`);
      }
    } else if (activeCategory === 'equipment' || activeCategory === 'armor' || activeCategory === 'magic-items') {
      const payload = dndApiService.toInventoryPayload(selectedItem);
      characterStore.addInventoryItem(payload as any);
      showToast(`✓ "${selectedItem.nameEs || selectedItem.name}" añadido a tu Mochila`);
    } else if (activeCategory === 'feats') {
      characterStore.addFeature({
        title: selectedItem.name,
        description: selectedItem.description,
        enabled: true
      });
      showToast(`✓ Dote "${selectedItem.name}" añadida a tus Rasgos`);
    }

    if (modal && backdrop) closeModal(modal, backdrop);
  });

  // Action Button: Edit before Add (pre-fills the corresponding manual modal)
  editBeforeAddBtn?.addEventListener('click', () => {
    if (!selectedItem) return;
    if (modal && backdrop) closeModal(modal, backdrop);

    if (activeCategory === 'spells') {
      const payload = dndApiService.toSpellPayload(selectedItem);
      window.dispatchEvent(new CustomEvent('open-add-spell-modal', { detail: { prefill: payload } }));
    } else if (activeCategory === 'weapons') {
      if (currentScope === 'inventory' || targetModalOnSelect === 'add-item') {
        const payload = dndApiService.toInventoryPayload(selectedItem);
        window.dispatchEvent(new CustomEvent('open-add-item-modal', { detail: { prefill: payload } }));
      } else {
        const payload = dndApiService.toAttackPayload(selectedItem);
        window.dispatchEvent(new CustomEvent('open-add-weapon-modal', { detail: { prefill: payload } }));
      }
    } else if (activeCategory === 'equipment' || activeCategory === 'armor' || activeCategory === 'magic-items') {
      const payload = dndApiService.toInventoryPayload(selectedItem);
      window.dispatchEvent(new CustomEvent('open-add-item-modal', { detail: { prefill: payload } }));
    }
  });

  // Toast notification helper
  function showToast(msg: string) {
    const toast = document.createElement('div');
    toast.className = 'fixed bottom-6 right-6 z-50 bg-[#121721] border border-amber-500/40 text-amber-300 font-headline font-bold text-xs px-4 py-3 rounded-xl shadow-[0_10px_30px_rgba(0,0,0,0.8)] flex items-center gap-2 transform translate-y-2 opacity-0 transition-all duration-300';
    toast.innerHTML = `<span class="material-symbols-outlined text-[18px] text-amber-400">check_circle</span><span>${msg}</span>`;
    document.body.appendChild(toast);
    requestAnimationFrame(() => {
      toast.classList.remove('translate-y-2', 'opacity-0');
    });
    setTimeout(() => {
      toast.classList.add('translate-y-2', 'opacity-0');
      setTimeout(() => toast.remove(), 300);
    }, 3200);
  }

  // Open & Close Listeners
  window.addEventListener('open-compendium-modal', ((e: CustomEvent) => {
    syncEditionWithCharacter();
    const reqScope = e.detail?.scope || (e.detail?.category === 'spells' ? 'spells' :
                     e.detail?.category === 'weapons' ? 'weapons' :
                     (e.detail?.category === 'equipment' || e.detail?.category === 'magic-items' || e.detail?.category === 'armor') ? 'inventory' :
                     e.detail?.category === 'feats' ? 'feats' :
                     e.detail?.category === 'classes' ? 'classes' : 'all');

    currentScope = reqScope;
    targetModalOnSelect = e.detail?.targetModal || null;

    const config = SCOPE_CONFIG[reqScope] || SCOPE_CONFIG.all;
    if (modalTitle) modalTitle.textContent = config.title;
    if (modalSubtitle) modalSubtitle.textContent = config.subtitle;
    if (searchInput) searchInput.placeholder = config.placeholder;

    // Filter which category tabs are visible
    const tabButtons = tabsContainer?.querySelectorAll<HTMLElement>('.compendium-tab-btn');
    tabButtons?.forEach(btn => {
      const cat = btn.getAttribute('data-cat');
      if (cat && config.allowedCategories.includes(cat)) {
        btn.classList.remove('hidden');
      } else {
        btn.classList.add('hidden');
      }
    });

    // If only 1 category is allowed (e.g. only spells), hide the tab bar completely!
    if (config.allowedCategories.length <= 1) {
      tabsContainer?.classList.add('hidden');
    } else {
      tabsContainer?.classList.remove('hidden');
    }

    // Set active category
    if (e.detail?.category && config.allowedCategories.includes(e.detail.category)) {
      activeCategory = e.detail.category;
    } else {
      activeCategory = config.defaultCategory;
    }

    // Highlight active tab
    tabButtons?.forEach(b => {
      const cat = b.getAttribute('data-cat');
      if (cat === activeCategory) {
        b.classList.add('bg-amber-500/20', 'text-amber-300', 'border', 'border-amber-500/30');
        b.classList.remove('text-[#94a3b8]');
      } else {
        b.classList.remove('bg-amber-500/20', 'text-amber-300', 'border', 'border-amber-500/30');
        b.classList.add('text-[#94a3b8]');
      }
    });

    updateFilterBarVisibility();

    if (e.detail?.query && searchInput) {
      searchInput.value = e.detail.query;
      searchClear?.classList.remove('hidden');
    } else if (searchInput) {
      searchInput.value = '';
      searchClear?.classList.add('hidden');
    }

    hideDetailPane();
    loadActiveCategoryData();

    if (modal && backdrop) openModal(modal, backdrop);
  }) as EventListener);

  closeBtn?.addEventListener('click', () => {
    if (modal && backdrop) closeModal(modal, backdrop);
  });
</script>
