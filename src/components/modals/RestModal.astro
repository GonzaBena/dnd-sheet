---
// src/components/modals/RestModal.astro
---

<div id="rest-modal" class="hidden fixed inset-0 z-50 flex items-center justify-center p-4">
  <div class="modal-content w-full max-w-sm sm:max-w-md rounded-2xl bg-[#121721] border border-amber-500/40 shadow-[0_20px_60px_rgba(0,0,0,0.95)] overflow-hidden flex flex-col">
    <!-- Header -->
    <div class="p-4 bg-amber-500/10 border-b border-[#222f42] flex items-center justify-between">
      <div class="flex items-center gap-2.5">
        <div class="w-8 h-8 rounded-lg bg-amber-500/20 text-amber-400 flex items-center justify-center border border-amber-500/30">
          <span class="material-symbols-outlined text-[20px]">bedtime</span>
        </div>
        <div>
          <h3 class="font-headline font-bold text-base text-[#f1f5f9]">Tomar un Descanso</h3>
          <span class="text-[10px] text-amber-400/90">Elige el tipo de descanso para tu personaje</span>
        </div>
      </div>
      <button
        type="button"
        id="rest-modal-close-x"
        class="w-7 h-7 rounded-lg bg-[#10141d] border border-[#222f42] hover:border-amber-500/50 text-[#94a3b8] hover:text-white flex items-center justify-center text-xs transition-colors cursor-pointer"
        aria-label="Cerrar modal"
      >
        <span class="material-symbols-outlined text-[16px]">close</span>
      </button>
    </div>

    <!-- Body / Options -->
    <div class="p-5 space-y-3.5">
      <!-- Option 1: Descanso Corto -->
      <div class="p-4 rounded-xl bg-[#18202e] border border-[#222f42] hover:border-amber-500/40 transition-colors flex flex-col gap-2.5">
        <div class="flex items-start justify-between gap-3">
          <div class="flex items-center gap-2.5">
            <span class="material-symbols-outlined text-amber-400 text-[20px]">hourglass_bottom</span>
            <div>
              <h4 class="font-headline font-bold text-sm text-[#f1f5f9]">Descanso Corto (1 hora)</h4>
              <p class="text-[11px] text-[#94a3b8] leading-tight">Gasta 1 Dado de Golpe para curar puntos de golpe.</p>
            </div>
          </div>
          <span id="rest-modal-hitdice-badge" class="px-2 py-0.5 rounded bg-[#10141d] text-amber-300 font-bold text-[10px] border border-amber-500/30 shrink-0">
            0/0 d8
          </span>
        </div>
        <button
          type="button"
          id="rest-modal-short-btn"
          class="w-full py-2 rounded-lg bg-[#10141d] hover:bg-amber-500/20 text-amber-300 hover:text-amber-200 border border-amber-500/30 font-bold text-xs transition-all active:scale-95 cursor-pointer flex items-center justify-center gap-1.5"
        >
          <span class="material-symbols-outlined text-[15px]">vital_signs</span>
          <span>Realizar Descanso Corto</span>
        </button>
      </div>

      <!-- Option 2: Descanso Largo -->
      <div class="p-4 rounded-xl bg-[#18202e] border border-[#222f42] hover:border-amber-500/40 transition-colors flex flex-col gap-2.5">
        <div class="flex items-start justify-between gap-3">
          <div class="flex items-center gap-2.5">
            <span class="material-symbols-outlined text-amber-400 text-[20px]">hotel</span>
            <div>
              <h4 class="font-headline font-bold text-sm text-[#f1f5f9]">Descanso Largo (8 horas)</h4>
              <p class="text-[11px] text-[#94a3b8] leading-tight">Restaura PG al 100%, espacios de conjuro y dados de golpe.</p>
            </div>
          </div>
          <span class="px-2 py-0.5 rounded bg-emerald-500/10 text-emerald-300 font-bold text-[10px] border border-emerald-500/30 shrink-0">
            100% PG
          </span>
        </div>
        <button
          type="button"
          id="rest-modal-long-btn"
          class="w-full py-2 rounded-lg bg-gradient-to-r from-amber-600 to-amber-500 text-[#0a0d12] hover:brightness-110 font-bold text-xs transition-all active:scale-95 shadow-[0_0_12px_rgba(245,158,11,0.25)] cursor-pointer flex items-center justify-center gap-1.5"
        >
          <span class="material-symbols-outlined text-[15px]">bedtime</span>
          <span>Completar Descanso Largo</span>
        </button>
      </div>
    </div>

    <!-- Footer with clear CANCEL button -->
    <div class="p-4 bg-[#18202e] border-t border-[#222f42] flex items-center justify-end">
      <button
        type="button"
        id="rest-modal-cancel-btn"
        class="px-5 py-2 rounded-xl bg-[#121721] border border-[#222f42] text-[#94a3b8] hover:text-[#f1f5f9] hover:border-slate-600 cursor-pointer text-xs font-medium transition-colors"
      >
        Cancelar (No descansar)
      </button>
    </div>
  </div>
</div>

<script>
  import { showAlert } from '../../scripts/ui/notify';
  import { openModal, closeModal } from '../../scripts/animations/modalAnimations';
  import { characterStore } from '../../scripts/state/characterStore';

  const modal = document.getElementById('rest-modal');
  const backdrop = document.getElementById('modal-backdrop');
  const closeX = document.getElementById('rest-modal-close-x');
  const cancelBtn = document.getElementById('rest-modal-cancel-btn');
  const shortBtn = document.getElementById('rest-modal-short-btn');
  const longBtn = document.getElementById('rest-modal-long-btn');
  const hitDiceBadge = document.getElementById('rest-modal-hitdice-badge');

  function updateBadge() {
    const char = characterStore.get();
    if (hitDiceBadge && char?.hitDice) {
      hitDiceBadge.textContent = `${char.hitDice.remaining}/${char.hitDice.total} ${char.hitDice.die}`;
    }
  }

  function hideModal() {
    if (modal && backdrop) {
      closeModal(modal, backdrop);
    }
  }

  closeX?.addEventListener('click', hideModal);
  cancelBtn?.addEventListener('click', hideModal);

  // Short rest handler
  shortBtn?.addEventListener('click', () => {
    const char = characterStore.get();
    if (char.hitDice.remaining <= 0) {
      showAlert('No te quedan Dados de Golpe disponibles para gastar. Necesitas un Descanso Largo.', { kind: 'warning' });
      return;
    }
    const res = characterStore.shortRest(1);
    showAlert(`¡Descanso Corto completado! Has gastado 1 Dado de Golpe y recuperado +${res.healed} PG.`, { kind: 'success', title: 'Descanso corto' });
    hideModal();
  });

  // Long rest handler
  longBtn?.addEventListener('click', () => {
    characterStore.longRest();
    showAlert(`¡Descanso Largo completado! Tus PG están al 100% (${characterStore.get().hp.max}/${characterStore.get().hp.max}) y todos los recursos restaurados.`, { kind: 'success', title: 'Descanso largo' });
    hideModal();
  });

  // Listen to open event
  window.addEventListener('open-rest-modal', () => {
    updateBadge();
    if (modal && backdrop) {
      openModal(modal, backdrop);
    }
  });
</script>
