---
// src/components/modals/SyncConfigModal.astro
---

<div id="sync-config-modal" class="hidden fixed inset-0 z-50 flex items-center justify-center p-3 sm:p-4">
  <div class="modal-content w-full max-w-lg rounded-2xl bg-[#121721] border border-[#222f42] shadow-[0_15px_50px_rgba(0,0,0,0.9)] overflow-hidden flex flex-col max-h-[92vh]">
    <!-- Header -->
    <div class="p-4 bg-[#18202e] border-b border-[#222f42] flex items-center justify-between shrink-0">
      <div class="flex items-center gap-2">
        <div class="w-8 h-8 rounded-lg bg-cyan-500/20 text-cyan-400 flex items-center justify-center border border-cyan-500/30">
          <span class="material-symbols-outlined text-[20px]">sync</span>
        </div>
        <div>
          <h3 class="font-headline font-bold text-base text-[#f1f5f9]">Sincronizar Campaña y Personaje</h3>
          <span class="text-[10px] text-[#94a3b8]">Firebase Firestore multi-dispositivo y multi-jugador</span>
        </div>
      </div>
      <button id="sync-modal-close-btn" class="w-7 h-7 rounded-lg bg-[#10141d] border border-[#222f42] hover:border-rose-500/50 text-[#94a3b8] hover:text-rose-400 flex items-center justify-center text-xs transition-colors cursor-pointer" aria-label="Cerrar modal">
        <span class="material-symbols-outlined text-[16px]">close</span>
      </button>
    </div>

    <!-- Body -->
    <div class="p-4 sm:p-5 space-y-4 text-xs font-label overflow-y-auto flex-1">
      <!-- Live Status Banner -->
      <div id="sync-status-box" class="p-3 rounded-xl border flex items-center gap-2.5 text-xs bg-[#18202e] border-[#222f42] text-[#94a3b8]">
        <span id="sync-status-dot" class="w-2.5 h-2.5 rounded-full bg-slate-500 shrink-0"></span>
        <div class="flex-1">
          <div class="font-bold text-[#f1f5f9]" id="sync-status-title">Estado: Desconectado</div>
          <div class="text-[10px] text-[#94a3b8]" id="sync-status-desc">Introduce tus datos de Firebase para sincronizar en vivo.</div>
        </div>
      </div>

      <!-- Collision Alert Box (Hidden by default) -->
      <div id="sync-collision-dialog" class="hidden p-4 rounded-xl bg-amber-500/10 border border-amber-500/40 text-amber-200 space-y-3">
        <div class="flex items-start gap-2.5">
          <span class="material-symbols-outlined text-amber-400 text-[20px] shrink-0 mt-0.5">warning</span>
          <div>
            <h4 class="font-bold text-sm text-amber-300">¡Ficha existente detectada en la nube!</h4>
            <p class="text-[11px] text-[#cbd5e1] mt-1 leading-relaxed">
              Ya existe un personaje guardado llamado <strong id="collision-char-name" class="text-amber-200"></strong> con el identificador <code id="collision-char-id" class="text-cyan-300 font-mono"></code> en esta campaña.
            </p>
          </div>
        </div>

        <div class="pt-2 border-t border-amber-500/20 flex flex-col sm:flex-row gap-2">
          <button
            type="button"
            id="collision-btn-pull"
            class="flex-1 p-2 rounded-lg bg-cyan-600 hover:bg-cyan-500 text-white font-bold text-xs flex items-center justify-center gap-1.5 transition-colors cursor-pointer"
          >
            <span class="material-symbols-outlined text-[15px]">cloud_download</span>
            <span>Descargar ficha existente</span>
          </button>
          <button
            type="button"
            id="collision-btn-new-id"
            class="flex-1 p-2 rounded-lg bg-[#18202e] hover:bg-[#222f42] border border-[#222f42] text-[#f1f5f9] font-bold text-xs flex items-center justify-center gap-1.5 transition-colors cursor-pointer"
          >
            <span class="material-symbols-outlined text-[15px]">casino</span>
            <span>Generar nuevo ID</span>
          </button>
          <button
            type="button"
            id="collision-btn-cancel"
            class="p-2 rounded-lg bg-[#10141d] text-[#94a3b8] hover:text-[#f1f5f9] text-xs transition-colors cursor-pointer"
          >
            Cancelar
          </button>
        </div>
      </div>

      <!-- Sync Active Toggle -->
      <div class="flex items-center justify-between p-3 rounded-xl bg-[#18202e] border border-[#222f42]">
        <div>
          <span class="font-bold text-[#f1f5f9] block">Activar Sincronización en Nube</span>
          <span class="text-[10px] text-[#94a3b8]">Guarda cambios en tiempo real en Firestore</span>
        </div>
        <label class="relative inline-flex items-center cursor-pointer">
          <input type="checkbox" id="sync-enabled-toggle" class="sr-only peer" />
          <div class="w-11 h-6 bg-[#10141d] peer-focus:outline-none rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-gray-300 after:border after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:bg-cyan-500"></div>
        </label>
      </div>

      <!-- Campaign / Room Code -->
      <div>
        <label class="text-[#94a3b8] block mb-1">Identificador de Campaña / Sala (Room Code)</label>
        <input
          type="text"
          id="sync-campaign-id"
          placeholder="ej: strahd-sesion-15"
          class="w-full p-2.5 rounded-lg bg-[#18202e] border border-[#222f42] text-[#f1f5f9] focus:border-cyan-500 focus:outline-none font-mono"
        />
        <span class="text-[10px] text-[#64748b] mt-1 block">Sala común compartida con tu mesa de juego y Director de Juego.</span>
      </div>

      <!-- Character ID & Generator -->
      <div>
        <div class="flex items-center justify-between mb-1">
          <label class="text-[#94a3b8]">Identificador de tu Personaje (Character ID)</label>
          <span class="text-[10px] text-cyan-400 font-mono">Único por jugador</span>
        </div>
        <div class="flex items-center gap-1.5">
          <input
            type="text"
            id="sync-character-id"
            placeholder="ej: elysian-8k2p"
            class="flex-1 p-2.5 rounded-lg bg-[#18202e] border border-[#222f42] text-[#f1f5f9] focus:border-cyan-500 focus:outline-none font-mono"
          />
          <button
            type="button"
            id="sync-regen-char-btn"
            title="Generar nuevo identificador aleatorio"
            class="p-2.5 rounded-lg bg-[#18202e] border border-[#222f42] hover:border-cyan-500/50 text-[#94a3b8] hover:text-cyan-400 transition-colors cursor-pointer flex items-center justify-center shrink-0"
          >
            <span class="material-symbols-outlined text-[16px]">casino</span>
          </button>
          <button
            type="button"
            id="sync-copy-char-btn"
            title="Copiar ID de personaje"
            class="p-2.5 rounded-lg bg-[#18202e] border border-[#222f42] hover:border-cyan-500/50 text-[#94a3b8] hover:text-cyan-400 transition-colors cursor-pointer flex items-center justify-center shrink-0"
          >
            <span class="material-symbols-outlined text-[16px]">content_copy</span>
          </button>
        </div>
        <span class="text-[10px] text-[#64748b] mt-1 block">Cada jugador debe tener un ID distinto para que sus fichas no colisionen.</span>
      </div>

      <!-- Character PIN Protection (Optional) -->
      <div>
        <label class="text-[#94a3b8] block mb-1">PIN de Seguridad de Ficha (Opcional, 4-6 dígitos)</label>
        <input
          type="password"
          id="sync-pin"
          placeholder="ej: 1234"
          maxlength="6"
          class="w-full p-2.5 rounded-lg bg-[#18202e] border border-[#222f42] text-[#f1f5f9] focus:border-cyan-500 focus:outline-none font-mono tracking-widest"
        />
        <span class="text-[10px] text-[#64748b] mt-1 block">Protege tu ficha para que nadie en la mesa pueda vincularse ni modificarla sin tu PIN.</span>
      </div>

      <!-- Quick Share URL for Mobile -->
      <div class="p-3 rounded-xl bg-[#18202e]/60 border border-[#222f42] flex items-center justify-between gap-3">
        <div>
          <span class="text-[#f1f5f9] font-bold block text-[11px] flex items-center gap-1">
            <span class="material-symbols-outlined text-[15px] text-cyan-400">phonelink</span>
            <span>Vincular con Móvil / Tablet</span>
          </span>
          <span class="text-[10px] text-[#94a3b8]">Copia un enlace para abrirlo en tu móvil y sincronizar al instante sin teclear.</span>
        </div>
        <button
          type="button"
          id="sync-share-url-btn"
          class="px-3 py-1.5 rounded-lg bg-[#18202e] hover:bg-cyan-500/20 border border-cyan-500/40 hover:border-cyan-400 text-cyan-300 text-xs font-bold transition-all cursor-pointer flex items-center gap-1 shrink-0"
        >
          <span class="material-symbols-outlined text-[14px]">share</span>
          <span>Copiar Enlace</span>
        </button>
      </div>

      <!-- Cloud Manual Actions -->
      <div class="pt-2 border-t border-[#222f42] space-y-2">
        <label class="text-[#94a3b8] block text-[10px] uppercase font-bold tracking-wider">Acciones Manuales con la Nube</label>
        <div class="grid grid-cols-2 gap-2">
          <button
            type="button"
            id="sync-push-now-btn"
            class="p-2.5 rounded-xl bg-[#18202e] hover:bg-[#222f42] border border-[#222f42] hover:border-amber-500/50 text-[#f1f5f9] flex items-center justify-center gap-1.5 transition-all cursor-pointer font-bold active:scale-95 text-[11px]"
            title="Sube y sobrescribe en Firebase el personaje de este dispositivo"
          >
            <span class="material-symbols-outlined text-[16px] text-amber-400">cloud_upload</span>
            <span>Subir a Nube</span>
          </button>

          <button
            type="button"
            id="sync-pull-now-btn"
            class="p-2.5 rounded-xl bg-[#18202e] hover:bg-[#222f42] border border-[#222f42] hover:border-cyan-500/50 text-[#f1f5f9] flex items-center justify-center gap-1.5 transition-all cursor-pointer font-bold active:scale-95 text-[11px]"
            title="Descarga en este navegador el personaje guardado en Firebase con este ID"
          >
            <span class="material-symbols-outlined text-[16px] text-cyan-400">cloud_download</span>
            <span>Bajar de Nube</span>
          </button>
        </div>
        <div id="sync-action-feedback" class="hidden p-2 rounded-lg text-[10px] text-center font-bold"></div>
      </div>
    </div>

    <!-- Footer -->
    <div class="p-4 bg-[#18202e] border-t border-[#222f42] flex items-center justify-end gap-2.5 shrink-0">
      <button type="button" id="sync-cancel-btn" class="px-4 py-2 rounded-xl bg-[#121721] border border-[#222f42] text-[#94a3b8] hover:text-[#f1f5f9] cursor-pointer">
        Cerrar
      </button>
      <button type="button" id="sync-save-btn" class="px-5 py-2 rounded-xl bg-gradient-to-r from-cyan-600 to-cyan-500 text-white font-bold shadow-[0_0_12px_rgba(6,182,212,0.3)] hover:brightness-110 active:scale-95 transition-all cursor-pointer flex items-center gap-1.5">
        <span class="material-symbols-outlined text-[16px]">save</span>
        <span>Guardar y Conectar</span>
      </button>
    </div>
  </div>
</div>

<script>
  import { syncManager, generateCharacterSyncId, type SyncStatusEvent } from '../../scripts/sync/syncManager';
  import { characterStore } from '../../scripts/state/characterStore';
  import { closeModal } from '../../scripts/animations/modalAnimations';

  const modal = document.getElementById('sync-config-modal');
  const backdrop = document.getElementById('modal-backdrop');
  const closeBtn = document.getElementById('sync-modal-close-btn');
  const cancelBtn = document.getElementById('sync-cancel-btn');
  const saveBtn = document.getElementById('sync-save-btn');

  const enabledToggle = document.getElementById('sync-enabled-toggle') as HTMLInputElement;
  const campaignInput = document.getElementById('sync-campaign-id') as HTMLInputElement;
  const characterInput = document.getElementById('sync-character-id') as HTMLInputElement;
  const pinInput = document.getElementById('sync-pin') as HTMLInputElement;

  const regenCharBtn = document.getElementById('sync-regen-char-btn');
  const copyCharBtn = document.getElementById('sync-copy-char-btn');
  const shareUrlBtn = document.getElementById('sync-share-url-btn');

  const collisionDialog = document.getElementById('sync-collision-dialog');
  const collisionCharName = document.getElementById('collision-char-name');
  const collisionCharId = document.getElementById('collision-char-id');
  const collisionBtnPull = document.getElementById('collision-btn-pull');
  const collisionBtnNewId = document.getElementById('collision-btn-new-id');
  const collisionBtnCancel = document.getElementById('collision-btn-cancel');

  const statusBox = document.getElementById('sync-status-box');
  const statusDot = document.getElementById('sync-status-dot');
  const statusTitle = document.getElementById('sync-status-title');
  const statusDesc = document.getElementById('sync-status-desc');

  const pushNowBtn = document.getElementById('sync-push-now-btn');
  const pullNowBtn = document.getElementById('sync-pull-now-btn');
  const feedbackEl = document.getElementById('sync-action-feedback');

  function showActionFeedback(text: string, isError = false) {
    if (!feedbackEl) return;
    feedbackEl.textContent = text;
    feedbackEl.className = isError
      ? 'p-2.5 rounded-lg text-[11px] text-center font-bold bg-rose-500/15 border border-rose-500/30 text-rose-300 block'
      : 'p-2.5 rounded-lg text-[11px] text-center font-bold bg-emerald-500/15 border border-emerald-500/30 text-emerald-300 block';
    setTimeout(() => {
      feedbackEl.className = 'hidden';
    }, 4500);
  }

  function renderStatus(state: string, message?: string) {
    if (!statusBox || !statusDot || !statusTitle || !statusDesc) return;

    if (state === 'connected') {
      statusBox.className = 'p-3 rounded-xl border flex items-center gap-2.5 text-xs bg-emerald-500/10 border-emerald-500/40 text-emerald-300';
      statusDot.className = 'w-2.5 h-2.5 rounded-full bg-emerald-400 shrink-0 shadow-[0_0_8px_rgba(52,211,153,0.8)] animate-pulse';
      statusTitle.textContent = '🟢 Conectado en Tiempo Real';
      statusDesc.textContent = message || `Sincronizando con sala: ${campaignInput?.value || 'activa'}`;
    } else if (state === 'connecting') {
      statusBox.className = 'p-3 rounded-xl border flex items-center gap-2.5 text-xs bg-amber-500/10 border-amber-500/40 text-amber-300';
      statusDot.className = 'w-2.5 h-2.5 rounded-full bg-amber-400 shrink-0 animate-ping';
      statusTitle.textContent = '🟡 Conectando a Firebase...';
      statusDesc.textContent = message || 'Estableciendo conexión WebSocket...';
    } else if (state === 'error') {
      statusBox.className = 'p-3 rounded-xl border flex items-center gap-2.5 text-xs bg-rose-500/10 border-rose-500/40 text-rose-300';
      statusDot.className = 'w-2.5 h-2.5 rounded-full bg-rose-500 shrink-0';
      statusTitle.textContent = '🔴 Error de Sincronización';
      statusDesc.textContent = message || 'Revisa las claves y las Reglas de Firestore en Firebase Console.';
    } else {
      statusBox.className = 'p-3 rounded-xl border flex items-center gap-2.5 text-xs bg-[#18202e] border-[#222f42] text-[#94a3b8]';
      statusDot.className = 'w-2.5 h-2.5 rounded-full bg-slate-500 shrink-0';
      statusTitle.textContent = '⚪ Modo Local (Offline)';
      statusDesc.textContent = 'Tus datos se guardan en el navegador. Activa la sincronización para jugar en varios dispositivos.';
    }
  }

  function loadSyncForm() {
    const cfg = syncManager.getConfig();
    if (enabledToggle) enabledToggle.checked = cfg.enabled;
    if (campaignInput) campaignInput.value = cfg.campaignId || 'barovia-strahd';
    if (characterInput) characterInput.value = cfg.characterId || syncManager.getEffectiveCharacterId();
    if (pinInput) pinInput.value = cfg.pin || '';

    renderStatus(syncManager.currentStatus, syncManager.currentMessage);
  }

  loadSyncForm();

  // Listen to status changes from syncManager
  window.addEventListener('sync-status-changed', ((e: CustomEvent<SyncStatusEvent>) => {
    renderStatus(e.detail.state, e.detail.message);
  }) as EventListener);

  // Close handlers
  const closeMe = () => {
    if (collisionDialog) collisionDialog.classList.add('hidden');
    if (modal && backdrop) closeModal(modal, backdrop);
  };
  closeBtn?.addEventListener('click', closeMe);
  cancelBtn?.addEventListener('click', closeMe);

  // Regenerate Character ID
  regenCharBtn?.addEventListener('click', () => {
    const localCharName = characterStore.get()?.name || 'personaje';
    const newId = generateCharacterSyncId(localCharName);
    if (characterInput) {
      characterInput.value = newId;
      showActionFeedback(`Nuevo ID generado: ${newId}`);
    }
  });

  // Copy Character ID
  copyCharBtn?.addEventListener('click', async () => {
    const val = characterInput?.value.trim();
    if (!val) return;
    try {
      await navigator.clipboard.writeText(val);
      showActionFeedback('✅ ID de personaje copiado al portapapeles');
    } catch (_) {
      showActionFeedback(val);
    }
  });

  // Share / Copy Mobile Link
  shareUrlBtn?.addEventListener('click', async () => {
    const url = syncManager.getShareableSyncUrl();
    if (!url) return;
    try {
      await navigator.clipboard.writeText(url);
      showActionFeedback('📲 ¡Enlace copiado! Pégalo en tu móvil para sincronizar directamente.');
    } catch (_) {
      showActionFeedback(url);
    }
  });

  // Save Config Execution
  async function performSave(forcePull = false) {
    const enabled = enabledToggle?.checked || false;
    const campaignId = campaignInput?.value.trim() || 'barovia-strahd';
    const characterId = characterInput?.value.trim() || syncManager.getEffectiveCharacterId();
    const pin = pinInput?.value.trim() || '';

    saveBtn?.setAttribute('disabled', 'true');
    saveBtn?.classList.add('opacity-60', 'pointer-events-none');

    const res = await syncManager.saveConfig({
      enabled,
      campaignId,
      characterId,
      pin,
      projectId: '',
      apiKey: ''
    });

    if (forcePull) {
      await syncManager.forcePullRemoteToLocal();
    }

    saveBtn?.removeAttribute('disabled');
    saveBtn?.classList.remove('opacity-60', 'pointer-events-none');

    if (res.success) {
      showActionFeedback('✅ Configuración guardada correctamente.');
      if (collisionDialog) collisionDialog.classList.add('hidden');
      setTimeout(closeMe, 800);
    } else {
      showActionFeedback(`❌ ${res.message}`, true);
    }
  }

  // Save button with collision check
  saveBtn?.addEventListener('click', async () => {
    const enabled = enabledToggle?.checked || false;
    const campaignId = campaignInput?.value.trim() || 'barovia-strahd';
    const characterId = characterInput?.value.trim() || syncManager.getEffectiveCharacterId();
    const cfg = syncManager.getConfig();

    if (enabled && cfg.projectId && cfg.apiKey) {
      const prev = syncManager.getConfig();
      // If this is a new connection or characterId has changed
      if (!prev.enabled || prev.characterId !== characterId || prev.campaignId !== campaignId) {
        showActionFeedback('Comprobando sala en la nube...');
        const check = await syncManager.checkRemoteCharacter(campaignId, characterId);
        if (check.exists) {
          // Character exists on remote! Show prompt so user chooses
          if (collisionCharName) collisionCharName.textContent = `"${check.characterName}"`;
          if (collisionCharId) collisionCharId.textContent = characterId;
          collisionDialog?.classList.remove('hidden');
          return;
        }
      }
    }

    await performSave(false);
  });

  // Collision Dialog handlers
  collisionBtnPull?.addEventListener('click', async () => {
    await performSave(true);
  });

  collisionBtnNewId?.addEventListener('click', async () => {
    const localCharName = characterStore.get()?.name || 'personaje';
    const newId = generateCharacterSyncId(localCharName);
    if (characterInput) characterInput.value = newId;
    if (collisionDialog) collisionDialog.classList.add('hidden');
    await performSave(false);
  });

  collisionBtnCancel?.addEventListener('click', () => {
    if (collisionDialog) collisionDialog.classList.add('hidden');
  });

  // Force Push button
  pushNowBtn?.addEventListener('click', async () => {
    pushNowBtn.setAttribute('disabled', 'true');
    pushNowBtn.classList.add('opacity-60');
    showActionFeedback('Subiendo personaje actual a la nube...');

    const res = await syncManager.forcePushLocalToRemote();
    pushNowBtn.removeAttribute('disabled');
    pushNowBtn.classList.remove('opacity-60');
    showActionFeedback(res.message || '', !res.success);
  });

  // Force Pull button
  pullNowBtn?.addEventListener('click', async () => {
    pullNowBtn.setAttribute('disabled', 'true');
    pullNowBtn.classList.add('opacity-60');
    showActionFeedback('Descargando de la nube...');

    const res = await syncManager.forcePullRemoteToLocal();
    pullNowBtn.removeAttribute('disabled');
    pullNowBtn.classList.remove('opacity-60');
    showActionFeedback(res.message || '', !res.success);
  });
</script>
