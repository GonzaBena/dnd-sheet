---
// src/components/combat/ReactionPromptBanner.astro
// Banner flotante contextual para resolver reacciones fuera de turno (Spec 12, H5).
---

<div
  id="reaction-prompt-banner"
  class="hidden fixed bottom-6 left-1/2 -translate-x-1/2 z-50 max-w-lg w-[94vw] sm:w-full bg-[#121721]/95 backdrop-blur-md border border-amber-500/50 shadow-[0_10px_35px_rgba(0,0,0,0.85)] rounded-2xl p-4 sm:p-5 text-[#f1f5f9] animate-fade-in transition-all"
  role="alert"
  aria-live="assertive"
>
  <!-- Glow accent -->
  <div class="absolute -top-1 left-1/2 -translate-x-1/2 w-32 h-1 bg-gradient-to-r from-transparent via-amber-400 to-transparent rounded-full blur-xs"></div>

  <div class="flex items-start gap-3.5">
    <div class="w-10 h-10 rounded-xl bg-amber-500/20 border border-amber-500/40 flex items-center justify-center shrink-0 shadow-[0_0_12px_rgba(245,158,11,0.3)]">
      <span class="material-symbols-outlined text-amber-400 text-2xl font-bold animate-pulse">bolt</span>
    </div>

    <div class="flex-1 min-w-0">
      <div class="flex items-center justify-between gap-2">
        <h4 class="text-xs sm:text-sm font-headline font-bold text-amber-300 uppercase tracking-wider flex items-center gap-1.5">
          <span>Oportunidad de Reacción</span>
          <span class="text-[10px] px-1.5 py-0.5 rounded bg-amber-500/20 text-amber-200 font-mono font-semibold border border-amber-500/30">1 / ronda</span>
        </h4>
        <button
          type="button"
          id="btn-reaction-prompt-close"
          class="text-[#94a3b8] hover:text-[#f1f5f9] text-sm p-1 rounded hover:bg-[#18202e] transition-colors cursor-pointer"
          title="Omitir reacción"
          aria-label="Cerrar aviso de reacción"
        >
          <span class="material-symbols-outlined text-lg leading-none">close</span>
        </button>
      </div>

      <p id="reaction-prompt-trigger-desc" class="text-xs text-[#cbd5e1] mt-1 leading-relaxed">
        Un evento desencadenante requiere tu atención.
      </p>

      <!-- Contenedor dinámico de botones de reacción -->
      <div id="reaction-prompt-options" class="mt-3 flex flex-wrap items-center gap-2">
        <!-- Generado dinámicamente -->
      </div>
    </div>
  </div>
</div>

<script>
  import { characterStore } from '../../scripts/state/characterStore.ts';
  import type { AvailableReaction, ReactionTriggerPayload } from '../../scripts/models/reaction.ts';
  import { initReactionListeners } from '../../scripts/ui/reactionPrompt.ts';

  const banner = document.getElementById('reaction-prompt-banner');
  const triggerDesc = document.getElementById('reaction-prompt-trigger-desc');
  const optionsContainer = document.getElementById('reaction-prompt-options');
  const closeBtn = document.getElementById('btn-reaction-prompt-close');

  let currentTrigger: ReactionTriggerPayload | null = null;
  let currentReactions: AvailableReaction[] = [];

  function dismissBanner() {
    if (banner) banner.classList.add('hidden');
    currentTrigger = null;
    currentReactions = [];
  }

  closeBtn?.addEventListener('click', dismissBanner);

  // Escuchar el evento que solicita abrir el prompt
  window.addEventListener('show-reaction-prompt', ((e: CustomEvent<{ trigger: ReactionTriggerPayload; reactions: AvailableReaction[] }>) => {
    if (!e.detail || !banner || !triggerDesc || !optionsContainer) return;
    const { trigger, reactions } = e.detail;

    // Solo mostramos si hay al menos una reacción ejecutable
    const viable = reactions.filter(r => r.canExecute);
    if (viable.length === 0) return;

    currentTrigger = trigger;
    currentReactions = viable;

    // Formatear texto explicativo del detonante
    if (trigger.triggerType === 'attack_hits') {
      const rollStr = trigger.attackRoll !== undefined ? ` (tirada ${trigger.attackRoll})` : '';
      const acStr = trigger.targetAc !== undefined ? ` tu CA ${trigger.targetAc}` : 'tu CA';
      const fromStr = trigger.sourceCombatantName ? ` de ${trigger.sourceCombatantName}` : '';
      triggerDesc.textContent = `Un ataque${fromStr}${rollStr} impacta contra ${acStr}. ¿Deseas usar tu reacción defensiva?`;
    } else if (trigger.triggerType === 'damage_taken') {
      const dmgStr = trigger.damageAmount !== undefined ? `${trigger.damageAmount} de daño` : 'daño';
      const typeStr = trigger.damageType ? ` (${trigger.damageType})` : '';
      const fromStr = trigger.sourceCombatantName ? ` de ${trigger.sourceCombatantName}` : '';
      triggerDesc.textContent = `Recibiste ${dmgStr}${typeStr}${fromStr}. Tienes facultades o conjuros para reaccionar.`;
    } else if (trigger.triggerType === 'opportunity_attack') {
      const fromStr = trigger.sourceCombatantName ? `${trigger.sourceCombatantName}` : 'Una criatura hostil';
      triggerDesc.textContent = `${fromStr} abandona tu alcance cuerpo a cuerpo sin destrabarse.`;
    } else if (trigger.triggerType === 'condition_applied') {
      const condStr = trigger.condition ? `el efecto de ${trigger.condition} (hechizado/miedo)` : 'un efecto mágico adverso';
      triggerDesc.textContent = `Se intenta aplicar ${condStr} sobre ti. ¿Deseas usar tu reacción defensiva?`;
    } else if (trigger.triggerType === 'ally_targeted' || trigger.triggerType === 'ally_attacked') {
      const allyStr = trigger.allyName ? `tu aliado ${trigger.allyName}` : 'un aliado cercano';
      const distStr = trigger.distanceFeet ? ` (a ${trigger.distanceFeet} pies)` : '';
      triggerDesc.textContent = `${allyStr}${distStr} es objetivo de un ataque o efecto. Puedes usar tu reacción para protegerlo.`;
    } else {
      triggerDesc.textContent = 'Tienes una oportunidad para ejecutar una reacción en este momento.';
    }

    // Renderizar opciones
    optionsContainer.innerHTML = '';

    viable.forEach(reaction => {
      const btnWrapper = document.createElement('div');
      btnWrapper.className = 'flex items-center gap-1.5 flex-wrap';

      const btn = document.createElement('button');
      btn.type = 'button';
      btn.className = 'px-3 py-1.5 rounded-lg bg-gradient-to-r from-amber-600 to-amber-500 hover:from-amber-500 hover:to-amber-400 text-[#0a0d12] text-xs font-bold font-headline flex items-center gap-1.5 shadow-sm active:scale-95 transition-all cursor-pointer';

      let icon = 'shield';
      if (reaction.id.includes('dodge')) icon = 'sports_martial_arts';
      else if (reaction.id.includes('absorb')) icon = 'local_fire_department';
      else if (reaction.id.includes('opportunity')) icon = 'swords';
      else if (reaction.id.includes('hellish')) icon = 'local_fire_department';
      else if (reaction.id.includes('protection') || reaction.id.includes('interception')) icon = 'security';
      else if (reaction.id.includes('deflect')) icon = 'front_hand';
      else if (reaction.sourceType === 'feature') icon = 'stars';
      else if (reaction.sourceType === 'item') icon = 'inventory_2';
      else if (reaction.sourceType === 'spell') icon = 'auto_fix_high';

      btn.innerHTML = `<span class="material-symbols-outlined text-[16px]">${icon}</span><span>${reaction.name}</span>`;

      // Selector de elemento para Absorber Elementos si no viene prefijado
      let elemSelect: HTMLSelectElement | null = null;
      if (reaction.id === 'reaction-absorb-elements') {
        elemSelect = document.createElement('select');
        elemSelect.className = 'bg-[#18202e] text-amber-200 border border-amber-500/40 text-[11px] rounded px-1.5 py-1 font-mono cursor-pointer focus:outline-none';
        const elements = [
          { val: 'fuego', label: 'Fuego' },
          { val: 'frío', label: 'Frío' },
          { val: 'rayo', label: 'Rayo' },
          { val: 'ácido', label: 'Ácido' },
          { val: 'trueno', label: 'Trueno' },
        ];
        elements.forEach(el => {
          const opt = document.createElement('option');
          opt.value = el.val;
          opt.textContent = el.label;
          if (trigger.damageType && trigger.damageType.toLowerCase().includes(el.val.replace(/[íá]/g, ''))) {
            opt.selected = true;
          }
          elemSelect?.appendChild(opt);
        });
      }

      // Si tiene selección de ranura
      let slotSelect: HTMLSelectElement | null = null;
      if (reaction.availableSlots && reaction.availableSlots.length > 1) {
        slotSelect = document.createElement('select');
        slotSelect.className = 'bg-[#18202e] text-amber-200 border border-amber-500/40 text-[11px] rounded px-1.5 py-1 font-mono cursor-pointer focus:outline-none';
        reaction.availableSlots.forEach(lvl => {
          const opt = document.createElement('option');
          opt.value = String(lvl);
          opt.textContent = `Nv ${lvl}`;
          slotSelect?.appendChild(opt);
        });
      }

      btn.addEventListener('click', () => {
        const slotLevel = slotSelect ? parseInt(slotSelect.value, 10) : reaction.cost?.spellSlotLevel;
        const chosenDamageType = elemSelect ? elemSelect.value : currentTrigger?.damageType;
        const payloadToUse = currentTrigger
          ? { ...currentTrigger, damageType: chosenDamageType || currentTrigger.damageType }
          : undefined;

        characterStore.executeReaction(reaction.id, {
          spellSlotLevel: slotLevel,
          damageTaken: currentTrigger?.damageAmount,
          triggerPayload: payloadToUse,
        });
        dismissBanner();
      });

      btnWrapper.appendChild(btn);
      if (elemSelect) btnWrapper.appendChild(elemSelect);
      if (slotSelect) btnWrapper.appendChild(slotSelect);
      optionsContainer.appendChild(btnWrapper);
    });

    // Botón Omitir
    const skipBtn = document.createElement('button');
    skipBtn.type = 'button';
    skipBtn.className = 'px-2.5 py-1.5 rounded-lg bg-[#18202e] hover:bg-[#222f42] text-[#94a3b8] hover:text-[#f1f5f9] text-xs font-semibold transition-colors cursor-pointer border border-[#222f42]';
    skipBtn.textContent = 'Omitir';
    skipBtn.addEventListener('click', dismissBanner);
    optionsContainer.appendChild(skipBtn);

    banner.classList.remove('hidden');
  }) as EventListener);

  // Iniciar interceptores de eventos
  initReactionListeners();
</script>
