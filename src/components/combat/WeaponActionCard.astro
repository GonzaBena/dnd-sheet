---
// src/components/combat/WeaponActionCard.astro
---

<div class="rounded-xl bg-[#121721] border border-[#222f42] p-5 shadow-sm">
  <div class="flex items-center justify-between mb-4 flex-wrap gap-2 select-none section-header-bar">
    <h3 class="text-sm font-headline font-bold text-[#f1f5f9] uppercase tracking-wider flex items-center gap-1.5">
      <span class="section-drag-handle material-symbols-outlined text-[#64748b] hover:text-amber-400 cursor-grab text-[18px] mr-0.5 transition-colors" title="Arrastrar para reordenar">drag_indicator</span>
      <span class="material-symbols-outlined text-amber-500 text-[18px]">swords</span>
      <span>Armas y Acciones de Ataque</span>
    </h3>
    
    <div class="flex items-center gap-2">
      <button
        type="button"
        id="open-compendium-weapons-btn"
        class="text-[10px] text-amber-400 hover:text-amber-300 font-bold bg-amber-500/10 hover:bg-amber-500/20 px-2.5 py-1 rounded-lg border border-amber-500/30 flex items-center gap-1 cursor-pointer transition-colors"
        title="Buscar armas en el Compendio SRD"
      >
        <span class="material-symbols-outlined text-[13px]">menu_book</span>
        <span>Compendio</span>
      </button>
      <button
        type="button"
        id="open-add-weapon-btn"
        class="text-[10px] text-amber-400 hover:text-amber-300 font-bold bg-amber-500/10 hover:bg-amber-500/20 px-2.5 py-1 rounded-lg border border-amber-500/30 flex items-center gap-1 cursor-pointer transition-colors"
        title="Añadir nueva arma o ataque"
      >
        <span class="material-symbols-outlined text-[13px]">add</span>
        <span>Añadir Arma</span>
      </button>
      <button
        type="button"
        class="section-collapse-btn w-6 h-6 rounded-md bg-[#18202e] border border-[#222f42] hover:border-amber-500/40 text-[#94a3b8] hover:text-[#f1f5f9] flex items-center justify-center transition-colors cursor-pointer"
        title="Colapsar / Expandir sección"
        aria-label="Colapsar o expandir"
      >
        <span class="material-symbols-outlined section-collapse-icon text-[18px]">expand_less</span>
      </button>
    </div>
  </div>

  <div class="section-collapsed-summary hidden text-[11px] text-[#94a3b8] font-label py-1">
    Armas preparadas y acciones de combate
  </div>

  <!-- Slot para barra de turno activo (TurnNotifier) -->
  <div data-turn-bar-slot class="hidden mb-3"></div>

  <div class="section-body space-y-3" id="weapon-actions-container">
    <!-- Populated by JavaScript -->
  </div>
</div>

<script>
  import { characterStore } from '../../scripts/state/characterStore';
  import { openModal } from '../../scripts/animations/modalAnimations';
  import { attachSwipeToDelete } from '../../scripts/ui/swipeToDelete';

  const container = document.getElementById('weapon-actions-container');
  const addWeaponBtn = document.getElementById('open-add-weapon-btn');

  addWeaponBtn?.addEventListener('click', () => {
    window.dispatchEvent(new CustomEvent('open-add-weapon-modal'));
  });

  document.getElementById('open-compendium-weapons-btn')?.addEventListener('click', () => {
    window.dispatchEvent(new CustomEvent('open-compendium-modal', {
      detail: { scope: 'weapons', category: 'weapons', targetModal: 'add-weapon' }
    }));
  });

  function renderWeapons(char: any) {
    if (!container) return;
    container.innerHTML = '';

    char.actions.forEach((act: any) => {
      const wrapper = document.createElement('div');
      wrapper.className = 'relative rounded-xl overflow-hidden select-none bg-[#10141d] border border-[#222f42]';

      // Background trash revealed on horizontal swipe
      const swipeBg = document.createElement('div');
      swipeBg.className = 'swipe-delete-bg absolute inset-0 bg-gradient-to-l from-rose-600/60 via-rose-600/30 to-rose-950/20 flex items-center justify-end px-4 gap-1.5 text-rose-300 font-bold text-xs pointer-events-none opacity-0';
      swipeBg.innerHTML = `
        <span class="material-symbols-outlined text-[18px]">delete</span>
        <span class="text-[11px]">Eliminar</span>
      `;
      wrapper.appendChild(swipeBg);

      const card = document.createElement('div');
      card.className = 'relative p-3.5 rounded-xl bg-[#18202e] border border-transparent hover:border-amber-500/40 transition-colors flex flex-col gap-2.5 group cursor-grab active:cursor-grabbing';
      
      const tagsHtml = (act.tags || []).map((t: string) => `<span class="px-2 py-0.5 rounded-full bg-[#10141d] border border-[#222f42] text-[10px] text-[#94a3b8] font-medium">${t}</span>`).join('');

      card.innerHTML = `
        <div class="flex flex-wrap items-center justify-between gap-2">
          <div class="flex-1 mr-2 flex items-center gap-2 truncate">
            <div class="truncate">
              <div class="flex items-center gap-2">
                <span class="font-headline font-bold text-[#f1f5f9] text-sm">${act.name}</span>
                <span class="text-[10px] text-amber-400 font-semibold px-1.5 py-0.2 rounded bg-amber-500/10 border border-amber-500/20">${act.type}</span>
                ${act.isAuto !== false && act.ability && act.ability !== 'none' ? `<span class="text-[9px] text-[#38bdf8] bg-sky-500/10 border border-sky-500/30 px-1.5 py-0.2 rounded font-mono font-bold uppercase" title="Modificador vinculado a ${act.ability.toUpperCase()}">${act.ability.toUpperCase()}</span>` : ''}
              </div>
              <span class="text-xs text-[#94a3b8] font-label">Daño: <strong class="text-amber-300">${act.damage}</strong> (${act.damageType})</span>
            </div>
          </div>

          <div class="flex items-center gap-1.5 shrink-0">
            <button class="roll-atk-btn px-2.5 py-1.5 rounded-lg bg-gradient-to-r from-amber-600 to-amber-500 text-[#0a0d12] text-xs font-bold shadow-sm hover:brightness-110 active:scale-95 transition-all flex items-center gap-1 cursor-pointer" title="Tirar Ataque con ${act.name}">
              <span class="material-symbols-outlined text-[14px]">casino</span>
              <span>${act.bonus}</span>
            </button>
            <button class="roll-dmg-btn px-2.5 py-1.5 rounded-lg bg-[#121721] border border-[#222f42] hover:border-amber-500/40 text-amber-300 text-xs font-bold active:scale-95 transition-all flex items-center gap-1 cursor-pointer" title="Tirar Daño (${act.damage})">
              <span class="material-symbols-outlined text-[14px] text-amber-500">flash_on</span>
              <span>Daño</span>
            </button>
            <button class="edit-weapon-btn w-6 h-6 rounded hover:bg-amber-500/20 text-[#94a3b8] hover:text-amber-400 flex items-center justify-center opacity-90 sm:opacity-0 sm:group-hover:opacity-100 transition-opacity cursor-pointer ml-1" title="Editar arma y modificadores">
              <span class="material-symbols-outlined text-[14px]">edit</span>
            </button>
            <button class="delete-weapon-btn w-6 h-6 rounded hover:bg-rose-950/40 text-[#94a3b8] hover:text-rose-400 flex items-center justify-center opacity-90 sm:opacity-0 sm:group-hover:opacity-100 transition-opacity cursor-pointer" title="Eliminar arma">
              <span class="material-symbols-outlined text-[14px]">close</span>
            </button>
          </div>
        </div>

        ${act.notes ? `
          <div class="px-2.5 py-1.5 rounded-lg bg-amber-500/10 border border-amber-500/20 text-[11px] text-[#cbd5e1] flex items-start gap-1.5">
            <span class="material-symbols-outlined text-[14px] text-amber-400 shrink-0 mt-0.5">auto_awesome</span>
            <span class="leading-relaxed"><strong class="text-amber-400/90 font-semibold">Efecto / Condición:</strong> ${act.notes}</span>
          </div>
        ` : ''}

        <div class="flex flex-wrap gap-1.5 pt-1 border-t border-[#222f42]/60">
          ${tagsHtml}
        </div>
      `;

      // Helper function to trigger delete modal
      const triggerWeaponDelete = () => {
        window.dispatchEvent(new CustomEvent('open-delete-modal', {
          detail: {
            type: 'weapon',
            id: act.id,
            name: act.name,
            category: act.type || 'Arma',
            icon: 'swords',
            quantity: 1,
            title: '¿Eliminar arma/acción?',
            subtitle: 'Confirmación de combate',
            onConfirm: () => {
              characterStore.removeAction(act.id);
            }
          }
        }));
      };

      // Attach mobile swipe-to-delete gesture
      attachSwipeToDelete({
        card,
        container: wrapper,
        threshold: 60,
        onTrigger: triggerWeaponDelete
      });

      // Attack roll button click
      const triggerAtkRoll = (isSecret = false) => {
        const bonusNum = parseInt(act.bonus.replace(/[^0-9-]/g, '')) || 0;
        window.dispatchEvent(new CustomEvent('open-dice-roller', {
          detail: {
            die: 20,
            count: 1,
            modifier: bonusNum,
            label: isSecret ? `Ataque Secreto con ${act.name}` : `Ataque con ${act.name}`,
            tag: isSecret ? '#Privado' : '#Combate',
            isSecret
          }
        }));
      };

      const atkBtn = card.querySelector('.roll-atk-btn');
      if (atkBtn) {
        atkBtn.setAttribute('title', `Tirar ataque de ${act.name} • Clic derecho o Shift+Clic para Tirada Secreta`);
        atkBtn.addEventListener('click', (e: any) => {
          triggerAtkRoll(Boolean(e.shiftKey || e.altKey));
        });
        atkBtn.addEventListener('contextmenu', (e) => {
          e.preventDefault();
          triggerAtkRoll(true);
        });
      }

      // Damage roll button click
      const triggerDmgRoll = (isSecret = false) => {
        const match = act.damage.match(/(\d+)d(\d+)(?:\s*([+-])\s*(\d+))?/);
        const count = match ? parseInt(match[1]) || 1 : 1;
        const die = match ? parseInt(match[2]) || 8 : 8;
        const sign = match && match[3] === '-' ? -1 : 1;
        const mod = match && match[4] ? sign * parseInt(match[4]) : 0;

        window.dispatchEvent(new CustomEvent('open-dice-roller', {
          detail: {
            die,
            count,
            modifier: mod,
            label: isSecret ? `Daño Secreto de ${act.name} (${act.damageType})` : `Daño de ${act.name} (${act.damageType})`,
            tag: isSecret ? '#Privado' : '#Combate',
            isSecret
          }
        }));
      };

      const dmgBtn = card.querySelector('.roll-dmg-btn');
      if (dmgBtn) {
        dmgBtn.setAttribute('title', `Tirar daño de ${act.name} • Clic derecho o Shift+Clic para Tirada Secreta`);
        dmgBtn.addEventListener('click', (e: any) => {
          triggerDmgRoll(Boolean(e.shiftKey || e.altKey));
        });
        dmgBtn.addEventListener('contextmenu', (e) => {
          e.preventDefault();
          triggerDmgRoll(true);
        });
      }

      // Edit weapon button click
      card.querySelector('.edit-weapon-btn')?.addEventListener('click', (e) => {
        e.stopPropagation();
        window.dispatchEvent(new CustomEvent('open-edit-weapon-modal', {
          detail: { action: act }
        }));
      });

      // Delete weapon button click
      card.querySelector('.delete-weapon-btn')?.addEventListener('click', (e) => {
        e.stopPropagation();
        triggerWeaponDelete();
      });

      wrapper.appendChild(card);
      container.appendChild(wrapper);
    });
  }

  renderWeapons(characterStore.get());

  window.addEventListener('character-updated', ((e: CustomEvent) => {
    renderWeapons(e.detail.character);
  }) as EventListener);
</script>
