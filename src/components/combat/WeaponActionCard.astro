---
// src/components/combat/WeaponActionCard.astro
---

<div class="rounded-xl bg-[#121721] border border-[#222f42] p-5 shadow-sm">
  <div class="flex items-center justify-between mb-4 flex-wrap gap-2 select-none section-header-bar">
    <h3 class="text-sm font-headline font-bold text-[#f1f5f9] uppercase tracking-wider flex items-center gap-1.5">
      <span class="section-drag-handle material-symbols-outlined text-[#64748b] hover:text-amber-400 cursor-grab text-[18px] mr-0.5 transition-colors" title="Arrastrar para reordenar">drag_indicator</span>
      <span class="material-symbols-outlined text-amber-500 text-[18px]">swords</span>
      <span>Armas y Acciones de Ataque</span>
    </h3>
    
    <div class="flex items-center gap-2">
      <button
        type="button"
        id="reset-combat-turn-btn"
        class="text-[10px] text-sky-400 hover:text-sky-300 font-bold bg-sky-500/10 hover:bg-sky-500/20 px-2.5 py-1 rounded-lg border border-sky-500/30 flex items-center gap-1 cursor-pointer transition-colors"
        title="Reiniciar facultades de 1 vez por turno (Ataque Furtivo, etc.)"
      >
        <span class="material-symbols-outlined text-[13px]">restart_alt</span>
        <span>Nuevo Turno</span>
        <span id="turn-used-badge" class="hidden px-1.5 py-0.2 rounded bg-amber-500/30 text-amber-300 text-[9px] font-mono font-bold">1</span>
      </button>
      <button
        type="button"
        id="open-add-weapon-btn"
        class="text-[10px] text-amber-400 hover:text-amber-300 font-bold bg-amber-500/10 hover:bg-amber-500/20 px-2.5 py-1 rounded-lg border border-amber-500/30 flex items-center gap-1 cursor-pointer transition-colors"
        title="Añadir nueva arma o ataque"
      >
        <span class="material-symbols-outlined text-[13px]">add</span>
        <span>Añadir Arma</span>
      </button>
      <button
        type="button"
        class="section-collapse-btn w-6 h-6 rounded-md bg-[#18202e] border border-[#222f42] hover:border-amber-500/40 text-[#94a3b8] hover:text-[#f1f5f9] flex items-center justify-center transition-colors cursor-pointer"
        title="Colapsar / Expandir sección"
        aria-label="Colapsar o expandir"
      >
        <span class="material-symbols-outlined section-collapse-icon text-[18px]">expand_less</span>
      </button>
    </div>
  </div>

  <div class="section-collapsed-summary hidden text-[11px] text-[#94a3b8] font-label py-1">
    Armas preparadas y acciones de combate
  </div>

  <!-- Slot para barra de turno activo (TurnNotifier) -->
  <div data-turn-bar-slot class="hidden mb-3"></div>

  <div class="section-body grid grid-cols-1 gap-3 items-start" id="weapon-actions-container">
    <!-- Populated by JavaScript -->
  </div>
</div>

<script>
  import { characterStore } from '../../scripts/state/characterStore';
  import { openModal } from '../../scripts/animations/modalAnimations';
  import { attachSwipeToDelete } from '../../scripts/ui/swipeToDelete';
  import { SLOT_LABELS, validSlotsForAction } from '../../scripts/dnd/equipment';
  import { showAlert } from '../../scripts/ui/notify';
  import { getAvailableCombatModifiers, combineDamageModifiers, parseFormulaDice } from '../../scripts/dnd/combat';
  import { evaluateAdvantage } from '../../scripts/dnd/advantage';
  import type { EquipSlot } from '../../scripts/models/character';

  const container = document.getElementById('weapon-actions-container');
  const addWeaponBtn = document.getElementById('open-add-weapon-btn');
  const resetTurnBtn = document.getElementById('reset-combat-turn-btn');
  const turnBadge = document.getElementById('turn-used-badge');

  addWeaponBtn?.addEventListener('click', () => {
    window.dispatchEvent(new CustomEvent('open-add-weapon-modal'));
  });

  resetTurnBtn?.addEventListener('click', () => {
    characterStore.resetTurn();
    showAlert('Nuevo turno iniciado: facultades de 1 vez por turno restablecidas.', { kind: 'info' });
  });

  const expandedWeapons = new Set<string>();
  const selectedModsPerWeapon = new Map<string, Set<string>>();

  function renderWeapons(char: any) {
    if (!container) return;
    container.innerHTML = '';

    // Actualizar indicador de facultades de 1 vez por turno usadas
    const usedModsCount = (char.turnState?.usedModifiers || []).length;
    if (turnBadge) {
      if (usedModsCount > 0) {
        turnBadge.textContent = String(usedModsCount);
        turnBadge.classList.remove('hidden');
      } else {
        turnBadge.classList.add('hidden');
      }
    }

    char.actions.forEach((act: any) => {
      const wrapper = document.createElement('div');
      wrapper.className = 'relative rounded-xl overflow-hidden select-none bg-[#10141d] border border-[#222f42]';

      // Background trash revealed on horizontal swipe
      const swipeBg = document.createElement('div');
      swipeBg.className = 'swipe-delete-bg absolute inset-0 bg-gradient-to-l from-rose-600/60 via-rose-600/30 to-rose-950/20 flex items-center justify-end px-4 gap-1.5 text-rose-300 font-bold text-xs pointer-events-none opacity-0';
      swipeBg.innerHTML = `
        <span class="material-symbols-outlined text-[18px]">delete</span>
        <span class="text-[11px]">Eliminar</span>
      `;
      wrapper.appendChild(swipeBg);

      const card = document.createElement('div');
      card.className = 'relative p-2.5 rounded-xl bg-[#18202e] border border-transparent hover:border-amber-500/40 transition-colors flex flex-col gap-1.5 group cursor-grab active:cursor-grabbing';
      
      const tagsHtml = (act.tags || []).map((t: string) => `<span class="px-2 py-0.5 rounded-full bg-[#10141d] border border-[#222f42] text-[10px] text-[#94a3b8] font-medium">${t}</span>`).join('');

      card.innerHTML = `
        <div class="flex flex-wrap items-center justify-between gap-2">
          <div class="flex-1 mr-2 flex items-center gap-2 truncate">
            <div class="truncate">
              <div class="flex items-center gap-2">
                <span class="font-headline font-bold text-[#f1f5f9] text-sm">${act.name}</span>
                ${act.equipped ? `<span class="material-symbols-outlined text-[13px] text-emerald-400" title="Equipada">check_circle</span>` : ''}
                ${act.isAuto !== false && act.ability && act.ability !== 'none' ? `<span class="text-[9px] text-[#38bdf8] bg-sky-500/10 border border-sky-500/30 px-1.5 py-0.2 rounded font-mono font-bold uppercase" title="Modificador vinculado a ${act.ability.toUpperCase()}">${act.ability.toUpperCase()}</span>` : ''}
              </div>
              ${act.type ? `<span class="block text-[10px] text-amber-400 font-semibold uppercase tracking-wide leading-tight">${act.type}</span>` : ''}
              <span class="text-xs text-[#94a3b8] font-label">Daño: <strong class="text-amber-300">${act.damage}</strong> (${act.damageType})</span>
            </div>
          </div>

          <div class="flex items-center gap-1.5 shrink-0">
            <button class="roll-atk-btn px-3 py-1.5 rounded-lg bg-gradient-to-r from-amber-600 to-amber-500 text-[#0a0d12] text-xs font-headline font-extrabold shadow-sm hover:brightness-110 active:scale-95 transition-all flex items-center gap-1.5 cursor-pointer" title="Atacar con ${act.name} (${act.bonus} al impacto → ${act.damage} ${act.damageType})">
              <span class="material-symbols-outlined text-[15px]">swords</span>
              <span>Atacar</span>
              <span class="px-1.5 py-0.2 rounded bg-[#0a0d12]/20 text-[#0a0d12] font-mono text-[10px] font-bold">${act.bonus}</span>
            </button>
            <button class="expand-weapon-btn w-6 h-6 rounded hover:bg-[#10141d] text-[#64748b] hover:text-[#cbd5e1] flex items-center justify-center cursor-pointer transition-colors" title="Opciones, notas y equipar" aria-label="Mostrar u ocultar detalles">
              <span class="material-symbols-outlined text-[16px] transition-transform ${expandedWeapons.has(act.id) ? 'rotate-180 text-amber-400' : ''}">expand_more</span>
            </button>
          </div>
        </div>

        <!-- Modificadores de Combate y 1 vez por turno (Spec 11, H4) -->
        <div class="weapon-mods-container pt-1 text-[10px]"></div>

        <div class="weapon-extra ${expandedWeapons.has(act.id) ? 'flex' : 'hidden'} flex-col gap-2 pt-2 border-t border-[#222f42]/60">
          ${act.notes ? `
            <div class="px-2.5 py-1.5 rounded-lg bg-amber-500/10 border border-amber-500/20 text-[11px] text-[#cbd5e1] flex items-start gap-1.5">
              <span class="material-symbols-outlined text-[14px] text-amber-400 shrink-0 mt-0.5">auto_awesome</span>
              <span class="leading-relaxed"><strong class="text-amber-400/90 font-semibold">Efecto / Condición:</strong> ${act.notes}</span>
            </div>
          ` : ''}
          ${tagsHtml ? `<div class="flex flex-wrap gap-1.5">${tagsHtml}</div>` : ''}
          <div class="flex items-center justify-end gap-2 pt-1 border-t border-[#222f42]/40">
            <button type="button" class="edit-weapon-btn px-2.5 py-1 rounded-lg bg-[#10141d] hover:bg-amber-500/20 text-[#cbd5e1] hover:text-amber-300 border border-[#222f42] hover:border-amber-500/40 text-[11px] font-bold flex items-center gap-1 cursor-pointer transition-colors" title="Editar arma y modificadores">
              <span class="material-symbols-outlined text-[13px]">edit</span>
              <span>Editar</span>
            </button>
            <button type="button" class="delete-weapon-btn px-2.5 py-1 rounded-lg bg-[#10141d] hover:bg-rose-500/20 text-[#94a3b8] hover:text-rose-400 border border-[#222f42] hover:border-rose-500/40 text-[11px] font-bold flex items-center gap-1 cursor-pointer transition-colors" title="Eliminar arma">
              <span class="material-symbols-outlined text-[13px]">delete</span>
              <span>Eliminar</span>
            </button>
          </div>
        </div>
      `;

      // Equipo (Spec 08, Fase A): manos y slot. Todo el texto con textContent.
      const equipRow = document.createElement('div');
      equipRow.className = 'flex items-center gap-1.5 flex-wrap text-[10px]';
      const selCls = 'bg-[#10141d] text-[#cbd5e1] border border-[#222f42] rounded px-1 py-0.5';

      const handsSel = document.createElement('select');
      handsSel.className = selCls;
      handsSel.title = 'Manos necesarias';
      [['1', 'Una mano'], ['2', 'Dos manos']].forEach(([v, t]) => {
        const o = document.createElement('option');
        o.value = v;
        o.textContent = t;
        handsSel.appendChild(o);
      });
      handsSel.value = act.hands === 2 ? '2' : '1';
      handsSel.addEventListener('change', () => {
        characterStore.setWeaponHands(act.id, handsSel.value === '2' ? 2 : 1);
      });
      equipRow.appendChild(handsSel);

      if (act.equipped && act.slot) {
        const badge = document.createElement('span');
        badge.className = 'px-1.5 py-0.5 rounded border font-bold bg-emerald-500/10 text-emerald-300 border-emerald-500/30';
        badge.textContent = `Equipada: ${SLOT_LABELS[act.slot as EquipSlot] ?? act.slot}`;
        const unBtn = document.createElement('button');
        unBtn.type = 'button';
        unBtn.className = 'px-2 py-0.5 rounded bg-[#10141d] text-[#cbd5e1] hover:text-amber-300 border border-[#222f42] font-bold cursor-pointer';
        unBtn.textContent = 'Quitar';
        unBtn.addEventListener('click', (e) => { e.stopPropagation(); characterStore.unequipWeapon(act.id); });
        equipRow.append(badge, unBtn);
      } else {
        const slotSel = document.createElement('select');
        slotSel.className = selCls;
        validSlotsForAction(act).forEach((sl) => {
          const o = document.createElement('option');
          o.value = sl;
          o.textContent = SLOT_LABELS[sl];
          slotSel.appendChild(o);
        });
        const eqBtn = document.createElement('button');
        eqBtn.type = 'button';
        eqBtn.className = 'px-2 py-0.5 rounded bg-amber-500/20 text-amber-300 hover:bg-amber-500 hover:text-[#0a0d12] border border-amber-500/30 font-bold cursor-pointer';
        eqBtn.textContent = 'Equipar';
        eqBtn.addEventListener('click', (e) => {
          e.stopPropagation();
          const res = characterStore.equipWeapon(act.id, slotSel.value as EquipSlot);
          if (res.error) showAlert(res.error, { kind: 'warning' });
          else if (res.unequipped.length > 0) {
            showAlert(`Se quitó ${res.unequipped.map((u) => u.name).join(', ')} para equipar ${act.name}.`, { kind: 'warning' });
          }
        });
        equipRow.append(slotSel, eqBtn);
      }
      card.querySelector('.weapon-extra')?.prepend(equipRow);

      // Panel desplegable: notas, tags y equipar quedan ocultos hasta que se pida (el estado sobrevive al render).
      const expandBtn = card.querySelector('.expand-weapon-btn');
      expandBtn?.addEventListener('click', (e) => {
        e.stopPropagation();
        const panel = card.querySelector('.weapon-extra');
        if (!panel) return;
        const open = panel.classList.contains('hidden');
        panel.classList.toggle('hidden', !open);
        panel.classList.toggle('flex', open);
        expandBtn.querySelector('.material-symbols-outlined')?.classList.toggle('rotate-180', open);
        if (open) expandedWeapons.add(act.id); else expandedWeapons.delete(act.id);
      });

      // Helper function to trigger delete modal
      const triggerWeaponDelete = () => {
        window.dispatchEvent(new CustomEvent('open-delete-modal', {
          detail: {
            type: 'weapon',
            id: act.id,
            name: act.name,
            category: act.type || 'Arma',
            icon: 'swords',
            quantity: 1,
            title: '¿Eliminar arma/acción?',
            subtitle: 'Confirmación de combate',
            onConfirm: () => {
              characterStore.removeAction(act.id);
            }
          }
        }));
      };

      // Attach mobile swipe-to-delete gesture
      attachSwipeToDelete({
        card,
        container: wrapper,
        threshold: 60,
        onTrigger: triggerWeaponDelete
      });

      // Spec 11, H4: Modificadores al impacto y 1 vez por turno
      const availableMods = getAvailableCombatModifiers(char, act);
      if (!selectedModsPerWeapon.has(act.id)) {
        selectedModsPerWeapon.set(act.id, new Set());
      }
      const curSelected = selectedModsPerWeapon.get(act.id)!;
      const modsContainer = card.querySelector('.weapon-mods-container');

      if (modsContainer && availableMods.length > 0) {
        modsContainer.className = 'weapon-mods-container pt-1.5 pb-0.5 flex flex-wrap items-center gap-1.5 border-t border-[#222f42]/40 text-[10px]';
        modsContainer.innerHTML = `
          <span class="text-[#64748b] font-bold uppercase tracking-wider flex items-center gap-0.5">
            <span class="material-symbols-outlined text-[12px] text-amber-400">bolt</span>
            <span>Opciones:</span>
          </span>
        `;
        availableMods.forEach((m) => {
          if (m.usedThisTurn) {
            const usedSpan = document.createElement('span');
            usedSpan.className = 'px-1.5 py-0.5 rounded bg-[#10141d] border border-[#222f42] text-[#64748b] cursor-not-allowed opacity-60';
            usedSpan.title = 'Ya utilizado en este turno (pulsa "Nuevo Turno" para reiniciar)';
            usedSpan.textContent = `${m.name} (${m.formula}) • Usado`;
            modsContainer.appendChild(usedSpan);
          } else {
            const chip = document.createElement('button');
            chip.type = 'button';
            const isActive = curSelected.has(m.id);
            chip.className = `combat-mod-chip px-2 py-0.5 rounded transition-all cursor-pointer font-bold ${
              isActive
                ? 'bg-amber-500/30 text-amber-300 border border-amber-500/60 shadow-xs'
                : 'bg-[#10141d] text-[#94a3b8] hover:text-[#f1f5f9] border border-[#222f42] hover:border-amber-500/40'
            }`;
            chip.textContent = `${m.name} (${m.formula})`;
            chip.title = m.description;
            chip.addEventListener('click', (e) => {
              e.stopPropagation();
              if (curSelected.has(m.id)) {
                curSelected.delete(m.id);
              } else {
                curSelected.add(m.id);
              }
              renderWeapons(characterStore.get());
            });
            modsContainer.appendChild(chip);
          }
        });
      } else if (modsContainer) {
        modsContainer.remove();
      }

      const parseDamageFormula = (dmgStr: string) => {
        const match = (dmgStr || '').match(/(\d+)d(\d+)(?:\s*([+-])\s*(\d+))?/);
        const count = match ? parseInt(match[1]) || 1 : 1;
        const die = match ? parseInt(match[2]) || 8 : 8;
        const sign = match && match[3] === '-' ? -1 : 1;
        const mod = match && match[4] ? sign * parseInt(match[4]) : 0;
        return { count, die, mod };
      };

      // Attack roll button click (encadena automáticamente la tirada de daño del arma tras el d20)
      const triggerAtkRoll = (isSecret = false) => {
        const bonusNum = parseInt(act.bonus.replace(/[^0-9-]/g, '')) || 0;
        const dmg = parseDamageFormula(act.damage);
        const curActiveMods = availableMods.filter(m => curSelected.has(m.id) && !m.usedThisTurn);

        let extraAttackBonus = 0;
        for (const m of curActiveMods) {
          if (m.type === 'attack' || m.type === 'both') {
            const parsed = parseFormulaDice(m.formula);
            if (parsed && parsed.die === 0) extraAttackBonus += parsed.mod;
          }
        }

        const combinedDmg = combineDamageModifiers(act.damage, act.damageType || 'Físico', curActiveMods);
        const advInfo = evaluateAdvantage(char, { action: act, checkType: 'attack' });

        window.dispatchEvent(new CustomEvent('open-dice-roller', {
          detail: {
            die: 20,
            count: 1,
            modifier: bonusNum + extraAttackBonus,
            label: isSecret ? `Ataque Secreto con ${act.name}` : `Ataque con ${act.name}`,
            tag: isSecret ? '#Privado' : '#Combate',
            isSecret,
            isAttackRoll: true,
            advantageInfo: advInfo,
            followUpDamage: {
              count: dmg.count,
              die: dmg.die,
              modifier: dmg.mod,
              damageType: act.damageType || 'Físico',
              weaponOrSpellName: act.name,
              combinedFormula: combinedDmg.combinedFormula,
              extraDiceList: combinedDmg.extraDiceList,
              selectedModifiers: curActiveMods,
            }
          }
        }));
      };

      const atkBtn = card.querySelector('.roll-atk-btn');
      if (atkBtn) {
        atkBtn.setAttribute('title', `Atacar con ${act.name} (${act.bonus} al impacto → ${act.damage} ${act.damageType}) • Clic derecho o Shift+Clic para Tirada Secreta`);
        atkBtn.addEventListener('click', (e: any) => {
          triggerAtkRoll(Boolean(e.shiftKey || e.altKey));
        });
        atkBtn.addEventListener('contextmenu', (e) => {
          e.preventDefault();
          triggerAtkRoll(true);
        });
      }

      // Edit weapon button click
      card.querySelector('.edit-weapon-btn')?.addEventListener('click', (e) => {
        e.stopPropagation();
        window.dispatchEvent(new CustomEvent('open-edit-weapon-modal', {
          detail: { action: act }
        }));
      });

      // Delete weapon button click
      card.querySelector('.delete-weapon-btn')?.addEventListener('click', (e) => {
        e.stopPropagation();
        triggerWeaponDelete();
      });

      wrapper.appendChild(card);
      container.appendChild(wrapper);
    });
  }

  renderWeapons(characterStore.get());

  window.addEventListener('character-updated', ((e: CustomEvent) => {
    renderWeapons(e.detail.character);
  }) as EventListener);
</script>
