---
// src/components/combat/SpellcastingPanel.astro
---

<div class="rounded-xl bg-[#121721] border border-[#222f42] p-5 shadow-sm">
  <div class="flex items-center justify-between mb-4 flex-wrap gap-2">
    <div class="flex items-center gap-2">
      <span class="material-symbols-outlined text-amber-500 text-[20px]">auto_fix_high</span>
      <h3 class="text-sm font-headline font-bold text-[#f1f5f9] uppercase tracking-wider">Magia y Conjuros</h3>
    </div>
    
    <div class="flex items-center gap-3 text-xs font-label">
      <span class="text-[#94a3b8]">CD: <strong class="text-amber-400 font-bold" id="spell-dc-num">13</strong></span>
      <span class="text-[#334155]">•</span>
      <span class="text-[#94a3b8]">Ataque: <strong class="text-amber-400 font-bold" id="spell-atk-num">+5</strong></span>
      <button
        type="button"
        id="open-add-spell-btn"
        class="text-[10px] text-amber-400 hover:text-amber-300 font-bold bg-amber-500/10 hover:bg-amber-500/20 px-2 py-0.5 rounded-lg border border-amber-500/30 flex items-center gap-1 cursor-pointer transition-colors ml-1"
        title="Añadir nuevo conjuro o truco"
      >
        <span class="material-symbols-outlined text-[12px]">add</span>
        <span>Añadir</span>
      </button>
    </div>
  </div>

  <!-- Spell Slots Tracker -->
  <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 mb-4">
    <!-- Level 1 Slots -->
    <div class="p-3 rounded-xl bg-[#18202e] border border-[#222f42] flex items-center justify-between">
      <div>
        <span class="text-xs font-headline font-bold text-[#f1f5f9] block">Espacios Nivel 1</span>
        <span class="text-[10px] text-[#94a3b8]" id="slot-l1-label">2 / 4 Disponibles</span>
      </div>
      <div class="flex items-center gap-1.5" id="slot-l1-pips">
        <!-- Pips rendered by JS -->
      </div>
    </div>

    <!-- Level 2 Slots -->
    <div class="p-3 rounded-xl bg-[#18202e] border border-[#222f42] flex items-center justify-between">
      <div>
        <span class="text-xs font-headline font-bold text-[#f1f5f9] block">Espacios Nivel 2</span>
        <span class="text-[10px] text-[#94a3b8]" id="slot-l2-label">1 / 2 Disponibles</span>
      </div>
      <div class="flex items-center gap-1.5" id="slot-l2-pips">
        <!-- Pips rendered by JS -->
      </div>
    </div>
  </div>

  <!-- Prepared Spells & Cantrips List -->
  <div class="space-y-2 text-xs font-label" id="spells-list-container">
    <!-- Populated by JavaScript -->
  </div>
</div>

<script>
  import { characterStore } from '../../scripts/state/characterStore';
  import { openModal } from '../../scripts/animations/modalAnimations';
  import { attachSwipeToDelete } from '../../scripts/ui/swipeToDelete';

  const spellsContainer = document.getElementById('spells-list-container');
  const l1PipsContainer = document.getElementById('slot-l1-pips');
  const l2PipsContainer = document.getElementById('slot-l2-pips');
  const addSpellBtn = document.getElementById('open-add-spell-btn');

  const expandedSpells = new Set<string>();

  addSpellBtn?.addEventListener('click', () => {
    window.dispatchEvent(new CustomEvent('open-add-spell-modal'));
  });

  function renderSpellSlots(char: any) {
    const dcEl = document.getElementById('spell-dc-num');
    const atkEl = document.getElementById('spell-atk-num');
    const l1Label = document.getElementById('slot-l1-label');
    const l2Label = document.getElementById('slot-l2-label');

    if (dcEl) dcEl.textContent = String(char.spellcasting.saveDc);
    if (atkEl) atkEl.textContent = `+${char.spellcasting.attackBonus}`;

    const s1 = char.spellcasting.slots?.level1 || { total: 4, used: 0 };
    const s2 = char.spellcasting.slots?.level2 || { total: 2, used: 0 };

    if (l1Label) l1Label.textContent = `${s1.total - s1.used} / ${s1.total} Disponibles`;
    if (l2Label) l2Label.textContent = `${s2.total - s2.used} / ${s2.total} Disponibles`;

    // Render L1 pips
    if (l1PipsContainer) {
      l1PipsContainer.innerHTML = '';
      for (let i = 0; i < s1.total; i++) {
        const isUsed = i < s1.used;
        const pip = document.createElement('button');
        pip.className = `w-5 h-5 rounded-md border transition-all cursor-pointer ${isUsed ? 'bg-[#10141d] border-[#222f42] opacity-40' : 'bg-amber-500/30 border-amber-500/60 shadow-[0_0_8px_rgba(245,158,11,0.4)]'}`;
        pip.title = isUsed ? 'Ranura gastada (clic para restaurar)' : 'Ranura activa (clic para gastar)';
        pip.addEventListener('click', () => {
          if (isUsed) {
            characterStore.restoreSpellSlot(1);
          } else {
            characterStore.useSpellSlot(1);
          }
        });
        l1PipsContainer.appendChild(pip);
      }
    }

    // Render L2 pips
    if (l2PipsContainer) {
      l2PipsContainer.innerHTML = '';
      for (let i = 0; i < s2.total; i++) {
        const isUsed = i < s2.used;
        const pip = document.createElement('button');
        pip.className = `w-5 h-5 rounded-md border transition-all cursor-pointer ${isUsed ? 'bg-[#10141d] border-[#222f42] opacity-40' : 'bg-amber-500/30 border-amber-500/60 shadow-[0_0_8px_rgba(245,158,11,0.4)]'}`;
        pip.title = isUsed ? 'Ranura gastada (clic para restaurar)' : 'Ranura activa (clic para gastar)';
        pip.addEventListener('click', () => {
          if (isUsed) {
            characterStore.restoreSpellSlot(2);
          } else {
            characterStore.useSpellSlot(2);
          }
        });
        l2PipsContainer.appendChild(pip);
      }
    }
  }

  function renderSpells(char: any) {
    if (!spellsContainer) return;
    spellsContainer.innerHTML = '';

    const spells = char.spellcasting?.spells || [];
    if (spells.length === 0) {
      spellsContainer.innerHTML = `
        <div class="py-4 text-center text-xs text-[#64748b]">
          El grimorio está vacío. Pulsa "Añadir" para registrar trucos o conjuros.
        </div>
      `;
      return;
    }

    spells.forEach((sp: any) => {
      const spellKey = sp.id || sp.name;
      const isExpanded = expandedSpells.has(spellKey);
      const isCantrip = sp.level === 0;

      const wrapper = document.createElement('div');
      wrapper.className = 'relative rounded-xl overflow-hidden select-none bg-[#10141d] border border-[#222f42]';

      // Background trash revealed on swipe
      const swipeBg = document.createElement('div');
      swipeBg.className = 'swipe-delete-bg absolute inset-0 bg-gradient-to-l from-rose-600/60 via-rose-600/30 to-rose-950/20 flex items-center justify-end px-3.5 gap-1.5 text-rose-300 font-bold text-xs pointer-events-none opacity-0';
      swipeBg.innerHTML = `
        <span class="material-symbols-outlined text-[15px]">delete</span>
        <span class="text-[10px]">Eliminar</span>
      `;
      wrapper.appendChild(swipeBg);

      const card = document.createElement('div');
      card.className = 'relative p-2.5 rounded-xl bg-[#18202e] border border-transparent hover:border-amber-500/30 transition-colors flex flex-col gap-1.5 group cursor-grab active:cursor-grabbing';
      
      const dmgFormula = sp.damageFormula || sp.damageDice;

      card.innerHTML = `
        <div class="flex items-center justify-between gap-2 flex-wrap sm:flex-nowrap">
          <div class="flex items-center gap-2 truncate flex-1 mr-1">
            <span class="w-5 h-5 rounded-md ${isCantrip ? 'bg-purple-500/20 text-purple-300 border border-purple-500/40' : 'bg-[#10141d] text-amber-400 border border-[#222f42]'} font-bold text-[10px] flex items-center justify-center shrink-0" title="${isCantrip ? 'Truco Mágico (Nivel 0)' : `Conjuro Nivel ${sp.level}`}">
              ${isCantrip ? 'T' : sp.level}
            </span>
            <div class="truncate">
              <div class="flex items-center gap-1.5 flex-wrap">
                <span class="text-[#f1f5f9] font-medium truncate">${sp.name}</span>
                <span class="text-[10px] text-[#64748b]">(${sp.school})</span>
                ${sp.isSave ? `<span class="px-1.5 py-0.2 rounded bg-purple-500/10 text-purple-300 border border-purple-500/30 text-[9px] font-bold font-mono">CD ${sp.saveDc || char.spellcasting.saveDc} ${sp.saveAbility ? sp.saveAbility.toUpperCase() : ''}</span>` : ''}
              </div>
            </div>
          </div>

          <div class="flex items-center gap-1.5 shrink-0 text-[10px] text-[#94a3b8]">
            <span class="hidden md:inline text-[10px] text-[#64748b]">${sp.castingTime}</span>
            <span class="hidden md:inline text-[#334155]">•</span>
            <span class="hidden sm:inline text-amber-400/90 text-[10px]">${sp.range}</span>

            ${sp.isAttack ? `
              <button
                type="button"
                class="roll-spell-atk-btn px-2 py-1 rounded bg-gradient-to-r from-amber-600 to-amber-500 text-[#0a0d12] text-[10px] font-bold shadow-xs hover:brightness-110 active:scale-95 transition-all flex items-center gap-0.5 cursor-pointer"
                title="Tirar Ataque de Conjuro (+${char.spellcasting.attackBonus})"
              >
                <span class="material-symbols-outlined text-[12px]">casino</span>
                <span>+${char.spellcasting.attackBonus}</span>
              </button>
            ` : ''}

            ${dmgFormula ? `
              <button
                type="button"
                class="roll-spell-dmg-btn px-2 py-1 rounded bg-[#10141d] border border-[#222f42] hover:border-amber-500/40 text-amber-300 text-[10px] font-bold active:scale-95 transition-all flex items-center gap-1 cursor-pointer"
                title="Tirar ${sp.damageType || 'Efecto'}: ${dmgFormula}"
              >
                <span class="material-symbols-outlined text-[12px] text-amber-500">flash_on</span>
                <span>${dmgFormula}</span>
              </button>
            ` : ''}

            <button
              type="button"
              class="edit-spell-btn w-6 h-6 rounded hover:bg-amber-500/20 text-[#94a3b8] hover:text-amber-400 opacity-90 sm:opacity-0 sm:group-hover:opacity-100 transition-opacity flex items-center justify-center cursor-pointer ml-1"
              title="Editar conjuro o truco"
            >
              <span class="material-symbols-outlined text-[13px]">edit</span>
            </button>

            <button
              type="button"
              class="delete-spell-btn w-6 h-6 rounded hover:bg-rose-950/40 text-[#94a3b8] hover:text-rose-400 opacity-90 sm:opacity-0 sm:group-hover:opacity-100 transition-opacity flex items-center justify-center cursor-pointer"
              title="Eliminar conjuro"
            >
              <span class="material-symbols-outlined text-[13px]">close</span>
            </button>

            <button
              type="button"
              class="expand-spell-btn w-6 h-6 rounded hover:bg-[#10141d] text-[#64748b] hover:text-[#cbd5e1] flex items-center justify-center cursor-pointer"
              title="${isExpanded ? 'Ocultar detalles' : 'Ver detalles y notas'}"
            >
              <span class="material-symbols-outlined text-[16px] transition-transform ${isExpanded ? 'rotate-180 text-amber-400' : ''}">expand_more</span>
            </button>
          </div>
        </div>

        <!-- Expanded Details Drawer -->
        <div class="expand-spell-panel ${isExpanded ? 'block' : 'hidden'} pt-2 border-t border-[#222f42]/70 space-y-1.5 text-[11px] text-[#cbd5e1]">
          <div class="flex flex-wrap items-center gap-2 text-[10px]">
            <span class="bg-[#10141d] px-2 py-0.5 rounded border border-[#222f42] text-[#94a3b8]"><strong>Tiempo:</strong> ${sp.castingTime}</span>
            <span class="bg-[#10141d] px-2 py-0.5 rounded border border-[#222f42] text-[#94a3b8]"><strong>Alcance:</strong> ${sp.range}</span>
            ${sp.duration ? `<span class="bg-[#10141d] px-2 py-0.5 rounded border border-[#222f42] text-amber-400/90"><strong>Duración:</strong> ${sp.duration}</span>` : ''}
            ${sp.components ? `<span class="bg-[#10141d] px-2 py-0.5 rounded border border-[#222f42] text-[#94a3b8]"><strong>Comp:</strong> ${sp.components}</span>` : ''}
          </div>

          ${sp.activationCondition ? `
            <div class="flex items-start gap-1.5 bg-amber-500/10 p-2 rounded border border-amber-500/20">
              <span class="material-symbols-outlined text-[14px] text-amber-400 shrink-0 mt-0.5">timer</span>
              <div>
                <strong class="text-amber-300 font-semibold">Activación / Desencadenante:</strong>
                <span>${sp.activationCondition}</span>
              </div>
            </div>
          ` : ''}

          ${sp.notes ? `
            <div class="flex items-start gap-1.5 bg-[#10141d] p-2 rounded border border-[#222f42]">
              <span class="material-symbols-outlined text-[14px] text-amber-400 shrink-0 mt-0.5">auto_awesome</span>
              <div>
                <strong class="text-amber-400 font-semibold">Notas y Efectos Especiales:</strong>
                <p class="text-[#cbd5e1] leading-relaxed mt-0.5 whitespace-pre-line">${sp.notes}</p>
              </div>
            </div>
          ` : ''}

          <div class="flex items-center justify-end gap-2 pt-1 text-[10px]">
            <button type="button" class="panel-edit-spell-btn text-amber-400 hover:underline flex items-center gap-0.5 cursor-pointer">
              <span class="material-symbols-outlined text-[12px]">edit</span>
              <span>Editar</span>
            </button>
            <button type="button" class="panel-delete-spell-btn text-rose-400 hover:underline flex items-center gap-0.5 cursor-pointer ml-2">
              <span class="material-symbols-outlined text-[12px]">delete</span>
              <span>Eliminar</span>
            </button>
          </div>
        </div>
      `;

      const triggerSpellDelete = () => {
        window.dispatchEvent(new CustomEvent('open-delete-modal', {
          detail: {
            type: 'spell',
            name: sp.name,
            category: isCantrip ? 'Truco Mágico (Nivel 0)' : `Nivel ${sp.level} • ${sp.school}`,
            icon: 'auto_fix_high',
            quantity: 1,
            title: '¿Olvidar conjuro?',
            subtitle: 'Confirmación de grimorio',
            onConfirm: () => {
              characterStore.removeSpell(spellKey);
            }
          }
        }));
      };

      // Attach mobile swipe-to-delete gesture
      attachSwipeToDelete({
        card,
        container: wrapper,
        threshold: 60,
        onTrigger: triggerSpellDelete
      });

      // Expand / Collapse details
      const toggleExpand = (e: Event) => {
        e.stopPropagation();
        if (expandedSpells.has(spellKey)) {
          expandedSpells.delete(spellKey);
        } else {
          expandedSpells.add(spellKey);
        }
        renderSpells(characterStore.get());
      };

      card.querySelector('.expand-spell-btn')?.addEventListener('click', toggleExpand);

      // Edit spell trigger
      const triggerEdit = (e: Event) => {
        e.stopPropagation();
        window.dispatchEvent(new CustomEvent('open-edit-spell-modal', {
          detail: { spell: sp }
        }));
      };

      card.querySelector('.edit-spell-btn')?.addEventListener('click', triggerEdit);
      card.querySelector('.panel-edit-spell-btn')?.addEventListener('click', triggerEdit);

      // Delete spell triggers
      card.querySelector('.delete-spell-btn')?.addEventListener('click', (e) => {
        e.stopPropagation();
        triggerSpellDelete();
      });
      card.querySelector('.panel-delete-spell-btn')?.addEventListener('click', (e) => {
        e.stopPropagation();
        triggerSpellDelete();
      });

      // Roll spell attack
      const triggerSpellAtk = (isSecret = false) => {
        window.dispatchEvent(new CustomEvent('open-dice-roller', {
          detail: {
            die: 20,
            count: 1,
            modifier: char.spellcasting?.attackBonus || 0,
            label: isSecret ? `Ataque Secreto de Conjuro: ${sp.name}` : `Ataque de Conjuro: ${sp.name}`,
            tag: isSecret ? '#Privado' : '#Magia',
            isSecret
          }
        }));
      };

      const spellAtkBtn = card.querySelector('.roll-spell-atk-btn');
      if (spellAtkBtn) {
        spellAtkBtn.setAttribute('title', `Tirar ataque de ${sp.name} • Clic derecho o Shift+Clic para Tirada Secreta`);
        spellAtkBtn.addEventListener('click', (e: any) => {
          e.stopPropagation();
          triggerSpellAtk(Boolean(e.shiftKey || e.altKey));
        });
        spellAtkBtn.addEventListener('contextmenu', (e) => {
          e.preventDefault();
          e.stopPropagation();
          triggerSpellAtk(true);
        });
      }

      // Roll spell damage / healing
      const triggerSpellDmg = (isSecret = false) => {
        const formula = sp.damageFormula || sp.damageDice || '1d8';
        const match = formula.match(/(\d+)d(\d+)(?:\s*([+-])\s*(\d+))?/);
        const count = match ? parseInt(match[1]) || 1 : 1;
        const die = match ? parseInt(match[2]) || 8 : 8;
        const sign = match && match[3] === '-' ? -1 : 1;
        const mod = match && match[4] ? sign * parseInt(match[4]) : 0;

        window.dispatchEvent(new CustomEvent('open-dice-roller', {
          detail: {
            die,
            count,
            modifier: mod,
            label: isSecret ? `Daño/Efecto Secreto de ${sp.name} (${sp.damageType || 'Efecto'})` : `${sp.damageType || 'Efecto'} de ${sp.name}`,
            tag: isSecret ? '#Privado' : '#Magia',
            isSecret
          }
        }));
      };

      const spellDmgBtn = card.querySelector('.roll-spell-dmg-btn');
      if (spellDmgBtn) {
        spellDmgBtn.setAttribute('title', `Tirar daño/efecto de ${sp.name} • Clic derecho o Shift+Clic para Tirada Secreta`);
        spellDmgBtn.addEventListener('click', (e: any) => {
          e.stopPropagation();
          triggerSpellDmg(Boolean(e.shiftKey || e.altKey));
        });
        spellDmgBtn.addEventListener('contextmenu', (e) => {
          e.preventDefault();
          e.stopPropagation();
          triggerSpellDmg(true);
        });
      }

      wrapper.appendChild(card);
      spellsContainer.appendChild(wrapper);
    });
  }

  renderSpellSlots(characterStore.get());
  renderSpells(characterStore.get());

  window.addEventListener('character-updated', ((e: CustomEvent) => {
    renderSpellSlots(e.detail.character);
    renderSpells(e.detail.character);
  }) as EventListener);
</script>
