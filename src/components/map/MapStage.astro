---
// src/components/map/MapStage.astro
// Isla de mapa táctico VTT con Konva (zoom, pan, táctil y capas).
//
// DECISION (D1): Konva se carga con dynamic import dentro del <script> para evitar ejecución en build,
// reemplazando el patrón client:only sin requerir frameworks externos (React/Vue).
// DECISION (F2-1): Todo se guarda y calcula en píxeles de la imagen original.

import FogTools from '../dm/FogTools.astro';
import TokenInfoCard from './TokenInfoCard.astro';

interface Props {
  mode?: 'dm' | 'player';
  class?: string;
  id?: string;
}

const { mode = 'player', class: className = '', id } = Astro.props;
---

<div
  id={id}
  data-map-stage-root
  data-mode={mode}
  class={`relative w-full h-[60vh] md:h-[70vh] rounded-2xl bg-[#0c1017] border border-[#222f42] overflow-hidden shadow-inner select-none group ${className}`}
>
  <!-- Background grid decorativo cuando no hay imagen cargada -->
  <div class="absolute inset-0 bg-[linear-gradient(to_right,#1f293712_1px,transparent_1px),linear-gradient(to_bottom,#1f293712_1px,transparent_1px)] bg-[size:32px_32px] pointer-events-none"></div>

  <!-- Contenedor del canvas Konva animable con anime.js (T-24) -->
  <div
    data-canvas-container
    class="w-full h-full relative z-0 origin-center cursor-grab active:cursor-grabbing"
  ></div>

  <!-- Barra de estado y cabecera del mapa (top-left) -->
  <div class="absolute top-3 left-3 z-20 flex items-center gap-2 pointer-events-none isolate">
    {mode === 'dm' ? (
      <div class="relative pointer-events-auto isolate flex items-center gap-2" data-map-dropdown-wrapper>
        <button
          type="button"
          data-map-dropdown-toggle
          class="flex items-center gap-2 px-3 py-1.5 rounded-xl bg-[#10141d]/90 backdrop-blur-md border border-[#222f42] hover:border-amber-500/50 text-xs shadow-md transition-colors duration-150 cursor-pointer select-none"
          title="Elegir mapa para editar o gestionar biblioteca"
          aria-haspopup="true"
          aria-expanded="false"
        >
          <span class="material-symbols-outlined text-[16px] text-amber-400">map</span>
          <span data-map-title class="font-headline font-bold text-[#f1f5f9] truncate max-w-[160px] sm:max-w-xs text-left">
            Sin mapa activo
          </span>
          <span data-active-badge class="hidden px-1.5 py-0.5 rounded text-[10px] font-bold bg-amber-500/20 text-amber-300 border border-amber-500/40 shrink-0">
            ACTIVO
          </span>
          <span data-map-dropdown-arrow class="material-symbols-outlined text-[16px] text-[#94a3b8] group-hover:text-amber-400 transition-colors shrink-0">
            arrow_drop_down
          </span>
        </button>

        <!-- Publica para los jugadores el mapa que el DM está editando -->
        <button
          type="button"
          data-map-activate-btn
          class="hidden items-center gap-1 px-2.5 py-1.5 rounded-xl bg-amber-500/20 hover:bg-amber-500/30 border border-amber-500/40 text-amber-300 font-bold text-xs whitespace-nowrap shrink-0 shadow-md transition-colors duration-150 cursor-pointer active:scale-95"
          title="Activar este mapa para los jugadores"
        >
          <span class="material-symbols-outlined text-[15px]">publish</span>
          <span>Activar</span>
        </button>

        <!-- Menú desplegable de mapas para el DM -->
        <div
          data-map-dropdown-menu
          class="hidden absolute top-full left-0 mt-1 w-72 max-h-80 overflow-y-auto rounded-xl bg-[#121721] border border-[#222f42] shadow-[0_10px_35px_rgba(0,0,0,0.8)] p-1.5 space-y-1 z-30 font-label text-xs backdrop-blur-md pointer-events-auto isolate"
        >
          <div class="px-2 py-1 text-[10px] font-bold uppercase tracking-wider text-[#94a3b8] flex items-center justify-between border-b border-[#222f42]/60 pb-1">
            <span>Mapas de la Campaña</span>
            <span data-map-dropdown-count class="text-amber-400 font-bold">0 mapas</span>
          </div>

          <!-- Contenedor dinámico de elementos de mapas -->
          <div data-map-dropdown-list class="space-y-0.5 max-h-56 overflow-y-auto pr-0.5">
            <div class="p-3 text-center text-[#64748b] text-[11px]">
              Cargando mapas...
            </div>
          </div>

          <!-- Acciones al pie del dropdown -->
          <div class="pt-1 border-t border-[#222f42]/80 mt-1">
            <button
              type="button"
              data-map-dropdown-manage-btn
              class="w-full flex items-center gap-2 px-2.5 py-1.5 rounded-lg text-amber-300 hover:bg-amber-500/15 hover:text-amber-200 transition-colors duration-150 text-left font-bold text-[11px] cursor-pointer"
            >
              <span class="material-symbols-outlined text-[15px]">tune</span>
              <span>Gestionar / Subir Mapas...</span>
            </button>
          </div>
        </div>
      </div>
    ) : (
      <div class="flex items-center gap-2 px-3 py-1.5 rounded-xl bg-[#10141d]/85 backdrop-blur-md border border-[#222f42] text-xs shadow-md pointer-events-auto isolate">
        <span class="material-symbols-outlined text-[16px] text-amber-400">map</span>
        <span data-map-title class="font-headline font-bold text-[#f1f5f9] truncate max-w-[200px] sm:max-w-xs">
          Sin mapa activo
        </span>
        <span data-active-badge class="hidden px-1.5 py-0.5 rounded text-[10px] font-bold bg-amber-500/20 text-amber-300 border border-amber-500/40">
          ACTIVO
        </span>
      </div>
    )}
  </div>

  <!-- HUD: Personaje del jugador (T-35) -->
  <div
    data-player-character-hud
    class="hidden absolute top-3 right-3 z-20 flex items-center gap-2 p-1.5 pr-2.5 rounded-xl bg-[#10141d]/90 backdrop-blur-md border border-[#222f42] shadow-xl font-label text-xs pointer-events-auto"
  >
    <img
      data-player-hud-avatar
      src="/characters/ch-1.avif"
      alt="Avatar"
      class="w-7 h-7 rounded-lg object-cover border border-[#222f42] shrink-0"
    />
    <div class="flex flex-col min-w-0 pr-1">
      <div class="flex items-center gap-1.5">
        <span data-player-hud-name class="font-headline font-bold text-[#f1f5f9] truncate max-w-[120px]">
          Personaje
        </span>
        <span
          data-player-hud-badge
          class="px-1.5 py-0.5 rounded text-[9px] font-bold bg-amber-500/20 text-amber-300 border border-amber-500/40 shrink-0"
        >
          En pausa
        </span>
      </div>
      <span data-player-hud-sub class="text-[10px] text-[#94a3b8] truncate">
        Token en mapa
      </span>
    </div>
    <button
      type="button"
      data-player-hud-center-btn
      class="p-1 rounded-lg bg-[#18202e] hover:bg-amber-500/20 border border-[#222f42] hover:border-amber-500/40 text-[#cbd5e1] hover:text-amber-300 transition-colors cursor-pointer shrink-0"
      title="Centrar mapa en mi token"
    >
      <span class="material-symbols-outlined text-[16px] block">my_location</span>
    </button>
  </div>

  <!-- Controles flotantes de navegación (bottom-right) (T-22) -->
  <!-- Controles de navegación y cuadrícula (bottom-right) -->
  <div class="absolute bottom-3 right-3 z-10 flex items-center gap-1.5 p-1.5 rounded-xl bg-[#10141d]/85 backdrop-blur-md border border-[#222f42] shadow-xl isolate">
    <span
      data-zoom-indicator
      class="text-[11px] font-mono font-bold text-[#94a3b8] px-2 py-1 select-none"
      title="Nivel de zoom actual"
    >
      100%
    </span>

    <!-- Toggle Cuadrícula (Alto Contraste / Sutil / Oculta) -->
    <button
      type="button"
      data-grid-toggle-btn
      class="w-8 h-8 rounded-lg bg-[#18202e] border border-[#222f42] hover:border-amber-500/50 text-[#cbd5e1] hover:text-amber-300 flex items-center justify-center transition-colors duration-150 active:bg-amber-500/20 cursor-pointer"
      title="Alternar cuadrícula: Alto Contraste / Sutil / Oculta"
    >
      <span data-grid-toggle-icon class="material-symbols-outlined text-[18px] text-amber-400">grid_on</span>
    </button>

    <button
      type="button"
      data-measure-btn
      aria-pressed="false"
      class="w-8 h-8 rounded-lg bg-[#18202e] border border-[#222f42] hover:border-amber-500/50 text-[#cbd5e1] hover:text-amber-300 flex items-center justify-center transition-colors duration-150 active:bg-amber-500/20 cursor-pointer"
      title="Regla: arrastra para medir distancias (5 ft por celda)"
    >
      <span class="material-symbols-outlined text-[18px]">straighten</span>
    </button>

    <button
      type="button"
      data-zoom-out-btn
      class="w-8 h-8 rounded-lg bg-[#18202e] border border-[#222f42] hover:border-amber-500/50 text-[#cbd5e1] hover:text-amber-300 flex items-center justify-center transition-colors duration-150 active:bg-amber-500/20 cursor-pointer"
      title="Alejar zoom (−)"
    >
      <span class="material-symbols-outlined text-[18px]">remove</span>
    </button>

    <button
      type="button"
      data-zoom-in-btn
      class="w-8 h-8 rounded-lg bg-[#18202e] border border-[#222f42] hover:border-amber-500/50 text-[#cbd5e1] hover:text-amber-300 flex items-center justify-center transition-colors duration-150 active:bg-amber-500/20 cursor-pointer"
      title="Acercar zoom (+)"
    >
      <span class="material-symbols-outlined text-[18px]">add</span>
    </button>

    <button
      type="button"
      data-fit-btn
      class="w-8 h-8 rounded-lg bg-[#18202e] border border-[#222f42] hover:border-amber-500/50 text-[#cbd5e1] hover:text-amber-300 flex items-center justify-center transition-colors duration-150 active:bg-amber-500/20 cursor-pointer"
      title="Encuadrar mapa completo"
    >
      <span class="material-symbols-outlined text-[18px]">fit_screen</span>
    </button>
  </div>

  <!-- Barra de Herramientas de Niebla del DM (bottom-left) (Fase 4: T-40, T-41) -->
  {mode === 'dm' && (
    <div class="[@media(orientation:portrait)_and_(max-width:639px)]:hidden absolute z-20 pointer-events-auto bottom-14 left-3 right-3 sm:bottom-3 sm:right-auto sm:max-w-[calc(100%-13rem)] overflow-x-auto rounded-2xl [scrollbar-width:none] [&::-webkit-scrollbar]:hidden">
      <FogTools />
    </div>
  )}

  <!-- Overlay de Carga (oculto por defecto para evitar pantallas de carga bloqueadas) -->
  <div
    data-loading-overlay
    class="absolute inset-0 bg-[#0c1017]/90 backdrop-blur-xs flex flex-col items-center justify-center gap-3 z-20 transition-opacity duration-200 pointer-events-none opacity-0 hidden"
  >
    <div class="w-8 h-8 border-2 border-amber-500 border-t-transparent rounded-full animate-spin"></div>
    <span class="text-xs text-[#94a3b8] font-label">Cargando mapa táctico...</span>
  </div>

  <!-- Overlay de "Sin mapa activo" -->
  <div
    data-empty-overlay
    class="absolute inset-0 bg-[#0c1017]/90 backdrop-blur-xs flex flex-col items-center justify-center p-6 text-center z-10 space-y-3 hidden"
  >
    <div class="w-12 h-12 rounded-2xl bg-[#161e2c] border border-[#222f42] flex items-center justify-center text-amber-400/80 shadow-md">
      <span class="material-symbols-outlined text-2xl">explore_off</span>
    </div>
    <div class="space-y-1 max-w-sm">
      <h3 class="text-sm font-headline font-bold text-[#f1f5f9]">No hay mapa activo en la mesa</h3>
      <p class="text-xs text-[#94a3b8]">
        {mode === 'dm'
          ? 'Elige un mapa de la lista o crea uno nuevo con una URL para desplegarlo a los aventureros.'
          : 'El Dungeon Master aún no ha desplegado un mapa táctico para la partida.'}
      </p>
    </div>
  </div>

  <!-- Tarjeta informativa del token (T-55, RF-25) -->
  <TokenInfoCard />

  <!-- Notificación toast flotante de error o aviso (T-34) -->
  <div
    data-map-toast
    class="hidden absolute top-4 left-1/2 -translate-x-1/2 z-30 px-3.5 py-1.5 rounded-xl bg-rose-950/90 border border-rose-500/60 text-rose-200 text-xs font-bold shadow-xl backdrop-blur-md flex items-center gap-2"
  >
    <span class="material-symbols-outlined text-[16px] text-rose-400">error</span>
    <span data-map-toast-msg>No se pudo mover el token</span>
  </div>
</div>

{mode === 'dm' && (
  <p class="hidden [@media(orientation:portrait)_and_(max-width:639px)]:flex items-center justify-center gap-1.5 mt-1.5 text-[11px] text-[#94a3b8] font-label">
    <span class="material-symbols-outlined text-[14px] text-amber-400">screen_rotation</span>
    Para editar la niebla del mapa, gira el móvil a horizontal
  </p>
)}

<script>
  // DECISION (D1): Importación dinámica de Konva para evitar problemas en SSG/Astro build.
  // DECISION (F2-3): watchActiveMap se suscribe únicamente al mapa activo y limpia el listener anterior.
  // DECISION (F2-4): Límites de zoom de 0.1x a 8x y fit automático en apertura.

  import { MapStageController } from '../../scripts/vtt/mapStage.ts';
  import { normalizeStatus } from '../../scripts/vtt/sessionStatus.ts';
  import {
    watchActiveMap,
    subscribeMap,
    listMaps,
    setActiveMap,
    commitTokenMove,
    reconcileTokenOwners,
    addFogShape,
    setFog,
    subscribeDmOnly,
    updateSecretToken,
  } from '../../scripts/data/mapService.ts';
  import { createLivePublisher, subscribeLive, type LivePublisher } from '../../scripts/data/liveService.ts';
  import { campaignStore } from '../../scripts/state/campaignStore.ts';
  import { userStore } from '../../scripts/state/userStore.ts';
  import { subscribeCombat } from '../../scripts/data/combatService.ts';
  import { currentTurnCombatant } from '../../scripts/vtt/initiative.ts';
  import { buildTokenCardData } from '../../scripts/vtt/tokenCard.ts';
  import { getConditionInfo } from '../../scripts/vtt/conditions.ts';
  import type { Combat } from '../../scripts/models/combat.ts';
  import type { MapDoc } from '../../scripts/models/map.ts';

  async function initMapStages() {
    const rootElements = document.querySelectorAll<HTMLElement>('[data-map-stage-root]');

    for (const root of rootElements) {
      if ((root as any).__initialized) continue;
      (root as any).__initialized = true;

      const mode = (root.getAttribute('data-mode') || 'player') as 'dm' | 'player';
      const canvasContainer = root.querySelector<HTMLElement>('[data-canvas-container]');
      const titleEl = root.querySelector<HTMLElement>('[data-map-title]');
      const activeBadgeEl = root.querySelector<HTMLElement>('[data-active-badge]');
      const activateBtn = root.querySelector<HTMLButtonElement>('[data-map-activate-btn]');
      const zoomIndicator = root.querySelector<HTMLElement>('[data-zoom-indicator]');
      const zoomInBtn = root.querySelector<HTMLElement>('[data-zoom-in-btn]');
      const zoomOutBtn = root.querySelector<HTMLElement>('[data-zoom-out-btn]');
      const fitBtn = root.querySelector<HTMLElement>('[data-fit-btn]');
      const loadingOverlay = root.querySelector<HTMLElement>('[data-loading-overlay]');
      const emptyOverlay = root.querySelector<HTMLElement>('[data-empty-overlay]');

      const playerHud = root.querySelector<HTMLElement>('[data-player-character-hud]');
      const hudAvatar = root.querySelector<HTMLImageElement>('[data-player-hud-avatar]');
      const hudName = root.querySelector<HTMLElement>('[data-player-hud-name]');
      const hudBadge = root.querySelector<HTMLElement>('[data-player-hud-badge]');
      const hudSub = root.querySelector<HTMLElement>('[data-player-hud-sub]');
      const hudCenterBtn = root.querySelector<HTMLButtonElement>('[data-player-hud-center-btn]');

      let lastReceivedMap: MapDoc | null = null;

      if (!canvasContainer) continue;

      // Importar Konva dinámicamente en el cliente
      const KonvaModule = await import('konva');
      const Konva = (KonvaModule as any).default || KonvaModule;

      const controller = new MapStageController(canvasContainer, Konva, { mode });
      (root as any).__mapStageController = controller;

      // Actualizar indicador de zoom al cambiar vista
      controller.addEventListener('view-changed', ((e: CustomEvent) => {
        if (zoomIndicator && e.detail?.scale) {
          zoomIndicator.textContent = `${Math.round(e.detail.scale * 100)}%`;
        }
      }) as EventListener);

      // Botones flotantes
      zoomInBtn?.addEventListener('click', () => controller.zoom(1.25));
      zoomOutBtn?.addEventListener('click', () => controller.zoom(0.8));
      fitBtn?.addEventListener('click', () => controller.fit());

      // Elementos del selector desplegable de mapas y cuadrícula
      const dropdownToggle = root.querySelector<HTMLButtonElement>('[data-map-dropdown-toggle]');
      const dropdownMenu = root.querySelector<HTMLElement>('[data-map-dropdown-menu]');
      const dropdownList = root.querySelector<HTMLElement>('[data-map-dropdown-list]');
      const dropdownCount = root.querySelector<HTMLElement>('[data-map-dropdown-count]');
      const dropdownManageBtn = root.querySelector<HTMLButtonElement>('[data-map-dropdown-manage-btn]');
      const gridToggleBtn = root.querySelector<HTMLButtonElement>('[data-grid-toggle-btn]');
      const gridToggleIcon = root.querySelector<HTMLElement>('[data-grid-toggle-icon]');

      // Toggle y sincronización de modo de cuadrícula
      const updateGridBtnUi = (gMode: 'high-contrast' | 'subtle' | 'hidden') => {
        if (!gridToggleIcon || !gridToggleBtn) return;
        if (gMode === 'high-contrast') {
          gridToggleIcon.textContent = 'grid_on';
          gridToggleIcon.className = 'material-symbols-outlined text-[18px] text-amber-400';
          gridToggleBtn.title = 'Cuadrícula: Alto Contraste (clic para sutil)';
        } else if (gMode === 'subtle') {
          gridToggleIcon.textContent = 'grid_4x4';
          gridToggleIcon.className = 'material-symbols-outlined text-[18px] text-[#cbd5e1]';
          gridToggleBtn.title = 'Cuadrícula: Sutil (clic para ocultar)';
        } else {
          gridToggleIcon.textContent = 'grid_off';
          gridToggleIcon.className = 'material-symbols-outlined text-[18px] text-rose-400';
          gridToggleBtn.title = 'Cuadrícula: Oculta (clic para alto contraste)';
        }
      };

      // Regla de medición (T-53): alterna la herramienta 'measure'; el resto de herramientas la desactivan.
      const measureBtn = root.querySelector<HTMLButtonElement>('[data-measure-btn]');
      measureBtn?.addEventListener('click', () => {
        controller.setTool(controller.getTool() === 'measure' ? 'none' : 'measure');
      });
      controller.addEventListener('tool-changed', ((e: CustomEvent) => {
        const on = e.detail?.tool === 'measure';
        measureBtn?.setAttribute('aria-pressed', String(on));
        measureBtn?.classList.toggle('bg-amber-500/25', on);
        measureBtn?.classList.toggle('border-amber-500/60', on);
        measureBtn?.classList.toggle('text-amber-300', on);
      }) as EventListener);

      gridToggleBtn?.addEventListener('click', () => {
        const nextMode = controller.cycleGridMode();
        updateGridBtnUi(nextMode);
      });

      controller.addEventListener('grid-mode-changed', ((e: CustomEvent) => {
        if (e.detail?.mode) updateGridBtnUi(e.detail.mode);
      }) as EventListener);

      // Desplegable de mapas para el DM
      async function populateMapDropdown() {
        const cid = getActiveCampaignId();
        if (!cid || !dropdownList) return;

        const maps = await listMaps(cid);
        const activeCamp = campaignStore.getCampaign(cid);
        const activeId = activeCamp?.activeMapId;

        if (dropdownCount) {
          dropdownCount.textContent = `${maps.length} mapa${maps.length === 1 ? '' : 's'}`;
        }

        if (maps.length === 0) {
          dropdownList.innerHTML = `
            <div class="p-3 text-center text-[#64748b] text-[11px]">
              No hay mapas creados todavía.
            </div>
          `;
          return;
        }

        dropdownList.innerHTML = '';
        maps.forEach((m) => {
          const isActive = m.id === activeId;
          const item = document.createElement('button');
          item.type = 'button';
          item.setAttribute('data-dropdown-map-id', m.id);
          item.className = `w-full flex items-center justify-between gap-2 px-2.5 py-2 rounded-lg text-left transition-colors duration-150 cursor-pointer ${
            isActive
              ? 'bg-amber-500/15 border border-amber-500/30 text-amber-300 font-bold'
              : 'hover:bg-[#18202e] text-[#cbd5e1] hover:text-[#f1f5f9]'
          }`;

          item.innerHTML = `
            <div class="flex items-center gap-2 min-w-0 pointer-events-none">
              <span class="material-symbols-outlined text-[16px] ${isActive ? 'text-amber-400' : 'text-[#64748b]'}">
                ${isActive ? 'check_circle' : 'map'}
              </span>
              <div class="min-w-0">
                <span class="block truncate text-xs font-headline ${isActive ? 'text-amber-200' : 'text-[#f1f5f9]'}">${m.name}</span>
                <span class="block text-[10px] text-[#64748b] font-mono">${m.imageWidth}×${m.imageHeight}px</span>
              </div>
            </div>
            ${isActive ? '<span class="text-[9px] font-bold px-1.5 py-0.5 rounded bg-amber-500/20 text-amber-300 border border-amber-500/40 shrink-0 pointer-events-none">ACTIVO</span>' : (m.id === currentMapId ? '<span class="text-[9px] font-bold px-1.5 py-0.5 rounded bg-cyan-500/15 text-cyan-300 border border-cyan-500/40 shrink-0 pointer-events-none">EDITANDO</span>' : '')}
          `;

          item.addEventListener('click', async (e) => {
            e.stopPropagation();
            dropdownMenu?.classList.add('hidden');
            try {
              if (isActive) {
                // Volver a ver el mapa activo para los jugadores
                if (dmManualMapUnsub) {
                  dmManualMapUnsub();
                  dmManualMapUnsub = null;
                }
                await onMapDocReceived(m);
              } else {
                // Abrir para editar sin activarlo para los jugadores
                window.dispatchEvent(new CustomEvent('open-dm-map', { detail: { cid, mid: m.id } }));
              }
            } catch (err: any) {
              console.error('[MapStage] Error abriendo mapa:', err);
            }
          });

          dropdownList.appendChild(item);
        });
      }

      activateBtn?.addEventListener('click', async (e) => {
        e.stopPropagation();
        const cid = getActiveCampaignId();
        const mid = currentMapId;
        if (!cid || !mid) return;
        try {
          activateBtn.disabled = true;
          await setActiveMap(cid, mid);
        } catch (err: any) {
          console.error('[MapStage] Error activando mapa:', err);
          showNotice('No se pudo activar el mapa.');
        } finally {
          activateBtn.disabled = false;
        }
      });

      dropdownToggle?.addEventListener('click', (e) => {
        e.stopPropagation();
        const isHidden = dropdownMenu?.classList.contains('hidden');
        if (isHidden) {
          populateMapDropdown();
          dropdownMenu?.classList.remove('hidden');
        } else {
          dropdownMenu?.classList.add('hidden');
        }
      });

      document.addEventListener('click', (e) => {
        if (!dropdownMenu || dropdownMenu.classList.contains('hidden')) return;
        if (!dropdownMenu.contains(e.target as Node) && !dropdownToggle?.contains(e.target as Node)) {
          dropdownMenu.classList.add('hidden');
        }
      });

      dropdownManageBtn?.addEventListener('click', () => {
        dropdownMenu?.classList.add('hidden');
        const mapManagerEl = document.getElementById('dm-map-manager-root');
        if (mapManagerEl) {
          mapManagerEl.scrollIntoView({ behavior: 'smooth', block: 'start' });
        }
        window.dispatchEvent(new CustomEvent('open-map-manager'));
      });

      let currentMapId: string | null = null;
      let activeUnsub: (() => void) | null = null;
      let dmManualMapUnsub: (() => void) | null = null;
      let lastActiveMapId: string | null = null;
      let liveUnsub: (() => void) | null = null;
      let dmOnlyUnsub: (() => void) | null = null;
      let currentPublisher: LivePublisher | null = null;

      function syncFogToolsUi(map: MapDoc | null) {
        if (mode !== 'dm') return;
        const fogTools = root.querySelector<HTMLElement>('[data-fog-tools-root]');
        if (!fogTools) return;
        const cid = getActiveCampaignId();
        const camp = cid ? campaignStore.getCampaign(cid) : null;
        const status = camp ? normalizeStatus(camp.status) : 'paused';
        fogTools.dispatchEvent(
          new CustomEvent('update-fog-status', {
            detail: {
              shapesCount: map?.fogRevealed?.length || 0,
              status,
              tool: controller.getTool(),
            },
          })
        );
      }

      function showNotice(msg: string) {
        const toast = root.querySelector<HTMLElement>('[data-map-toast]');
        const msgEl = root.querySelector<HTMLElement>('[data-map-toast-msg]');
        if (toast && msgEl) {
          msgEl.textContent = msg;
          toast.classList.remove('hidden');
          setTimeout(() => {
            toast.classList.add('hidden');
          }, 3500);
        }
      }

      function updateViewerAndStatus() {
        const uid = userStore.getCurrentUser()?.id || null;
        const cid = getActiveCampaignId();
        const camp = cid ? campaignStore.getCampaign(cid) : null;
        const isDm = mode === 'dm' || (cid ? campaignStore.isCurrentUserDm(cid) : false);
        controller.setViewer({ uid, isDm });
        if (camp?.status) {
          controller.setStatus(camp.status);
        } else if (!cid) {
          controller.setStatus('paused');
        }
        syncFogToolsUi(lastReceivedMap);
      }

      updateViewerAndStatus();

      window.addEventListener('session-status-changed', ((e: CustomEvent) => {
        if (e.detail?.status) {
          controller.setStatus(e.detail.status);
          syncFogToolsUi(lastReceivedMap);
        }
      }) as EventListener);

      window.addEventListener('user-changed', updateViewerAndStatus);
      window.addEventListener('campaigns-updated', updateViewerAndStatus);
      window.addEventListener('active-campaign-changed', updateViewerAndStatus);
      window.addEventListener('cloud-session-changed', updateViewerAndStatus);

      // Manejo de arrastre de tokens (T-31, T-32, T-34)
      controller.addEventListener('token-drag-start', (async (e: CustomEvent) => {
        const { tid } = e.detail;
        const cid = getActiveCampaignId();
        if (!cid || !currentMapId) return;
        const camp = campaignStore.getCampaign(cid);
        const roomId = camp?.liveRoomId;
        const uid = userStore.getCurrentUser()?.id || '';
        if (!roomId || !uid) return;

        currentPublisher = createLivePublisher(roomId, currentMapId, tid, uid);
        await currentPublisher.start();
      }) as EventListener);

      controller.addEventListener('token-drag-move', ((e: CustomEvent) => {
        const { x, y } = e.detail;
        if (currentPublisher) {
          currentPublisher.move(x, y);
        }
      }) as EventListener);

      controller.addEventListener('token-drag-end', (async (e: CustomEvent) => {
        const { tid, x, y } = e.detail;
        const cid = getActiveCampaignId();
        if (!cid || !currentMapId) {
          if (currentPublisher) {
            await currentPublisher.end();
            currentPublisher = null;
          }
          return;
        }

        try {
          // 1. Escritura en Firestore primero (T-34)
          await commitTokenMove(cid, currentMapId, tid, x, y);
        } catch (err: any) {
          console.error('[MapStage] Error guardando movimiento de token:', err);
          controller.revertTokenMove(tid);
          showNotice('No se pudo mover el token');
        } finally {
          // 2. Borrado del nodo live en RTDB después de Firestore (T-34)
          if (currentPublisher) {
            await currentPublisher.end();
            currentPublisher = null;
          }
        }
      }) as EventListener);

      controller.addEventListener('token-select', ((e: CustomEvent) => {
        window.dispatchEvent(new CustomEvent('token-selected', { detail: e.detail }));
        showTokenCard(e.detail?.tid);
      }) as EventListener);

      // --- Combate: pulso de turno (RF-05) y tarjeta del token (RF-25) ---
      // DECISION (F5-5): cada MapStage usa subscribeCombat, que ya mantiene un único listener de Firestore por campaña.
      let lastCombat: Combat | null = null;
      let combatUnsub: (() => void) | null = null;
      let combatCid: string | null = null;
      const card = root.querySelector<HTMLElement>('[data-token-card]');
      let cardTid: string | null = null;

      function hideTokenCard() {
        cardTid = null;
        card?.classList.add('hidden');
      }

      function showTokenCard(tid?: string) {
        const token = tid && lastReceivedMap?.tokens ? lastReceivedMap.tokens[tid] : null;
        if (!card || !tid || !token) return hideTokenCard();
        cardTid = tid;
        renderTokenCard();
      }

      function renderTokenCard() {
        if (!card || !cardTid) return;
        const token = lastReceivedMap?.tokens?.[cardTid];
        const anchor = controller.getTokenAnchor(cardTid);
        if (!token || !anchor) return hideTokenCard();

        const cid = getActiveCampaignId();
        const viewer = {
          uid: userStore.getCurrentUser()?.id || null,
          isDm: mode === 'dm' || (cid ? campaignStore.isCurrentUserDm(cid) : false),
        };
        const data = buildTokenCardData(lastCombat, cardTid, token, viewer);

        card.querySelector('[data-token-card-name]')!.textContent = data.name;
        const hpBox = card.querySelector<HTMLElement>('[data-token-card-hp]');
        if (hpBox) {
          hpBox.classList.toggle('hidden', !data.hp);
          hpBox.classList.toggle('flex', Boolean(data.hp));
          const txt = hpBox.querySelector('[data-token-card-hp-text]');
          if (txt && data.hp) txt.textContent = `${data.hp.hp} / ${data.hp.maxHp} PG`;
        }
        const conds = card.querySelector<HTMLElement>('[data-token-card-conds]');
        if (conds) {
          conds.replaceChildren();
          data.conditions.forEach((id) => {
            const info = getConditionInfo(id);
            const chip = document.createElement('span');
            chip.className = `inline-flex items-center gap-0.5 px-1.5 py-0.5 rounded text-[9px] font-bold border ${info.color}`;
            chip.textContent = info.name;
            conds.appendChild(chip);
          });
        }

        // Se ancla sobre el token; si no entra arriba, se muestra debajo.
        const above = anchor.y - anchor.r - 8 > 70;
        card.style.left = `${Math.min(Math.max(anchor.x, 96), root.clientWidth - 96)}px`;
        card.style.top = `${above ? anchor.y - anchor.r - 8 : anchor.y + anchor.r + 8 + (card.offsetHeight || 60)}px`;
        card.classList.remove('hidden');
      }

      function applyTurnHighlight() {
        const tid = currentTurnCombatant(lastCombat)?.tokenId ?? null;
        controller.setTurnToken(tid);
      }

      function bindCombat() {
        const cid = getActiveCampaignId();
        if (!cid || cid === combatCid) return;
        combatUnsub?.();
        combatCid = cid;
        lastCombat = null;
        hideTokenCard();
        combatUnsub = subscribeCombat(cid, (combat) => {
          lastCombat = combat;
          applyTurnHighlight();
          renderTokenCard();
        });
      }

      bindCombat();
      window.addEventListener('active-campaign-changed', bindCombat);
      window.addEventListener('campaigns-updated', bindCombat);
      controller.addEventListener('view-changed', hideTokenCard);
      document.addEventListener('keydown', (ev) => {
        if (ev.key === 'Escape') hideTokenCard();
      });
      document.addEventListener('pointerdown', (ev) => {
        if (cardTid && card && !card.contains(ev.target as Node)) hideTokenCard();
      });

      controller.addEventListener('token-locked', ((e: CustomEvent) => {
        const msg = e.detail?.message || 'No se puede mover el token en este momento';
        showNotice(msg);
      }) as EventListener);

      window.addEventListener('map-center-token', ((e: CustomEvent) => {
        const tid = e.detail?.tid;
        if (tid) {
          controller.centerOnToken(tid);
        }
      }) as EventListener);

      controller.addEventListener('map-click', ((e: CustomEvent) => {
        window.dispatchEvent(new CustomEvent('map-click', { detail: e.detail }));
      }) as EventListener);

      window.addEventListener('token-placement-mode', ((e: CustomEvent) => {
        const active = Boolean(e.detail?.active);
        controller.setPlacementMode(active);
        if (canvasContainer) {
          if (active) {
            canvasContainer.classList.add('cursor-crosshair', 'ring-2', 'ring-amber-500/50');
            canvasContainer.classList.remove('cursor-grab', 'active:cursor-grabbing');
          } else {
            canvasContainer.classList.remove('cursor-crosshair', 'ring-2', 'ring-amber-500/50');
            canvasContainer.classList.add('cursor-grab', 'active:cursor-grabbing');
          }
        }
      }) as EventListener);

      // Eventos de niebla de guerra (T-40, T-41)
      controller.addEventListener('fog-shape', (async (e: CustomEvent) => {
        const { shape } = e.detail;
        const cid = getActiveCampaignId();
        if (!cid || !currentMapId) return;
        try {
          const currentList = lastReceivedMap?.fogRevealed || [];
          const res = await addFogShape(cid, currentMapId, currentList, shape);
          if (res.warn) {
            showNotice('Niebla: se han aplicado más de 450 formas. Conviene "Cubrir todo" y rehacer.');
          }
        } catch (err: any) {
          console.error('[MapStage] Error guardando forma de niebla:', err);
          showNotice(err.message || 'No se pudo guardar la niebla');
        }
      }) as EventListener);

      root.addEventListener('fog-tool-select', ((e: CustomEvent) => {
        controller.setTool(e.detail.tool);
      }) as EventListener);

      root.addEventListener('fog-brush-size', ((e: CustomEvent) => {
        const mult = Number(e.detail.multiplier) || 1;
        const cellSize = (lastReceivedMap && lastReceivedMap.grid && lastReceivedMap.grid.size) || 50;
        const newRadius = Math.max(6, Math.round((cellSize / 2) * mult));
        controller.setBrushRadius(newRadius);
      }) as EventListener);

      root.addEventListener('fog-action-reveal-all', (async () => {
        const cid = getActiveCampaignId();
        if (!cid || !currentMapId || !lastReceivedMap) return;
        try {
          await setFog(cid, currentMapId, [
            { kind: 'rect', x: 0, y: 0, w: lastReceivedMap.imageWidth, h: lastReceivedMap.imageHeight },
          ]);
        } catch (err: any) {
          console.error('[MapStage] Error revelando todo el mapa:', err);
          showNotice(err.message || 'No se pudo guardar la niebla');
        }
      }) as EventListener);

      root.addEventListener('fog-action-cover-all', (async () => {
        const cid = getActiveCampaignId();
        if (!cid || !currentMapId) return;
        try {
          await setFog(cid, currentMapId, []);
        } catch (err: any) {
          console.error('[MapStage] Error cubriendo todo el mapa:', err);
          showNotice(err.message || 'No se pudo guardar la niebla');
        }
      }) as EventListener);

      root.addEventListener('fog-toggle-player-view', ((e: CustomEvent) => {
        controller.setPlayerFogView(Boolean(e.detail.enabled));
      }) as EventListener);

      controller.addEventListener('tool-changed', ((e: CustomEvent) => {
        const fogTools = root.querySelector<HTMLElement>('[data-fog-tools-root]');
        fogTools?.dispatchEvent(new CustomEvent('update-fog-status', { detail: { tool: e.detail.tool } }));
      }) as EventListener);

      // Eventos de tokens secretos (T-42)
      controller.addEventListener('secret-token-drag-end', (async (e: CustomEvent) => {
        const { tid, x, y } = e.detail;
        const cid = getActiveCampaignId();
        if (!cid || !currentMapId) return;
        try {
          await updateSecretToken(cid, currentMapId, tid, { x, y });
        } catch (err: any) {
          console.error('[MapStage] Error guardando posición de token secreto:', err);
          showNotice('No se pudo guardar la posición del token secreto');
        }
      }) as EventListener);

      function showLoading(show: boolean) {
        if (!loadingOverlay) return;
        if (show) {
          loadingOverlay.classList.remove('opacity-0', 'pointer-events-none', 'hidden');
          loadingOverlay.classList.add('opacity-100');
        } else {
          loadingOverlay.classList.remove('opacity-100');
          loadingOverlay.classList.add('opacity-0', 'pointer-events-none');
          setTimeout(() => {
            if (loadingOverlay.classList.contains('opacity-0')) {
              loadingOverlay.classList.add('hidden');
            }
          }, 250);
        }
      }

      function updateTitle(map: MapDoc | null) {
        const activeCampId = getActiveCampaignId();
        const camp = activeCampId ? campaignStore.getCampaign(activeCampId) : null;
        const isActive = Boolean(camp && map && camp.activeMapId === map.id);

        if (titleEl) {
          titleEl.textContent = map ? map.name : 'Sin mapa activo';
        }
        if (activeBadgeEl) {
          if (isActive) {
            activeBadgeEl.classList.remove('hidden');
          } else {
            activeBadgeEl.classList.add('hidden');
          }
        }
        if (activateBtn) {
          const showActivate = mode === 'dm' && Boolean(map) && !isActive;
          activateBtn.classList.toggle('hidden', !showActivate);
          activateBtn.classList.toggle('flex', showActivate);
        }
        if (dropdownMenu && !dropdownMenu.classList.contains('hidden') && dropdownList) {
          const activeMid = map ? map.id : null;
          dropdownList.querySelectorAll<HTMLButtonElement>('[data-dropdown-map-id]').forEach((btn) => {
            const btnMid = btn.getAttribute('data-dropdown-map-id');
            const isItemActive = btnMid === activeMid;
            btn.className = `w-full flex items-center justify-between gap-2 px-2.5 py-2 rounded-lg text-left transition-colors duration-150 cursor-pointer ${
              isItemActive
                ? 'bg-amber-500/15 border border-amber-500/30 text-amber-300 font-bold'
                : 'hover:bg-[#18202e] text-[#cbd5e1] hover:text-[#f1f5f9]'
            }`;
          });
        }
      }

      function updatePlayerHud(map: MapDoc | null) {
        if (!playerHud) return;
        const activeCampId = getActiveCampaignId();
        if (!activeCampId) {
          playerHud.classList.add('hidden');
          return;
        }

        const user = userStore.getCurrentUser();
        const currentUid = user?.id || null;
        if (!user || !currentUid) {
          playerHud.classList.add('hidden');
          return;
        }

        const camp = campaignStore.getCampaign(activeCampId);
        // Si el usuario es DM, ocultar este HUD de aventurero propio
        if (camp && (camp.dmId === currentUid || campaignStore.isCurrentUserDm(activeCampId))) {
          playerHud.classList.add('hidden');
          return;
        }

        const characters = campaignStore.getCharactersForCampaign(activeCampId);
        const myChar = characters.find(
          (c) => c.playerId === currentUid || (user.email && c.playerEmail === user.email)
        );

        if (!myChar) {
          playerHud.classList.add('hidden');
          return;
        }

        playerHud.classList.remove('hidden');
        if (hudAvatar) hudAvatar.src = myChar.avatarUrl || '/characters/ch-1.avif';
        if (hudName) hudName.textContent = myChar.name;

        const tokens = map?.tokens || {};
        const myTokenEntry = Object.entries(tokens).find(
          ([_, t]) =>
            t.ownerUid === currentUid ||
            (myChar && t.characterId === myChar.id) ||
            (myChar && t.name.toLowerCase() === myChar.name.toLowerCase())
        );

        const status = camp ? normalizeStatus(camp.status) : 'paused';

        if (myTokenEntry) {
          const [myTid] = myTokenEntry;
          if (hudSub) hudSub.textContent = 'Token en el mapa';
          if (hudCenterBtn) {
            hudCenterBtn.classList.remove('hidden');
            hudCenterBtn.onclick = () => {
              controller.centerOnToken(myTid);
            };
          }

          if (hudBadge) {
            if (status === 'active') {
              hudBadge.textContent = 'Listo para mover';
              hudBadge.className =
                'px-1.5 py-0.5 rounded text-[9px] font-bold bg-emerald-500/20 text-emerald-300 border border-emerald-500/40 shrink-0';
            } else if (status === 'paused') {
              hudBadge.textContent = 'En pausa (espera al DM)';
              hudBadge.className =
                'px-1.5 py-0.5 rounded text-[9px] font-bold bg-amber-500/20 text-amber-300 border border-amber-500/40 shrink-0';
            } else {
              hudBadge.textContent = 'Terminada';
              hudBadge.className =
                'px-1.5 py-0.5 rounded text-[9px] font-bold bg-slate-500/20 text-slate-300 border border-slate-500/40 shrink-0';
            }
          }
        } else {
          if (hudSub) hudSub.textContent = 'Sin token desplegado';
          if (hudCenterBtn) hudCenterBtn.classList.add('hidden');
          if (hudBadge) {
            hudBadge.textContent = 'Esperando al DM';
            hudBadge.className =
              'px-1.5 py-0.5 rounded text-[9px] font-bold bg-slate-500/20 text-slate-400 border border-slate-500/30 shrink-0';
          }
        }
      }

      // Cambio de mapa (T-24). Sin fundido a opacidad 0: setMap precarga la imagen
      // antes de reemplazar la anterior, así el lienzo nunca queda en negro.
      let transitionSeq = 0;
      let pendingMapId: string | null = null;
      async function onMapDocReceived(map: MapDoc | null) {
        lastReceivedMap = map;
        try {
          if (!map) {
            transitionSeq++;
            pendingMapId = null;
            if (liveUnsub) {
              liveUnsub();
              liveUnsub = null;
            }
            if (dmOnlyUnsub) {
              dmOnlyUnsub();
              dmOnlyUnsub = null;
            }
            currentMapId = null;
            await controller.setMap(null);
            updateTitle(null);
            updatePlayerHud(null);
            syncFogToolsUi(null);
            emptyOverlay?.classList.remove('hidden');
            return;
          }

          emptyOverlay?.classList.add('hidden');
          updateTitle(map);

          // Mismo mapa ya cargado: actualizar grilla, tokens y niebla sin reiniciar el stage
          if (currentMapId === map.id) {
            controller.setGrid(map.grid);
            controller.setTokens(map.tokens || {});
            controller.setFog(map.fogRevealed || []);
            syncFogToolsUi(map);
            updatePlayerHud(map);
            const cid = getActiveCampaignId();
            if (mode === 'dm' && cid) {
              reconcileTokenOwners(cid, map.id, map);
            }
            return;
          }

          // Carga del mismo mapa ya en curso: ignorar el duplicado
          if (pendingMapId === map.id) return;

          const seq = ++transitionSeq;
          pendingMapId = map.id;
          const isStale = () => seq !== transitionSeq;

          if (liveUnsub) {
            liveUnsub();
            liveUnsub = null;
          }
          if (dmOnlyUnsub) {
            dmOnlyUnsub();
            dmOnlyUnsub = null;
          }

          try {
            await controller.setMap(map);
          } catch (err) {
            console.error('[MapStage] Error cargando mapa:', err);
            if (!isStale()) pendingMapId = null;
            return;
          }
          if (isStale()) return;

          pendingMapId = null;
          currentMapId = map.id;
          updatePlayerHud(map);
          controller.fit();
          syncFogToolsUi(map);

          // Suscribirse a dmOnly si es DM (T-42)
          const dmCid = getActiveCampaignId();
          if (mode === 'dm' && dmCid && map.id) {
            dmOnlyUnsub = subscribeDmOnly(dmCid, map.id, (dmOnly) => {
              controller.setSecretTokens(dmOnly.secretTokens || {});
              window.dispatchEvent(
                new CustomEvent('dm-only-changed', {
                  detail: { cid: dmCid, mid: map.id, dmOnly },
                })
              );
            });
          }

          // Suscribirse a live tokens en RTDB (T-32, T-33)
          const camp = dmCid ? campaignStore.getCampaign(dmCid) : null;
          const roomId = camp?.liveRoomId;
          const uid = userStore.getCurrentUser()?.id || '';

          if (roomId && map.id) {
            liveUnsub = subscribeLive(roomId, map.id, uid, (tid, pos) => {
              controller.applyRemoteLiveMove(tid, pos);
            });
          }

          if (mode === 'dm' && dmCid) {
            reconcileTokenOwners(dmCid, map.id, map);
          }
        } finally {
          showLoading(false);
        }
      }

      // Suscripción al mapa activo de la campaña
      function bindCampaignMaps(cid: string) {
        if (activeUnsub) {
          activeUnsub();
          activeUnsub = null;
        }
        if (dmManualMapUnsub) {
          dmManualMapUnsub();
          dmManualMapUnsub = null;
        }
        lastActiveMapId = null;
        if (liveUnsub) {
          liveUnsub();
          liveUnsub = null;
        }
        if (dmOnlyUnsub) {
          dmOnlyUnsub();
          dmOnlyUnsub = null;
        }

        showLoading(true);

        // Temporizador de seguridad: si tras 3.5s no ha respondido nada, desbloquear spinner
        const safetyTimer = setTimeout(() => {
          showLoading(false);
        }, 3500);

        activeUnsub = watchActiveMap(cid, (map) => {
          clearTimeout(safetyTimer);
          const newActiveId = map ? map.id : null;
          const activeChanged = newActiveId !== lastActiveMapId;
          lastActiveMapId = newActiveId;
          if (map) {
            // Si el DM edita otro mapa, los snapshots del activo no le quitan la vista;
            // solo la pierde si cambia el mapa activo.
            if (dmManualMapUnsub && !activeChanged) return;
            if (dmManualMapUnsub) {
              dmManualMapUnsub();
              dmManualMapUnsub = null;
            }
            onMapDocReceived(map);
          } else if (!dmManualMapUnsub) {
            onMapDocReceived(null);
          }
        });
      }

      // Sincronización cuando se cambia el mapa activo
      window.addEventListener('active-map-changed', ((e: CustomEvent<{ cid?: string; mid?: string }>) => {
        if (dmManualMapUnsub) {
          dmManualMapUnsub();
          dmManualMapUnsub = null;
        }
        const targetMid = e.detail?.mid;
        const targetCid = e.detail?.cid || currentCid;
        if (targetMid && targetCid) {
          listMaps(targetCid).then((maps) => {
            const found = maps.find((m) => m.id === targetMid);
            if (found) {
              onMapDocReceived(found);
            }
          });
        }
      }) as EventListener);

      // El DM puede abrir e inspeccionar mapas que no son el activo (T-24)
      if (mode === 'dm') {
        window.addEventListener('open-dm-map', ((e: CustomEvent<{ cid: string; mid: string }>) => {
          if (!e.detail || !e.detail.cid || !e.detail.mid) return;
          const { cid, mid } = e.detail;

          if (dmManualMapUnsub) {
            dmManualMapUnsub();
            dmManualMapUnsub = null;
          }

          showLoading(true);
          const safetyTimer = setTimeout(() => showLoading(false), 3500);

          dmManualMapUnsub = subscribeMap(cid, mid, (map) => {
            clearTimeout(safetyTimer);
            onMapDocReceived(map);
          });
        }) as EventListener);
      }

      function getActiveCampaignId(): string | null {
        let cid = campaignStore.getActiveCampaignId();
        if (!cid && typeof window !== 'undefined') {
          const params = new URLSearchParams(window.location.search);
          cid = params.get('id') || params.get('campaign');
        }
        return cid;
      }

      // Inicializar con la campaña activa
      let currentCid = getActiveCampaignId();
      if (currentCid) {
        bindCampaignMaps(currentCid);
      } else {
        showLoading(false);
        emptyOverlay?.classList.remove('hidden');
      }

      function handleCampaignSwitch(newCid: string | null) {
        if (!newCid || newCid === currentCid) return;
        currentCid = newCid;
        bindCampaignMaps(currentCid);
      }

      window.addEventListener('campaigns-updated', () => {
        handleCampaignSwitch(getActiveCampaignId());
        updatePlayerHud(lastReceivedMap);
      });
      window.addEventListener('active-campaign-changed', ((e: CustomEvent) => {
        handleCampaignSwitch(e.detail?.campaignId || getActiveCampaignId());
        updatePlayerHud(lastReceivedMap);
      }) as EventListener);
      window.addEventListener('user-changed', () => {
        updatePlayerHud(lastReceivedMap);
      });
      window.addEventListener('maps-updated', () => {
        if (dropdownMenu && !dropdownMenu.classList.contains('hidden') && dropdownList) {
          const activeMid = lastReceivedMap ? lastReceivedMap.id : null;
          dropdownList.querySelectorAll<HTMLButtonElement>('[data-dropdown-map-id]').forEach((btn) => {
            const btnMid = btn.getAttribute('data-dropdown-map-id');
            const isItemActive = btnMid === activeMid;
            btn.className = `w-full flex items-center justify-between gap-2 px-2.5 py-2 rounded-lg text-left transition-colors duration-150 cursor-pointer ${
              isItemActive
                ? 'bg-amber-500/15 border border-amber-500/30 text-amber-300 font-bold'
                : 'hover:bg-[#18202e] text-[#cbd5e1] hover:text-[#f1f5f9]'
            }`;
          });
        }
      });
    }
  }

  // Ejecutar cuando el DOM esté listo
  if (typeof document !== 'undefined') {
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', () => initMapStages());
    } else {
      initMapStages();
    }
  }
</script>
