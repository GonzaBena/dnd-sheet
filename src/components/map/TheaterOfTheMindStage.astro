---
// src/components/map/TheaterOfTheMindStage.astro
// Tablero interactivo de combate abstracto para el Modo Teatro de la Mente (Spec 14, H7, Fase C).
// Permite ubicar combatientes en 3 zonas tácticas (Melé 5ft, Cerca 30ft, Lejos 60ft) y sincroniza distancias.
---

<div id="totm-stage-root" class="relative w-full rounded-2xl bg-[#0c1017] border border-[#222f42] p-3 sm:p-5 flex flex-col justify-between gap-3 sm:gap-4 select-none shadow-inner">
  <!-- Cabecera de Teatro de la Mente -->
  <div class="flex items-center justify-between gap-2 pb-2.5 border-b border-[#222f42]">
    <div class="flex items-center gap-2">
      <div class="w-8 h-8 rounded-xl bg-purple-500/15 border border-purple-500/30 flex items-center justify-center text-purple-400 shrink-0">
        <span class="material-symbols-outlined text-[18px]">theater_comedy</span>
      </div>
      <div>
        <h3 class="text-xs sm:text-sm font-headline font-bold text-[#f1f5f9] flex items-center gap-1.5 sm:gap-2">
          <span>Teatro de la Mente</span>
          <span class="hidden sm:inline px-1.5 py-0.5 rounded-full bg-purple-500/20 text-purple-300 border border-purple-500/30 text-[9px] font-mono font-bold">
            Sin Cuadrícula
          </span>
        </h3>
        <p class="hidden sm:block text-[10px] text-[#94a3b8] font-label">
          Zonas conceptuales con cálculo automático de distancias 5e
        </p>
      </div>
    </div>

    <!-- Acciones rápidas -->
    <div class="flex items-center gap-2 font-label text-xs">
      <button
        type="button"
        id="totm-reset-btn"
        class="px-2.5 py-1 rounded-lg bg-[#18202e] hover:bg-[#222f42] text-[#94a3b8] hover:text-[#f1f5f9] border border-[#222f42] text-[11px] font-bold transition-colors cursor-pointer"
        title="Reagrupar combatientes"
      >
        Reagrupar
      </button>
    </div>
  </div>

  <!-- Selector de Pestañas Táctiles para Móvil (Spec 14, Refinamiento) -->
  <div id="totm-mobile-tabs" class="grid grid-cols-3 gap-1 md:hidden p-1 rounded-xl bg-[#10141d] border border-[#222f42] text-xs font-headline">
    <button
      type="button"
      data-totm-tab="melee"
      class="totm-tab-btn py-1.5 px-2 rounded-lg text-center font-bold text-[11px] transition-all cursor-pointer flex items-center justify-center gap-1 bg-amber-500/20 text-amber-300 border border-amber-500/40"
    >
      <span class="material-symbols-outlined text-[14px]">swords</span>
      <span>Melé (<span id="totm-tab-count-melee">0</span>)</span>
    </button>
    <button
      type="button"
      data-totm-tab="near"
      class="totm-tab-btn py-1.5 px-2 rounded-lg text-center font-bold text-[11px] transition-all cursor-pointer flex items-center justify-center gap-1 text-[#94a3b8] hover:text-[#f1f5f9]"
    >
      <span class="material-symbols-outlined text-[14px]">directions_run</span>
      <span>Cerca (<span id="totm-tab-count-near">0</span>)</span>
    </button>
    <button
      type="button"
      data-totm-tab="far"
      class="totm-tab-btn py-1.5 px-2 rounded-lg text-center font-bold text-[11px] transition-all cursor-pointer flex items-center justify-center gap-1 text-[#94a3b8] hover:text-[#f1f5f9]"
    >
      <span class="material-symbols-outlined text-[14px]">explore</span>
      <span>Lejos (<span id="totm-tab-count-far">0</span>)</span>
    </button>
  </div>

  <!-- Las 3 Zonas Tácticas (Grid de 3 Columnas en md+, Pestaña Activa en móvil) -->
  <div class="grid grid-cols-1 md:grid-cols-3 gap-3 flex-1 items-stretch">
    <!-- 1. ZONA MELÉ (CUERPO A CUERPO • 5 FT) -->
    <div
      class="totm-zone-card flex md:flex flex-col justify-between gap-2.5 rounded-2xl bg-[#121721] border-2 border-amber-500/30 hover:border-amber-500/50 p-3 sm:p-3.5 transition-colors shadow-sm"
      data-zone="melee"
    >
      <div class="space-y-1 pb-1.5 sm:pb-2 border-b border-[#222f42]/60">
        <div class="flex items-center justify-between">
          <span class="text-xs font-headline font-bold text-amber-300 flex items-center gap-1.5 uppercase tracking-wider">
            <span class="material-symbols-outlined text-[16px] text-amber-400">swords</span>
            <span>Cuerpo a Cuerpo</span>
          </span>
          <span class="px-2 py-0.5 rounded-md bg-amber-500/20 text-amber-300 font-mono text-[10px] font-bold">
            5 ft
          </span>
        </div>
        <p class="hidden sm:block text-[10px] text-[#94a3b8] leading-tight">
          Trabados directamente. Armas a distancia sufren desventaja.
        </p>
      </div>

      <!-- Contenedor de tokens en Melé -->
      <div id="totm-zone-melee" class="totm-drop-area flex-1 min-h-[130px] max-h-[300px] md:max-h-[360px] space-y-2 p-1 rounded-xl bg-[#0e131b]/70 border border-dashed border-[#222f42]/70 overflow-y-auto no-scrollbar">
        <!-- Poblado dinámicamente -->
      </div>
    </div>

    <!-- 2. ZONA CERCANA (MEDIO ALCANCE • 30 FT) -->
    <div
      class="totm-zone-card hidden md:flex flex-col justify-between gap-2.5 rounded-2xl bg-[#121721] border-2 border-sky-500/30 hover:border-sky-500/50 p-3 sm:p-3.5 transition-colors shadow-sm"
      data-zone="near"
    >
      <div class="space-y-1 pb-1.5 sm:pb-2 border-b border-[#222f42]/60">
        <div class="flex items-center justify-between">
          <span class="text-xs font-headline font-bold text-sky-300 flex items-center gap-1.5 uppercase tracking-wider">
            <span class="material-symbols-outlined text-[16px] text-sky-400">directions_run</span>
            <span>Rango Cercano</span>
          </span>
          <span class="px-2 py-0.5 rounded-md bg-sky-500/20 text-sky-300 font-mono text-[10px] font-bold">
            30 ft
          </span>
        </div>
        <p class="hidden sm:block text-[10px] text-[#94a3b8] leading-tight">
          A un movimiento normal. Ideal para proyectiles y apoyo.
        </p>
      </div>

      <!-- Contenedor de tokens en Rango Cercano -->
      <div id="totm-zone-near" class="totm-drop-area flex-1 min-h-[130px] max-h-[300px] md:max-h-[360px] space-y-2 p-1 rounded-xl bg-[#0e131b]/70 border border-dashed border-[#222f42]/70 overflow-y-auto no-scrollbar">
        <!-- Poblado dinámicamente -->
      </div>
    </div>

    <!-- 3. ZONA LEJANA (LARGO ALCANCE • 60+ FT) -->
    <div
      class="totm-zone-card hidden md:flex flex-col justify-between gap-2.5 rounded-2xl bg-[#121721] border-2 border-purple-500/30 hover:border-purple-500/50 p-3 sm:p-3.5 transition-colors shadow-sm"
      data-zone="far"
    >
      <div class="space-y-1 pb-1.5 sm:pb-2 border-b border-[#222f42]/60">
        <div class="flex items-center justify-between">
          <span class="text-xs font-headline font-bold text-purple-300 flex items-center gap-1.5 uppercase tracking-wider">
            <span class="material-symbols-outlined text-[16px] text-purple-400">explore</span>
            <span>Largo Alcance</span>
          </span>
          <span class="px-2 py-0.5 rounded-md bg-purple-500/20 text-purple-300 font-mono text-[10px] font-bold">
            60+ ft
          </span>
        </div>
        <p class="hidden sm:block text-[10px] text-[#94a3b8] leading-tight">
          Francotiradores, conjuros de gran alcance y refuerzos.
        </p>
      </div>

      <!-- Contenedor de tokens en Rango Lejano -->
      <div id="totm-zone-far" class="totm-drop-area flex-1 min-h-[130px] max-h-[300px] md:max-h-[360px] space-y-2 p-1 rounded-xl bg-[#0e131b]/70 border border-dashed border-[#222f42]/70 overflow-y-auto no-scrollbar">
        <!-- Poblado dinámicamente -->
      </div>
    </div>
  </div>

  <!-- Pie explicativo táctico -->
  <div class="hidden sm:flex items-center justify-between text-[11px] text-[#94a3b8] font-mono pt-1">
    <span>Distancia relativa calculada automáticamente</span>
    <span class="text-amber-400">Melé ➔ Melé: 5 ft • Melé ➔ Cerca: 30 ft • Melé ➔ Lejos: 60 ft</span>
  </div>
</div>

<script>
  import { campaignStore } from '../../scripts/state/campaignStore';
  import type { TotmZone } from '../../scripts/models/map';

  const zoneMeleeEl = document.getElementById('totm-zone-melee');
  const zoneNearEl = document.getElementById('totm-zone-near');
  const zoneFarEl = document.getElementById('totm-zone-far');
  const resetBtn = document.getElementById('totm-reset-btn');

  let currentMobileTab: TotmZone = 'melee';
  const tabBtns = document.querySelectorAll<HTMLButtonElement>('.totm-tab-btn');
  const zoneCards = document.querySelectorAll<HTMLElement>('.totm-zone-card');

  function setMobileZoneTab(zone: TotmZone) {
    currentMobileTab = zone;
    tabBtns.forEach((btn) => {
      const bz = btn.getAttribute('data-totm-tab') as TotmZone;
      const isActive = bz === zone;
      if (isActive) {
        if (zone === 'melee') {
          btn.className = 'totm-tab-btn py-1.5 px-2 rounded-lg text-center font-bold text-[11px] transition-all cursor-pointer flex items-center justify-center gap-1 bg-amber-500/20 text-amber-300 border border-amber-500/40';
        } else if (zone === 'near') {
          btn.className = 'totm-tab-btn py-1.5 px-2 rounded-lg text-center font-bold text-[11px] transition-all cursor-pointer flex items-center justify-center gap-1 bg-sky-500/20 text-sky-300 border border-sky-500/40';
        } else {
          btn.className = 'totm-tab-btn py-1.5 px-2 rounded-lg text-center font-bold text-[11px] transition-all cursor-pointer flex items-center justify-center gap-1 bg-purple-500/20 text-purple-300 border border-purple-500/40';
        }
      } else {
        btn.className = 'totm-tab-btn py-1.5 px-2 rounded-lg text-center font-bold text-[11px] transition-all cursor-pointer flex items-center justify-center gap-1 text-[#94a3b8] hover:text-[#f1f5f9]';
      }
    });

    zoneCards.forEach((card) => {
      const cardZone = card.getAttribute('data-zone') as TotmZone;
      if (cardZone === zone) {
        card.classList.remove('hidden');
        card.classList.add('flex');
      } else {
        card.classList.add('hidden');
        card.classList.remove('flex');
      }
    });
  }

  tabBtns.forEach((btn) => {
    btn.addEventListener('click', () => {
      const z = btn.getAttribute('data-totm-tab') as TotmZone;
      if (z) setMobileZoneTab(z);
    });
  });

  function getStorageKey(): string {
    const cid = campaignStore.getActiveCampaignId() || 'default';
    return `dnd_totm_zones_${cid}`;
  }

  export function getSavedZones(): Record<string, TotmZone> {
    try {
      const data = localStorage.getItem(getStorageKey());
      return data ? JSON.parse(data) : {};
    } catch (_) {
      return {};
    }
  }

  export function saveZones(zones: Record<string, TotmZone>) {
    try {
      localStorage.setItem(getStorageKey(), JSON.stringify(zones));
      window.dispatchEvent(new CustomEvent('totm-zones-updated', { detail: { zones } }));
    } catch (_) {}
  }

  export function moveCombatantToZone(combatantId: string, zone: TotmZone) {
    const zones = getSavedZones();
    zones[combatantId] = zone;
    saveZones(zones);
    renderTheaterOfTheMind();
  }

  export function renderTheaterOfTheMind() {
    if (!zoneMeleeEl || !zoneNearEl || !zoneFarEl) return;

    zoneMeleeEl.innerHTML = '';
    zoneNearEl.innerHTML = '';
    zoneFarEl.innerHTML = '';

    const cid = campaignStore.getActiveCampaignId();
    const characters = cid ? campaignStore.getCharactersForCampaign(cid) : [];
    const zones = getSavedZones();

    const badgeMelee = document.getElementById('totm-tab-count-melee');
    const badgeNear = document.getElementById('totm-tab-count-near');
    const badgeFar = document.getElementById('totm-tab-count-far');

    // Si no hay aventureros, mostrar aviso
    if (characters.length === 0) {
      if (badgeMelee) badgeMelee.textContent = '0';
      if (badgeNear) badgeNear.textContent = '0';
      if (badgeFar) badgeFar.textContent = '0';
      zoneNearEl.innerHTML = `
        <div class="p-3 text-center text-xs text-[#64748b] italic">
          No hay aventureros ni combatientes registrados.
        </div>
      `;
      return;
    }

    let countMelee = 0;
    let countNear = 0;
    let countFar = 0;

    characters.forEach((char, idx) => {
      // Zona por defecto: primeros en melé, resto cerca
      let assignedZone: TotmZone = zones[char.id] || (idx === 0 ? 'melee' : 'near');
      if (!zones[char.id]) {
        zones[char.id] = assignedZone;
      }

      if (assignedZone === 'melee') countMelee++;
      else if (assignedZone === 'far') countFar++;
      else countNear++;

      const card = document.createElement('div');
      card.className = 'p-2 rounded-xl bg-[#18202e] border border-[#222f42] hover:border-amber-500/40 flex items-center justify-between gap-2 shadow-xs transition-colors';

      card.innerHTML = `
        <div class="flex items-center gap-2 min-w-0">
          <div class="w-7 h-7 rounded-lg overflow-hidden shrink-0 border border-amber-500/30 bg-[#10141d]">
            <img src="${char.avatarUrl || '/characters/ch-1.avif'}" alt="${char.name}" class="w-full h-full object-cover" onerror="this.onerror=null;this.src='/characters/ch-1.avif';" />
          </div>
          <div class="min-w-0">
            <span class="font-headline font-bold text-xs text-[#f1f5f9] block truncate">${char.name}</span>
            <span class="text-[9px] text-amber-300/80 font-mono">${char.className}</span>
          </div>
        </div>

        <div class="flex items-center gap-1 font-mono text-[9px] shrink-0">
          ${assignedZone !== 'melee' ? `<button type="button" class="totm-to-melee px-1.5 py-0.5 rounded bg-amber-500/10 hover:bg-amber-500/20 text-amber-300 border border-amber-500/30 cursor-pointer" title="Mover a Melé">Melé</button>` : ''}
          ${assignedZone !== 'near' ? `<button type="button" class="totm-to-near px-1.5 py-0.5 rounded bg-sky-500/10 hover:bg-sky-500/20 text-sky-300 border border-sky-500/30 cursor-pointer" title="Mover a Cerca">Cerca</button>` : ''}
          ${assignedZone !== 'far' ? `<button type="button" class="totm-to-far px-1.5 py-0.5 rounded bg-purple-500/10 hover:bg-purple-500/20 text-purple-300 border border-purple-500/30 cursor-pointer" title="Mover a Lejos">Lejos</button>` : ''}
        </div>
      `;

      card.querySelector('.totm-to-melee')?.addEventListener('click', () => moveCombatantToZone(char.id, 'melee'));
      card.querySelector('.totm-to-near')?.addEventListener('click', () => moveCombatantToZone(char.id, 'near'));
      card.querySelector('.totm-to-far')?.addEventListener('click', () => moveCombatantToZone(char.id, 'far'));

      if (assignedZone === 'melee') zoneMeleeEl.appendChild(card);
      else if (assignedZone === 'far') zoneFarEl.appendChild(card);
      else zoneNearEl.appendChild(card);
    });

    if (badgeMelee) badgeMelee.textContent = String(countMelee);
    if (badgeNear) badgeNear.textContent = String(countNear);
    if (badgeFar) badgeFar.textContent = String(countFar);

    saveZones(zones);
  }

  resetBtn?.addEventListener('click', () => {
    const cid = campaignStore.getActiveCampaignId();
    if (!cid) return;
    const characters = campaignStore.getCharactersForCampaign(cid);
    const zones: Record<string, TotmZone> = {};
    characters.forEach((c, idx) => {
      zones[c.id] = idx === 0 ? 'melee' : 'near';
    });
    saveZones(zones);
    renderTheaterOfTheMind();
  });

  window.addEventListener('campaigns-updated', renderTheaterOfTheMind);
  window.addEventListener('all-characters-updated', renderTheaterOfTheMind);
  window.addEventListener('totm-refresh', renderTheaterOfTheMind);
  renderTheaterOfTheMind();
</script>
