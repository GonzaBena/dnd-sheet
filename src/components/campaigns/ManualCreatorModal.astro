  import { CLASS_DEFINITIONS, type AbilityKeyType } from '../../scripts/dnd/classes';
  import { calculateModifier, calculateProficiencyBonus } from '../../scripts/dnd/calculations';
  import {
    CHARACTER_PRESET_IMAGES,
    QUICK_RACES,
    QUICK_CLASSES,
    QUICK_BACKGROUNDS,
    QUICK_NAME_SUGGESTIONS,
    STANDARD_5E_SKILLS,
    POINT_BUY_TOTAL,
