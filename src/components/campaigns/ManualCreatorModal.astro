---
// src/components/campaigns/ManualCreatorModal.astro
import StepRail from '../ui/StepRail.astro';
import { CHARACTER_PRESET_IMAGES, toAvatarThumb } from '../../scripts/data/characterAvatars';
import {
  QUICK_RACES,
  QUICK_CLASSES,
  QUICK_BACKGROUNDS,
  BACKPACK_STARTER_OPTIONS,
} from '../../scripts/data/manualCreatorData';

const inputCls =
  'w-full p-2.5 rounded-lg bg-[#18202e] border border-[#222f42] text-[#f1f5f9] focus:border-amber-500 focus:outline-none text-xs';
const lblCls = 'text-[#94a3b8] block mb-1 text-xs font-bold';
---

<dialog
  id="manual-creator-modal"
  closedby="any"
  aria-labelledby="manual-creator-modal-title"
  class="w-full max-w-4xl rounded-2xl bg-[#121721] border border-amber-500/40 shadow-[0_20px_60px_rgba(0,0,0,0.95)] p-0 text-[#f1f5f9] overflow-hidden m-auto"
>
  <div class="flex flex-col max-h-[92vh]">
    <!-- Header -->
    <div class="px-5 py-3.5 bg-gradient-to-r from-[#18202e] via-[#1b2434] to-[#18202e] border-b border-[#222f42] flex items-center justify-between gap-3 shrink-0">
      <div class="flex items-center gap-3 min-w-0">
        <button
          type="button"
          id="manual-creator-back-header-btn"
          class="w-9 h-9 rounded-xl bg-[#10141d] border border-[#222f42] hover:border-amber-500/50 text-[#cbd5e1] hover:text-amber-300 flex items-center justify-center transition-colors cursor-pointer shrink-0"
          title="Volver"
          aria-label="Volver"
        >
          <span class="material-symbols-outlined text-[18px]">arrow_back</span>
        </button>
        <div class="w-9 h-9 rounded-xl bg-amber-500/20 text-amber-400 flex items-center justify-center border border-amber-500/40 shadow-[0_0_12px_rgba(245,158,11,0.25)] shrink-0">
          <span class="material-symbols-outlined text-[20px]" id="manual-creator-header-icon">tune</span>
        </div>
        <div class="min-w-0">
          <h3 id="manual-creator-modal-title" class="font-headline font-bold text-base sm:text-lg text-[#f1f5f9] truncate">
            Creación Manual de Personaje
          </h3>
          <p id="manual-creator-modal-subtitle" class="text-[11px] sm:text-xs text-[#94a3b8] font-label truncate">
            Personaliza cada atributo, competencia, suministro de mochila y detalle en 5 pasos
          </p>
        </div>
      </div>
      <button
        type="button"
        id="manual-creator-close-btn"
        class="w-8 h-8 rounded-lg bg-[#10141d] border border-[#222f42] hover:border-amber-500/50 text-[#94a3b8] hover:text-[#f1f5f9] flex items-center justify-center text-xs transition-colors cursor-pointer shrink-0"
        aria-label="Cerrar modal"
      >
        <span class="material-symbols-outlined text-[18px]">close</span>
      </button>
    </div>

    <!-- ===================================================================== -->
    <!-- FORMULARIO PRINCIPAL POR 5 FASES                                      -->
    <!-- ===================================================================== -->
    <form id="manual-creator-form" novalidate class="modal-subview flex flex-col flex-1 min-h-0 font-label">
      <StepRail />

      <div data-step-body class="flex-1 overflow-y-auto p-4 sm:p-5 custom-scrollbar text-xs">
        <!-- ================================================================= -->
        <!-- PASO 1: IDENTIDAD Y RETRATO                                       -->
        <!-- ================================================================= -->
        <section data-page="identidad" class="space-y-4">
          <div>
            <h4 class="font-headline font-bold text-base text-[#f1f5f9]">Identidad y Retrato</h4>
            <p class="text-xs text-[#94a3b8]">Define el nombre, título, nivel inicial, alineamiento y retrato de tu aventurero.</p>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
            <div>
              <div class="flex items-center justify-between gap-2 mb-1">
                <label class={`${lblCls} !mb-0`} for="manual-char-name-input">Nombre del Personaje *</label>
                <button
                  type="button"
                  id="manual-suggest-name-btn"
                  class="text-[11px] text-amber-400 hover:text-amber-300 font-bold flex items-center gap-1 bg-amber-500/10 hover:bg-amber-500/20 px-2 py-0.5 rounded-lg border border-amber-500/30 transition-all cursor-pointer"
                  title="Sugerir un nombre heroico aleatorio"
                >
                  <span class="material-symbols-outlined text-[13px]">casino</span>
                  <span>Sugerir</span>
                </button>
              </div>
              <input
                type="text"
                id="manual-char-name-input"
                autocomplete="off"
                placeholder="Ej: Kaelen Sombraviento, Lyra Hojaplata…"
                class={inputCls}
              />
            </div>

            <div>
              <label class={lblCls} for="manual-char-title-input">Título o Epíteto (opcional)</label>
              <input
                type="text"
                id="manual-char-title-input"
                autocomplete="off"
                placeholder="Ej: Guardián del Cónclave, Espada del Alba…"
                class={inputCls}
              />
            </div>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
            <div>
              <label class={lblCls} for="manual-char-level-input">Nivel Inicial (1–20)</label>
              <input type="number" id="manual-char-level-input" value="1" min="1" max="20" class={inputCls} />
            </div>
            <div>
              <label class={lblCls} for="manual-char-alignment-select">Alineamiento</label>
              <select id="manual-char-alignment-select" class={inputCls}>
                <option value="Legal Bueno">Legal Bueno</option>
                <option value="Neutral Bueno" selected>Neutral Bueno</option>
                <option value="Caótico Bueno">Caótico Bueno</option>
                <option value="Legal Neutral">Legal Neutral</option>
                <option value="Neutral">Neutral Auténtico</option>
                <option value="Caótico Neutral">Caótico Neutral</option>
                <option value="Legal Malvado">Legal Malvado</option>
                <option value="Neutral Malvado">Neutral Malvado</option>
                <option value="Caótico Malvado">Caótico Malvado</option>
              </select>
            </div>
            <div>
              <label class={lblCls} for="manual-char-edition-select">Edición de Reglas</label>
              <select id="manual-char-edition-select" class={inputCls}>
                <option value="2024" selected>D&D 2024</option>
                <option value="2014">D&D 2014</option>
              </select>
            </div>
          </div>

          <div>
            <label class={lblCls} for="manual-char-quote-input">Lema, Historia Breve o Cita Personal (opcional)</label>
            <input
              type="text"
              id="manual-char-quote-input"
              placeholder='Ej: "Juramentado a proteger las tierras fronterizas contra la oscuridad."'
              class={inputCls}
            />
          </div>

          <div class="space-y-2">
            <div class="flex flex-wrap items-center justify-between gap-2">
              <span class={`${lblCls} !mb-0`}>Retrato del Personaje</span>
              <input
                type="url"
                id="manual-char-custom-avatar-input"
                placeholder="O pega una URL de imagen personalizada (https://...)"
                class="w-full sm:w-72 px-2.5 py-1.5 rounded-lg bg-[#18202e] border border-[#222f42] text-[#f1f5f9] focus:border-amber-500 focus:outline-none text-[11px]"
              />
            </div>
            <div class="flex flex-wrap items-center justify-center gap-3 pt-1" id="manual-avatar-picker">
              {CHARACTER_PRESET_IMAGES.map((imgUrl, idx) => (
                <button
                  type="button"
                  data-manual-avatar-url={imgUrl}
                  aria-label={`Seleccionar retrato ${idx + 1}`}
                  class={`manual-avatar-btn relative w-20 sm:w-24 aspect-[3/4] rounded-xl overflow-hidden border-2 transition-all cursor-pointer bg-[#10141d] shrink-0 ${
                    idx === 0
                      ? 'border-amber-500 ring-2 ring-amber-500/40 scale-[1.02]'
                      : 'border-[#222f42] opacity-75 hover:opacity-100 hover:border-amber-500/50'
                  }`}
                >
                  <img src={toAvatarThumb(imgUrl)} decoding="async" alt={`Retrato ${idx + 1}`} class="w-full h-full object-cover object-top" loading="lazy" />
                </button>
              ))}
            </div>
          </div>
        </section>

        <!-- ================================================================= -->
        <!-- PASO 2: ORIGEN, CLASE, SUBCLASE Y TRASFONDO                       -->
        <!-- ================================================================= -->
        <section data-page="origen" class="hidden space-y-4">
          <div>
            <h4 class="font-headline font-bold text-sm sm:text-base text-[#f1f5f9]">Raza, Clase, Subclase y Trasfondo</h4>
            <p class="text-[11px] text-[#94a3b8]">Elige tu origen en las 3 tarjetas y personaliza la subclase, dado de golpe, velocidad o dote de origen.</p>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 items-stretch">
            <!-- BOOKMARK CARD 1: RAZA -->
            <article
              id="manual-race-bookmark-card"
              class="group rounded-2xl bg-[#18202e] border border-[#222f42] hover:border-amber-500/70 transition-all overflow-hidden flex flex-col shadow-lg cursor-pointer"
            >
              <img
                id="manual-race-card-img"
                src={toAvatarThumb(QUICK_RACES[0].avatarUrl)} decoding="async"
                alt={`Raza seleccionada: ${QUICK_RACES[0].name}`}
                class="w-full aspect-[3/4] max-h-40 object-cover object-top group-hover:scale-105 transition-transform duration-500 bg-[#10141d]"
              />
              <header class="px-3.5 flex flex-col items-center text-center">
                <div
                  id="manual-race-card-icon"
                  class="class-emblem-badge -mt-5 mb-1.5 relative z-10 w-10 h-10 rounded-full bg-[#121721] border-2 border-amber-500/70 shadow-[0_4px_15px_rgba(0,0,0,0.85)] flex items-center justify-center text-amber-400 group-hover:scale-110 group-hover:border-amber-400 transition-all"
                  set:html={QUICK_RACES[0].raceIconSvg}
                />
                <span class="text-[10px] uppercase tracking-wider font-bold text-[#94a3b8]">Raza / Especie</span>
                <h4 id="manual-race-card-title" class="font-headline font-bold text-sm sm:text-base text-[#f1f5f9] text-center leading-tight">
                  {QUICK_RACES[0].name}
                </h4>
                <span id="manual-race-card-tagline" class="text-[10px] font-bold text-amber-400/90 font-label mt-0.5">
                  {QUICK_RACES[0].tagline}
                </span>
              </header>
              <p id="manual-race-card-desc" class="px-3.5 pt-1 text-[11px] text-[#94a3b8] text-center font-label leading-snug line-clamp-2">
                {QUICK_RACES[0].description}
              </p>
              <footer class="p-3 pt-2.5 mt-auto">
                <button
                  type="button"
                  id="btn-manual-open-race-picker"
                  class="w-full py-2 px-3 rounded-xl bg-gradient-to-r from-amber-600 to-amber-500 hover:from-amber-500 hover:to-amber-400 text-[#0a0d12] font-bold text-xs font-label shadow-[0_0_12px_rgba(245,158,11,0.3)] active:scale-95 transition-all cursor-pointer flex items-center justify-center gap-1.5"
                >
                  <span class="material-symbols-outlined text-[15px]">diversity_3</span>
                  <span>Cambiar Raza</span>
                </button>
              </footer>
            </article>

            <!-- BOOKMARK CARD 2: CLASE -->
            <article
              id="manual-class-bookmark-card"
              class="group rounded-2xl bg-[#18202e] border border-[#222f42] hover:border-amber-500/70 transition-all overflow-hidden flex flex-col shadow-lg cursor-pointer"
            >
              <img
                id="manual-class-card-img"
                src={toAvatarThumb(QUICK_CLASSES[0].avatarUrl)} decoding="async"
                alt={`Clase seleccionada: ${QUICK_CLASSES[0].name}`}
                class="w-full aspect-[3/4] max-h-40 object-cover object-top group-hover:scale-105 transition-transform duration-500 bg-[#10141d]"
              />
              <header class="px-3.5 flex flex-col items-center text-center">
                <div
                  id="manual-class-card-icon"
                  class="class-emblem-badge -mt-5 mb-1.5 relative z-10 w-10 h-10 rounded-full bg-[#121721] border-2 border-amber-500/70 shadow-[0_4px_15px_rgba(0,0,0,0.85)] flex items-center justify-center text-amber-400 group-hover:scale-110 group-hover:border-amber-400 transition-all"
                  set:html={QUICK_CLASSES[0].classIconSvg}
                />
                <span class="text-[10px] uppercase tracking-wider font-bold text-[#94a3b8]">Clase</span>
                <h4 id="manual-class-card-title" class="font-headline font-bold text-sm sm:text-base text-[#f1f5f9] text-center leading-tight">
                  {QUICK_CLASSES[0].name}
                </h4>
                <span id="manual-class-card-tagline" class="text-[10px] font-bold text-amber-400/90 font-label mt-0.5">
                  {QUICK_CLASSES[0].tagline}
                </span>
              </header>
              <p id="manual-class-card-desc" class="px-3.5 pt-1 text-[11px] text-[#94a3b8] text-center font-label leading-snug line-clamp-2">
                {QUICK_CLASSES[0].description}
              </p>
              <footer class="p-3 pt-2.5 mt-auto">
                <button
                  type="button"
                  id="btn-manual-open-class-picker"
                  class="w-full py-2 px-3 rounded-xl bg-gradient-to-r from-amber-600 to-amber-500 hover:from-amber-500 hover:to-amber-400 text-[#0a0d12] font-bold text-xs font-label shadow-[0_0_12px_rgba(245,158,11,0.3)] active:scale-95 transition-all cursor-pointer flex items-center justify-center gap-1.5"
                >
                  <span class="material-symbols-outlined text-[15px]">swords</span>
                  <span>Cambiar Clase</span>
                </button>
              </footer>
            </article>

            <!-- BOOKMARK CARD 3: TRASFONDO -->
            <article
              id="manual-background-bookmark-card"
              class="group rounded-2xl bg-[#18202e] border border-[#222f42] hover:border-amber-500/70 transition-all overflow-hidden flex flex-col shadow-lg cursor-pointer"
            >
              <img
                id="manual-bg-card-img"
                src={toAvatarThumb(QUICK_BACKGROUNDS[0].avatarUrl)} decoding="async"
                alt={`Trasfondo seleccionado: ${QUICK_BACKGROUNDS[0].name}`}
                class="w-full aspect-[3/4] max-h-40 object-cover object-top group-hover:scale-105 transition-transform duration-500 bg-[#10141d]"
              />
              <header class="px-3.5 flex flex-col items-center text-center">
                <div
                  id="manual-bg-card-icon"
                  class="class-emblem-badge -mt-5 mb-1.5 relative z-10 w-10 h-10 rounded-full bg-[#121721] border-2 border-amber-500/70 shadow-[0_4px_15px_rgba(0,0,0,0.85)] flex items-center justify-center text-amber-400 group-hover:scale-110 group-hover:border-amber-400 transition-all"
                  set:html={QUICK_BACKGROUNDS[0].backgroundIconSvg}
                />
                <span class="text-[10px] uppercase tracking-wider font-bold text-[#94a3b8]">Trasfondo</span>
                <h4 id="manual-bg-card-title" class="font-headline font-bold text-sm sm:text-base text-[#f1f5f9] text-center leading-tight">
                  {QUICK_BACKGROUNDS[0].name}
                </h4>
                <span id="manual-bg-card-tagline" class="text-[10px] font-bold text-amber-400/90 font-label mt-0.5">
                  {QUICK_BACKGROUNDS[0].tagline}
                </span>
              </header>
              <p id="manual-bg-card-desc" class="px-3.5 pt-1 text-[11px] text-[#94a3b8] text-center font-label leading-snug line-clamp-2">
                {QUICK_BACKGROUNDS[0].description}
              </p>
              <footer class="p-3 pt-2.5 mt-auto">
                <button
                  type="button"
                  id="btn-manual-open-bg-picker"
                  class="w-full py-2 px-3 rounded-xl bg-gradient-to-r from-amber-600 to-amber-500 hover:from-amber-500 hover:to-amber-400 text-[#0a0d12] font-bold text-xs font-label shadow-[0_0_12px_rgba(245,158,11,0.3)] active:scale-95 transition-all cursor-pointer flex items-center justify-center gap-1.5"
                >
                  <span class="material-symbols-outlined text-[15px]">history_edu</span>
                  <span>Cambiar Trasfondo</span>
                </button>
              </footer>
            </article>
          </div>

          <!-- Ajustes Manuales de Origen, Subclase y Dote -->
          <div class="p-3.5 rounded-2xl bg-[#18202e]/80 border border-[#222f42] space-y-3">
            <span class="text-[11px] font-headline font-bold text-amber-400 uppercase tracking-wider flex items-center gap-1.5">
              <span class="material-symbols-outlined text-[15px]">edit_note</span>
              <span>Ajustes Manuales de Especie, Subclase y Dote</span>
            </span>
            <div class="grid grid-cols-1 sm:grid-cols-4 gap-3">
              <div>
                <label class={lblCls} for="manual-custom-race-input">Subespecie / Variante</label>
                <input
                  type="text"
                  id="manual-custom-race-input"
                  placeholder="Ej: Enano de las Colinas"
                  class={inputCls}
                />
              </div>
              <div>
                <label class={lblCls} for="manual-subclass-input">Subclase</label>
                <input
                  type="text"
                  id="manual-subclass-input"
                  placeholder="Ej: Maestro de Batalla"
                  class={inputCls}
                />
              </div>
              <div>
                <label class={lblCls} for="manual-hitdie-select">Dado de Golpe</label>
                <select id="manual-hitdie-select" class={inputCls}>
                  <option value="d6">d6</option>
                  <option value="d8">d8</option>
                  <option value="d10" selected>d10</option>
                  <option value="d12">d12</option>
                </select>
              </div>
              <div>
                <label class={lblCls} for="manual-speed-input">Velocidad Base (ft)</label>
                <input type="number" id="manual-speed-input" value="30" min="5" max="120" step="5" class={inputCls} />
              </div>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
              <div>
                <label class={lblCls} for="manual-feat-title-input">Título de Dote de Origen / Rasgo Inicial</label>
                <input
                  type="text"
                  id="manual-feat-title-input"
                  value={QUICK_BACKGROUNDS[0].originFeatTitle}
                  class={inputCls}
                />
              </div>
              <div>
                <label class={lblCls} for="manual-feat-desc-input">Descripción de la Dote / Rasgo</label>
                <input
                  type="text"
                  id="manual-feat-desc-input"
                  value={QUICK_BACKGROUNDS[0].originFeatDesc}
                  class={inputCls}
                />
              </div>
            </div>
          </div>
        </section>

        <!-- ================================================================= -->
        <!-- PASO 3: ATRIBUTOS Y VITALES                                       -->
        <!-- ================================================================= -->
        <section data-page="atributos" class="hidden space-y-4">
          <div class="flex flex-wrap items-center justify-between gap-2">
            <div>
              <h4 class="font-headline font-bold text-base text-[#f1f5f9]">Puntuaciones de Característica y Vitales</h4>
              <p class="text-xs text-[#94a3b8]">Elige tu método de generación, aplica bonos de origen y ajusta tus Puntos de Golpe.</p>
            </div>
          </div>

          <!-- Selector de Método de Atributos (4 métodos) -->
          <div class="grid grid-cols-2 sm:grid-cols-4 gap-2">
            <button
              type="button"
              data-stat-method="free"
              class="manual-stat-method-btn p-2.5 rounded-xl bg-amber-500/15 border border-amber-500/50 text-left transition-all cursor-pointer"
            >
              <div class="flex items-center gap-1.5 font-headline font-bold text-xs text-amber-300">
                <span class="material-symbols-outlined text-[15px]">tune</span>
                <span>Edición Libre</span>
              </div>
              <p class="text-[10px] text-[#94a3b8] mt-0.5">Valores manuales 1–20</p>
            </button>

            <button
              type="button"
              data-stat-method="pointbuy"
              class="manual-stat-method-btn p-2.5 rounded-xl bg-[#18202e] border border-[#222f42] hover:border-amber-500/40 text-left transition-all cursor-pointer"
            >
              <div class="flex items-center gap-1.5 font-headline font-bold text-xs text-[#f1f5f9]">
                <span class="material-symbols-outlined text-[15px] text-amber-400">calculate</span>
                <span>Compra (27 pts)</span>
              </div>
              <p class="text-[10px] text-[#94a3b8] mt-0.5">Point Buy oficial (8–15)</p>
            </button>

            <button
              type="button"
              data-stat-method="standard"
              class="manual-stat-method-btn p-2.5 rounded-xl bg-[#18202e] border border-[#222f42] hover:border-amber-500/40 text-left transition-all cursor-pointer"
            >
              <div class="flex items-center gap-1.5 font-headline font-bold text-xs text-[#f1f5f9]">
                <span class="material-symbols-outlined text-[15px] text-sky-400">view_column</span>
                <span>Array Estándar</span>
              </div>
              <p class="text-[10px] text-[#94a3b8] mt-0.5">15, 14, 13, 12, 10, 8</p>
            </button>

            <button
              type="button"
              data-stat-method="dice"
              class="manual-stat-method-btn p-2.5 rounded-xl bg-[#18202e] border border-[#222f42] hover:border-amber-500/40 text-left transition-all cursor-pointer"
            >
              <div class="flex items-center gap-1.5 font-headline font-bold text-xs text-[#f1f5f9]">
                <span class="material-symbols-outlined text-[15px] text-emerald-400">casino</span>
                <span>Tirador 4d6</span>
              </div>
              <p class="text-[10px] text-[#94a3b8] mt-0.5">4d6 descartando el menor</p>
            </button>
          </div>

          <!-- Barra contextual del método activo (Point Buy / Array / Dados 4d6) -->
          <div id="manual-method-helper-bar" class="hidden p-3 rounded-xl bg-[#18202e] border border-[#222f42] flex flex-wrap items-center justify-between gap-2">
            <div id="manual-method-helper-text" class="text-xs text-[#cbd5e1]"></div>
            <div id="manual-method-helper-actions" class="flex items-center gap-2"></div>
          </div>

          <!-- Grid de las 6 Características -->
          <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-6 gap-2.5" id="manual-stats-editor-grid">
            <!-- Populated and updated reactively via JS -->
          </div>

          <!-- Bonificadores de Trasfondo / Origen (+2/+1 o +1/+1/+1) -->
          <div class="p-3.5 rounded-2xl bg-[#18202e] border border-[#222f42] space-y-2.5">
            <div class="flex flex-wrap items-center justify-between gap-2">
              <div>
                <span class="font-headline font-bold text-xs text-amber-400 flex items-center gap-1.5">
                  <span class="material-symbols-outlined text-[15px]">upgrade</span>
                  <span>Bonificadores de Origen / Trasfondo</span>
                </span>
                <p class="text-[11px] text-[#94a3b8]">Suma bonos de creación a tus puntuaciones base (máx. 20).</p>
              </div>
              <div class="flex items-center gap-1.5">
                <button
                  type="button"
                  data-origin-bonus-mode="none"
                  class="manual-origin-mode-btn px-2.5 py-1 rounded-lg bg-[#10141d] border border-[#222f42] text-[11px] font-bold text-[#94a3b8] cursor-pointer"
                >
                  Sin bono extra
                </button>
                <button
                  type="button"
                  data-origin-bonus-mode="2-1"
