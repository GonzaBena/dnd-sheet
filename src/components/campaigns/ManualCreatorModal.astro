    type QuickClassOption,
    type QuickBackgroundOption,
    type ManualStatMethod,
    type OriginBonusMode,
    type SkillProfState,
    type EquipmentStartMode,
    type DiceStatRoll,
  } from '../../scripts/data/manualCreatorData';

  const ABILITY_META: { key: AbilityKeyType; abbr: string; name: string }[] = [
    { key: 'str', abbr: 'FUE', name: 'Fuerza' },
    { key: 'dex', abbr: 'DES', name: 'Destreza' },
    { key: 'con', abbr: 'CON', name: 'Constitución' },
    { key: 'int', abbr: 'INT', name: 'Inteligencia' },
    { key: 'wis', abbr: 'SAB', name: 'Sabiduría' },
    { key: 'cha', abbr: 'CAR', name: 'Carisma' },
  ];

  const ARMOR_PROF_OPTIONS = [
    { id: 'light', label: 'Ligera' },
    { id: 'medium', label: 'Media' },
    { id: 'heavy', label: 'Pesada' },
    { id: 'shield', label: 'Escudos' },
  ];

  const WEAPON_PROF_OPTIONS = [
    { id: 'simple', label: 'Armas Simples' },
    { id: 'martial', label: 'Armas Marciales' },
  ];

  const dialog = document.getElementById('manual-creator-modal') as HTMLDialogElement | null;
  const form = document.getElementById('manual-creator-form') as HTMLFormElement | null;
  const racePickerView = document.getElementById('manual-race-picker-view');
  const classPickerView = document.getElementById('manual-class-picker-view');
  const bgPickerView = document.getElementById('manual-background-picker-view');

  const closeBtn = document.getElementById('manual-creator-close-btn');
  const cancelBtn = document.getElementById('manual-creator-cancel-btn');
  const backHeaderBtn = document.getElementById('manual-creator-back-header-btn');
  const modalTitle = document.getElementById('manual-creator-modal-title');
  const modalSubtitle = document.getElementById('manual-creator-modal-subtitle');

  // Step 1 inputs
  const nameInp = document.getElementById('manual-char-name-input') as HTMLInputElement;
  const suggestNameBtn = document.getElementById('manual-suggest-name-btn');
  const titleInp = document.getElementById('manual-char-title-input') as HTMLInputElement;
  const levelInp = document.getElementById('manual-char-level-input') as HTMLInputElement;
  const alignmentSel = document.getElementById('manual-char-alignment-select') as HTMLSelectElement;
  const editionSel = document.getElementById('manual-char-edition-select') as HTMLSelectElement;
  const quoteInp = document.getElementById('manual-char-quote-input') as HTMLInputElement;
  const customAvatarInp = document.getElementById('manual-char-custom-avatar-input') as HTMLInputElement;

  // Step 2 bookmark cards & inputs
  const raceBookmarkCard = document.getElementById('manual-race-bookmark-card');
  const raceCardImg = document.getElementById('manual-race-card-img') as HTMLImageElement | null;
  const raceCardIcon = document.getElementById('manual-race-card-icon');
  const raceCardTitle = document.getElementById('manual-race-card-title');
  const raceCardTagline = document.getElementById('manual-race-card-tagline');
  const raceCardDesc = document.getElementById('manual-race-card-desc');

  const classBookmarkCard = document.getElementById('manual-class-bookmark-card');
  const classCardImg = document.getElementById('manual-class-card-img') as HTMLImageElement | null;
  const classCardIcon = document.getElementById('manual-class-card-icon');
  const classCardTitle = document.getElementById('manual-class-card-title');
  const classCardTagline = document.getElementById('manual-class-card-tagline');
  const classCardDesc = document.getElementById('manual-class-card-desc');

  const bgBookmarkCard = document.getElementById('manual-background-bookmark-card');
  const bgCardImg = document.getElementById('manual-bg-card-img') as HTMLImageElement | null;
  const bgCardIcon = document.getElementById('manual-bg-card-icon');
  const bgCardTitle = document.getElementById('manual-bg-card-title');
  const bgCardTagline = document.getElementById('manual-bg-card-tagline');
  const bgCardDesc = document.getElementById('manual-bg-card-desc');

  const customRaceInp = document.getElementById('manual-custom-race-input') as HTMLInputElement;
  const subclassInp = document.getElementById('manual-subclass-input') as HTMLInputElement;
  const hitDieSel = document.getElementById('manual-hitdie-select') as HTMLSelectElement;
  const speedInp = document.getElementById('manual-speed-input') as HTMLInputElement;
  const featTitleInp = document.getElementById('manual-feat-title-input') as HTMLInputElement;
  const featDescInp = document.getElementById('manual-feat-desc-input') as HTMLInputElement;

  // Step 3 elements
  const methodHelperBar = document.getElementById('manual-method-helper-bar');
  const methodHelperText = document.getElementById('manual-method-helper-text');
  const methodHelperActions = document.getElementById('manual-method-helper-actions');
  const statsEditorGrid = document.getElementById('manual-stats-editor-grid');
  const originBonusControls = document.getElementById('manual-origin-bonus-controls');
  const maxHpInp = document.getElementById('manual-max-hp-input') as HTMLInputElement;
  const suggestedHpVal = document.getElementById('manual-suggested-hp-val');
  const recalcHpBtn = document.getElementById('manual-recalc-hp-btn');
  const acOverrideInp = document.getElementById('manual-ac-override-input') as HTMLInputElement;

  // Step 4 elements
  const pbBadge = document.getElementById('manual-pb-badge');
  const savesGrid = document.getElementById('manual-saves-grid');
  const skillsGrid = document.getElementById('manual-skills-grid');
  const skillsCounter = document.getElementById('manual-skills-counter');
  const armorProfGrid = document.getElementById('manual-armor-prof-grid');
  const weaponProfGrid = document.getElementById('manual-weapon-prof-grid');

  // Step 5 elements
  const kitPreviewDesc = document.getElementById('manual-kit-preview-desc');
  const selectAllBackpackBtn = document.getElementById('manual-backpack-select-all');
  const clearAllBackpackBtn = document.getElementById('manual-backpack-clear-all');
  const gpInp = document.getElementById('manual-gold-gp-input') as HTMLInputElement;
  const spInp = document.getElementById('manual-gold-sp-input') as HTMLInputElement;
  const cpInp = document.getElementById('manual-gold-cp-input') as HTMLInputElement;

  const summaryAvatar = document.getElementById('manual-summary-avatar') as HTMLImageElement | null;
  const summaryName = document.getElementById('manual-summary-name');
  const summarySubtitle = document.getElementById('manual-summary-subtitle');
  const summarySkills = document.getElementById('manual-summary-skills');
  const summaryHp = document.getElementById('manual-summary-hp');
  const summarySpeed = document.getElementById('manual-summary-speed');
  const summaryStatsGrid = document.getElementById('manual-summary-stats-grid');

  // State
  let currentTargetCampaignId: string | null = null;
  let activeSubView: 'form' | 'race-picker' | 'class-picker' | 'bg-picker' = 'form';
  let selectedRace: QuickRaceOption = QUICK_RACES[0];
  let selectedClass: QuickClassOption = QUICK_CLASSES[0];
  let selectedBackground: QuickBackgroundOption = QUICK_BACKGROUNDS[0];
  let selectedAvatarUrl: string = CHARACTER_PRESET_IMAGES[0];

  let statMethod: ManualStatMethod = 'free';
  let baseScores: Record<AbilityKeyType, number> = {
    str: 15,
    dex: 13,
    con: 14,
    int: 10,
    wis: 12,
    cha: 8,
  };
  let rolledPool: DiceStatRoll[] = [];
  let originBonusMode: OriginBonusMode = '2-1';
  let originPlus2: AbilityKeyType = 'str';
  let originPlus1List: AbilityKeyType[] = ['con', 'dex', 'wis'];
  let hpManuallyEdited = false;

  let savingThrowsSet = new Set<AbilityKeyType>(CLASS_DEFINITIONS[QUICK_CLASSES[0].name].savingThrows);
  let skillStates: Record<string, SkillProfState> = {};
  let armorProfs = new Set<string>(CLASS_DEFINITIONS[QUICK_CLASSES[0].name].armorProficiencies);
  let weaponProfs = new Set<string>(CLASS_DEFINITIONS[QUICK_CLASSES[0].name].weaponProficiencies);

  let equipmentMode: EquipmentStartMode = 'class-kit';
  let selectedBackpackIds = new Set<string>(
    BACKPACK_STARTER_OPTIONS.filter((o) => o.defaultSelected).map((o) => o.id)
  );

  // Fallback for browsers without closedby="any" support
  if (dialog && !('closedBy' in HTMLDialogElement.prototype)) {
    dialog.addEventListener('click', (event) => {
      if (event.target !== dialog) return;
      const rect = dialog.getBoundingClientRect();
      const isDialogContent =
        rect.top <= event.clientY &&
        event.clientY <= rect.top + rect.height &&
        rect.left <= event.clientX &&
        event.clientX <= rect.left + rect.width;
      if (isDialogContent) return;
      dialog.close();
    });
  }

  let currentStepName = 'identidad';
  let currentStepIndex = 1;
  let characterCreated = false;

  const steps = form
    ? initSteps({
        form,
        labels: {
          identidad: 'Identidad',
          origen: 'Raza y Clase',
          atributos: 'Atributos',
          habilidades: 'Habilidades',
          equipo: 'Equipo y Mochila',
        },
        pages: () => ['identidad', 'origen', 'atributos', 'habilidades', 'equipo'],
        finalLabel: () => 'Crear Personaje',
        validate: (id) => {
          if (id === 'identidad' && !nameInp.value.trim()) {
            return {
              message: 'Escribe o sugiere un nombre para tu personaje antes de continuar.',
              focus: nameInp,
            };
          }
          return null;
        },
        onRender: ({ id }) => {
          const stepPages = ['identidad', 'origen', 'atributos', 'habilidades', 'equipo'];
          const idx = stepPages.indexOf(id);
          currentStepName = id;
          currentStepIndex = idx >= 0 ? idx + 1 : 1;
          telemetry.trackStep('manual', id, currentStepIndex);

          if (id === 'atributos') {
            renderStatsStep();
          } else if (id === 'habilidades') {
            renderSkillsStep();
          } else if (id === 'equipo') {
            renderEquipmentStep();
          }
        },
      })
    : null;

  function getFinalScores(): Record<AbilityKeyType, number> {
    return applyOriginBonuses(baseScores, originBonusMode, originPlus2, originPlus1List);
  }

  function updateSuggestedHpUI(forceApply = false) {
    const finals = getFinalScores();
    const suggested = computeSuggestedMaxHp({
      level: Number(levelInp?.value) || 1,
      hitDie: hitDieSel?.value || selectedClass.hitDie,
      conScore: finals.con,
      raceHpBonusPerLevel: selectedRace.hpBonusPerLevel,
    });
    if (suggestedHpVal) suggestedHpVal.textContent = String(suggested);
    if ((forceApply || !hpManuallyEdited) && maxHpInp) {
      maxHpInp.value = String(suggested);
    }
  }

  function setSubView(view: 'form' | 'race-picker' | 'class-picker' | 'bg-picker') {
    activeSubView = view;
    if (!dialog || !form || !racePickerView || !classPickerView || !bgPickerView) return;

    form.classList.toggle('hidden', view !== 'form');
    racePickerView.classList.toggle('hidden', view !== 'race-picker');
    classPickerView.classList.toggle('hidden', view !== 'class-picker');
    bgPickerView.classList.toggle('hidden', view !== 'bg-picker');

    if (view === 'form') {
      if (modalTitle) modalTitle.textContent = 'Creación Manual de Personaje';
      if (modalSubtitle)
        modalSubtitle.textContent =
          'Personaliza cada atributo, competencia, suministro de mochila y detalle en 5 pasos';
    } else if (view === 'race-picker') {
      if (modalTitle) modalTitle.textContent = 'Selecciona la Raza / Especie';
      if (modalSubtitle) modalSubtitle.textContent = 'Ajusta la velocidad y rasgos base de tu especie';
    } else if (view === 'class-picker') {
      if (modalTitle) modalTitle.textContent = 'Selecciona la Clase';
      if (modalSubtitle) modalSubtitle.textContent = 'Actualiza el dado de golpe, salvaciones y kit sugerido';
    } else if (view === 'bg-picker') {
      if (modalTitle) modalTitle.textContent = 'Selecciona el Trasfondo';
      if (modalSubtitle) modalSubtitle.textContent = 'Preselecciona habilidades iniciales y Dote de Origen';
    }
  }

  function updateBookmarkCardsUI() {
    if (raceCardImg) {
      raceCardImg.src = toAvatarThumb(selectedRace.avatarUrl);
      raceCardImg.alt = `Raza seleccionada: ${selectedRace.name}`;
    }
    if (raceCardIcon) raceCardIcon.innerHTML = selectedRace.raceIconSvg;
    if (raceCardTitle) raceCardTitle.textContent = selectedRace.name;
    if (raceCardTagline) raceCardTagline.textContent = selectedRace.tagline;
    if (raceCardDesc) raceCardDesc.textContent = selectedRace.description;

    if (classCardImg) {
      classCardImg.src = toAvatarThumb(selectedClass.avatarUrl);
      classCardImg.alt = `Clase seleccionada: ${selectedClass.name}`;
    }
    if (classCardIcon) classCardIcon.innerHTML = selectedClass.classIconSvg;
    if (classCardTitle) classCardTitle.textContent = selectedClass.name;
    if (classCardTagline) classCardTagline.textContent = selectedClass.tagline;
    if (classCardDesc) classCardDesc.textContent = selectedClass.description;

    if (bgCardImg) {
      bgCardImg.src = toAvatarThumb(selectedBackground.avatarUrl);
      bgCardImg.alt = `Trasfondo seleccionado: ${selectedBackground.name}`;
    }
    if (bgCardIcon) bgCardIcon.innerHTML = selectedBackground.backgroundIconSvg;
    if (bgCardTitle) bgCardTitle.textContent = selectedBackground.name;
    if (bgCardTagline) bgCardTagline.textContent = selectedBackground.tagline;
    if (bgCardDesc) bgCardDesc.textContent = selectedBackground.description;
  }

  function applyClassDefaults(cls: QuickClassOption) {
    const def = CLASS_DEFINITIONS[cls.name];
    if (hitDieSel) hitDieSel.value = def.hitDie;
    if (subclassInp) subclassInp.value = cls.defaultSubclass;
    savingThrowsSet = new Set<AbilityKeyType>(def.savingThrows);
    armorProfs = new Set<string>(def.armorProficiencies);
    weaponProfs = new Set<string>(def.weaponProficiencies);
    originPlus2 = cls.abilityPriority[0];
    originPlus1List = [cls.abilityPriority[1], cls.abilityPriority[2], cls.abilityPriority[0]];
    const kit = CLASS_STARTER_KITS[cls.name];
    if (gpInp && kit) gpInp.value = String(kit.defaultGold);
    updateSuggestedHpUI();
  }

  function applyBackgroundDefaults(bg: QuickBackgroundOption) {
    if (featTitleInp) featTitleInp.value = bg.originFeatTitle;
    if (featDescInp) featDescInp.value = bg.originFeatDesc;
    const bgSkills = resolveBackgroundSkillIds(bg);
    skillStates = {};
    bgSkills.forEach((id) => {
      skillStates[id] = 'proficient';
    });
  }

  function updateAvatarSelectionUI(url: string) {
    selectedAvatarUrl = url;
    document.querySelectorAll<HTMLButtonElement>('.manual-avatar-btn').forEach((btn) => {
      const isSelected = btn.getAttribute('data-manual-avatar-url') === url;
      btn.className = `manual-avatar-btn relative w-20 sm:w-24 aspect-[3/4] rounded-xl overflow-hidden border-2 transition-all cursor-pointer bg-[#10141d] shrink-0 ${
        isSelected
          ? 'border-amber-500 ring-2 ring-amber-500/40 scale-[1.02]'
          : 'border-[#222f42] opacity-75 hover:opacity-100 hover:border-amber-500/50'
      }`;
    });
  }

  function renderStatsStep() {
    // 1. Method buttons active state
    document.querySelectorAll<HTMLButtonElement>('.manual-stat-method-btn').forEach((btn) => {
      const m = btn.getAttribute('data-stat-method') as ManualStatMethod;
      const active = m === statMethod;
      btn.className = active
        ? 'manual-stat-method-btn p-2.5 rounded-xl bg-amber-500/15 border border-amber-500/50 text-left transition-all cursor-pointer'
        : 'manual-stat-method-btn p-2.5 rounded-xl bg-[#18202e] border border-[#222f42] hover:border-amber-500/40 text-left transition-all cursor-pointer';
    });

    // 2. Helper bar per method
    if (methodHelperBar && methodHelperText && methodHelperActions) {
      methodHelperActions.innerHTML = '';
      if (statMethod === 'free') {
        methodHelperBar.classList.add('hidden');
      } else if (statMethod === 'pointbuy') {
        methodHelperBar.classList.remove('hidden');
        const spent = calculatePointBuySpent(baseScores);
        const remaining = POINT_BUY_TOTAL - spent;
        const badgeColor =
          remaining < 0 ? 'text-rose-400' : remaining === 0 ? 'text-emerald-400' : 'text-amber-300';
        methodHelperText.innerHTML = `Compra por Puntos (8–15): <strong class="${badgeColor}">${spent} / ${POINT_BUY_TOTAL} pts usados</strong> (${remaining >= 0 ? `${remaining} restantes` : `${Math.abs(remaining)} de exceso`})`;
        const resetPbBtn = document.createElement('button');
        resetPbBtn.type = 'button';
        resetPbBtn.className =
          'px-2.5 py-1 rounded-lg bg-[#10141d] border border-[#222f42] hover:border-amber-500/40 text-[11px] font-bold text-[#cbd5e1] cursor-pointer';
        resetPbBtn.textContent = 'Reiniciar a 8';
        resetPbBtn.addEventListener('click', () => {
          baseScores = { str: 8, dex: 8, con: 8, int: 8, wis: 8, cha: 8 };
          renderStatsStep();
        });
        methodHelperActions.append(resetPbBtn);
      } else if (statMethod === 'standard') {
        methodHelperBar.classList.remove('hidden');
        methodHelperText.innerHTML = `Array Estándar oficial: <strong class="text-amber-300">15, 14, 13, 12, 10, 8</strong>`;
        const autoBtn = document.createElement('button');
        autoBtn.type = 'button';
        autoBtn.className =
          'px-2.5 py-1 rounded-lg bg-amber-500/15 border border-amber-500/40 text-[11px] font-bold text-amber-300 cursor-pointer';
        autoBtn.textContent = `Auto-repartir para ${selectedClass.name}`;
        autoBtn.addEventListener('click', () => {
          baseScores = assignStandardArrayForClass(selectedClass);
          renderStatsStep();
        });
        methodHelperActions.append(autoBtn);
      } else if (statMethod === 'dice') {
        methodHelperBar.classList.remove('hidden');
        if (rolledPool.length === 0) {
          rolledPool = rollFullStatSet();
          selectedClass.abilityPriority.forEach((k, idx) => {
            baseScores[k] = rolledPool[idx]?.total ?? 10;
          });
        }
        const chipsHtml = rolledPool
          .map(
            (r) =>
              `<span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-md bg-[#10141d] border border-amber-500/40 text-[11px] font-bold text-amber-300" title="Dados: ${r.rolls.join(', ')}">${r.total}</span>`
          )
          .join(' ');
        methodHelperText.innerHTML = `<span class="mr-1.5">Tiradas 4d6 (descartando menor):</span> ${chipsHtml}`;
        const rerollBtn = document.createElement('button');
        rerollBtn.type = 'button';
        rerollBtn.className =
          'px-2.5 py-1 rounded-lg bg-emerald-500/15 border border-emerald-500/40 text-[11px] font-bold text-emerald-300 cursor-pointer flex items-center gap-1';
        rerollBtn.innerHTML = `<span class="material-symbols-outlined text-[14px]">casino</span><span>Volver a tirar 4d6</span>`;
        rerollBtn.addEventListener('click', () => {
          rolledPool = rollFullStatSet();
          const sorted = [...rolledPool].sort((a, b) => b.total - a.total);
          selectedClass.abilityPriority.forEach((k, idx) => {
            baseScores[k] = sorted[idx]?.total ?? 10;
          });
          renderStatsStep();
        });
        methodHelperActions.append(rerollBtn);
      }
    }

    // 3. Render 6 Stat Cards
    const finals = getFinalScores();
    if (statsEditorGrid) {
      statsEditorGrid.innerHTML = '';
      ABILITY_META.forEach(({ key, abbr, name }) => {
        const baseVal = baseScores[key];
        const finalVal = finals[key];
        const bonusVal = finalVal - baseVal;
        const modVal = calculateModifier(finalVal);
        const modStr = modVal >= 0 ? `+${modVal}` : String(modVal);

        const card = document.createElement('div');
        card.className =
          'p-2 rounded-xl bg-[#18202e] border border-[#222f42] flex flex-col items-center text-center gap-1 min-w-0';

        const minAllowed = statMethod === 'pointbuy' ? POINT_BUY_MIN : 1;
        const maxAllowed = statMethod === 'pointbuy' ? POINT_BUY_MAX : 20;

        card.innerHTML = `
          <span class="text-[8.5px] font-bold uppercase tracking-tight text-[#94a3b8] whitespace-nowrap truncate w-full">${abbr} • ${name}</span>
          <div class="flex items-center gap-1">
            <button type="button" data-stat-dec="${key}" class="w-5 h-5 rounded-md bg-[#10141d] border border-[#222f42] hover:border-amber-500/50 text-[#cbd5e1] text-[11px] font-bold cursor-pointer flex items-center justify-center shrink-0" ${baseVal <= minAllowed ? 'disabled' : ''}>−</button>
            <input type="number" data-stat-input="${key}" value="${baseVal}" min="${minAllowed}" max="${maxAllowed}" aria-label="Base ${name}" class="w-10 text-center font-headline font-bold text-xs py-0.5 rounded-md bg-[#10141d] border border-[#222f42] text-[#f1f5f9]" />
            <button type="button" data-stat-inc="${key}" class="w-5 h-5 rounded-md bg-[#10141d] border border-[#222f42] hover:border-amber-500/50 text-[#cbd5e1] text-[11px] font-bold cursor-pointer flex items-center justify-center shrink-0" ${baseVal >= maxAllowed ? 'disabled' : ''}>+</button>
          </div>
          <div class="text-[10px] text-[#94a3b8] whitespace-nowrap">
            Final: <strong class="text-[#f1f5f9] font-bold">${finalVal}</strong>
            ${bonusVal > 0 ? `<span class="text-emerald-400 font-bold">(+${bonusVal})</span>` : ''}
          </div>
          <span class="px-1.5 py-0.5 rounded-md bg-amber-500/15 border border-amber-500/30 text-amber-300 font-headline font-bold text-[10px] whitespace-nowrap">
            Mod ${modStr}
          </span>
        `;

        statsEditorGrid.append(card);
      });

      statsEditorGrid.querySelectorAll<HTMLButtonElement>('button[data-stat-dec]').forEach((btn) => {
        btn.addEventListener('click', () => {
          const k = btn.getAttribute('data-stat-dec') as AbilityKeyType;
          const minAllowed = statMethod === 'pointbuy' ? POINT_BUY_MIN : 1;
          if (baseScores[k] > minAllowed) {
            baseScores[k] -= 1;
            renderStatsStep();
          }
        });
      });

      statsEditorGrid.querySelectorAll<HTMLButtonElement>('button[data-stat-inc]').forEach((btn) => {
        btn.addEventListener('click', () => {
          const k = btn.getAttribute('data-stat-inc') as AbilityKeyType;
          const maxAllowed = statMethod === 'pointbuy' ? POINT_BUY_MAX : 20;
          if (baseScores[k] < maxAllowed) {
            baseScores[k] += 1;
            renderStatsStep();
          }
        });
      });

      statsEditorGrid.querySelectorAll<HTMLInputElement>('input[data-stat-input]').forEach((inp) => {
        inp.addEventListener('change', () => {
          const k = inp.getAttribute('data-stat-input') as AbilityKeyType;
          const minAllowed = statMethod === 'pointbuy' ? POINT_BUY_MIN : 1;
          const maxAllowed = statMethod === 'pointbuy' ? POINT_BUY_MAX : 20;
          const val = Math.max(minAllowed, Math.min(maxAllowed, Number(inp.value) || 10));
          baseScores[k] = val;
          renderStatsStep();
        });
      });
    }

    // 4. Origin bonus controls
    document.querySelectorAll<HTMLButtonElement>('.manual-origin-mode-btn').forEach((btn) => {
      const m = btn.getAttribute('data-origin-bonus-mode') as OriginBonusMode;
      const active = m === originBonusMode;
      btn.className = active
        ? 'manual-origin-mode-btn px-2.5 py-1 rounded-lg bg-amber-500/20 border border-amber-500/60 text-[11px] font-bold text-amber-300 cursor-pointer'
        : 'manual-origin-mode-btn px-2.5 py-1 rounded-lg bg-[#10141d] border border-[#222f42] text-[11px] font-bold text-[#94a3b8] cursor-pointer';
    });

    if (originBonusControls) {
      if (originBonusMode === 'none') {
        originBonusControls.innerHTML = `<p class="text-[11px] text-[#64748b]">Las puntuaciones base se usarán directamente sin modificadores adicionales de origen.</p>`;
      } else if (originBonusMode === '2-1') {
        const currentPlus1 = originPlus1List.find((k) => k !== originPlus2) || 'con';
        originBonusControls.innerHTML = `
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-2.5">
            <div class="flex items-center justify-between p-2 rounded-xl bg-[#10141d] border border-[#222f42]">
              <span class="text-xs font-bold text-amber-300">Bono +2 en:</span>
              <select id="manual-origin-plus2-sel" class="px-2.5 py-1 rounded-lg bg-[#18202e] border border-[#222f42] text-[#f1f5f9] text-xs font-bold">
                ${ABILITY_META.map(
                  (a) => `<option value="${a.key}" ${a.key === originPlus2 ? 'selected' : ''}>${a.abbr} (${a.name})</option>`
                ).join('')}
              </select>
            </div>
            <div class="flex items-center justify-between p-2 rounded-xl bg-[#10141d] border border-[#222f42]">
              <span class="text-xs font-bold text-emerald-300">Bono +1 en:</span>
              <select id="manual-origin-plus1-sel" class="px-2.5 py-1 rounded-lg bg-[#18202e] border border-[#222f42] text-[#f1f5f9] text-xs font-bold">
                ${ABILITY_META.filter((a) => a.key !== originPlus2)
                  .map(
                    (a) => `<option value="${a.key}" ${a.key === currentPlus1 ? 'selected' : ''}>${a.abbr} (${a.name})</option>`
                  )
                  .join('')}
              </select>
            </div>
          </div>
        `;
        originBonusControls
          .querySelector<HTMLSelectElement>('#manual-origin-plus2-sel')
          ?.addEventListener('change', (e) => {
            originPlus2 = (e.target as HTMLSelectElement).value as AbilityKeyType;
            if (originPlus1List[0] === originPlus2) {
              const fallback = ABILITY_META.find((a) => a.key !== originPlus2)?.key || 'con';
              originPlus1List = [fallback, ...originPlus1List.slice(1)];
            }
            renderStatsStep();
          });
        originBonusControls
          .querySelector<HTMLSelectElement>('#manual-origin-plus1-sel')
          ?.addEventListener('change', (e) => {
            const chosen = (e.target as HTMLSelectElement).value as AbilityKeyType;
            originPlus1List = [chosen, ...originPlus1List.filter((k) => k !== chosen)];
            renderStatsStep();
          });
      } else if (originBonusMode === '1-1-1') {
        const active3 = new Set(Array.from(new Set(originPlus1List)).slice(0, 3));
        originBonusControls.innerHTML = `
          <div class="flex flex-wrap items-center gap-2">
            <span class="text-[11px] text-[#94a3b8] mr-1">Elige hasta 3 características (+1 cada una):</span>
            ${ABILITY_META.map((a) => {
              const on = active3.has(a.key);
              return `<button type="button" data-origin-triple="${a.key}" class="px-2.5 py-1 rounded-lg border text-xs font-bold cursor-pointer transition-all ${
                on
                  ? 'bg-emerald-500/20 border-emerald-500/60 text-emerald-300'
                  : 'bg-[#10141d] border-[#222f42] text-[#94a3b8]'
              }">${a.abbr} ${on ? '+1' : ''}</button>`;
            }).join('')}
          </div>
        `;
        originBonusControls
          .querySelectorAll<HTMLButtonElement>('button[data-origin-triple]')
          .forEach((btn) => {
            btn.addEventListener('click', () => {
              const k = btn.getAttribute('data-origin-triple') as AbilityKeyType;
              const set = new Set(Array.from(new Set(originPlus1List)).slice(0, 3));
              if (set.has(k)) {
                set.delete(k);
              } else if (set.size < 3) {
                set.add(k);
              }
              originPlus1List = Array.from(set);
              renderStatsStep();
            });
          });
      }
    }

    updateSuggestedHpUI();
  }

  function renderSkillsStep() {
    const level = Math.max(1, Math.min(20, Number(levelInp?.value) || 1));
    const pb = calculateProficiencyBonus(level);
    const finals = getFinalScores();
    if (pbBadge) pbBadge.textContent = String(pb);

    // 1. Saving Throws
    if (savesGrid) {
      savesGrid.innerHTML = '';
      ABILITY_META.forEach(({ key, abbr, name }) => {
        const isProf = savingThrowsSet.has(key);
        const total = calculateModifier(finals[key]) + (isProf ? pb : 0);
        const totalStr = total >= 0 ? `+${total}` : String(total);
        const btn = document.createElement('button');
        btn.type = 'button';
        btn.className = `p-2 rounded-xl border text-left transition-all cursor-pointer flex items-center justify-between ${
          isProf
            ? 'bg-amber-500/15 border-amber-500/60 text-[#f1f5f9]'
            : 'bg-[#10141d] border-[#222f42] text-[#94a3b8] hover:border-amber-500/30'
        }`;
        btn.innerHTML = `
          <div>
            <span class="text-[10px] font-bold block ${isProf ? 'text-amber-300' : 'text-[#94a3b8]'}">${abbr}</span>
            <span class="text-[11px] font-medium">${name}</span>
          </div>
          <strong class="font-headline font-bold text-xs ${isProf ? 'text-amber-300' : 'text-[#cbd5e1]'}">${totalStr}</strong>
        `;
        btn.addEventListener('click', () => {
          if (savingThrowsSet.has(key)) savingThrowsSet.delete(key);
          else savingThrowsSet.add(key);
          renderSkillsStep();
        });
        savesGrid.append(btn);
      });
    }

    // 2. 18 Standard Skills
    if (skillsGrid) {
      skillsGrid.innerHTML = '';
      let profCount = 0;
      let expCount = 0;

      STANDARD_5E_SKILLS.forEach((sk) => {
        const state: SkillProfState = skillStates[sk.id] || 'none';
        if (state === 'proficient') profCount++;
        if (state === 'expertise') {
          profCount++;
          expCount++;
        }
        const statMod = calculateModifier(finals[sk.stat]);
        const bonus =
          statMod + (state === 'proficient' ? pb : state === 'expertise' ? pb * 2 : 0);
        const bonusStr = bonus >= 0 ? `+${bonus}` : String(bonus);
        const statAbbr = ABILITY_META.find((a) => a.key === sk.stat)?.abbr || sk.stat.toUpperCase();

        const btn = document.createElement('button');
        btn.type = 'button';
        btn.setAttribute('data-manual-skill-id', sk.id);
        btn.className = `p-2 rounded-xl border text-left transition-all cursor-pointer flex items-center justify-between gap-2 ${
          state === 'expertise'
            ? 'bg-purple-500/15 border-purple-400/60 text-[#f1f5f9]'
            : state === 'proficient'
            ? 'bg-amber-500/15 border-amber-500/50 text-[#f1f5f9]'
            : 'bg-[#10141d] border-[#222f42] text-[#94a3b8] hover:border-amber-500/30'
        }`;

        const badgeLabel =
          state === 'expertise' ? 'Pericia (×2)' : state === 'proficient' ? 'Competente' : 'Normal';

        btn.innerHTML = `
          <div class="min-w-0">
            <div class="flex items-center gap-1.5">
              <strong class="text-xs font-bold truncate">${sk.name}</strong>
              <span class="text-[10px] uppercase px-1.5 py-0.2 rounded bg-[#18202e] text-[#94a3b8]">${statAbbr}</span>
            </div>
            <span class="text-[10px] ${
              state === 'expertise'
                ? 'text-purple-300 font-bold'
                : state === 'proficient'
                ? 'text-amber-300 font-bold'
                : 'text-[#64748b]'
            }">${badgeLabel}</span>
          </div>
          <strong class="font-headline font-bold text-xs shrink-0 ${
            state !== 'none' ? 'text-amber-300' : 'text-[#cbd5e1]'
          }">${bonusStr}</strong>
        `;

        btn.addEventListener('click', () => {
          const nextState: SkillProfState =
            state === 'none' ? 'proficient' : state === 'proficient' ? 'expertise' : 'none';
          skillStates[sk.id] = nextState;
          renderSkillsStep();
        });

        skillsGrid.append(btn);
      });

      if (skillsCounter) {
        skillsCounter.textContent = `${profCount} competentes${expCount > 0 ? ` (${expCount} con pericia)` : ''}`;
      }
    }

    // 3. Armor & Weapon proficiencies
    if (armorProfGrid) {
      armorProfGrid.innerHTML = '';
      ARMOR_PROF_OPTIONS.forEach((opt) => {
        const on = armorProfs.has(opt.id);
        const btn = document.createElement('button');
        btn.type = 'button';
        btn.className = `p-2 rounded-xl border text-xs font-bold cursor-pointer transition-all ${
          on
            ? 'bg-amber-500/15 border-amber-500/50 text-amber-300'
            : 'bg-[#10141d] border-[#222f42] text-[#94a3b8]'
        }`;
        btn.textContent = `${on ? '✓ ' : ''}${opt.label}`;
        btn.addEventListener('click', () => {
          if (armorProfs.has(opt.id)) armorProfs.delete(opt.id);
          else armorProfs.add(opt.id);
          renderSkillsStep();
        });
        armorProfGrid.append(btn);
      });
    }

    if (weaponProfGrid) {
      weaponProfGrid.innerHTML = '';
      WEAPON_PROF_OPTIONS.forEach((opt) => {
        const on = weaponProfs.has(opt.id);
        const btn = document.createElement('button');
        btn.type = 'button';
        btn.className = `p-2 rounded-xl border text-xs font-bold cursor-pointer transition-all ${
          on
            ? 'bg-amber-500/15 border-amber-500/50 text-amber-300'
            : 'bg-[#10141d] border-[#222f42] text-[#94a3b8]'
        }`;
        btn.textContent = `${on ? '✓ ' : ''}${opt.label}`;
        btn.addEventListener('click', () => {
          if (weaponProfs.has(opt.id)) weaponProfs.delete(opt.id);
          else weaponProfs.add(opt.id);
          renderSkillsStep();
        });
        weaponProfGrid.append(btn);
      });
    }
  }

  function updateBackpackButtonsUI() {
    document.querySelectorAll<HTMLButtonElement>('.manual-backpack-item-btn').forEach((btn) => {
      const id = btn.getAttribute('data-backpack-item-id') || '';
      const active = selectedBackpackIds.has(id);
      btn.className = `manual-backpack-item-btn p-2.5 rounded-xl border text-left transition-all cursor-pointer flex items-start gap-2.5 ${
        active
          ? 'bg-amber-500/15 border-amber-500/50 text-[#f1f5f9]'
          : 'bg-[#10141d] border-[#222f42] text-[#94a3b8] hover:border-amber-500/30'
      }`;
    });
  }

  function renderEquipmentStep() {
    const kit = CLASS_STARTER_KITS[selectedClass.name];
    if (kitPreviewDesc && kit) {
      kitPreviewDesc.textContent = `${kit.summary} (${kit.spellsSummary}).`;
    }

    document.querySelectorAll<HTMLButtonElement>('.manual-equip-mode-btn').forEach((btn) => {
      const mode = btn.getAttribute('data-equip-mode') as EquipmentStartMode;
      const active = mode === equipmentMode;
      btn.className = active
        ? 'manual-equip-mode-btn p-3.5 rounded-2xl bg-amber-500/15 border border-amber-500/60 text-left transition-all cursor-pointer'
        : 'manual-equip-mode-btn p-3.5 rounded-2xl bg-[#18202e] border border-[#222f42] hover:border-amber-500/40 text-left transition-all cursor-pointer';
    });

    updateBackpackButtonsUI();

    const built = collectBuiltCharacter();
    if (summaryAvatar) summaryAvatar.src = toAvatarThumb(built.avatarUrl || selectedAvatarUrl);
    if (summaryName) summaryName.textContent = built.name || 'Nuevo Aventurero';
    if (summarySubtitle) {
      const sub = built.subclass ? ` (${built.subclass})` : '';
      summarySubtitle.textContent = `${built.race} • ${built.className}${sub} • ${selectedBackground.name} (Nvl. ${built.level})`;
    }
    if (summarySkills) {
      const profNames = (built.skills || [])
        .filter((s) => s.proficient)
        .map((s) => (s.expertise ? `${s.name} (Pericia)` : s.name));
      summarySkills.textContent =
        profNames.length > 0
          ? `Habilidades: ${profNames.join(', ')} • Mochila: ${selectedBackpackIds.size} suministros`
          : `Sin habilidades marcadas • Mochila: ${selectedBackpackIds.size} suministros`;
    }
    if (summaryHp) summaryHp.textContent = String(built.hp?.max ?? 10);
    if (summarySpeed) summarySpeed.textContent = `${built.speedFt ?? 30} ft`;

    if (summaryStatsGrid && built.stats) {
      summaryStatsGrid.innerHTML = ABILITY_META.map(({ key, abbr }) => {
        const st = built.stats![key];
        const modStr = st.modifier >= 0 ? `+${st.modifier}` : String(st.modifier);
        return `
          <div class="p-2 rounded-xl bg-[#10141d] border ${
            st.savingProficient ? 'border-amber-500/50' : 'border-[#222f42]'
          }">
            <span class="text-[10px] font-bold text-[#94a3b8] block">${abbr}</span>
            <strong class="font-headline font-bold text-sm text-[#f1f5f9] block">${st.score}</strong>
            <span class="text-[11px] font-bold text-amber-400">${modStr}</span>
          </div>
        `;
      }).join('');
    }
  }

  function collectBuiltCharacter() {
    const manualAcVal = acOverrideInp?.value.trim() ? Number(acOverrideInp.value) : null;
    return buildCharacterFromManualCreator({
      name: nameInp?.value || 'Nuevo Aventurero',
      title: titleInp?.value || '',
      quote: quoteInp?.value || '',
      level: Number(levelInp?.value) || 1,
      alignment: alignmentSel?.value || 'Neutral Bueno',
      rulesEdition: (editionSel?.value as '2024' | '2014') || '2024',
      avatarUrl: customAvatarInp?.value.trim() || selectedAvatarUrl,
      raceOption: selectedRace,
      customRaceName: customRaceInp?.value || '',
      classOption: selectedClass,
      subclass: subclassInp?.value ?? '',
      hitDie: (hitDieSel?.value as 'd6' | 'd8' | 'd10' | 'd12') || selectedClass.hitDie,
      baseSpeedFt: Number(speedInp?.value) || selectedRace.speedFt,
      backgroundOption: selectedBackground,
      customOriginFeatTitle: featTitleInp?.value || '',
      customOriginFeatDesc: featDescInp?.value || '',
      baseScores,
      originBonusMode,
      originPlus2,
      originPlus1: originPlus1List,
      maxHp: Number(maxHpInp?.value) || undefined,
      manualAc: manualAcVal,
      savingThrows: Array.from(savingThrowsSet),
      skillStates,
      armorProficiencies: Array.from(armorProfs),
      weaponProficiencies: Array.from(weaponProfs),
      equipmentMode,
      selectedBackpackIds: Array.from(selectedBackpackIds),
      currency: {
        gp: Number(gpInp?.value) || 0,
        sp: Number(spInp?.value) || 0,
        cp: Number(cpInp?.value) || 0,
      },
    });
  }

  function resetManualCreator() {
    if (nameInp) nameInp.value = '';
    if (titleInp) titleInp.value = '';
    if (levelInp) levelInp.value = '1';
    if (alignmentSel) alignmentSel.value = 'Neutral Bueno';
    if (editionSel) editionSel.value = '2024';
    if (quoteInp) quoteInp.value = '';
    if (customAvatarInp) customAvatarInp.value = '';
    if (customRaceInp) customRaceInp.value = '';
    if (acOverrideInp) acOverrideInp.value = '';

    selectedRace = QUICK_RACES[0];
    selectedClass = QUICK_CLASSES[0];
    selectedBackground = QUICK_BACKGROUNDS[0];
    if (speedInp) speedInp.value = String(selectedRace.speedFt);

    statMethod = 'free';
    baseScores = assignStandardArrayForClass(selectedClass);
    rolledPool = [];
    originBonusMode = '2-1';
    hpManuallyEdited = false;

    applyClassDefaults(selectedClass);
    applyBackgroundDefaults(selectedBackground);

    equipmentMode = 'class-kit';
    selectedBackpackIds = new Set(
      BACKPACK_STARTER_OPTIONS.filter((o) => o.defaultSelected).map((o) => o.id)
    );
    if (spInp) spInp.value = '10';
    if (cpInp) cpInp.value = '0';

    updateAvatarSelectionUI(CHARACTER_PRESET_IMAGES[0]);
    updateBookmarkCardsUI();
    setSubView('form');
    steps?.reset();
  }

  // Event Listeners
  suggestNameBtn?.addEventListener('click', () => {
    const randomName =
      QUICK_NAME_SUGGESTIONS[Math.floor(Math.random() * QUICK_NAME_SUGGESTIONS.length)];
    if (nameInp) {
      nameInp.value = randomName;
      nameInp.focus();
    }
  });

  document.querySelectorAll<HTMLButtonElement>('.manual-avatar-btn').forEach((btn) => {
    btn.addEventListener('click', () => {
      const url = btn.getAttribute('data-manual-avatar-url');
      if (url) {
        if (customAvatarInp) customAvatarInp.value = '';
        updateAvatarSelectionUI(url);
      }
    });
  });

  raceBookmarkCard?.addEventListener('click', () => setSubView('race-picker'));
  classBookmarkCard?.addEventListener('click', () => setSubView('class-picker'));
  bgBookmarkCard?.addEventListener('click', () => setSubView('bg-picker'));

  dialog?.querySelectorAll<HTMLButtonElement>('button[data-manual-select-race-id]').forEach((btn) => {
    btn.addEventListener('click', (e) => {
      e.stopPropagation();
      const id = btn.getAttribute('data-manual-select-race-id');
      const found = QUICK_RACES.find((r) => r.id === id);
      if (found) {
        selectedRace = found;
        if (speedInp) speedInp.value = String(found.speedFt);
        updateBookmarkCardsUI();
        updateSuggestedHpUI();
      }
      setSubView('form');
    });
  });

  dialog?.querySelectorAll<HTMLButtonElement>('button[data-manual-select-class-id]').forEach((btn) => {
    btn.addEventListener('click', (e) => {
      e.stopPropagation();
      const id = btn.getAttribute('data-manual-select-class-id');
      const found = QUICK_CLASSES.find((c) => c.id === id);
      if (found) {
        selectedClass = found;
        applyClassDefaults(found);
        updateBookmarkCardsUI();
      }
      setSubView('form');
    });
  });

  dialog?.querySelectorAll<HTMLButtonElement>('button[data-manual-select-bg-id]').forEach((btn) => {
    btn.addEventListener('click', (e) => {
      e.stopPropagation();
      const id = btn.getAttribute('data-manual-select-bg-id');
      const found = QUICK_BACKGROUNDS.find((b) => b.id === id);
      if (found) {
        selectedBackground = found;
        applyBackgroundDefaults(found);
        updateBookmarkCardsUI();
      }
      setSubView('form');
    });
  });

  document.querySelectorAll<HTMLButtonElement>('.manual-stat-method-btn').forEach((btn) => {
    btn.addEventListener('click', () => {
      const m = btn.getAttribute('data-stat-method') as ManualStatMethod;
      if (!m) return;
      statMethod = m;
      if (m === 'pointbuy') {
        ABILITY_META.forEach(({ key }) => {
          baseScores[key] = Math.max(POINT_BUY_MIN, Math.min(POINT_BUY_MAX, baseScores[key]));
        });
      } else if (m === 'standard') {
        baseScores = assignStandardArrayForClass(selectedClass);
      } else if (m === 'dice' && rolledPool.length === 0) {
        rolledPool = rollFullStatSet();
        const sorted = [...rolledPool].sort((a, b) => b.total - a.total);
        selectedClass.abilityPriority.forEach((k, idx) => {
          baseScores[k] = sorted[idx]?.total ?? 10;
        });
      }
      renderStatsStep();
    });
  });

  document.querySelectorAll<HTMLButtonElement>('.manual-origin-mode-btn').forEach((btn) => {
    btn.addEventListener('click', () => {
      const mode = btn.getAttribute('data-origin-bonus-mode') as OriginBonusMode;
      if (mode) {
        originBonusMode = mode;
        renderStatsStep();
      }
    });
  });

  maxHpInp?.addEventListener('input', () => {
    hpManuallyEdited = true;
  });

  recalcHpBtn?.addEventListener('click', () => {
    hpManuallyEdited = false;
    updateSuggestedHpUI(true);
  });

  [levelInp, hitDieSel].forEach((el) => {
    el?.addEventListener('change', () => updateSuggestedHpUI());
  });

  document.querySelectorAll<HTMLButtonElement>('.manual-equip-mode-btn').forEach((btn) => {
    btn.addEventListener('click', () => {
      const mode = btn.getAttribute('data-equip-mode') as EquipmentStartMode;
      if (mode) {
        equipmentMode = mode;
        renderEquipmentStep();
      }
    });
  });

  document.querySelectorAll<HTMLButtonElement>('.manual-backpack-item-btn').forEach((btn) => {
    btn.addEventListener('click', () => {
      const id = btn.getAttribute('data-backpack-item-id');
      if (!id) return;
      if (selectedBackpackIds.has(id)) selectedBackpackIds.delete(id);
      else selectedBackpackIds.add(id);
      renderEquipmentStep();
    });
  });

  selectAllBackpackBtn?.addEventListener('click', () => {
    BACKPACK_STARTER_OPTIONS.forEach((o) => selectedBackpackIds.add(o.id));
    renderEquipmentStep();
  });

  clearAllBackpackBtn?.addEventListener('click', () => {
    selectedBackpackIds.clear();
    renderEquipmentStep();
  });

  backHeaderBtn?.addEventListener('click', () => {
    if (activeSubView !== 'form') {
      setSubView('form');
      return;
    }
    dialog?.close();
    window.dispatchEvent(
      new CustomEvent('open-create-character-modal', {
        detail: { targetCampaignId: currentTargetCampaignId },
      })
    );
  });

  closeBtn?.addEventListener('click', () => dialog?.close());
  cancelBtn?.addEventListener('click', () => dialog?.close());

  dialog?.addEventListener('close', () => {
    if (!characterCreated) {
      telemetry.track('character_creator_abandon', {
        creatorType: 'manual',
        step: currentStepIndex,
        stepName: currentStepName,
      });
    }
  });

  window.addEventListener('open-manual-creator-modal', ((
    e: CustomEvent<{ targetCampaignId?: string | null }>
  ) => {
    currentTargetCampaignId = e.detail?.targetCampaignId ?? null;
    characterCreated = false;
    currentStepName = 'identidad';
    currentStepIndex = 1;
    resetManualCreator();
    telemetry.track('character_creator_open', { creatorType: 'manual' });
    if (dialog && !dialog.open) {
      dialog.showModal();
    }
  }) as EventListener);

  form?.addEventListener('submit', (e) => {
    e.preventDefault();
    const charName = nameInp?.value.trim();
    if (!charName) {
      steps?.goTo('identidad');
      steps?.problem({ message: 'Escribe un nombre para tu personaje.', focus: nameInp });
      return;
    }

    const charData = collectBuiltCharacter();
    characterCreated = true;
    dialog?.close();

    try {
      const created = campaignStore.createCharacter(charData, currentTargetCampaignId);
      telemetry.track('character_creator_complete', {
        creatorType: 'manual',
        race: created.race,
        className: created.className,
      });
      showAlert(
        `¡${created.name} (${created.race} • ${created.className} Nvl. ${created.level}) ha sido creado con tu configuración manual!`,
        { kind: 'success', title: 'Personaje creado manualmente' }
      );
    } catch (err: any) {
      showAlert(err?.message || 'Error al crear el personaje.', { kind: 'error' });
    }
  });
</script>
