---
// src/components/party/PartyView.astro
// Vista compartida de la partida (VTT) para todos los miembros de la mesa: grupo, bitácora y slots reservados.
import StatusBanner from './StatusBanner.astro';
import InitiativeList from './InitiativeList.astro';
import MapStage from '../map/MapStage.astro';
import CombatTracker from '../dm/CombatTracker.astro';
import MapManager from '../dm/MapManager.astro';
import PresenceTracker from './PresenceTracker.astro';
---

<div id="party-view-root" class="w-full max-w-7xl mx-auto px-4 sm:px-6 py-6 space-y-6">
  <!-- AVISO MODO LOCAL (D10) -->
  <div id="party-local-notice" class="hidden p-6 rounded-2xl bg-amber-950/40 border border-amber-500/40 text-amber-200 text-center space-y-2">
    <span class="material-symbols-outlined text-4xl text-amber-400">cloud_off</span>
    <h2 class="text-base font-headline font-bold text-[#f1f5f9]">Mesa en vivo requiere cuenta</h2>
    <p class="text-xs text-[#94a3b8] max-w-md mx-auto">
      La mesa compartida en vivo utiliza sincronización en la nube. Requiere iniciar sesión con cuenta para conectar con tus compañeros.
    </p>
  </div>

  <!-- AVISO NO ENCONTRADA / SIN PERMISOS -->
  <div id="party-not-found-notice" class="hidden p-8 rounded-2xl bg-[#121721] border border-[#222f42] text-center space-y-3">
    <span class="material-symbols-outlined text-4xl text-rose-400">shield_lock</span>
    <h2 class="text-base font-headline font-bold text-[#f1f5f9]">Partida no disponible</h2>
    <p class="text-xs text-[#94a3b8] max-w-md mx-auto">
      No sos miembro de esta partida o la campaña no existe. Pedile al Dungeon Master el código de invitación o revisá tus campañas.
    </p>
    <a
      href="/campaigns"
      class="inline-flex items-center gap-2 px-4 py-2 rounded-xl bg-[#18202e] border border-[#222f42] hover:border-amber-500/40 text-amber-300 text-xs font-bold transition-all"
    >
      <span class="material-symbols-outlined text-[16px]">arrow_back</span>
      <span>Volver a Campañas</span>
    </a>
  </div>

  <!-- ESTADO DE CARGA -->
  <div id="party-loading" class="p-12 text-center text-[#94a3b8] text-xs space-y-3">
    <div class="w-8 h-8 mx-auto border-2 border-amber-500 border-t-transparent rounded-full animate-spin"></div>
    <p>Conectando con la mesa de juego...</p>
  </div>

  <!-- CONTENIDO PRINCIPAL DE LA PARTIDA -->
  <div id="party-content" class="hidden space-y-6">
    <!-- HERO HEADER DE LA CAMPAÑA: [titulo, titulo, dados] -->
    <header class="relative rounded-2xl bg-gradient-to-r from-[#121721] via-[#161e2c] to-[#121721] border border-[#222f42] p-5 sm:p-7 shadow-xl overflow-hidden">
      <div class="grid grid-cols-1 xl:grid-cols-12 gap-5 items-center relative z-10">
        <!-- LADO IZQUIERDO: [titulo, titulo] -->
        <div class="xl:col-span-7 space-y-2 min-w-0">
          <div class="flex items-center gap-2 flex-wrap">
            <span class="px-2.5 py-0.5 rounded-full bg-amber-500/20 text-amber-300 border border-amber-500/40 text-[10px] font-bold uppercase tracking-wider flex items-center gap-1">
              <span class="material-symbols-outlined text-[12px]">table_restaurant</span>
              <span>Mesa de Partida</span>
            </span>
            <span id="party-header-session" class="text-xs text-[#94a3b8] font-label">Sesión 1</span>
          </div>
          <h1 id="party-header-title" class="text-2xl sm:text-3xl font-headline font-bold text-[#f1f5f9] tracking-tight truncate">
            Cargando campaña...
          </h1>
          <p id="party-header-subtitle" class="text-xs sm:text-sm text-[#94a3b8] flex items-center gap-2 flex-wrap">
            <span id="party-header-dm">DM: -</span>
            <span>•</span>
            <span id="party-header-weather">Clima: -</span>
            <span>•</span>
            <span id="party-header-location">Lugar: -</span>
          </p>
          <div class="flex items-center gap-2 pt-1 flex-wrap">
            <a
              id="party-header-sheet-link"
              href="/campaigns"
              class="flex items-center gap-1.5 px-3 py-1.5 rounded-xl bg-[#18202e] border border-amber-500/30 hover:border-amber-500 text-amber-300 text-xs font-bold transition-all shadow-xs"
              title="Ir a mi ficha de personaje"
            >
              <span class="material-symbols-outlined text-[16px]">badge</span>
              <span>Mi Ficha</span>
            </a>
            <a
              href="/campaigns"
              class="flex items-center gap-1.5 px-3 py-1.5 rounded-xl bg-[#10141d] border border-[#222f42] hover:text-[#f1f5f9] text-[#94a3b8] text-xs font-bold transition-colors"
            >
              <span class="material-symbols-outlined text-[16px]">view_list</span>
              <span>Campañas</span>
            </a>
          </div>
        </div>

        <!-- LADO DERECHO: [dados] (Visible para el DM) -->
        <div id="party-dm-dice-container" class="hidden xl:col-span-5 rounded-xl bg-[#10141d]/90 border border-[#222f42] p-3.5 space-y-2.5 font-label text-xs backdrop-blur-sm shadow-md">
          <!-- Quick Dice Bar -->
          <div class="space-y-1.5">
            <div class="flex items-center justify-between">
              <span class="text-[11px] font-bold uppercase text-amber-400 tracking-wider flex items-center gap-1">
                <span class="material-symbols-outlined text-[15px]">casino</span>
                <span>Dados DM</span>
              </span>
              <label class="flex items-center gap-1.5 cursor-pointer text-[#94a3b8] hover:text-[#f1f5f9] select-none text-[10px]">
                <input type="checkbox" id="party-dm-secret-dice-check" class="rounded bg-[#18202e] border-[#222f42] text-amber-500 focus:ring-amber-500/40" />
                <span class="flex items-center gap-1">
                  <span>🔒</span>
                  <span>Tirada Oculta</span>
                </span>
              </label>
            </div>
            <div class="flex items-center gap-1 flex-wrap">
              <button type="button" class="party-dm-dice-btn px-2.5 py-1 rounded-lg bg-[#18202e] border border-amber-500/40 text-amber-300 font-bold hover:bg-amber-500/20 active:scale-95 transition-all cursor-pointer shadow-xs text-xs" data-dice="1d20">d20</button>
              <button type="button" class="party-dm-dice-btn px-2 py-1 rounded-lg bg-[#18202e] border border-[#222f42] hover:border-amber-400/60 text-[#cbd5e1] font-bold active:scale-95 transition-all cursor-pointer text-xs" data-dice="1d100">d100</button>
              <button type="button" class="party-dm-dice-btn px-2 py-1 rounded-lg bg-[#18202e] border border-[#222f42] hover:border-amber-400/60 text-[#cbd5e1] font-bold active:scale-95 transition-all cursor-pointer text-xs" data-dice="2d6">2d6</button>
              <button type="button" class="party-dm-dice-btn px-2 py-1 rounded-lg bg-[#18202e] border border-[#222f42] hover:border-amber-400/60 text-[#cbd5e1] font-bold active:scale-95 transition-all cursor-pointer text-xs" data-dice="1d12">1d12</button>
              <button type="button" class="party-dm-dice-btn px-2 py-1 rounded-lg bg-[#18202e] border border-[#222f42] hover:border-amber-400/60 text-[#cbd5e1] font-bold active:scale-95 transition-all cursor-pointer text-xs" data-dice="1d10">1d10</button>
              <button type="button" class="party-dm-dice-btn px-2 py-1 rounded-lg bg-[#18202e] border border-[#222f42] hover:border-amber-400/60 text-[#cbd5e1] font-bold active:scale-95 transition-all cursor-pointer text-xs" data-dice="1d8">1d8</button>
              <button type="button" class="party-dm-dice-btn px-2 py-1 rounded-lg bg-[#18202e] border border-[#222f42] hover:border-amber-400/60 text-[#cbd5e1] font-bold active:scale-95 transition-all cursor-pointer text-xs" data-dice="1d6">1d6</button>
              <button type="button" class="party-dm-dice-btn px-2 py-1 rounded-lg bg-[#18202e] border border-[#222f42] hover:border-amber-400/60 text-[#cbd5e1] font-bold active:scale-95 transition-all cursor-pointer text-xs" data-dice="1d4">1d4</button>
            </div>
          </div>

          <!-- Epic Milestones & Resting Actions -->
          <div class="flex items-center gap-1.5 pt-1.5 border-t border-[#222f42]/60 flex-wrap">
            <button
              type="button"
              id="party-dm-short-rest-btn"
              class="flex items-center gap-1 px-2.5 py-1 rounded-lg bg-[#18202e] border border-[#222f42] hover:border-amber-500/50 text-[#cbd5e1] hover:text-amber-300 font-bold active:scale-95 transition-colors cursor-pointer text-[11px]"
              title="Otorgar descanso corto a todos los aventureros (+8 PG)"
            >
              <span class="material-symbols-outlined text-[14px] text-amber-400">bedtime</span>
              <span>Descanso Corto</span>
            </button>

            <button
              type="button"
              id="party-dm-long-rest-btn"
              class="flex items-center gap-1 px-2.5 py-1 rounded-lg bg-[#18202e] border border-[#222f42] hover:border-amber-500/50 text-[#cbd5e1] hover:text-amber-300 font-bold active:scale-95 transition-colors cursor-pointer text-[11px]"
              title="Otorgar descanso largo a todo el grupo (restaura PG al máximo)"
            >
              <span class="material-symbols-outlined text-[14px] text-indigo-400">hotel</span>
              <span>Descanso Largo</span>
            </button>

            <button
              type="button"
              id="party-dm-milestone-btn"
              class="flex items-center gap-1 px-2.5 py-1 rounded-lg bg-gradient-to-r from-amber-600 via-amber-500 to-amber-600 hover:from-amber-500 hover:to-amber-400 text-[#0a0d12] font-bold shadow-[0_0_12px_rgba(245,158,11,0.3)] active:scale-95 transition-all cursor-pointer text-[11px] ml-auto"
              title="Lanzar un Hito o Logro Épico para la mesa"
            >
              <span class="material-symbols-outlined text-[14px]">celebration</span>
              <span>¡Hito!</span>
            </button>
          </div>
        </div>

        <!-- LADO DERECHO: [dados] (Visible para el Jugador / Usuario) -->
        <div id="party-player-dice-container" class="hidden xl:col-span-5 rounded-xl bg-[#10141d]/90 border border-[#222f42] p-3.5 space-y-2.5 font-label text-xs backdrop-blur-sm shadow-md">
          <!-- Quick Dice Bar -->
          <div class="space-y-1.5">
            <div class="flex items-center justify-between">
              <span class="text-[11px] font-bold uppercase text-amber-400 tracking-wider flex items-center gap-1">
                <span class="material-symbols-outlined text-[15px]">casino</span>
                <span>Dados</span>
              </span>
              <label class="flex items-center gap-1.5 cursor-pointer text-[#94a3b8] hover:text-[#f1f5f9] select-none text-[10px]">
                <input type="checkbox" id="party-player-secret-dice-check" class="rounded bg-[#18202e] border-[#222f42] text-amber-500 focus:ring-amber-500/40" />
                <span class="flex items-center gap-1">
                  <span>🔒</span>
                  <span>Tirada Oculta</span>
                </span>
              </label>
            </div>
            <div class="flex items-center gap-1 flex-wrap">
              <button type="button" class="party-player-dice-btn px-2.5 py-1 rounded-lg bg-[#18202e] border border-amber-500/40 text-amber-300 font-bold hover:bg-amber-500/20 active:scale-95 transition-all cursor-pointer shadow-xs text-xs" data-dice="1d20">d20</button>
              <button type="button" class="party-player-dice-btn px-2 py-1 rounded-lg bg-[#18202e] border border-[#222f42] hover:border-amber-400/60 text-[#cbd5e1] font-bold active:scale-95 transition-all cursor-pointer text-xs" data-dice="1d100">d100</button>
              <button type="button" class="party-player-dice-btn px-2 py-1 rounded-lg bg-[#18202e] border border-[#222f42] hover:border-amber-400/60 text-[#cbd5e1] font-bold active:scale-95 transition-all cursor-pointer text-xs" data-dice="2d6">2d6</button>
              <button type="button" class="party-player-dice-btn px-2 py-1 rounded-lg bg-[#18202e] border border-[#222f42] hover:border-amber-400/60 text-[#cbd5e1] font-bold active:scale-95 transition-all cursor-pointer text-xs" data-dice="1d12">1d12</button>
              <button type="button" class="party-player-dice-btn px-2 py-1 rounded-lg bg-[#18202e] border border-[#222f42] hover:border-amber-400/60 text-[#cbd5e1] font-bold active:scale-95 transition-all cursor-pointer text-xs" data-dice="1d10">1d10</button>
              <button type="button" class="party-player-dice-btn px-2 py-1 rounded-lg bg-[#18202e] border border-[#222f42] hover:border-amber-400/60 text-[#cbd5e1] font-bold active:scale-95 transition-all cursor-pointer text-xs" data-dice="1d8">1d8</button>
              <button type="button" class="party-player-dice-btn px-2 py-1 rounded-lg bg-[#18202e] border border-[#222f42] hover:border-amber-400/60 text-[#cbd5e1] font-bold active:scale-95 transition-all cursor-pointer text-xs" data-dice="1d6">1d6</button>
              <button type="button" class="party-player-dice-btn px-2 py-1 rounded-lg bg-[#18202e] border border-[#222f42] hover:border-amber-400/60 text-[#cbd5e1] font-bold active:scale-95 transition-all cursor-pointer text-xs" data-dice="1d4">1d4</button>
            </div>
          </div>

          <!-- Resting, Inspiration & Initiative Actions -->
          <div class="flex items-center gap-1.5 pt-1.5 border-t border-[#222f42]/60 flex-wrap">
            <button
              type="button"
              id="party-player-short-rest-btn"
              class="flex items-center gap-1 px-2.5 py-1 rounded-lg bg-[#18202e] border border-[#222f42] hover:border-amber-500/50 text-[#cbd5e1] hover:text-amber-300 font-bold active:scale-95 transition-colors cursor-pointer text-[11px]"
              title="Descanso corto para tu personaje (+8 PG)"
            >
              <span class="material-symbols-outlined text-[14px] text-amber-400">bedtime</span>
              <span>Descanso Corto</span>
            </button>

            <button
              type="button"
              id="party-player-long-rest-btn"
              class="flex items-center gap-1 px-2.5 py-1 rounded-lg bg-[#18202e] border border-[#222f42] hover:border-amber-500/50 text-[#cbd5e1] hover:text-amber-300 font-bold active:scale-95 transition-colors cursor-pointer text-[11px]"
              title="Descanso largo (restaura PG al máximo)"
            >
              <span class="material-symbols-outlined text-[14px] text-indigo-400">hotel</span>
              <span>Descanso Largo</span>
            </button>

            <button
              type="button"
              id="party-player-inspiration-btn"
              class="flex items-center gap-1 px-2.5 py-1 rounded-lg bg-[#18202e] border border-[#222f42] hover:border-amber-500/50 text-[#cbd5e1] hover:text-amber-300 font-bold active:scale-95 transition-colors cursor-pointer text-[11px]"
              title="Alternar estado de Inspiración de tu personaje"
            >
              <span class="material-symbols-outlined text-[14px] text-amber-400">auto_awesome</span>
              <span id="party-player-inspiration-text">Inspiración</span>
            </button>

            <button
              type="button"
              id="party-player-init-roll-btn"
              class="flex items-center gap-1 px-2.5 py-1 rounded-lg bg-gradient-to-r from-amber-600 via-amber-500 to-amber-600 hover:from-amber-500 hover:to-amber-400 text-[#0a0d12] font-bold shadow-[0_0_12px_rgba(245,158,11,0.3)] active:scale-95 transition-all cursor-pointer text-[11px] ml-auto"
              title="Tirar iniciativa con tu personaje"
            >
              <span class="material-symbols-outlined text-[14px]">bolt</span>
              <span>Iniciativa</span>
            </button>
          </div>
        </div>
      </div>
    </header>

    <!-- STATUS BANNER FLOTANTE (PAUSED / ENDED) -->
    <StatusBanner />

    <!-- PRESENCIA (T-51a): sin sección propia, marca las cards del roster -->
    <PresenceTracker />

    <!-- 1. VISTA DM TÁCTICA COCKPIT (Cuando el usuario conectado es DM) -->
    <div id="party-dm-cockpit" class="hidden space-y-6">
      <!-- [mapa,mapa,combate] -->
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 items-start">
        <!-- Columna Izquierda (7 cols): Mapa modo DM con selector de mapa y cuadrícula -->
        <div class="lg:col-span-7 space-y-2">
          <div class="flex items-center justify-between">
            <div class="flex items-center gap-2">
              <span class="material-symbols-outlined text-[20px] text-amber-400">map</span>
              <h2 class="text-sm font-headline font-bold text-[#f1f5f9]">Mapa Táctico de la Mesa</h2>
            </div>
            <span class="text-[11px] text-[#94a3b8] font-label">Visor VTT interactivo</span>
          </div>
          <MapStage mode="dm" id="party-dm-map-stage" />
        </div>

        <!-- Columna Derecha (5 cols): CombatTracker -->
        <div class="lg:col-span-5">
          <CombatTracker />
        </div>
      </div>

      <!-- [editar mapas] (FULL WIDTH) -->
      <MapManager />
    </div>

    <!-- 2. VISTA PASIVA DE JUGADOR (Cuando el usuario conectado es jugador) -->
    <div id="party-player-tactical-view" class="grid grid-cols-1 lg:grid-cols-12 gap-6 items-start">
      <!-- Columna Izquierda (7 cols): Mapa modo Jugador con selector/visor interactivo -->
      <div class="lg:col-span-7 space-y-2">
        <div class="flex items-center justify-between">
          <div class="flex items-center gap-2">
            <span class="material-symbols-outlined text-[20px] text-amber-400">map</span>
            <h2 class="text-sm font-headline font-bold text-[#f1f5f9]">Mapa Táctico de la Mesa</h2>
          </div>
          <span class="text-[11px] text-[#94a3b8] font-label">Visor VTT interactivo</span>
        </div>
        <MapStage mode="player" id="party-player-map-stage" />
      </div>

      <!-- Columna Derecha (5 cols): Tracker de Iniciativa y Combate -->
      <div class="lg:col-span-5">
        <InitiativeList />
      </div>
    </div>

    <!-- SECCIÓN INFERIOR: GRUPO Y BITÁCORA -->
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 items-start">
      <!-- 1. GRUPO DE AVENTUREROS (ROSTER) -->
      <section class="space-y-4">
        <div class="flex items-center justify-between gap-2 border-b border-[#222f42] pb-3">
          <div class="flex items-center gap-2">
            <span class="material-symbols-outlined text-amber-500 text-[20px]">groups</span>
            <h2 class="font-headline font-bold text-base text-[#f1f5f9]">Grupo de Aventureros</h2>
          </div>
          <span id="party-roster-count" class="text-xs text-[#94a3b8] font-label">0 Aventureros</span>
        </div>

        <div id="party-characters-list" class="space-y-3">
          <!-- Renderizado dinámico de tarjetas de aventureros -->
        </div>
      </section>

      <!-- 2. CRÓNICA DE LA PARTIDA (BITÁCORA PÚBLICA) -->
      <section class="space-y-4">
        <div class="flex items-center justify-between gap-2 border-b border-[#222f42] pb-3">
          <div class="flex items-center gap-2">
            <span class="material-symbols-outlined text-amber-500 text-[20px]">auto_stories</span>
            <h2 class="font-headline font-bold text-base text-[#f1f5f9]">Crónica de la Partida</h2>
          </div>
          <span class="text-xs text-[#94a3b8] font-label">Bitácora pública</span>
        </div>

        <div id="party-journal-feed" class="space-y-3 max-h-[600px] overflow-y-auto pr-1">
          <!-- Renderizado dinámico de entradas de la bitácora -->
        </div>
      </section>
    </div>
  </div>
</div>

<script>
  import { isFirebaseConfigured } from '../../scripts/firebase/client.ts';
  import { cloudSession } from '../../scripts/data/cloudSync.ts';
  import { campaignStore } from '../../scripts/state/campaignStore.ts';
  import { journalStore } from '../../scripts/state/journalStore.ts';
  import { characterStore } from '../../scripts/state/characterStore.ts';
  import { userStore } from '../../scripts/state/userStore.ts';
  import { showAlert, showConfirm, showForm } from '../../scripts/ui/notify.ts';

  const root = document.getElementById('party-view-root');
  const localNotice = document.getElementById('party-local-notice');
  const notFoundNotice = document.getElementById('party-not-found-notice');
  const loadingEl = document.getElementById('party-loading');
  const contentEl = document.getElementById('party-content');

  const titleEl = document.getElementById('party-header-title');
  const sessionEl = document.getElementById('party-header-session');
  const dmEl = document.getElementById('party-header-dm');
  const weatherEl = document.getElementById('party-header-weather');
  const locationEl = document.getElementById('party-header-location');
  const sheetLink = document.getElementById('party-header-sheet-link') as HTMLAnchorElement;

  const rosterCount = document.getElementById('party-roster-count');
  const charactersList = document.getElementById('party-characters-list');
  const journalFeed = document.getElementById('party-journal-feed');

  let currentCampaignId: string | null = null;

  async function initPartyView() {
    // 1. Modo local sin Firebase configurado (D10)
    if (!isFirebaseConfigured()) {
      loadingEl?.classList.add('hidden');
      localNotice?.classList.remove('hidden');
      return;
    }

    // 2. Esperar inicio de sesión en la nube
    try {
      await cloudSession.ready();
    } catch (e) {
      console.warn('[PartyView] Error esperando sesión:', e);
    }

    const params = new URLSearchParams(window.location.search);
    currentCampaignId = params.get('id') || params.get('campaign') || campaignStore.getActiveCampaignId();

    if (!currentCampaignId) {
      const allCamps = campaignStore.getCampaigns();
      if (allCamps.length > 0) {
        currentCampaignId = allCamps[0].id;
      }
    }

    if (!currentCampaignId) {
      if (campaignStore.hasLoadedCampaigns()) {
        showNotFound();
      }
      return;
    }

    // Activar campaña para que cloudSync monte los listeners
    campaignStore.setActiveCampaign(currentCampaignId);

    // Cargar ficha del jugador si pertenece a la campaña
    const currentUser = userStore.getCurrentUser();
    const myChar = campaignStore.getMyCharacterForCampaign(currentCampaignId, currentUser.id);
    if (myChar && characterStore.get().id !== myChar.id) {
      characterStore.loadCharacter(myChar);
    }

    // Dados DM en PartyView
    document.querySelectorAll('.party-dm-dice-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        const formula = btn.getAttribute('data-dice') || '1d20';
        const secretCheck = document.getElementById('party-dm-secret-dice-check') as HTMLInputElement;
        const isSecret = secretCheck?.checked || false;
        const sides = parseInt(formula.replace(/\D/g, '')) || 20;
        const count = parseInt(formula) || 1;

        window.dispatchEvent(new CustomEvent('open-dice-roller', {
          detail: {
            die: sides,
            count: count,
            modifier: 0,
            label: isSecret ? `Tirada Secreta de DM (${formula})` : `Tirada de DM (${formula})`,
            tag: isSecret ? '#Privado' : '#Tirada',
            isDmRoll: true,
            isSecret: isSecret,
            autoroll: true
          }
        }));
      });
    });

    // Descanso Corto DM
    document.getElementById('party-dm-short-rest-btn')?.addEventListener('click', async () => {
      if (!currentCampaignId) return;
      if (await showConfirm('Cada personaje de la campaña recupera +8 PG.', { title: '¿Descanso Corto para todo el grupo?', confirmText: 'Aplicar' })) {
        const chars = campaignStore.getCharactersForCampaign(currentCampaignId);
        chars.forEach(c => {
          c.hp.current = Math.min(c.hp.max, c.hp.current + 8);
          campaignStore.saveCharacter(c);
        });
        journalStore.log(
          'Descanso Corto de Grupo',
          'El Dungeon Master decretó un descanso corto para todos los aventureros (+8 PG recuperados).',
          ['#Descanso']
        );
        render();
        showAlert('¡Descanso corto aplicado a todos los aventureros!', { kind: 'success', title: 'Descanso corto' });
      }
    });

    // Descanso Largo DM
    document.getElementById('party-dm-long-rest-btn')?.addEventListener('click', async () => {
      if (!currentCampaignId) return;
      if (await showConfirm('Todos los personajes recuperan sus PG al máximo.', { title: '¿Descanso Largo para toda la mesa?', confirmText: 'Aplicar' })) {
        const chars = campaignStore.getCharactersForCampaign(currentCampaignId);
        chars.forEach(c => {
          c.hp.current = c.hp.max;
          if (c.hp.temp) c.hp.temp = 0;
          campaignStore.saveCharacter(c);
        });
        journalStore.log(
          'Descanso Largo de Grupo',
          'El Dungeon Master concedió un descanso largo completo. Todos los aventureros han restablecido sus Puntos de Golpe al máximo.',
          ['#Descanso']
        );
        render();
        showAlert('¡Descanso largo completado! Todos los aventureros tienen la salud restaurada.', { kind: 'success', title: 'Descanso largo' });
      }
    });

    // Hito Épico DM
    document.getElementById('party-dm-milestone-btn')?.addEventListener('click', async () => {
      if (!currentCampaignId) return;
      const camp = campaignStore.getCampaign(currentCampaignId);
      const values = await showForm([
        { name: 'title', label: 'Título del hito', value: '¡Hazaña Heroica de la Mesa!', required: true },
        { name: 'banner', label: 'Texto del banderín', value: '¡VICTORIA ÉPICA!', hint: 'Se muestra en mayúsculas sobre el título.' },
        { name: 'desc', label: 'Descripción del logro', type: 'textarea', value: 'El grupo ha triunfado ante el peligro y grabado su nombre en las crónicas.' },
      ], { title: 'Celebrar un hito', message: 'Se le muestra a toda la mesa en vivo.', confirmText: 'Celebrar' });
      if (!values) return;
      const title = values.title.trim();
      const banner = values.banner.trim() || '¡FELICIDADES!';
      const desc = values.desc.trim() || '¡Logro conseguido!';

      campaignStore.sendDmEvent(currentCampaignId, {
        campaignId: currentCampaignId,
        type: 'milestone',
        dmName: camp?.dmName || 'Dungeon Master',
        payload: {
          milestone: { bannerText: banner, title, description: desc }
        }
      });

      journalStore.log(
        `⭐ Hito Épico: ${title}`,
        desc,
        ['#Hito'],
        undefined,
        { bannerText: banner, authorName: camp?.dmName || 'Dungeon Master' }
      );

      render();
    });

    // Dados de Jugador en PartyView
    document.querySelectorAll('.party-player-dice-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        const formula = btn.getAttribute('data-dice') || '1d20';
        const secretCheck = document.getElementById('party-player-secret-dice-check') as HTMLInputElement;
        const isSecret = secretCheck?.checked || false;
        const sides = parseInt(formula.replace(/\D/g, '')) || 20;
        const count = parseInt(formula) || 1;
        const currentUser = userStore.getCurrentUser();
        const myChar = currentCampaignId ? campaignStore.getMyCharacterForCampaign(currentCampaignId, currentUser.id) : characterStore.get();
        const charName = myChar?.name || currentUser?.name || 'Aventurero';

        window.dispatchEvent(new CustomEvent('open-dice-roller', {
          detail: {
            die: sides,
            count: count,
            modifier: 0,
            label: isSecret ? `Tirada Secreta de ${charName} (${formula})` : `Tirada de ${charName} (${formula})`,
            tag: isSecret ? '#Privado' : '#Tirada',
            isSecret: isSecret,
            characterId: myChar?.id,
            characterName: charName,
            authorName: charName,
            campaignId: currentCampaignId,
            autoroll: true
          }
        }));
      });
    });

    // Descanso Corto Jugador
    document.getElementById('party-player-short-rest-btn')?.addEventListener('click', async () => {
      const currentUser = userStore.getCurrentUser();
      const myChar = currentCampaignId ? campaignStore.getMyCharacterForCampaign(currentCampaignId, currentUser.id) : characterStore.get();
      if (!myChar) {
        showAlert('No tienes un personaje asignado en esta campaña para descansar.', { kind: 'warning' });
        return;
      }
      if (await showConfirm(`Recuperas +8 Puntos de Golpe en ${myChar.name}.`, { title: '¿Descanso Corto?', confirmText: 'Descansar (+8 PG)' })) {
        myChar.hp.current = Math.min(myChar.hp.max, (myChar.hp.current || 0) + 8);
        campaignStore.saveCharacter(myChar);
        if (characterStore.get().id === myChar.id) {
          characterStore.updateHp(myChar.hp.current);
        }
        journalStore.log(
          `Descanso Corto de ${myChar.name}`,
          `${myChar.name} ha tomado un descanso corto (+8 PG recuperados).`,
          ['#Descanso']
        );
        render();
        showAlert(`¡Descanso corto aplicado! ${myChar.name} recuperó +8 PG (${myChar.hp.current}/${myChar.hp.max}).`, { kind: 'success', title: 'Descanso corto' });
      }
    });

    // Descanso Largo Jugador
    document.getElementById('party-player-long-rest-btn')?.addEventListener('click', async () => {
      const currentUser = userStore.getCurrentUser();
      const myChar = currentCampaignId ? campaignStore.getMyCharacterForCampaign(currentCampaignId, currentUser.id) : characterStore.get();
      if (!myChar) {
        showAlert('No tienes un personaje asignado en esta campaña para descansar.', { kind: 'warning' });
        return;
      }
      if (await showConfirm(`Tus Puntos de Golpe se restauran al máximo (${myChar.hp.max} PG) y se limpian PG temporales.`, { title: '¿Descanso Largo?', confirmText: 'Descansar al Máximo' })) {
        myChar.hp.current = myChar.hp.max;
        if (myChar.hp.temp) myChar.hp.temp = 0;
        campaignStore.saveCharacter(myChar);
        if (characterStore.get().id === myChar.id) {
          characterStore.updateHp(myChar.hp.current);
        }
        journalStore.log(
          `Descanso Largo de ${myChar.name}`,
          `${myChar.name} completó un descanso largo. Puntos de Golpe restaurados al máximo.`,
          ['#Descanso']
        );
        render();
        showAlert(`¡Descanso largo completado! ${myChar.name} tiene ${myChar.hp.max} PG.`, { kind: 'success', title: 'Descanso largo' });
      }
    });

    // Alternar Inspiración Jugador
    document.getElementById('party-player-inspiration-btn')?.addEventListener('click', () => {
      const currentUser = userStore.getCurrentUser();
      const myChar = currentCampaignId ? campaignStore.getMyCharacterForCampaign(currentCampaignId, currentUser.id) : characterStore.get();
      if (!myChar) return;
      myChar.inspiration = !myChar.inspiration;
      campaignStore.saveCharacter(myChar);
      if (characterStore.get().id === myChar.id) {
        characterStore.toggleInspiration();
      }
      updatePlayerInspirationBadge(Boolean(myChar.inspiration));
      showAlert(myChar.inspiration ? `¡${myChar.name} ahora está Inspirado!` : `Inspiración consumida en ${myChar.name}.`, { kind: 'info', title: 'Inspiración' });
    });

    // Tirar Iniciativa Jugador
    document.getElementById('party-player-init-roll-btn')?.addEventListener('click', () => {
      const currentUser = userStore.getCurrentUser();
      const myChar = currentCampaignId ? campaignStore.getMyCharacterForCampaign(currentCampaignId, currentUser.id) : characterStore.get();
      const dexMod = myChar?.stats?.dex?.modifier ?? 0;
      const secretCheck = document.getElementById('party-player-secret-dice-check') as HTMLInputElement;
      const isSecret = secretCheck?.checked || false;
      const charName = myChar?.name || currentUser?.name || 'Aventurero';

      window.dispatchEvent(new CustomEvent('open-dice-roller', {
        detail: {
          die: 20,
          count: 1,
          modifier: dexMod,
          label: `Iniciativa de ${charName} (1d20 ${dexMod >= 0 ? '+' : ''}${dexMod})`,
          tag: isSecret ? '#Privado' : '#Iniciativa',
          isSecret: isSecret,
          isInitiative: true,
          lockDie: true,
          lockCount: true,
          characterId: myChar?.id,
          characterName: charName,
          authorName: charName,
          campaignId: currentCampaignId,
          autoroll: true
        }
      }));
    });

    render();
  }

  function updatePlayerInspirationBadge(inspired: boolean) {
    const btn = document.getElementById('party-player-inspiration-btn');
    const txt = document.getElementById('party-player-inspiration-text');
    if (!btn || !txt) return;
    if (inspired) {
      btn.className = 'flex items-center gap-1 px-2.5 py-1 rounded-lg bg-gradient-to-r from-rose-600 to-amber-600 text-white font-bold shadow-[0_0_10px_rgba(245,158,11,0.4)] border border-amber-400/40 active:scale-95 transition-all cursor-pointer text-[11px]';
      txt.textContent = 'Inspirado';
    } else {
      btn.className = 'flex items-center gap-1 px-2.5 py-1 rounded-lg bg-[#18202e] border border-[#222f42] hover:border-amber-500/50 text-[#cbd5e1] hover:text-amber-300 font-bold active:scale-95 transition-colors cursor-pointer text-[11px]';
      txt.textContent = 'Inspiración';
    }
  }

  // Evita recrear los hijos del enlace en cada evento en vivo: en táctil el click se pierde si el nodo cambia.
  function setLinkContent(link: HTMLElement, icon: string, label: string) {
    const key = `${icon}|${label}`;
    if (link.dataset.content === key) return;
    link.dataset.content = key;
    link.innerHTML = `
      <span class="material-symbols-outlined text-[16px]">${icon}</span>
      <span>${label}</span>
    `;
  }

  function render() {
    if (!currentCampaignId) return;
    const camp = campaignStore.getCampaign(currentCampaignId);

    if (!camp) {
      if (campaignStore.hasLoadedCampaigns()) {
        showNotFound();
      }
      return;
    }

    // Ocultar avisos y mostrar contenido
    loadingEl?.classList.add('hidden');
    notFoundNotice?.classList.add('hidden');
    localNotice?.classList.add('hidden');
    contentEl?.classList.remove('hidden');

    // Header info
    if (titleEl) titleEl.textContent = camp.name;
    if (sessionEl) sessionEl.textContent = `Sesión ${camp.sessionNumber || 1}`;
    if (dmEl) dmEl.textContent = `DM: ${camp.dmName || 'Dungeon Master'}`;
    if (weatherEl) weatherEl.textContent = `Clima: ${camp.weather || 'Despejado'}`;
    if (locationEl) locationEl.textContent = `Lugar: ${camp.location || 'Aventura'}`;

    // Conmutar entre Cockpit DM y vista pasiva de Jugador
    const isDm = currentCampaignId ? campaignStore.isCurrentUserDm(currentCampaignId) : false;
    const dmCockpit = document.getElementById('party-dm-cockpit');
    const playerView = document.getElementById('party-player-tactical-view');

    const dmDice = document.getElementById('party-dm-dice-container');
    const playerDice = document.getElementById('party-player-dice-container');

    if (isDm) {
      dmCockpit?.classList.remove('hidden');
      playerView?.classList.add('hidden');
      dmDice?.classList.remove('hidden');
      playerDice?.classList.add('hidden');
    } else {
      dmCockpit?.classList.add('hidden');
      playerView?.classList.remove('hidden');
      dmDice?.classList.add('hidden');
      playerDice?.classList.remove('hidden');

      const currentUser = userStore.getCurrentUser();
      const myChar = currentCampaignId ? campaignStore.getMyCharacterForCampaign(currentCampaignId, currentUser.id) : characterStore.get();
      if (myChar) {
        updatePlayerInspirationBadge(Boolean(myChar.inspiration));
      }
    }

    // Link a la ficha o al grimorio DM
    if (sheetLink) {
      if (isDm) {
        sheetLink.href = `/campaigns?campaign=${encodeURIComponent(camp.id)}&mode=dm`;
        setLinkContent(sheetLink, 'shield_with_heart', 'Grimorio DM');
        sheetLink.classList.remove('hidden');
      } else {
        const myChar = campaignStore.getMyCharacterForCampaign(camp.id);
        if (myChar) {
          sheetLink.href = `/campaigns?campaign=${encodeURIComponent(camp.id)}&character=${encodeURIComponent(myChar.id)}`;
          setLinkContent(sheetLink, 'badge', 'Mi Ficha');
          sheetLink.classList.remove('hidden');
        } else {
          sheetLink.href = `/campaigns?campaign=${encodeURIComponent(camp.id)}`;
          sheetLink.classList.add('hidden');
        }
      }
    }

    renderRoster(camp.id);
    renderJournal(camp.id);
  }

  function renderRoster(cid: string) {
    if (!charactersList) return;
    const camp = campaignStore.getCampaign(cid);
    const chars = campaignStore.getCharactersForCampaign(cid);
    const memberUids = camp?.memberUserIds || [];
    const currentUser = userStore.getCurrentUser();

    // Miembros de la campaña sin personaje asignado todavía (ej: DM o jugador recién unido)
    const membersWithoutChar = memberUids.filter(uid => !chars.some(c => c.userId === uid));
    const totalMembersCount = chars.length + membersWithoutChar.length;

    if (rosterCount) {
      rosterCount.textContent = `${totalMembersCount} Miembro${totalMembersCount === 1 ? '' : 's'} (${chars.length} Aventurero${chars.length === 1 ? '' : 's'})`;
    }

    if (chars.length === 0 && membersWithoutChar.length === 0) {
      charactersList.innerHTML = `
        <div class="p-6 rounded-xl bg-[#121721] border border-[#222f42] text-center text-xs text-[#94a3b8]">
          No hay aventureros ni miembros asignados a esta campaña todavía.
        </div>
      `;
      return;
    }

    charactersList.innerHTML = '';

    // 1. Personajes asignados a la campaña
    chars.forEach(c => {
      const hpPercent = Math.max(0, Math.min(100, Math.round(((c.hp?.current || 0) / (c.hp?.max || 1)) * 100)));
      const isMine = c.userId === currentUser.id;
      const ownerUser = c.userId ? userStore.getUser(c.userId) : null;
      const ownerName = c.playerName || ownerUser?.name || 'Jugador';

      const card = document.createElement('div');
      card.className = 'flex items-center justify-between gap-3 p-3.5 rounded-xl bg-[#121721] border border-[#222f42] shadow-xs hover:border-amber-500/40 transition-colors';
      if (c.userId) card.dataset.presenceUid = c.userId;
      card.innerHTML = `
        <div class="flex items-center gap-3 min-w-0">
          <img
            src="${c.avatarUrl || '/characters/ch-1.avif'}"
            alt="${c.name}"
            class="w-10 h-10 rounded-xl object-cover border border-[#222f42] shrink-0"
            onerror="this.onerror=null;this.src='/characters/ch-1.avif';"
          />
          <div class="min-w-0">
            <div class="flex items-center gap-1.5 flex-wrap">
              <h4 class="font-headline font-bold text-xs text-[#f1f5f9] truncate">${c.name}</h4>
              ${isMine ? '<span class="text-[9px] px-1.5 py-0.2 rounded bg-amber-500/15 text-amber-300 font-bold border border-amber-500/30">Tú</span>' : ''}
              ${c.inspiration ? '<span class="text-[9px] px-1.5 py-0.2 rounded bg-amber-500/20 text-amber-300 font-bold border border-amber-500/40">⭐ Inspirado</span>' : ''}
            </div>
            <p class="text-[11px] text-[#94a3b8] truncate">
              ${c.race || ''} ${c.className || ''} Nivel ${c.level || 1} • <span class="text-[#cbd5e1]">${ownerName}</span>
            </p>
          </div>
        </div>

        <div class="text-right shrink-0">
          <div class="flex items-center gap-1.5 justify-end font-mono text-xs font-bold text-[#f1f5f9]">
            <span class="text-rose-400 material-symbols-outlined text-[14px]">favorite</span>
            <span>${c.hp?.current || 0} / ${c.hp?.max || 0}</span>
          </div>
          <div class="w-20 h-1.5 bg-[#18202e] rounded-full overflow-hidden mt-1 ml-auto">
            <div class="h-full bg-emerald-500 rounded-full transition-all" style="width: ${hpPercent}%"></div>
          </div>
        </div>
      `;
      charactersList.appendChild(card);
    });

    // 2. Otros miembros de la mesa (DM o usuarios sin personaje enlazado)
    if (membersWithoutChar.length > 0) {
      const sectionDivider = document.createElement('div');
      sectionDivider.className = 'pt-2.5 mt-2 border-t border-[#222f42]/60 text-[10px] font-bold text-[#64748b] uppercase tracking-wider px-1';
      sectionDivider.textContent = 'Otros Miembros de la Mesa';
      charactersList.appendChild(sectionDivider);

      membersWithoutChar.forEach(mUid => {
        const mUser = userStore.getUser(mUid);
        const isThisMe = mUid === currentUser.id;
        const isThisCreator = camp && mUid === camp.creatorId;
        const isThisDm = camp && mUid === camp.dmId;
        const displayName = mUser?.name || (isThisDm ? (camp?.dmName || 'Dungeon Master') : 'Aventurero');

        const mCard = document.createElement('div');
        mCard.className = 'p-3 rounded-xl bg-[#10141d] border border-[#222f42] flex items-center justify-between gap-3 text-xs';
        mCard.dataset.presenceUid = mUid;
        mCard.innerHTML = `
          <div class="flex items-center gap-2.5 min-w-0">
            <div class="w-8 h-8 rounded-lg ${isThisDm ? 'bg-purple-500/20 text-purple-300 border border-purple-500/30' : 'bg-amber-500/10 text-amber-400 border border-amber-500/30'} flex items-center justify-center shrink-0">
              <span class="material-symbols-outlined text-[16px]">${isThisDm ? 'crown' : 'person'}</span>
            </div>
            <div class="min-w-0">
              <div class="flex items-center gap-1.5 flex-wrap">
                <span class="font-bold text-[#f1f5f9] truncate">${displayName}</span>
                ${isThisMe ? '<span class="text-[9px] text-amber-400 font-bold">(Tú)</span>' : ''}
                ${isThisDm ? '<span class="px-1.5 py-0.2 rounded bg-purple-500/20 text-purple-300 text-[8px] font-bold border border-purple-500/30">👑 DM</span>' : ''}
                ${isThisCreator && !isThisDm ? '<span class="px-1.5 py-0.2 rounded bg-amber-500/20 text-amber-300 text-[8px] font-bold border border-amber-500/30">Creador</span>' : ''}
              </div>
              <span class="text-[10px] text-[#64748b] block truncate">${isThisDm ? 'Dungeon Master de la partida' : 'Miembro sin personaje asignado'}</span>
            </div>
          </div>

          ${isThisMe && !isThisDm ? `
            <a
              href="/campaigns?campaign=${encodeURIComponent(cid)}"
              class="px-2.5 py-1 rounded-lg bg-amber-500/15 hover:bg-amber-500/25 border border-amber-500/30 text-amber-300 text-[11px] font-bold transition-all shrink-0 flex items-center gap-1"
            >
              <span class="material-symbols-outlined text-[14px]">add</span>
              <span>Asignar Ficha</span>
            </a>
          ` : ''}
        `;
        charactersList.appendChild(mCard);
      });
    }
  }

  function renderJournal(cid: string) {
    if (!journalFeed) return;
    const entries = journalStore.getPublicCampaignEntries(cid);
    const isDm = cid ? campaignStore.isCurrentUserDm(cid) : false;

    if (entries.length === 0) {
      journalFeed.innerHTML = `
        <div class="p-6 rounded-xl bg-[#121721] border border-[#222f42] text-center text-xs text-[#94a3b8]">
          No hay entradas públicas registradas en la crónica todavía.
        </div>
      `;
      return;
    }

    journalFeed.innerHTML = '';
    entries.forEach(e => {
      const card = document.createElement('div');
      card.className = 'p-3.5 rounded-xl bg-[#121721] border border-[#222f42] space-y-2 shadow-xs';

      const isStatusEvent = (e as any).systemEvent === 'status';
      const badgeStyle = isStatusEvent
        ? 'bg-amber-500/20 text-amber-300 border-amber-500/40'
        : 'bg-[#18202e] text-[#94a3b8] border-[#222f42]';

      let extraBoxHtml = '';
      if (e.diceRoll && e.diceRoll.formula && e.diceRoll.result !== undefined) {
        extraBoxHtml = `
          <div class="p-2 rounded-lg bg-[#10141d] border border-amber-500/30 flex items-center justify-between text-xs my-1">
            <span class="text-[#94a3b8]">${e.diceRoll.formula}</span>
            <span class="font-headline font-bold text-amber-400 text-sm">Resultado: ${e.diceRoll.result}</span>
          </div>
        `;
      } else {
        const milestoneBanner = e.milestone?.bannerText || (e.diceRoll as any)?.bannerText;
        if (milestoneBanner) {
          extraBoxHtml = `
            <div class="p-2 rounded-lg bg-amber-500/15 border border-amber-500/40 flex items-center gap-1.5 my-1 text-amber-300 font-headline font-bold text-xs tracking-wider uppercase">
              <span class="material-symbols-outlined text-[16px] text-amber-400">military_tech</span>
              <span>${milestoneBanner}</span>
            </div>
          `;
        }
      }

      card.innerHTML = `
        <div class="flex items-center justify-between gap-2 text-xs">
          <span class="font-headline font-bold text-[#f1f5f9] flex items-center gap-1.5 truncate">
            ${isStatusEvent ? '<span class="material-symbols-outlined text-[14px] text-amber-400">info</span>' : ''}
            <span>${e.title}</span>
          </span>
          <div class="flex items-center gap-1.5 shrink-0">
            <span class="text-[10px] text-[#64748b] font-label">
              ${e.timestamp ? new Date(e.timestamp).toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' }) : ''}
            </span>
            ${isDm ? `
              <button
                type="button"
                class="party-delete-entry-btn w-5 h-5 rounded hover:bg-rose-500/20 text-[#64748b] hover:text-rose-400 flex items-center justify-center transition-colors cursor-pointer"
                data-id="${e.id}"
                title="Eliminar entrada de la crónica"
                aria-label="Eliminar entrada"
              >
                <span class="material-symbols-outlined text-[13px]">delete</span>
              </button>
            ` : ''}
          </div>
        </div>
        <p class="text-xs text-[#cbd5e1] leading-relaxed whitespace-pre-wrap">${e.content}</p>
        ${extraBoxHtml}
        <div class="flex items-center justify-between gap-2 pt-1 border-t border-[#222f42]/60 text-[10px] text-[#64748b]">
          <span>${e.authorName || 'Mesa'}</span>
          <div class="flex items-center gap-1">
            ${(e.tags || []).map(t => `<span class="px-1.5 py-0.5 rounded border ${badgeStyle}">${t}</span>`).join('')}
          </div>
        </div>
      `;

      if (isDm) {
        card.querySelector('.party-delete-entry-btn')?.addEventListener('click', async (evt) => {
          evt.stopPropagation();
          if (await showConfirm(`¿Deseas eliminar la entrada "${e.title}" de la crónica?`, {
            title: 'Eliminar entrada de bitácora',
            confirmText: 'Eliminar'
          })) {
            journalStore.deleteEntry(e.id);
            renderJournal(cid);
          }
        });
      }

      journalFeed.appendChild(card);
    });
  }

  function showNotFound() {
    loadingEl?.classList.add('hidden');
    contentEl?.classList.add('hidden');
    localNotice?.classList.add('hidden');
    notFoundNotice?.classList.remove('hidden');
  }

  window.addEventListener('campaigns-updated', render);
  window.addEventListener('all-characters-updated', () => {
    if (currentCampaignId) {
      const currentUser = userStore.getCurrentUser();
      const myChar = campaignStore.getMyCharacterForCampaign(currentCampaignId, currentUser.id);
      if (myChar && characterStore.get().id !== myChar.id) {
        characterStore.loadCharacter(myChar);
      }
    }
    render();
  });
  window.addEventListener('journal-updated', render);
  window.addEventListener('session-status-changed', render);
  window.addEventListener('users-updated', render);
  window.addEventListener('current-user-changed', render);
  window.addEventListener('active-campaign-changed', () => {
    const nextCid = campaignStore.getActiveCampaignId();
    if (nextCid) {
      currentCampaignId = nextCid;
      render();
    }
  });

  initPartyView();
</script>
