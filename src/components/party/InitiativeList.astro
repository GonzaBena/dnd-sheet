---
// src/components/party/InitiativeList.astro
// Vista de iniciativa y turnos para los jugadores en la mesa de partida (/partida), con selector de ataque contra objetivos.
---

<div
  id="party-initiative-root"
  class="w-full rounded-2xl bg-[#121721] border border-[#222f42] p-5 shadow-sm space-y-4"
>
  <!-- ENCABEZADO -->
  <div class="flex items-center justify-between gap-3 pb-3 border-b border-[#222f42]">
    <div class="flex items-center gap-2.5">
      <div class="w-9 h-9 rounded-xl bg-rose-500/15 border border-rose-500/30 flex items-center justify-center text-rose-400">
        <span class="material-symbols-outlined text-[20px]">swords</span>
      </div>
      <div>
        <h3 class="text-sm font-headline font-bold text-[#f1f5f9] leading-tight">
          Iniciativa y Turnos
        </h3>
        <p class="text-[11px] text-[#94a3b8] font-label">
          Combate en tiempo real
        </p>
      </div>
    </div>

    <!-- BADGE DE ESTADO / RONDA -->
    <div id="party-round-badge" class="hidden items-center gap-1.5 px-2.5 py-1 rounded-full bg-amber-500/15 border border-amber-500/30 text-amber-300 text-xs font-bold font-label">
      <span class="w-2 h-2 rounded-full bg-amber-400 animate-pulse"></span>
      <span id="party-round-text">Ronda 1</span>
    </div>
  </div>

  <!-- ESTADO SIN COMBATE -->
  <div
    id="party-no-combat"
    class="py-12 px-4 text-center space-y-3"
  >
    <div class="w-12 h-12 mx-auto rounded-2xl bg-[#18202e] border border-[#222f42] flex items-center justify-center text-[#94a3b8]">
      <span class="material-symbols-outlined text-[24px]">shield</span>
    </div>
    <div class="space-y-1">
      <p class="text-xs font-bold text-[#cbd5e1]">Sin combate en curso</p>
      <p class="text-[11px] text-[#94a3b8] max-w-xs mx-auto leading-relaxed">
        El orden de turnos, asaltos y condiciones aparecerán acá cuando el Dungeon Master inicie un encuentro.
      </p>
    </div>
  </div>

  <!-- LISTA DE COMBATIENTES -->
  <div
    id="party-combat-list"
    class="hidden space-y-2.5 max-h-[550px] overflow-y-auto pr-1"
  >
    <!-- Se llena dinámicamente -->
  </div>

  <!-- MODAL RÁPIDO DE ATAQUE A OBJETIVO -->
  <div
    id="party-attack-modal"
    class="hidden fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/75 backdrop-blur-xs"
  >
    <div class="relative w-full max-w-md rounded-2xl bg-[#121721] border border-[#222f42] shadow-2xl p-5 space-y-4 max-h-[85vh] overflow-y-auto">
      <div class="flex items-center justify-between pb-3 border-b border-[#222f42]">
        <div class="flex items-center gap-2.5">
          <div class="w-8 h-8 rounded-lg bg-rose-500/20 text-rose-400 flex items-center justify-center border border-rose-500/30">
            <span class="material-symbols-outlined text-[18px]">my_location</span>
          </div>
          <div>
            <h3 class="font-headline font-bold text-sm text-[#f1f5f9] flex items-center gap-1.5 flex-wrap">
              <span>Atacar a</span>
              <span id="party-modal-target-name" class="text-rose-300">Oponente</span>
            </h3>
            <span id="party-modal-target-ac" class="text-[11px] text-[#94a3b8] font-mono">CA: --</span>
          </div>
        </div>
        <button
          type="button"
          id="party-attack-modal-close"
          class="w-7 h-7 rounded-lg bg-[#18202e] border border-[#222f42] text-[#94a3b8] hover:text-[#f1f5f9] flex items-center justify-center text-xs cursor-pointer"
        >
          ✕
        </button>
      </div>

      <p class="text-xs text-[#94a3b8]">
        Elige tu arma, magia u objeto para realizar el ataque contra este objetivo según la distancia táctica. Podrás tirar en la app o ingresar dados físicos en mesa.
      </p>

      <!-- Selector de Distancia Táctica al Objetivo (5e Reach / Range) -->
      <div class="p-3 rounded-xl bg-[#10141d] border border-[#222f42] space-y-2">
        <div class="flex items-center justify-between">
          <label class="text-[10px] font-bold text-[#cbd5e1] uppercase tracking-wider flex items-center gap-1.5">
            <span class="material-symbols-outlined text-[15px] text-amber-400">straighten</span>
            <span>Distancia al Objetivo:</span>
          </label>
          <div class="flex items-center gap-1 font-mono text-xs font-bold text-amber-300">
            <span id="party-modal-distance-display">5</span>
            <span class="text-[10px] text-[#94a3b8]">pies</span>
          </div>
        </div>

        <div class="flex items-center gap-1.5 flex-wrap" id="party-distance-presets">
          <button
            type="button"
            class="party-dist-btn active px-2.5 py-1 rounded-lg bg-amber-500/20 border border-amber-500/60 text-amber-300 text-[11px] font-bold transition-all cursor-pointer shadow-xs"
            data-feet="5"
          >
            5 pies (Melé)
          </button>
          <button
            type="button"
            class="party-dist-btn px-2.5 py-1 rounded-lg bg-[#18202e] border border-[#222f42] hover:border-slate-600 text-[#cbd5e1] text-[11px] font-bold transition-all cursor-pointer"
            data-feet="10"
          >
            10 pies (Alcance)
          </button>
          <button
            type="button"
            class="party-dist-btn px-2.5 py-1 rounded-lg bg-[#18202e] border border-[#222f42] hover:border-slate-600 text-[#cbd5e1] text-[11px] font-bold transition-all cursor-pointer"
            data-feet="30"
          >
            30 pies (Corto)
          </button>
          <button
            type="button"
            class="party-dist-btn px-2.5 py-1 rounded-lg bg-[#18202e] border border-[#222f42] hover:border-slate-600 text-[#cbd5e1] text-[11px] font-bold transition-all cursor-pointer"
            data-feet="60"
          >
            60 pies (Medio)
          </button>
          <button
            type="button"
            class="party-dist-btn px-2.5 py-1 rounded-lg bg-[#18202e] border border-[#222f42] hover:border-slate-600 text-[#cbd5e1] text-[11px] font-bold transition-all cursor-pointer"
            data-feet="120"
          >
            120 pies (Largo)
          </button>
        </div>
      </div>

      <!-- Lista de Armas, Conjuros y Objetos Disponibles -->
      <div id="party-attack-actions-list" class="space-y-2.5 max-h-64 overflow-y-auto pr-1">
        <!-- Generado dinámicamente -->
      </div>

      <!-- Tirada Libre -->
      <div class="pt-2 border-t border-[#222f42] flex justify-end">
        <button
          type="button"
          id="party-attack-custom-roll-btn"
          class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-[#18202e] border border-[#222f42] hover:border-amber-500/40 text-xs font-bold text-amber-300 transition-colors cursor-pointer"
        >
          <span class="material-symbols-outlined text-[15px]">casino</span>
          <span>Tirada libre contra este objetivo</span>
        </button>
      </div>
    </div>
  </div>
</div>

<script>
  import anime from 'animejs';
  import { subscribeCombat } from '../../scripts/data/combatService.ts';
  import { visibleHp } from '../../scripts/vtt/initiative.ts';
  import { getConditionInfo } from '../../scripts/vtt/conditions.ts';
  import {
    getWeaponReachFeet,
    getSpellRangeFeet,
    getItemReachFeet,
    validateActionForDistance,
  } from '../../scripts/vtt/tacticalCombat.ts';
  import { campaignStore } from '../../scripts/state/campaignStore.ts';
  import { characterStore } from '../../scripts/state/characterStore.ts';
  import { userStore } from '../../scripts/state/userStore.ts';
  import { animateHpBar } from '../../scripts/animations/hpAnimations.ts';
  import type { Combat, Combatant } from '../../scripts/models/combat.ts';

  let currentCampaignId: string | null = null;
  let unsubscribe: (() => void) | null = null;
  let previousHpMap = new Map<string, number>();
  let previousTurnIndex = -1;

  // Estado del modal de ataque y distancia táctica (pies)
  let activeTarget: { id: string; name: string; ac?: number } | null = null;
  let currentTargetDistanceFeet = 5;

  const rootEl = document.getElementById('party-initiative-root');
  const roundBadgeEl = document.getElementById('party-round-badge');
  const roundTextEl = document.getElementById('party-round-text');
  const noCombatEl = document.getElementById('party-no-combat');
  const listEl = document.getElementById('party-combat-list');

  // Modal de ataque
  const attackModal = document.getElementById('party-attack-modal');
  const attackModalClose = document.getElementById('party-attack-modal-close');
  const modalTargetName = document.getElementById('party-modal-target-name');
  const modalTargetAc = document.getElementById('party-modal-target-ac');
  const attackActionsList = document.getElementById('party-attack-actions-list');
  const attackCustomBtn = document.getElementById('party-attack-custom-roll-btn');
  const distancePresetsContainer = document.getElementById('party-distance-presets');
  const distanceDisplayEl = document.getElementById('party-modal-distance-display');

  function init() {
    const params = new URLSearchParams(window.location.search);
    const cid = params.get('id') || params.get('campaign') || campaignStore.getActiveCampaignId();

    if (cid && cid !== currentCampaignId) {
      if (unsubscribe) {
        unsubscribe();
        unsubscribe = null;
      }
      currentCampaignId = cid;
      unsubscribe = subscribeCombat(cid, (combat) => {
        renderCombat(combat);
      });
    }
  }

  function renderCombat(combat: Combat | null) {
    if (!combat || !combat.active || combat.combatants.length === 0) {
      if (roundBadgeEl) roundBadgeEl.classList.add('hidden');
      if (roundBadgeEl) roundBadgeEl.classList.remove('flex');
      if (noCombatEl) noCombatEl.classList.remove('hidden');
      if (listEl) {
        listEl.classList.add('hidden');
        listEl.innerHTML = '';
      }
      previousTurnIndex = -1;
      return;
    }

    if (noCombatEl) noCombatEl.classList.add('hidden');
    if (roundBadgeEl) {
      roundBadgeEl.classList.remove('hidden');
      roundBadgeEl.classList.add('flex');
    }
    if (roundTextEl) roundTextEl.textContent = `Ronda ${combat.round}`;
    if (listEl) listEl.classList.remove('hidden');

    const currentUser = userStore.getCurrentUser();
    const viewer = {
      uid: currentUser?.id || '',
      isDm: currentCampaignId ? campaignStore.isCurrentUserDm(currentCampaignId) : false,
    };

    const isNewTurn = previousTurnIndex !== combat.turnIndex;
    previousTurnIndex = combat.turnIndex;

    const activeCombatant = combat.combatants[combat.turnIndex];
    const myChar = currentCampaignId
      ? campaignStore.getMyCharacterForCampaign(currentCampaignId)
      : characterStore.get();

    // Verificamos si el turno activo es de mi propio personaje
    const isMyTurn = Boolean(
      activeCombatant && (
        (activeCombatant.ownerUid && viewer.uid && activeCombatant.ownerUid === viewer.uid) ||
        (myChar && activeCombatant.characterId && activeCombatant.characterId === myChar.id) ||
        (myChar && activeCombatant.name === myChar.name)
      )
    );

    if (!listEl) return;
    listEl.innerHTML = '';

    combat.combatants.forEach((c, idx) => {
      const isCurrentTurn = idx === combat.turnIndex;
      const isOwnCharacter = Boolean(
        (c.ownerUid && viewer.uid && c.ownerUid === viewer.uid) ||
        (myChar && c.characterId && c.characterId === myChar.id) ||
        (myChar && c.name === myChar.name)
      );
      const hpData = visibleHp(c, viewer);
      const isDead = hpData ? hpData.hp <= 0 : false;

      const itemEl = document.createElement('div');
      itemEl.id = `party-combatant-${c.id}`;
      itemEl.className = [
        'relative rounded-xl p-3 border transition-all duration-200',
        isCurrentTurn
          ? 'bg-amber-500/10 border-amber-500/70 shadow-[0_0_15px_rgba(245,158,11,0.25)]'
          : 'bg-[#18202e] border-[#222f42] hover:border-slate-700',
        isOwnCharacter ? 'ring-1 ring-blue-500/40' : '',
        isDead ? 'opacity-50 grayscale-20' : '',
      ].filter(Boolean).join(' ');

      // Contenido principal
      itemEl.innerHTML = `
        <div class="flex items-center justify-between gap-2.5">
          <div class="flex items-center gap-2.5 min-w-0">
            <!-- Píldora de iniciativa -->
            <div class="w-8 h-8 rounded-lg shrink-0 flex items-center justify-center font-bold text-xs ${
              isCurrentTurn
                ? 'bg-amber-500 text-[#0a0d12] shadow-xs'
                : 'bg-[#10141d] border border-[#222f42] text-[#cbd5e1]'
            }" title="Iniciativa: ${c.initiative}">
              ${c.initiative}
            </div>

            <!-- Nombre e identificadores -->
            <div class="min-w-0">
              <div class="flex items-center gap-1.5 flex-wrap">
                <span class="text-xs font-bold text-[#f1f5f9] truncate">
                  ${c.name}
                </span>
                ${
                  isOwnCharacter
                    ? '<span class="px-1.5 py-0.2 rounded bg-blue-500/20 text-blue-300 border border-blue-500/40 text-[9px] font-bold">TÚ</span>'
                    : ''
                }
                ${
                  isCurrentTurn
                    ? '<span class="px-1.5 py-0.2 rounded bg-amber-500/25 text-amber-300 border border-amber-500/50 text-[9px] font-bold animate-pulse">TURNO</span>'
                    : ''
                }
              </div>

              <!-- CA y Estado básico -->
              <div class="flex items-center gap-2 text-[10px] text-[#94a3b8] font-label mt-0.5">
                ${c.ac !== undefined ? `<span>CA ${c.ac}</span> • ` : ''}
                <span>${c.isPlayer ? 'Personaje' : 'Oponente'}</span>
                ${isDead ? '<span class="text-rose-400 font-bold">• Inconsciente</span>' : ''}
              </div>
            </div>
          </div>

          <!-- LADO DERECHO: PG Y BOTÓN ATACAR -->
          <div class="shrink-0 flex items-center gap-2.5">
            <!-- Acción / Estado del combatiente -->
            ${
              isCurrentTurn
                ? `
                <span class="px-2 py-0.5 rounded-full ${
                  c.isPlayer
                    ? 'bg-blue-500/20 text-blue-300 border border-blue-500/40'
                    : 'bg-rose-500/20 text-rose-300 border border-rose-500/40'
                } text-[10px] font-bold inline-flex items-center gap-1 shadow-xs">
                  <span class="w-1.5 h-1.5 rounded-full ${c.isPlayer ? 'bg-blue-400' : 'bg-rose-400'} animate-ping"></span>
                  <span>Actuando</span>
                </span>
              `
                : isMyTurn && !c.isPlayer && !isDead
                ? `
                <button
                  type="button"
                  class="party-attack-target-btn inline-flex items-center gap-1 px-2.5 py-1 rounded-lg bg-rose-500/20 border border-rose-500/40 hover:bg-rose-500/30 text-rose-300 text-xs font-bold transition-all cursor-pointer shadow-xs active:scale-95"
                  data-target-id="${c.id}"
                  data-target-name="${c.name}"
                  data-target-ac="${c.ac || ''}"
                  title="Declarar ataque contra ${c.name}"
                >
                  <span class="material-symbols-outlined text-[14px]">my_location</span>
                  <span>🎯 Atacar</span>
                </button>
              `
                : ''
            }

            <!-- PG (RF-04: solo si visibleHp lo autoriza) -->
            <div class="text-right min-w-[65px]">
              ${
                hpData
                  ? `
                  <div class="text-xs font-bold font-mono text-[#cbd5e1]">
                    <span id="hp-num-${c.id}">${hpData.hp}</span><span class="text-[#64748b]">/${hpData.maxHp}</span>
                  </div>
                  <div class="w-16 h-1.5 bg-[#10141d] rounded-full overflow-hidden mt-1 border border-[#222f42]">
                    <div
                      id="hp-bar-${c.id}"
                      class="h-full rounded-full transition-all ${
                        hpData.hp <= hpData.maxHp * 0.25
                          ? 'bg-rose-500'
                          : hpData.hp <= hpData.maxHp * 0.5
                          ? 'bg-amber-500'
                          : 'bg-emerald-500'
                      }"
                      style="width: ${Math.max(0, Math.min(100, (hpData.hp / hpData.maxHp) * 100))}%"
                    ></div>
                  </div>
                `
                  : `
                  <div class="text-xs font-bold font-mono text-[#64748b]" title="PG ocultos por el DM">
                    —
                  </div>
                `
              }
            </div>
          </div>
        </div>

        <!-- Condiciones activas -->
        ${
          c.conditions && c.conditions.length > 0
            ? `
          <div class="flex flex-wrap gap-1 mt-2 pt-2 border-t border-[#222f42]/60">
            ${c.conditions
              .map((condId) => {
                const info = getConditionInfo(condId);
                return `
                <span class="inline-flex items-center gap-1 px-1.5 py-0.5 rounded text-[10px] font-bold border ${info.color}">
                  <span class="material-symbols-outlined text-[12px]">${info.icon}</span>
                  <span>${info.name}</span>
                </span>
              `;
              })
              .join('')}
          </div>
        `
            : ''
        }
      `;

      listEl.appendChild(itemEl);

      // Animación de PG con animateHpBar si cambió el valor numérico
      if (hpData) {
        const prevHp = previousHpMap.get(c.id);
        if (prevHp !== undefined && prevHp !== hpData.hp) {
          const barEl = itemEl.querySelector(`#hp-bar-${c.id}`) as HTMLElement;
          const numEl = itemEl.querySelector(`#hp-num-${c.id}`) as HTMLElement;
          if (barEl && numEl) {
            animateHpBar(barEl, numEl, prevHp, hpData.hp, hpData.maxHp);
          }
        }
        previousHpMap.set(c.id, hpData.hp);
      }

      // Animación de pulso si es el turno activo y acaba de cambiar de turno (T-13)
      if (isCurrentTurn && isNewTurn) {
        itemEl.scrollIntoView({ block: 'nearest', behavior: 'smooth' });
        anime({
          targets: itemEl,
          scale: [1, 1.025, 1],
          duration: 400,
          easing: 'easeOutQuad',
        });
      }
    });

    bindAttackButtons();
  }

  function bindAttackButtons() {
    listEl?.querySelectorAll('.party-attack-target-btn').forEach((btn) => {
      btn.addEventListener('click', (e) => {
        const target = e.currentTarget as HTMLElement;
        const targetId = target.dataset.targetId || '';
        const targetName = target.dataset.targetName || 'Oponente';
        const targetAc = target.dataset.targetAc ? parseInt(target.dataset.targetAc) : undefined;

        openAttackModal({ id: targetId, name: targetName, ac: targetAc });
      });
    });
  }

  function openAttackModal(target: { id: string; name: string; ac?: number }) {
    activeTarget = target;
    if (!attackModal || !modalTargetName || !modalTargetAc || !attackActionsList) return;

    modalTargetName.textContent = target.name;
    modalTargetAc.textContent = target.ac ? `CA: ${target.ac}` : 'CA: Oculta por DM';

    // Restablecer preset a 5 pies al abrir
    currentTargetDistanceFeet = 5;
    if (distanceDisplayEl) distanceDisplayEl.textContent = '5';
    updateDistancePresetButtons(5);

    renderTacticalAttackActions(target, currentTargetDistanceFeet);
    attackModal.classList.remove('hidden');
  }

  function updateDistancePresetButtons(activeFeet: number) {
    distancePresetsContainer?.querySelectorAll<HTMLButtonElement>('.party-dist-btn').forEach((btn) => {
      const feet = parseInt(btn.dataset.feet || '5', 10);
      if (feet === activeFeet) {
        btn.classList.add('active', 'bg-amber-500/20', 'border-amber-500/60', 'text-amber-300', 'shadow-xs');
        btn.classList.remove('bg-[#18202e]', 'border-[#222f42]', 'text-[#cbd5e1]');
      } else {
        btn.classList.remove('active', 'bg-amber-500/20', 'border-amber-500/60', 'text-amber-300', 'shadow-xs');
        btn.classList.add('bg-[#18202e]', 'border-[#222f42]', 'text-[#cbd5e1]');
      }
    });
  }

  // Event listeners para los botones de distancia táctica
  distancePresetsContainer?.querySelectorAll<HTMLButtonElement>('.party-dist-btn').forEach((btn) => {
    btn.addEventListener('click', () => {
      const feet = parseInt(btn.dataset.feet || '5', 10);
      currentTargetDistanceFeet = feet;
      if (distanceDisplayEl) distanceDisplayEl.textContent = String(feet);
      updateDistancePresetButtons(feet);

      if (activeTarget) {
        renderTacticalAttackActions(activeTarget, currentTargetDistanceFeet);
      }
    });
  });

  function renderTacticalAttackActions(target: { id: string; name: string; ac?: number }, currentDistance: number) {
    if (!attackActionsList) return;
    attackActionsList.innerHTML = '';

    const char = currentCampaignId
      ? campaignStore.getMyCharacterForCampaign(currentCampaignId)
      : characterStore.get();

    const actions = char?.actions || [];
    const spells = (char?.spellcasting?.spells || []).filter((s) => s.isAttack || s.damageDice || s.damageFormula);
    const tacticalItems = (char?.inventory || []).filter(
      (item) =>
        item.quantity > 0 &&
        (item.category === 'weapon' ||
          item.usableType === 'usable' ||
          item.usableType === 'drinkable' ||
          item.usableType === 'potion' ||
          item.name.toLowerCase().includes('fuego') ||
          item.name.toLowerCase().includes('ácido') ||
          item.name.toLowerCase().includes('bomba'))
    );

    if (actions.length === 0 && spells.length === 0 && tacticalItems.length === 0) {
      attackActionsList.innerHTML = `
        <div class="p-3 rounded-xl bg-[#18202e] border border-[#222f42] text-xs text-[#94a3b8] italic">
          No tienes armas, conjuros ni objetos configurados en tu ficha. Puedes usar la tirada libre abajo.
        </div>
      `;
      return;
    }

    // 1. Armas y Acciones de Ataque
    if (actions.length > 0) {
      const header = document.createElement('div');
      header.className = 'text-[10px] font-bold uppercase tracking-wider text-amber-400 mt-1';
      header.textContent = 'Armas y Ataques Físicos';
      attackActionsList.appendChild(header);

      actions.forEach((act) => {
        const reach = getWeaponReachFeet(act);
        const validation = validateActionForDistance(reach, currentDistance);

        const bonusNum = parseInt(act.bonus?.replace(/[^0-9-]/g, '') || '0') || 0;
        const dmgMatch = (act.damage || '1d8').match(/(\d+)d(\d+)(?:\s*([+-])\s*(\d+))?/);
        const dmgCount = dmgMatch ? parseInt(dmgMatch[1]) || 1 : 1;
        const dmgDie = dmgMatch ? parseInt(dmgMatch[2]) || 8 : 8;
        const sign = dmgMatch && dmgMatch[3] === '-' ? -1 : 1;
        const dmgMod = dmgMatch && dmgMatch[4] ? sign * parseInt(dmgMatch[4]) : 0;

        const item = document.createElement('div');

        if (!validation.valid) {
          // Arma fuera de alcance: deshabilitada y estilizada en gris apagado
          item.className = 'flex items-center justify-between gap-2 p-2.5 rounded-xl bg-[#10141d]/80 border border-dashed border-[#222f42] opacity-45 cursor-not-allowed select-none transition-all';
          item.title = validation.reason || 'Fuera de alcance';
          item.innerHTML = `
            <div class="min-w-0">
              <div class="flex items-center gap-1.5 flex-wrap">
                <span class="text-xs font-bold text-[#94a3b8] line-through truncate">${act.name}</span>
                <span class="px-1.5 py-0.2 rounded text-[9px] font-bold bg-rose-500/15 text-rose-400 border border-rose-500/25">${validation.badgeText}</span>
              </div>
              <span class="text-[10px] text-[#64748b] font-mono">${reach.label} • ${act.damage || '1d8'} ${act.damageType || ''}</span>
            </div>
            <div class="flex items-center gap-1.5 shrink-0 opacity-30 pointer-events-none">
              <button type="button" disabled class="px-2.5 py-1.5 rounded-lg bg-[#18202e] text-[#64748b] text-[11px] font-bold">Ataque</button>
              <button type="button" disabled class="px-2 py-1.5 rounded-lg bg-[#18202e] text-[#64748b] text-[11px] font-bold">Daño</button>
            </div>
          `;
        } else {
          // Arma válida y lista para atacar
          item.className = 'flex items-center justify-between gap-2 p-2.5 rounded-xl bg-[#18202e] border border-[#222f42] hover:border-amber-500/40 transition-all';
          item.innerHTML = `
            <div class="min-w-0">
              <div class="flex items-center gap-1.5 flex-wrap">
                <span class="text-xs font-bold text-[#f1f5f9] truncate">${act.name}</span>
                <span class="px-1.5 py-0.2 rounded text-[9px] font-bold ${
                  validation.disadvantage
                    ? 'bg-amber-500/20 text-amber-300 border border-amber-500/40'
                    : 'bg-emerald-500/15 text-emerald-300 border border-emerald-500/30'
                }">${validation.disadvantage ? validation.badgeText : reach.label}</span>
              </div>
              <span class="text-[10px] text-[#94a3b8] font-mono">${act.bonus || '+0'} • ${act.damage || '1d8'} ${act.damageType || ''}</span>
            </div>
            <div class="flex items-center gap-1.5 shrink-0">
              <button
                type="button"
                class="party-modal-roll-atk px-2.5 py-1.5 rounded-lg bg-amber-500/20 hover:bg-amber-500/30 text-amber-300 border border-amber-500/40 text-[11px] font-bold transition-all cursor-pointer flex items-center gap-1 active:scale-95"
                title="Tirar ataque d20 contra ${target.name}"
              >
                <span>Ataque</span>
                <span class="font-mono text-[10px]">(${act.bonus || '+0'})</span>
              </button>
              <button
                type="button"
                class="party-modal-roll-dmg px-2 py-1.5 rounded-lg bg-[#10141d] hover:bg-[#222f42] text-[#cbd5e1] border border-[#222f42] text-[11px] font-bold transition-all cursor-pointer active:scale-95"
                title="Tirar daño contra ${target.name}"
              >
                <span>Daño</span>
              </button>
            </div>
          `;

          // Clic en Ataque
          item.querySelector('.party-modal-roll-atk')?.addEventListener('click', () => {
            closeAttackModal();
            window.dispatchEvent(
              new CustomEvent('open-dice-roller', {
                detail: {
                  die: 20,
                  count: 1,
                  modifier: bonusNum,
                  label: `Ataque con ${act.name} (${currentDistance} pies)`,
                  tag: '#Combate',
                  targetName: target.name,
                  targetAc: target.ac,
                },
              })
            );
          });

          // Clic en Daño
          item.querySelector('.party-modal-roll-dmg')?.addEventListener('click', () => {
            closeAttackModal();
            window.dispatchEvent(
              new CustomEvent('open-dice-roller', {
                detail: {
                  die: dmgDie,
                  count: dmgCount,
                  modifier: dmgMod,
                  label: `Daño de ${act.name} (${act.damageType || 'Daño'})`,
                  tag: '#Combate',
                  targetName: target.name,
                  targetAc: target.ac,
                },
              })
            );
          });
        }

        attackActionsList.appendChild(item);
      });
    }

    // 2. Conjuros y Magia de Ataque
    if (spells.length > 0) {
      const header = document.createElement('div');
      header.className = 'text-[10px] font-bold uppercase tracking-wider text-purple-400 mt-2';
      header.textContent = 'Conjuros y Magia de Ataque';
      attackActionsList.appendChild(header);

      spells.forEach((sp) => {
        const reach = getSpellRangeFeet(sp);
        const validation = validateActionForDistance(reach, currentDistance);

        const formula = sp.damageFormula || sp.damageDice || '1d8';
        const dmgMatch = formula.match(/(\d+)d(\d+)(?:\s*([+-])\s*(\d+))?/);
        const dmgCount = dmgMatch ? parseInt(dmgMatch[1]) || 1 : 1;
        const dmgDie = dmgMatch ? parseInt(dmgMatch[2]) || 8 : 8;
        const sign = dmgMatch && dmgMatch[3] === '-' ? -1 : 1;
        const dmgMod = dmgMatch && dmgMatch[4] ? sign * parseInt(dmgMatch[4]) : 0;
        const atkBonus = char?.spellcasting?.attackBonus || 0;

        const item = document.createElement('div');

        if (!validation.valid) {
          item.className = 'flex items-center justify-between gap-2 p-2.5 rounded-xl bg-[#10141d]/80 border border-dashed border-[#222f42] opacity-45 cursor-not-allowed select-none transition-all';
          item.title = validation.reason || 'Fuera de alcance';
          item.innerHTML = `
            <div class="min-w-0">
              <div class="flex items-center gap-1.5 flex-wrap">
                <span class="text-xs font-bold text-[#94a3b8] line-through truncate">${sp.name}</span>
                <span class="px-1.5 py-0.2 rounded text-[9px] font-bold bg-rose-500/15 text-rose-400 border border-rose-500/25">${validation.badgeText}</span>
              </div>
              <span class="text-[10px] text-[#64748b] font-mono">${reach.label} • ${formula} ${sp.damageType || ''}</span>
            </div>
            <div class="flex items-center gap-1.5 shrink-0 opacity-30 pointer-events-none">
              <button type="button" disabled class="px-2.5 py-1.5 rounded-lg bg-[#18202e] text-[#64748b] text-[11px] font-bold">Ataque</button>
              <button type="button" disabled class="px-2 py-1.5 rounded-lg bg-[#18202e] text-[#64748b] text-[11px] font-bold">Efecto</button>
            </div>
          `;
        } else {
          item.className = 'flex items-center justify-between gap-2 p-2.5 rounded-xl bg-[#18202e] border border-[#222f42] hover:border-purple-500/40 transition-all';
          item.innerHTML = `
            <div class="min-w-0">
              <div class="flex items-center gap-1.5 flex-wrap">
                <span class="text-xs font-bold text-[#f1f5f9] truncate">${sp.name}</span>
                <span class="px-1.5 py-0.2 rounded text-[9px] font-bold ${
                  validation.disadvantage
                    ? 'bg-amber-500/20 text-amber-300 border border-amber-500/40'
                    : 'bg-purple-500/20 text-purple-300 border border-purple-500/40'
                }">${validation.disadvantage ? validation.badgeText : reach.label}</span>
              </div>
              <span class="text-[10px] text-[#94a3b8] font-mono">${sp.isAttack ? `Atk +${atkBonus} • ` : ''}${formula} ${sp.damageType || ''}</span>
            </div>
            <div class="flex items-center gap-1.5 shrink-0">
              ${
                sp.isAttack
                  ? `
                <button
                  type="button"
                  class="party-modal-roll-spell-atk px-2.5 py-1.5 rounded-lg bg-purple-500/20 hover:bg-purple-500/30 text-purple-300 border border-purple-500/40 text-[11px] font-bold transition-all cursor-pointer flex items-center gap-1 active:scale-95"
                >
                  <span>Ataque</span>
                </button>
              `
                  : ''
              }
              <button
                type="button"
                class="party-modal-roll-spell-dmg px-2 py-1.5 rounded-lg bg-[#10141d] hover:bg-[#222f42] text-[#cbd5e1] border border-[#222f42] text-[11px] font-bold transition-all cursor-pointer active:scale-95"
              >
                <span>Efecto/Daño</span>
              </button>
            </div>
          `;

          // Clic en Ataque de Conjuro
          item.querySelector('.party-modal-roll-spell-atk')?.addEventListener('click', () => {
            closeAttackModal();
            window.dispatchEvent(
              new CustomEvent('open-dice-roller', {
                detail: {
                  die: 20,
                  count: 1,
                  modifier: atkBonus,
                  label: `Ataque de Conjuro: ${sp.name} (${currentDistance} pies)`,
                  tag: '#Magia',
                  targetName: target.name,
                  targetAc: target.ac,
                },
              })
            );
          });

          // Clic en Daño de Conjuro
          item.querySelector('.party-modal-roll-spell-dmg')?.addEventListener('click', () => {
            closeAttackModal();
            window.dispatchEvent(
              new CustomEvent('open-dice-roller', {
                detail: {
                  die: dmgDie,
                  count: dmgCount,
                  modifier: dmgMod,
                  label: `Daño/Efecto de ${sp.name} (${sp.damageType || 'Magia'})`,
                  tag: '#Magia',
                  targetName: target.name,
                  targetAc: target.ac,
                },
              })
            );
          });
        }

        attackActionsList.appendChild(item);
      });
    }

    // 3. Objetos y Consumibles Tácticos
    if (tacticalItems.length > 0) {
      const header = document.createElement('div');
      header.className = 'text-[10px] font-bold uppercase tracking-wider text-emerald-400 mt-2';
      header.textContent = 'Objetos y Consumibles Tácticos';
      attackActionsList.appendChild(header);

      tacticalItems.forEach((item) => {
        const reach = getItemReachFeet(item);
        const validation = validateActionForDistance(reach, currentDistance);

        const el = document.createElement('div');
        if (!validation.valid) {
          el.className = 'flex items-center justify-between gap-2 p-2.5 rounded-xl bg-[#10141d]/80 border border-dashed border-[#222f42] opacity-45 cursor-not-allowed select-none transition-all';
          el.title = validation.reason || 'Fuera de alcance';
          el.innerHTML = `
            <div class="min-w-0">
              <div class="flex items-center gap-1.5 flex-wrap">
                <span class="text-xs font-bold text-[#94a3b8] line-through truncate">${item.name}</span>
                <span class="px-1.5 py-0.2 rounded text-[9px] font-bold bg-rose-500/15 text-rose-400 border border-rose-500/25">${validation.badgeText}</span>
              </div>
              <span class="text-[10px] text-[#64748b] font-mono">Cant: ${item.quantity} • ${reach.label}</span>
            </div>
            <div class="flex items-center gap-1.5 shrink-0 opacity-30 pointer-events-none">
              <button type="button" disabled class="px-2.5 py-1.5 rounded-lg bg-[#18202e] text-[#64748b] text-[11px] font-bold">Usar</button>
            </div>
          `;
        } else {
          el.className = 'flex items-center justify-between gap-2 p-2.5 rounded-xl bg-[#18202e] border border-[#222f42] hover:border-emerald-500/40 transition-all';
          el.innerHTML = `
            <div class="min-w-0">
              <div class="flex items-center gap-1.5 flex-wrap">
                <span class="text-xs font-bold text-[#f1f5f9] truncate">${item.name}</span>
                <span class="px-1.5 py-0.2 rounded text-[9px] font-bold bg-emerald-500/15 text-emerald-300 border border-emerald-500/30">${reach.label}</span>
              </div>
              <span class="text-[10px] text-[#94a3b8] font-mono">Cant: ${item.quantity}${item.healAmount ? ` • Cura ${item.healAmount} PG` : ''}</span>
            </div>
            <div class="flex items-center gap-1.5 shrink-0">
              <button
                type="button"
                class="party-modal-use-item px-2.5 py-1.5 rounded-lg bg-emerald-500/20 hover:bg-emerald-500/30 text-emerald-300 border border-emerald-500/40 text-[11px] font-bold transition-all cursor-pointer active:scale-95 flex items-center gap-1"
              >
                <span>Usar / Lanzar</span>
              </button>
            </div>
          `;

          el.querySelector('.party-modal-use-item')?.addEventListener('click', () => {
            closeAttackModal();
            window.dispatchEvent(
              new CustomEvent('open-dice-roller', {
                detail: {
                  die: 20,
                  count: 1,
                  modifier: 0,
                  label: `Uso de ${item.name} contra ${target.name} (${currentDistance} pies)`,
                  tag: '#Objetos',
                  targetName: target.name,
                  targetAc: target.ac,
                },
              })
            );
          });
        }

        attackActionsList.appendChild(el);
      });
    }
  }

  function closeAttackModal() {
    attackModal?.classList.add('hidden');
    activeTarget = null;
  }

  attackModalClose?.addEventListener('click', closeAttackModal);

  // Clic fuera del contenido para cerrar
  attackModal?.addEventListener('click', (e) => {
    if (e.target === attackModal) closeAttackModal();
  });

  // Tirada libre contra el objetivo
  attackCustomBtn?.addEventListener('click', () => {
    if (!activeTarget) return;
    const target = activeTarget;
    closeAttackModal();
    window.dispatchEvent(
      new CustomEvent('open-dice-roller', {
        detail: {
          die: 20,
          count: 1,
          modifier: 0,
          label: `Ataque contra ${target.name} (${currentTargetDistanceFeet} pies)`,
          tag: '#Combate',
          targetName: target.name,
          targetAc: target.ac,
        },
      })
    );
  });

  // Inicialización y eventos
  window.addEventListener('DOMContentLoaded', init);
  window.addEventListener('popstate', init);
  window.addEventListener('campaign-activated', init);
  window.addEventListener('campaigns-updated', init);

  if (document.readyState === 'complete' || document.readyState === 'interactive') {
    init();
  }
</script>
