---
// src/components/party/PresenceList.astro
// Quién está conectado en la sala (T-51a, RF-42). Se monta en /partida y en el grimoire del DM.
---

<section data-presence-list class="rounded-2xl bg-[#121721] border border-[#222f42] px-4 py-3 space-y-2">
  <div class="flex items-center gap-2">
    <span class="material-symbols-outlined text-amber-500 text-[18px]">wifi</span>
    <h2 class="font-headline font-bold text-sm text-[#f1f5f9]">En la mesa</h2>
    <span data-presence-count class="text-[11px] text-[#94a3b8] font-label"></span>
  </div>
  <ul data-presence-items class="flex flex-wrap gap-2" aria-live="polite"></ul>
  <p data-presence-empty class="text-[11px] text-[#64748b]">Sin conexión en tiempo real todavía.</p>
</section>

<script>
  import anime from 'animejs';
  import { campaignStore } from '../../scripts/state/campaignStore';
  import { userStore } from '../../scripts/state/userStore';
  import { ensureRoom } from '../../scripts/data/roomService.ts';
  import {
    joinPresence,
    subscribePresence,
    formatLastSeen,
    type PresenceEntry,
  } from '../../scripts/data/presenceService.ts';

  let boundRoom: string | null = null;
  let leave: (() => void) | null = null;
  let unsub: (() => void) | null = null;
  let knownOnline = new Set<string>();
  let firstSnapshot = true;
  let binding = false;

  function getCid(): string | null {
    const params = new URLSearchParams(window.location.search);
    return params.get('id') || params.get('campaign') || campaignStore.getActiveCampaignId();
  }

  function render(list: PresenceEntry[]) {
    const lists = document.querySelectorAll<HTMLElement>('[data-presence-list]');
    const online = list.filter((p) => p.online);
    const justJoined = new Set<string>();
    online.forEach((p) => {
      if (!firstSnapshot && !knownOnline.has(p.uid)) justJoined.add(p.uid);
    });
    knownOnline = new Set(online.map((p) => p.uid));
    firstSnapshot = false;

    lists.forEach((root) => {
      const ul = root.querySelector('[data-presence-items]');
      const empty = root.querySelector('[data-presence-empty]');
      const count = root.querySelector('[data-presence-count]');
      if (!ul) return;
      ul.replaceChildren();
      empty?.classList.toggle('hidden', list.length > 0);
      if (count) count.textContent = list.length ? `${online.length} en línea` : '';

      list.forEach((p) => {
        const li = document.createElement('li');
        li.className =
          'flex items-center gap-2 px-2.5 py-1 rounded-full bg-[#18202e] border border-[#222f42] text-xs ' +
          (p.online ? 'text-[#f1f5f9]' : 'text-[#94a3b8]');
        const dot = document.createElement('span');
        dot.className = `w-2 h-2 rounded-full shrink-0 ${p.online ? 'bg-emerald-400' : 'bg-slate-500'}`;
        dot.setAttribute('aria-hidden', 'true');
        const name = document.createElement('span');
        name.className = 'font-bold truncate max-w-[140px]';
        name.textContent = p.name;
        li.append(dot, name);
        if (!p.online && p.lastSeen) {
          const seen = document.createElement('span');
          seen.className = 'text-[10px] text-[#64748b]';
          seen.textContent = formatLastSeen(p.lastSeen);
          li.append(seen);
        }
        ul.appendChild(li);
        if (justJoined.has(p.uid)) {
          anime({ targets: dot, scale: [0.2, 1.6, 1], duration: 700, easing: 'easeOutElastic(1, .6)' });
        }
      });
    });
  }

  async function bind() {
    if (binding) return;
    const cid = getCid();
    if (!cid) return;
    const camp = campaignStore.getCampaign(cid);
    const user = userStore.getCurrentUser();
    if (!camp || !user?.id) return;

    binding = true;
    try {
      let roomId = camp.liveRoomId || null;
      // Solo el DM puede crear la sala; los jugadores esperan a que exista liveRoomId.
      if (!roomId && camp.dmId === user.id) {
        try {
          roomId = await ensureRoom(camp);
        } catch (err) {
          console.warn('[PresenceList] No se pudo crear la sala:', err);
        }
      }
      if (!roomId || roomId === boundRoom) return;

      leave?.();
      unsub?.();
      boundRoom = roomId;
      knownOnline = new Set();
      firstSnapshot = true;
      leave = joinPresence(roomId, user.id, user.name || 'Aventurero');
      unsub = subscribePresence(roomId, render);
    } finally {
      binding = false;
    }
  }

  window.addEventListener('pagehide', () => leave?.());
  window.addEventListener('DOMContentLoaded', bind);
  window.addEventListener('campaigns-updated', bind);
  window.addEventListener('active-campaign-changed', bind);
  window.addEventListener('user-changed', bind);
  window.addEventListener('cloud-session-changed', bind);
  if (document.readyState !== 'loading') void bind();
</script>
