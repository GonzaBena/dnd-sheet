---
// src/components/ui/CustomEntryFields.astro
// Bloque "Entrada propia" (imagen y efectos) para los modales de objeto y hechizo. Ver scripts/ui/customEntry.ts.
interface Props {
  prefix: string;
}
const { prefix } = Astro.props;
---

<div class="space-y-3 p-3 rounded-xl bg-[#10141d] border border-[#222f42]">
  <label class="flex items-center gap-2 cursor-pointer">
    <input
      type="checkbox"
      id={`${prefix}-custom-toggle`}
      class="rounded bg-[#10141d] border-[#222f42] text-amber-500 focus:ring-amber-500/40"
    />
    <span class="text-[#f1f5f9] font-bold">Entrada propia</span>
    <span class="text-[10px] text-[#64748b]">Muestra imagen y efectos, y la marca con la insignia "Propio"</span>
  </label>

  <div id={`${prefix}-custom-fields`} class="hidden space-y-3">
    <div>
      <label class="text-[#94a3b8] block mb-1" for={`${prefix}-image-input`}>Imagen (URL, opcional)</label>
      <input
        type="text"
        id={`${prefix}-image-input`}
        placeholder="https://… o data:image/png;base64,…"
        class="w-full p-2.5 rounded-lg bg-[#18202e] border border-[#222f42] text-[#f1f5f9] focus:border-amber-500 focus:outline-none"
      />
    </div>
    <div>
      <label class="text-[#94a3b8] block mb-1" for={`${prefix}-effects-input`}>
        Efectos (opcional, uno por línea: <span class="font-mono">objetivo operación valor</span>)
      </label>
      <textarea
        id={`${prefix}-effects-input`}
        rows="3"
        placeholder={"ac add 2\nsave.dex advantage"}
        class="w-full p-2.5 rounded-lg bg-[#18202e] border border-[#222f42] text-[#f1f5f9] font-mono focus:border-amber-500 focus:outline-none resize-none"
      ></textarea>
      <p id={`${prefix}-effects-error`} class="hidden mt-1 text-[11px] text-rose-400"></p>
    </div>
  </div>
</div>
