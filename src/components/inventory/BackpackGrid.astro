---
// src/components/inventory/BackpackGrid.astro
---

<div class="rounded-xl bg-[#121721] border border-[#222f42] p-5 shadow-sm">
  <div class="flex items-center justify-between mb-4 select-none section-header-bar">
    <h3 class="text-sm font-headline font-bold text-[#f1f5f9] uppercase tracking-wider flex items-center gap-1.5">
      <span class="section-drag-handle material-symbols-outlined text-[#64748b] hover:text-amber-400 cursor-grab text-[18px] mr-0.5 transition-colors" title="Arrastrar para reordenar">drag_indicator</span>
      <span class="material-symbols-outlined text-amber-500 text-[18px]">backpack</span>
      <span>Mochila y Pociones</span>
    </h3>
    
    <div class="flex items-center gap-2">
      <button
        type="button"
        id="open-add-item-btn"
        class="text-[10px] text-amber-400 hover:text-amber-300 font-bold bg-amber-500/10 hover:bg-amber-500/20 px-2.5 py-1 rounded-lg border border-amber-500/30 flex items-center gap-1 cursor-pointer transition-colors"
        title="Añadir nuevo objeto al inventario"
      >
        <span class="material-symbols-outlined text-[13px]">add</span>
        <span>Añadir Objeto</span>
      </button>
      <button
        type="button"
        class="section-collapse-btn w-6 h-6 rounded-md bg-[#18202e] border border-[#222f42] hover:border-amber-500/40 text-[#94a3b8] hover:text-[#f1f5f9] flex items-center justify-center transition-colors cursor-pointer"
        title="Colapsar / Expandir sección"
        aria-label="Colapsar o expandir"
      >
        <span class="material-symbols-outlined section-collapse-icon text-[18px]">expand_less</span>
      </button>
    </div>
  </div>

  <div class="section-collapsed-summary hidden text-[11px] text-[#94a3b8] font-label py-1">
    Equipo, pociones, herramientas y consumibles
  </div>

  <div class="section-body space-y-3">
    <!-- Dynamic Quick Access Item / Potion Slot -->
    <div id="quick-slot-card-container">
      <!-- Populated by JavaScript -->
    </div>

    <!-- Standard Gear List (2 wide columns on desktop across the full-width backpack row) -->
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-2.5 text-xs font-label items-start" id="backpack-items-container">
      <!-- Populated by JavaScript -->
    </div>

    <!-- Mobile helper hint -->
    <div class="flex items-center justify-between text-[10px] text-[#64748b] pt-1 border-t border-[#222f42]/40" id="backpack-footer-hint">
      <span class="flex items-center gap-1 text-[#94a3b8]">
        <span class="material-symbols-outlined text-[13px] text-amber-500/80">swipe_left</span>
        <span>Desliza a la izquierda para eliminar. Toca la flecha para ver notas.</span>
      </span>
      <span id="backpack-item-count" class="text-[10px] text-[#64748b]">0 objetos</span>
    </div>
  </div>
</div>

<script>
  import { showAlert } from '../../scripts/ui/notify';
  import { SLOT_LABELS, validSlotsFor, belongsToDefense } from '../../scripts/dnd/equipment';
  import type { EquipSlot } from '../../scripts/models/character';
  import { characterStore } from '../../scripts/state/characterStore';
  import { escapeHtml, toCatalogEntry } from '../../scripts/dnd/catalog';
  import { customBadgeHtml } from '../../scripts/ui/customBadge';
  import { openModal } from '../../scripts/animations/modalAnimations';
  import { attachSwipeToDelete } from '../../scripts/ui/swipeToDelete';

  const quickSlotContainer = document.getElementById('quick-slot-card-container');
  const gearContainer = document.getElementById('backpack-items-container');
  const addItemBtn = document.getElementById('open-add-item-btn');

  // Track expanded item IDs so state survives re-renders
  const expandedItems = new Set<string>();

  addItemBtn?.addEventListener('click', () => {
    window.dispatchEvent(new CustomEvent('open-add-item-modal'));
  });


  function renderQuickSlot(char: any) {
    if (!quickSlotContainer) return;
    quickSlotContainer.innerHTML = '';

    const quickId = char.quickSlotItemId;
    const item = quickId ? char.inventory.find((i: any) => i.id === quickId) : null;

    if (!item) {
      // Empty unassigned state
      const emptyCard = document.createElement('div');
      emptyCard.className = 'p-3 rounded-xl bg-[#18202e]/60 border border-dashed border-[#222f42] flex items-center justify-between gap-3 text-xs';
      emptyCard.innerHTML = `
        <div class="flex items-center gap-2.5 text-[#64748b]">
          <span class="material-symbols-outlined text-[18px]">push_pin</span>
          <span class="italic">Ningún objeto de acceso rápido asignado</span>
        </div>
        <button
          type="button"
          class="assign-quick-btn text-[10px] text-amber-400 hover:text-amber-300 font-bold bg-amber-500/10 hover:bg-amber-500/20 px-2.5 py-1 rounded-lg border border-amber-500/30 flex items-center gap-1 cursor-pointer transition-colors"
        >
          <span class="material-symbols-outlined text-[13px]">add</span>
          <span>Asignar</span>
        </button>
      `;

      emptyCard.querySelector('.assign-quick-btn')?.addEventListener('click', () => {
        const firstUsable = char.inventory.find((i: any) => i.usableType && i.usableType !== 'none') || char.inventory[0];
        if (firstUsable) {
          characterStore.setQuickSlotItem(firstUsable.id);
        } else {
          showAlert('No tienes objetos en la mochila para asignar.', { kind: 'warning' });
        }
      });

      quickSlotContainer.appendChild(emptyCard);
      return;
    }

    // Item assigned
    const actionVerb = item.usableType === 'edible' ? 'Comer' : item.usableType === 'usable' ? 'Usar' : 'Beber';
    const actionIcon = item.usableType === 'edible' ? 'lunch_dining' : item.usableType === 'usable' ? 'bolt' : 'vital_signs';

    const card = document.createElement('div');
    card.className = 'p-3.5 rounded-xl bg-gradient-to-r from-amber-500/10 via-[#18202e] to-[#18202e] border border-amber-500/30 flex flex-col gap-2 shadow-xs';
    card.innerHTML = `
      <div class="flex items-center justify-between gap-2.5 flex-wrap sm:flex-nowrap">
        <div class="flex items-center gap-3 min-w-0 flex-1">
          <div class="w-10 h-10 rounded-lg bg-amber-500/20 border border-amber-500/40 flex items-center justify-center text-amber-400 shrink-0">
            <span class="material-symbols-outlined text-[20px]">${item.icon || 'medication'}</span>
          </div>
          <div class="min-w-0 flex-1">
            <div class="flex items-center gap-1.5 flex-wrap">
              <span class="font-headline font-bold text-sm text-[#f1f5f9] truncate">${escapeHtml(item.name)}</span>
              ${customBadgeHtml(item)}
              <span class="px-2 py-0.2 rounded-full bg-amber-500/20 text-amber-300 text-[10px] font-bold border border-amber-500/40 shrink-0">x${item.quantity}</span>
            </div>
            <div class="flex items-center gap-2 flex-wrap mt-0.5">
              <span class="text-xs text-[#94a3b8] font-label truncate">
                ${item.description || (item.healAmount ? `Recupera +${item.healAmount} PG` : 'Objeto usable en combate')}
              </span>
              ${item.activationCondition ? `<span class="px-1.5 py-0.2 rounded bg-amber-500/10 text-amber-300 text-[9px] font-bold border border-amber-500/20 flex items-center gap-0.5 shrink-0"><span class="material-symbols-outlined text-[11px]">timer</span><span>${item.activationCondition}</span></span>` : ''}
            </div>
          </div>
        </div>

        <div class="flex items-center gap-2 shrink-0">
          <button
            type="button"
            class="edit-quick-btn text-[#64748b] hover:text-amber-400 p-1.5 rounded-lg hover:bg-[#10141d] transition-colors cursor-pointer"
            title="Editar objeto"
          >
            <span class="material-symbols-outlined text-[16px]">edit</span>
          </button>
          <button
            type="button"
            class="unpin-quick-btn text-[#64748b] hover:text-rose-400 p-1.5 rounded-lg hover:bg-[#10141d] transition-colors cursor-pointer"
            title="Desasignar de acceso rápido"
          >
            <span class="material-symbols-outlined text-[16px]">do_not_disturb_on</span>
          </button>
          <button
            type="button"
            class="consume-quick-btn px-3.5 py-1.5 rounded-lg bg-gradient-to-r from-amber-600 to-amber-500 text-[#0a0d12] text-xs font-bold shadow-[0_0_12px_rgba(245,158,11,0.3)] hover:brightness-110 active:scale-95 transition-all flex items-center gap-1 cursor-pointer"
          >
            <span class="material-symbols-outlined text-[15px]">${actionIcon}</span>
            <span>${actionVerb}</span>
          </button>
        </div>
      </div>

      ${item.notes ? `
        <div class="px-2.5 py-1 rounded bg-[#10141d] border border-amber-500/20 text-[11px] text-[#cbd5e1] flex items-start gap-1.5">
          <span class="material-symbols-outlined text-[13px] text-amber-400 shrink-0 mt-0.5">auto_awesome</span>
          <span class="leading-relaxed"><strong class="text-amber-400/90 font-medium">Efecto Especial:</strong> ${item.notes}</span>
        </div>
      ` : ''}
    `;

    card.querySelector('.edit-quick-btn')?.addEventListener('click', () => {
      window.dispatchEvent(new CustomEvent('open-edit-item-modal', { detail: { item } }));
    });

    card.querySelector('.unpin-quick-btn')?.addEventListener('click', () => {
      characterStore.setQuickSlotItem(null);
    });

    card.querySelector('.consume-quick-btn')?.addEventListener('click', () => {
      const res = characterStore.consumeItem(item.id);
      if (res.success && res.healed && res.healed > 0) {
        showAlert(`¡Has consumido "${item.name}"! +${res.healed} PG recuperados.`, { kind: 'success' });
      }
    });

    quickSlotContainer.appendChild(card);
  }

  // Fase D: acciones de la ficha que dependen del renglón (confirmación de borrado de cada objeto).
  const deleteTriggers = new Map<string, () => void>();

  function renderBackpack(char: any) {
    deleteTriggers.clear();
    renderQuickSlot(char);

    if (!gearContainer) return;
    gearContainer.innerHTML = '';

    // Armaduras y escudos (puestos o no) se ven en la sección "Armaduras y Defensa".
    const items = (char.inventory || []).filter((i: any) => !belongsToDefense(i));
    const countEl = document.getElementById('backpack-item-count');
    if (countEl) countEl.textContent = `${items.length} ${items.length === 1 ? 'objeto' : 'objetos'}`;
    if (items.length === 0) {
      gearContainer.innerHTML = `
        <div class="w-full py-6 text-center text-xs text-[#64748b]">
          La mochila está vacía. Pulsa "Añadir Objeto" para guardar equipo.
        </div>
      `;
      return;
    }

    items.forEach((item: any) => {
      const isPinned = char.quickSlotItemId === item.id;
      const isExpanded = expandedItems.has(item.id);
      const isUsable = item.usableType && item.usableType !== 'none';
      const actionVerb = item.usableType === 'edible' ? 'Comer' : item.usableType === 'usable' ? 'Usar' : item.usableType === 'drinkable' || item.category === 'potion' ? 'Beber' : null;

      const wrapper = document.createElement('div');
      wrapper.className = 'relative rounded-lg overflow-hidden select-none bg-[#10141d] border border-[#222f42] w-full';

      // Background trash revealed ONLY on horizontal swipe
      const swipeBg = document.createElement('div');
      swipeBg.className = 'swipe-delete-bg absolute inset-0 bg-gradient-to-l from-rose-600/60 via-rose-600/30 to-rose-950/20 flex items-center justify-end px-4 gap-1.5 text-rose-300 font-bold text-xs pointer-events-none opacity-0';
      swipeBg.innerHTML = `
        <span class="material-symbols-outlined text-[16px]">delete</span>
        <span class="text-[11px]">Eliminar</span>
      `;
      wrapper.appendChild(swipeBg);

      const card = document.createElement('div');
      card.className = `relative p-2.5 rounded-lg bg-[#18202e] border ${isPinned ? 'border-amber-500/50 shadow-[0_0_12px_rgba(245,158,11,0.08)]' : 'border-transparent'} hover:border-amber-500/30 flex flex-col gap-2 group transition-colors w-full`;

      const usableLabelEs = item.usableType === 'drinkable' || item.category === 'potion'
        ? 'Bebible'
        : item.usableType === 'edible'
        ? 'Comestible'
        : item.usableType === 'usable'
        ? 'Usable'
        : '';

      card.innerHTML = `
        <div class="flex items-center justify-between gap-2 w-full min-w-0">
          <div class="item-info-trigger flex items-center gap-2.5 min-w-0 flex-1 cursor-pointer select-none" title="Ver detalles y notas">
            <span class="material-symbols-outlined text-[18px] text-amber-500 shrink-0">${item.icon || 'inventory_2'}</span>
            <div class="min-w-0 flex-1">
              <div class="flex items-center gap-1.5 flex-wrap">
                <span class="text-[#f1f5f9] font-medium truncate max-w-full">${escapeHtml(item.name)}</span>
                ${customBadgeHtml(item)}
                ${usableLabelEs ? `<span class="px-1.5 py-0.2 rounded bg-emerald-500/10 text-emerald-300 text-[9px] font-bold border border-emerald-500/25 uppercase shrink-0">${usableLabelEs}</span>` : ''}
                ${item.activationCondition ? `<span class="px-1.5 py-0.2 rounded bg-amber-500/10 text-amber-300 text-[9px] font-bold border border-amber-500/20 flex items-center gap-0.5 shrink-0" title="Condición de activación: ${item.activationCondition}"><span class="material-symbols-outlined text-[10px]">timer</span><span>${escapeHtml(item.activationCondition)}</span></span>` : ''}
              </div>
              ${item.description ? `<span class="text-[10px] text-[#64748b] truncate block">${escapeHtml(item.description)}</span>` : ''}
            </div>
          </div>

          <div class="flex items-center gap-1 shrink-0">
            <span class="px-2 py-0.5 rounded bg-[#10141d] text-[#94a3b8] font-bold text-[11px] border border-[#222f42]">x${item.quantity}</span>
            
            ${actionVerb ? `
              <button
                type="button"
                class="action-item-btn px-2 py-0.5 rounded bg-amber-500/20 text-amber-300 hover:bg-amber-500 hover:text-[#0a0d12] text-[10px] font-bold border border-amber-500/30 transition-all cursor-pointer"
                data-id="${item.id}"
                title="${actionVerb} ${item.name}"
              >
                ${actionVerb}
              </button>
            ` : ''}

            <button
              type="button"
              class="edit-item-btn w-6 h-6 rounded hover:bg-amber-500/20 text-[#94a3b8] hover:text-amber-400 flex sm:hidden sm:group-hover:flex items-center justify-center transition-colors cursor-pointer"
              title="Editar objeto y notas"
            >
              <span class="material-symbols-outlined text-[14px]">edit</span>
            </button>

            <button
              type="button"
              class="pin-item-btn w-6 h-6 rounded hover:bg-[#10141d] ${isPinned ? 'text-amber-400 flex' : 'text-[#64748b] flex sm:hidden sm:group-hover:flex'} items-center justify-center transition-colors cursor-pointer"
              title="${isPinned ? 'Desasignar de acceso rápido' : 'Fijar como acceso rápido superior'}"
              data-id="${item.id}"
            >
              <span class="material-symbols-outlined text-[14px]">${isPinned ? 'push_pin' : 'keep'}</span>
            </button>

            <button
              type="button"
              class="expand-item-btn w-6 h-6 rounded hover:bg-[#10141d] text-[#64748b] hover:text-[#cbd5e1] flex items-center justify-center cursor-pointer"
              title="${isExpanded ? 'Ocultar notas' : 'Ver notas completas'}"
            >
              <span class="material-symbols-outlined text-[16px] transition-transform ${isExpanded ? 'rotate-180 text-amber-400' : ''}">expand_more</span>
            </button>
          </div>
        </div>

        <!-- Expandable Details Row -->
        <div class="expand-panel ${isExpanded ? 'block' : 'hidden'} pt-2 border-t border-[#222f42]/70 space-y-1.5 text-[11px] text-[#cbd5e1]">
          ${item.activationCondition ? `
            <div class="flex items-start gap-1.5 bg-amber-500/10 p-2 rounded border border-amber-500/20">
              <span class="material-symbols-outlined text-[14px] text-amber-400 shrink-0 mt-0.5">timer</span>
              <div>
                <strong class="text-amber-300 font-semibold">Activación:</strong>
                <span>${item.activationCondition}</span>
              </div>
            </div>
          ` : ''}

          ${item.description ? `
            <div>
              <strong class="text-[#94a3b8]">Descripción:</strong>
              <p class="text-[#e2e8f0] leading-relaxed mt-0.5">${item.description}</p>
            </div>
          ` : ''}

          ${item.notes ? `
            <div class="flex items-start gap-1.5 bg-[#10141d] p-2 rounded border border-[#222f42]">
              <span class="material-symbols-outlined text-[14px] text-amber-400 shrink-0 mt-0.5">auto_awesome</span>
              <div>
                <strong class="text-amber-400 font-semibold">Notas y Efectos Especiales:</strong>
                <p class="text-[#cbd5e1] leading-relaxed mt-0.5 whitespace-pre-line">${item.notes}</p>
              </div>
            </div>
          ` : ''}

          <div class="flex items-center justify-end gap-2 pt-1 text-[10px]">
            <button type="button" class="panel-edit-btn text-amber-400 hover:underline flex items-center gap-0.5 cursor-pointer">
              <span class="material-symbols-outlined text-[12px]">edit</span>
              <span>Editar</span>
            </button>
            <button type="button" class="panel-delete-btn text-rose-400 hover:underline flex items-center gap-0.5 cursor-pointer ml-2">
              <span class="material-symbols-outlined text-[12px]">delete</span>
              <span>Eliminar</span>
            </button>
          </div>
        </div>
      `;

      // Equipo y sintonización (Spec 08, Fase A). Todo el texto con textContent.
      // Las armas se equipan desde la sección "Armas y Acciones de Ataque", y solo los objetos
      // realmente vestibles (con ranuras válidas en validSlotsFor) muestran el selector de ranura.
      const slots = validSlotsFor(item);
      const isEquippable = (item.equipped || slots.length > 0) && item.category !== 'weapon';
      const isWeaponInBackpack = item.category === 'weapon' || !!item.weapon;
      const mkBadge = (text: string, cls: string, icon?: string) => {
        const b = document.createElement('span');
        b.className = `px-1.5 py-0.5 rounded text-[9px] font-bold border flex items-center gap-0.5 shrink-0 ${cls}`;
        if (icon) {
          const ic = document.createElement('span');
          ic.className = 'material-symbols-outlined text-[10px]';
          ic.textContent = icon;
          b.appendChild(ic);
        }
        const t = document.createElement('span');
        t.textContent = text;
        b.appendChild(t);
        return b;
      };
      const badges = document.createElement('div');
      badges.className = 'flex items-center gap-1 flex-wrap';
      if (item.equipped && item.slot) badges.appendChild(mkBadge(`Equipado: ${SLOT_LABELS[item.slot as EquipSlot] ?? item.slot}`, 'bg-emerald-500/10 text-emerald-300 border-emerald-500/30', 'checkroom'));
      if (item.attuned) badges.appendChild(mkBadge('Sintonizado', 'bg-violet-500/10 text-violet-300 border-violet-500/30', 'auto_awesome'));
      if (item.equipped && item.requiresAttunement && !item.attuned) badges.appendChild(mkBadge('Sin sintonizar: no aplica efectos', 'bg-rose-500/10 text-rose-300 border-rose-500/30', 'warning'));

      const equipRow = document.createElement('div');
      equipRow.className = 'flex items-center gap-1.5 flex-wrap ml-auto';
      if (isWeaponInBackpack) {
        const hasAttack = (char.actions || []).some((a: any) => a.itemId === item.id || a.name === item.name);
        if (hasAttack) {
          badges.appendChild(mkBadge('En Armas y Ataques', 'bg-amber-500/10 text-amber-300 border-amber-500/30', 'swords'));
        } else {
          const prepBtn = document.createElement('button');
          prepBtn.type = 'button';
          prepBtn.className = 'px-2 py-0.5 rounded bg-amber-500/20 text-amber-300 hover:bg-amber-500 hover:text-[#0a0d12] border border-amber-500/30 text-[10px] font-bold cursor-pointer';
          prepBtn.textContent = '⚔️ Preparar Ataque';
          prepBtn.addEventListener('click', () => {
            const created = characterStore.createAttackFromWeapon(item.id);
            if (created) {
              showAlert(`¡"${item.name}" añadido a tu panel de Armas y Acciones de Ataque!`, { kind: 'success' });
            } else {
              window.dispatchEvent(new CustomEvent('open-add-weapon-modal', {
                detail: { prefill: { name: item.name, type: 'Cuerpo a cuerpo', damageDice: item.weapon?.damage || '1d6', damageType: item.weapon?.damageType || 'Cortante' } }
              }));
            }
          });
          equipRow.appendChild(prepBtn);
        }
      }
      if (isEquippable) {
        if (item.equipped) {
          const unBtn = document.createElement('button');
          unBtn.type = 'button';
          unBtn.className = 'px-2 py-0.5 rounded bg-[#10141d] text-[#cbd5e1] hover:text-amber-300 border border-[#222f42] text-[10px] font-bold cursor-pointer';
          unBtn.textContent = 'Quitar';
          unBtn.addEventListener('click', () => characterStore.unequipItem(item.id));
          equipRow.appendChild(unBtn);
        } else if (slots.length > 0) {
          const sel = document.createElement('select');
          sel.className = 'bg-[#10141d] text-[#cbd5e1] border border-[#222f42] rounded text-[10px] px-1.5 py-0.5';
          slots.forEach((s) => {
            const o = document.createElement('option');
            o.value = s;
            o.textContent = SLOT_LABELS[s];
            sel.appendChild(o);
          });
          const eqBtn = document.createElement('button');
          eqBtn.type = 'button';
          eqBtn.className = 'px-2 py-0.5 rounded bg-amber-500/20 text-amber-300 hover:bg-amber-500 hover:text-[#0a0d12] border border-amber-500/30 text-[10px] font-bold cursor-pointer';
          eqBtn.textContent = 'Equipar';
          eqBtn.addEventListener('click', () => {
            const res = characterStore.equipItem(item.id, sel.value as EquipSlot);
            if (res.error) showAlert(res.error, { kind: 'warning' });
            else if (res.unequipped.length > 0) {
              showAlert(`Se quitó ${res.unequipped.map((u) => u.name).join(', ')} para equipar ${item.name}.`, { kind: 'warning' });
            }
          });
          equipRow.append(sel, eqBtn);
        }
      }
      if (item.requiresAttunement || item.attuned) {
        const atBtn = document.createElement('button');
        atBtn.type = 'button';
        atBtn.className = 'px-2 py-0.5 rounded bg-violet-500/15 text-violet-300 hover:bg-violet-500/30 border border-violet-500/30 text-[10px] font-bold cursor-pointer';
        atBtn.textContent = item.attuned ? 'Quitar sintonía' : 'Sintonizar';
        atBtn.addEventListener('click', () => {
          if (item.attuned) { characterStore.unattuneItem(item.id); return; }
          const res = characterStore.attuneItem(item.id);
          if (res.error) showAlert(res.error, { kind: 'warning' });
        });
        equipRow.appendChild(atBtn);
      }
      if (badges.childElementCount > 0 || equipRow.childElementCount > 0) {
        const metaBar = document.createElement('div');
        metaBar.className = 'flex items-center justify-between gap-2 flex-wrap pt-1.5 border-t border-[#222f42]/50';
        if (badges.childElementCount > 0) metaBar.appendChild(badges);
        if (equipRow.childElementCount > 0) metaBar.appendChild(equipRow);
        card.querySelector('.expand-panel')?.before(metaBar);
      }

      // Helper function to trigger delete modal
      const triggerItemDelete = () => {
        window.dispatchEvent(new CustomEvent('open-delete-modal', {
          detail: {
            type: 'inventory',
            id: item.id,
            name: item.name,
            category: item.category === 'potion' ? 'Poción' : item.category === 'weapon' ? 'Arma' : item.category === 'armor' ? 'Armadura' : item.category === 'treasure' ? 'Tesoro' : 'Equipo',
            icon: item.icon || 'inventory_2',
            quantity: item.quantity,
            title: '¿Eliminar de la mochila?',
            subtitle: 'Confirmación de inventario',
            onConfirm: (amount?: number) => {
              characterStore.removeInventoryItem(item.id, amount);
            }
          }
        }));
      };

      // Attach mobile swipe-to-delete gesture
      attachSwipeToDelete({
        card,
        container: wrapper,
        threshold: 60,
        onTrigger: triggerItemDelete
      });

      // Expand / Collapse details in-place without rebuilding DOM or causing scroll shifts
      const toggleExpand = (e: Event) => {
        e.preventDefault();
        e.stopPropagation();
        const panel = card.querySelector('.expand-panel');
        const icon = card.querySelector('.expand-item-btn .material-symbols-outlined');
        const btn = card.querySelector('.expand-item-btn');
        if (!panel) return;

        if (expandedItems.has(item.id)) {
          expandedItems.delete(item.id);
          panel.classList.add('hidden');
          panel.classList.remove('block');
          if (icon) {
            icon.classList.remove('rotate-180', 'text-amber-400');
          }
          if (btn) btn.setAttribute('title', 'Ver notas completas');
        } else {
          expandedItems.add(item.id);
          panel.classList.remove('hidden');
          panel.classList.add('block');
          if (icon) {
            icon.classList.add('rotate-180', 'text-amber-400');
          }
          if (btn) btn.setAttribute('title', 'Ocultar notas');
        }
      };

      card.querySelector('.expand-item-btn')?.addEventListener('click', toggleExpand);
      deleteTriggers.set(item.id, triggerItemDelete);

      // Fase D: tocar el nombre abre la ficha; el detalle en línea sigue con la flecha.
      card.querySelector('.item-info-trigger')?.addEventListener('click', () => {
        window.dispatchEvent(new CustomEvent('open-item-detail', {
          detail: { entry: toCatalogEntry('item', item), context: 'inventory' }
        }));
      });

      // Edit item trigger
      const triggerEdit = (e: Event) => {
        e.stopPropagation();
        window.dispatchEvent(new CustomEvent('open-edit-item-modal', {
          detail: { item }
        }));
      };

      card.querySelector('.edit-item-btn')?.addEventListener('click', triggerEdit);
      card.querySelector('.panel-edit-btn')?.addEventListener('click', triggerEdit);
      card.querySelector('.panel-delete-btn')?.addEventListener('click', (e) => {
        e.stopPropagation();
        triggerItemDelete();
      });

      // Action (Beber / Comer / Usar)
      card.querySelector('.action-item-btn')?.addEventListener('click', (e) => {
        e.stopPropagation();
        const res = characterStore.consumeItem(item.id);
        if (res.success && res.healed && res.healed > 0) {
          showAlert(`¡Has consumido "${item.name}"! +${res.healed} PG recuperados.`, { kind: 'success' });
        }
      });

      // Pin / unpin trigger
      card.querySelector('.pin-item-btn')?.addEventListener('click', (e) => {
        e.stopPropagation();
        if (isPinned) {
          characterStore.setQuickSlotItem(null);
        } else {
          characterStore.setQuickSlotItem(item.id);
        }
      });

      wrapper.appendChild(card);
      gearContainer.appendChild(wrapper);
    });
  }

  renderBackpack(characterStore.get());

  // Acciones de la ficha de objeto abierta desde la mochila (FD-3).
  window.addEventListener('item-action', ((e: CustomEvent) => {
    const { entryId, action, context } = e.detail || {};
    if (context !== 'inventory') return;
    if (action === 'use') {
      const res = characterStore.consumeItem(entryId);
      if (res.success && res.healed && res.healed > 0) {
        showAlert(`¡Has consumido "${res.name}"! +${res.healed} PG recuperados.`, { kind: 'success' });
      }
    } else if (action === 'edit') {
      const item = characterStore.get().inventory.find((i: any) => i.id === entryId);
      if (item) window.dispatchEvent(new CustomEvent('open-edit-item-modal', { detail: { item } }));
    } else if (action === 'drop') {
      deleteTriggers.get(entryId)?.();
    }
  }) as EventListener);

  window.addEventListener('character-updated', ((e: CustomEvent) => {
    renderBackpack(e.detail.character);
  }) as EventListener);
</script>
