---
// src/components/landing/LandingHero.astro
// Hero banner de bienvenida y propuesta de valor para visitantes.
---

<section class="relative w-full pt-6 pb-16 lg:py-20 overflow-hidden">
  <!-- Luces ambientales de fondo -->
  <div class="absolute -top-24 left-1/2 -translate-x-1/2 w-[600px] h-[350px] bg-amber-500/15 rounded-full blur-[130px] pointer-events-none"></div>
  <div class="absolute top-1/2 right-10 w-[450px] h-[350px] bg-rose-600/10 rounded-full blur-[140px] pointer-events-none"></div>
  <div class="absolute -bottom-20 left-10 w-[400px] h-[300px] bg-amber-600/10 rounded-full blur-[120px] pointer-events-none"></div>

  <div class="relative z-10 max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 text-center space-y-8">
    
    <!-- Eyebrow Badge -->
    <div class="inline-flex items-center gap-2.5 px-3.5 py-1.5 rounded-full bg-[#18202e]/90 border border-amber-500/40 text-amber-300 font-label text-xs sm:text-sm font-bold shadow-[0_0_15px_rgba(245,158,11,0.2)] animate-fade-in">
      <span class="w-2.5 h-2.5 rounded-full bg-amber-400 shadow-[0_0_8px_rgba(245,158,11,0.9)] animate-pulse"></span>
      <span>D&D 5e · Gestor de Campañas & Mesa Virtual en Vivo</span>
      <span class="px-2 py-0.5 rounded-md bg-amber-500/20 text-amber-200 text-[10px] uppercase tracking-wider font-extrabold border border-amber-500/30">100% en Español</span>
    </div>

    <!-- Main Title -->
    <div class="space-y-4 max-w-4xl mx-auto">
      <h1 class="text-3xl sm:text-5xl lg:text-6xl font-headline font-bold text-[#f1f5f9] tracking-tight leading-[1.15]">
        Tu mesa de rol cobra vida en tiempo real.{' '}<br class="hidden sm:inline" />
        <span class="bg-gradient-to-r from-amber-400 via-amber-200 to-amber-500 bg-clip-text text-transparent drop-shadow-[0_2px_15px_rgba(245,158,11,0.3)]">
          Sin suscripciones ni barreras.
        </span>
      </h1>
      <p class="text-sm sm:text-lg text-[#94a3b8] max-w-2xl mx-auto font-body leading-relaxed">
        Fichas inteligentes con cálculo automático de CA, torre de dados animada con tiradas secretas, grimorio táctico para Dungeon Masters y mesa virtual sincronizada entre celular y PC.
      </p>
    </div>

    <!-- CTA Buttons Group -->
    <div class="flex flex-col sm:flex-row items-center justify-center gap-4 pt-3 max-w-2xl mx-auto">
      <a
        href="/campaigns?demo=1"
        id="landing-hero-demo-btn"
        class="w-full sm:w-auto sm:min-w-[270px] px-8 py-4 rounded-xl bg-gradient-to-r from-amber-600 via-amber-500 to-amber-600 hover:from-amber-500 hover:to-amber-400 text-[#0a0d12] font-headline font-bold text-base flex items-center justify-center gap-2.5 shadow-[0_0_25px_rgba(245,158,11,0.45)] hover:shadow-[0_0_35px_rgba(245,158,11,0.65)] hover:scale-[1.02] active:scale-[0.98] transition-all cursor-pointer whitespace-nowrap"
        title="Probar hoja de personaje interactiva en modo demo sin necesidad de registrarse"
      >
        <span class="material-symbols-outlined text-[22px] font-bold">casino</span>
        <span>Probar Demo sin Registro</span>
      </a>

      <button
        type="button"
        id="landing-hero-auth-btn"
        class="w-full sm:w-auto sm:min-w-[270px] px-8 py-4 rounded-xl bg-[#18202e] hover:bg-[#1f2a3d] border border-amber-500/40 hover:border-amber-500/80 text-[#f1f5f9] hover:text-amber-300 font-headline font-bold text-base flex items-center justify-center gap-2 shadow-md hover:scale-[1.02] active:scale-[0.98] transition-all cursor-pointer whitespace-nowrap"
        title="Crear cuenta o iniciar sesión para sincronizar tus campañas en la nube"
      >
        <span class="material-symbols-outlined text-[20px] text-amber-400">login</span>
        <span>Entrar / Crear Cuenta</span>
      </button>
    </div>

    <!-- Micro-trust signals -->
    <div class="flex flex-wrap items-center justify-center gap-y-2 gap-x-6 text-xs text-[#64748b] font-label pt-2">
      <span class="flex items-center gap-1.5">
        <span class="material-symbols-outlined text-amber-400 text-[15px]">bolt</span>
        <span>Sin descargas ni instalaciones</span>
      </span>
      <span class="flex items-center gap-1.5">
        <span class="material-symbols-outlined text-amber-400 text-[15px]">auto_stories</span>
        <span>Reglas oficiales SRD 5.1</span>
      </span>
      <span class="flex items-center gap-1.5">
        <span class="material-symbols-outlined text-amber-400 text-[15px]">devices</span>
        <span>Móvil y PC sincronizados</span>
      </span>
      <span class="flex items-center gap-1.5">
        <span class="material-symbols-outlined text-emerald-400 text-[15px]">verified_user</span>
        <span>Gratuito y sin publicidad</span>
      </span>
    </div>

  </div>
</section>

<script>
  import { telemetry } from '../../scripts/analytics/telemetry.ts';

  // Telemetría del botón Probar Demo
  document.getElementById('landing-hero-demo-btn')?.addEventListener('click', () => {
    telemetry.track('landing_cta_demo_click', { source: 'landing_hero' });
  });

  // Enlace del botón secundario de auth para abrir el modal AuthGate y telemetría
  document.getElementById('landing-hero-auth-btn')?.addEventListener('click', () => {
    telemetry.track('landing_cta_auth_click', { source: 'landing_hero' });
    window.dispatchEvent(new CustomEvent('open-auth-modal', { detail: { mode: 'login' } }));
  });
</script>
