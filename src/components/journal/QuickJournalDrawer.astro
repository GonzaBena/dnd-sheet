---
// src/components/journal/QuickJournalDrawer.astro
---

<!-- Drawer Backdrop -->
<div id="drawer-backdrop" class="hidden fixed inset-0 bg-black/60 backdrop-blur-xs z-50 transition-opacity"></div>

<!-- Off-Canvas Drawer -->
<div
  id="quick-journal-drawer"
  class="hidden fixed bottom-0 right-0 sm:right-6 sm:bottom-6 w-full sm:w-[440px] max-h-[85vh] z-50 bg-[#121721] border border-[#222f42] rounded-t-2xl sm:rounded-2xl shadow-[0_10px_40px_rgba(0,0,0,0.9)] overflow-hidden flex flex-col transition-[bottom,max-height] duration-150 ease-out"
>
  <!-- Drawer Header -->
  <div class="p-3.5 sm:p-4 bg-[#18202e] border-b border-[#222f42] flex items-center justify-between shrink-0">
    <div class="flex items-center gap-2">
      <div class="w-8 h-8 rounded-lg bg-amber-500/20 text-amber-400 flex items-center justify-center border border-amber-500/30">
        <span class="material-symbols-outlined text-[18px]">history_edu</span>
      </div>
      <div>
        <h4 class="font-headline font-bold text-sm text-[#f1f5f9]">Bitácora Rápida</h4>
        <span class="text-[10px] text-[#94a3b8]">Apunte al vuelo durante la partida</span>
      </div>
    </div>
    
    <button
      id="drawer-close-btn"
      type="button"
      class="w-7 h-7 rounded-lg bg-[#10141d] border border-[#222f42] hover:border-rose-500/50 text-[#94a3b8] hover:text-rose-400 flex items-center justify-center text-xs transition-colors cursor-pointer"
      aria-label="Cerrar bitácora rápida"
    >
      <span class="material-symbols-outlined text-[16px]">close</span>
    </button>
  </div>

  <!-- Drawer Body Wrapper (scrollable if viewport height is very small) -->
  <div class="flex-1 min-h-0 overflow-y-auto flex flex-col overscroll-contain">
    <!-- Drawer Quick Input Form -->
    <div class="p-3 sm:p-4 bg-[#10141d] border-b border-[#222f42] space-y-2.5 shrink-0">
      <textarea
        id="drawer-note-input"
        rows="2"
        placeholder="Escribe un apunte rápido (ej: #Botín encontramos una gema roja tallada...)"
        class="w-full text-base sm:text-xs font-body p-2.5 sm:p-3 rounded-lg bg-[#18202e] border border-[#222f42] text-[#f1f5f9] placeholder:text-[#64748b] focus:outline-none focus:border-amber-500/60 focus:ring-1 focus:ring-amber-500/40 resize-none leading-relaxed"
      ></textarea>

      <div class="flex items-center justify-between gap-2 flex-wrap">
        <div class="flex items-center gap-1 flex-wrap">
          <button type="button" class="drawer-tag text-[10px] font-bold px-2 py-0.5 rounded bg-[#18202e] border border-amber-500/30 text-amber-300 hover:bg-amber-500 hover:text-[#0a0d12] transition-colors cursor-pointer" data-tag="#Combate">#Combate</button>
          <button type="button" class="drawer-tag text-[10px] font-bold px-2 py-0.5 rounded bg-[#18202e] border border-amber-500/30 text-amber-300 hover:bg-amber-500 hover:text-[#0a0d12] transition-colors cursor-pointer" data-tag="#Botín">#Botín</button>
          <button type="button" class="drawer-tag text-[10px] font-bold px-2 py-0.5 rounded bg-[#18202e] border border-amber-500/30 text-amber-300 hover:bg-amber-500 hover:text-[#0a0d12] transition-colors cursor-pointer" data-tag="#Privado">🔒 #Privado</button>
          <button type="button" class="drawer-tag text-[10px] font-bold px-2 py-0.5 rounded bg-[#18202e] border border-amber-500/30 text-amber-300 hover:bg-amber-500 hover:text-[#0a0d12] transition-colors cursor-pointer" data-tag="#Pista">#Pista</button>
          <button type="button" class="drawer-tag text-[10px] font-bold px-2 py-0.5 rounded bg-[#18202e] border border-amber-500/30 text-amber-300 hover:bg-amber-500 hover:text-[#0a0d12] transition-colors cursor-pointer" data-tag="#NPC">#NPC</button>
        </div>

        <button
          type="button"
          id="drawer-save-btn"
          class="px-3.5 py-1.5 rounded-lg bg-gradient-to-r from-amber-600 to-amber-500 text-[#0a0d12] text-xs font-bold shadow-[0_0_10px_rgba(245,158,11,0.3)] hover:brightness-110 active:scale-95 flex items-center gap-1 transition-all cursor-pointer ml-auto"
        >
          <span class="material-symbols-outlined text-[14px]">send</span>
          <span>Guardar</span>
        </button>
      </div>
    </div>

    <!-- Recent Mini Feed -->
    <div class="p-3.5 space-y-2 overflow-y-auto max-h-[220px]" id="drawer-recent-feed">
      <!-- Populated by JavaScript -->
    </div>
  </div>

  <!-- Drawer Footer -->
  <div id="drawer-footer" class="p-3 bg-[#18202e] border-t border-[#222f42] flex items-center justify-between text-[11px] shrink-0 pb-[max(0.75rem,env(safe-area-inset-bottom,0px))]">
    <span class="text-[#94a3b8]" id="drawer-count-label">4 notas sincronizadas</span>
    <a href="#journal-feed-section" id="drawer-expand-link" class="text-amber-400 hover:text-amber-300 font-bold flex items-center gap-1">
      <span class="material-symbols-outlined text-[13px]">open_in_full</span>
      <span>Ir a Bitácora Completa</span>
    </a>
  </div>
</div>

<style>
  @media (max-width: 639px) {
    #quick-journal-drawer.keyboard-open #drawer-recent-feed {
      display: none !important;
    }
    #quick-journal-drawer.keyboard-open #drawer-footer {
      display: none !important;
    }
  }
</style>

<script>
  import { journalStore } from '../../scripts/state/journalStore';
  import { characterStore } from '../../scripts/state/characterStore';
  import { closeDrawer } from '../../scripts/animations/modalAnimations';

  const drawer = document.getElementById('quick-journal-drawer');
  const backdrop = document.getElementById('drawer-backdrop');
  const closeBtn = document.getElementById('drawer-close-btn');
  const saveBtn = document.getElementById('drawer-save-btn');
  const noteInput = document.getElementById('drawer-note-input') as HTMLTextAreaElement;
  const miniFeed = document.getElementById('drawer-recent-feed');
  const countLabel = document.getElementById('drawer-count-label');

  function renderMiniFeed() {
    if (!miniFeed) return;
    miniFeed.innerHTML = '';
    const currentChar = characterStore.get();
    const entries = journalStore.getEntries(currentChar?.id);
    if (countLabel) countLabel.textContent = `${entries.length} notas registradas`;

    entries.slice(0, 3).forEach((entry) => {
      const card = document.createElement('div');
      card.className = `p-2.5 rounded-lg bg-[#18202e] border ${entry.isPrivate ? 'border-amber-400/50 ring-1 ring-amber-400/30' : 'border-[#222f42]'} text-xs`;
      card.innerHTML = `
        <div class="flex items-center justify-between mb-1">
          <div class="flex items-center gap-1">
            <span class="px-1.5 py-0.2 rounded bg-amber-500/20 text-amber-300 text-[9px] font-bold uppercase">${entry.tags[0] || '#Nota'}</span>
            ${entry.isPrivate ? '<span class="text-[9px] text-amber-300 font-bold uppercase">🔒 Privado</span>' : ''}
          </div>
          <span class="text-[9px] text-[#64748b]">${entry.timeAgoText || 'Sesión ' + entry.sessionNumber}</span>
        </div>
        <p class="text-[#cbd5e1] text-[11px] leading-tight line-clamp-2">${entry.content}</p>
      `;
      miniFeed.appendChild(card);
    });
  }

  function handleClose() {
    if (noteInput) noteInput.blur();
    if (drawer) {
      drawer.classList.remove('keyboard-open');
      drawer.style.bottom = '';
      drawer.style.maxHeight = '';
    }
    if (drawer && backdrop) {
      closeDrawer(drawer, backdrop);
    }
  }

  // Close handlers
  closeBtn?.addEventListener('click', handleClose);
  backdrop?.addEventListener('click', handleClose);

  // Hashtag quick tag insert
  document.querySelectorAll('.drawer-tag').forEach((btn) => {
    btn.addEventListener('click', () => {
      const tag = btn.getAttribute('data-tag') || '';
      if (noteInput && !noteInput.value.includes(tag)) {
        noteInput.value = `${tag} ${noteInput.value}`.trim();
        noteInput.focus();
      }
    });
  });

  // Save entry
  saveBtn?.addEventListener('click', () => {
    const text = noteInput?.value.trim();
    if (!text) return;

    const foundTags = text.match(/#[a-zA-ZáéíóúÁÉÍÓÚñÑ]+/g) || ['#Pista'];
    const isPrivate = foundTags.includes('#Privado');
    const currentChar = characterStore.get();

    journalStore.addEntry({
      sessionNumber: currentChar?.sessionContext?.sessionNumber || 15,
      title: isPrivate ? 'Nota personal rápida' : 'Nota rápida al vuelo',
      content: text,
      tags: Array.from(new Set(foundTags)),
      isPrivate,
      characterId: currentChar?.id,
      authorName: currentChar?.name
    });

    if (noteInput) noteInput.value = '';
    renderMiniFeed();
    handleClose();
  });

  document.getElementById('drawer-expand-link')?.addEventListener('click', () => {
    handleClose();
  });

  // Adaptive positioning for mobile virtual keyboards (iOS Safari & Android)
  function updateDrawerForViewport() {
    if (!drawer || drawer.classList.contains('hidden')) return;

    const isMobile = window.innerWidth < 640;
    if (!isMobile) {
      drawer.style.bottom = '';
      drawer.style.maxHeight = '';
      drawer.classList.remove('keyboard-open');
      return;
    }

    if (window.visualViewport) {
      const vv = window.visualViewport;
      // Calculate how much the virtual keyboard overlays the viewport from the bottom
      const keyboardOffset = Math.max(0, window.innerHeight - (vv.height + vv.offsetTop));

      if (keyboardOffset > 50) {
        drawer.style.bottom = `${keyboardOffset}px`;
        drawer.style.maxHeight = `${Math.min(vv.height - 8, vv.height)}px`;
        drawer.classList.add('keyboard-open');
      } else {
        drawer.style.bottom = '0px';
        drawer.style.maxHeight = '';
        if (document.activeElement !== noteInput) {
          drawer.classList.remove('keyboard-open');
        }
      }
    }
  }

  if (window.visualViewport) {
    window.visualViewport.addEventListener('resize', updateDrawerForViewport);
    window.visualViewport.addEventListener('scroll', updateDrawerForViewport);
  }

  noteInput?.addEventListener('focus', () => {
    if (window.innerWidth < 640) {
      drawer?.classList.add('keyboard-open');
      setTimeout(updateDrawerForViewport, 50);
      setTimeout(updateDrawerForViewport, 150);
      setTimeout(updateDrawerForViewport, 300);
    }
  });

  noteInput?.addEventListener('blur', () => {
    if (window.innerWidth < 640) {
      setTimeout(() => {
        if (document.activeElement !== noteInput) {
          drawer?.classList.remove('keyboard-open');
          updateDrawerForViewport();
        }
      }, 100);
    }
  });

  renderMiniFeed();

  window.addEventListener('journal-updated', () => {
    renderMiniFeed();
  });
</script>
