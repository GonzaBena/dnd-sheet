---
// src/components/journal/JournalModal.astro
---

<!-- Modal Backdrop -->
<div id="journal-modal-backdrop" class="hidden fixed inset-0 bg-black/80 backdrop-blur-xs z-50 transition-opacity"></div>

<!-- Full Journal Modal Container -->
<div
  id="journal-modal"
  class="hidden fixed inset-0 z-50 flex items-center justify-center p-2 sm:p-4 md:p-6"
  role="dialog"
  aria-modal="true"
  aria-labelledby="journal-modal-title"
>
  <div class="modal-content w-full max-w-4xl max-h-[92vh] sm:max-h-[88vh] rounded-2xl bg-[#121721] border border-[#222f42] shadow-[0_20px_60px_rgba(0,0,0,0.95)] overflow-hidden flex flex-col">
    <!-- Header -->
    <div class="p-3.5 sm:p-4 bg-gradient-to-r from-[#18202e] via-[#1c2536] to-[#18202e] border-b border-[#222f42] flex items-center justify-between gap-3 shrink-0">
      <div class="flex items-center gap-2.5">
        <div class="w-9 h-9 rounded-xl bg-amber-500/20 text-amber-400 flex items-center justify-center border border-amber-500/30 shadow-[0_0_12px_rgba(245,158,11,0.25)] shrink-0">
          <span class="material-symbols-outlined text-[20px]">history_edu</span>
        </div>
        <div>
          <h3 id="journal-modal-title" class="font-headline font-bold text-base sm:text-lg text-[#f1f5f9] leading-tight">
            Bitácora de Sesión
          </h3>
          <span class="text-[11px] text-[#94a3b8] hidden sm:block">
            Crónicas, pistas, botín y tiradas registradas
          </span>
        </div>
      </div>

      <div class="flex items-center gap-2">
        <!-- Entry Counter Badge -->
        <span id="journal-modal-count-badge" class="px-2.5 py-1 rounded-full bg-amber-500/15 border border-amber-500/30 text-amber-400 text-xs font-bold font-label shrink-0">
          0 notas
        </span>

        <!-- Toggle Form Button -->
        <button
          type="button"
          id="journal-modal-toggle-form-btn"
          class="flex items-center gap-1 px-3 py-1.5 rounded-lg bg-[#18202e] hover:bg-amber-500/15 border border-amber-500/30 text-amber-300 text-xs font-bold font-label transition-colors cursor-pointer"
          title="Alternar formulario para nueva nota"
        >
          <span class="material-symbols-outlined text-[15px]" id="journal-modal-toggle-icon">add</span>
          <span class="hidden sm:inline" id="journal-modal-toggle-label">Nueva Nota</span>
        </button>

        <!-- Close Button -->
        <button
          type="button"
          id="journal-modal-close-btn"
          class="w-8 h-8 rounded-lg bg-[#10141d] border border-[#222f42] hover:border-rose-500/50 text-[#94a3b8] hover:text-rose-400 flex items-center justify-center text-xs transition-colors cursor-pointer shrink-0"
          aria-label="Cerrar bitácora"
        >
          <span class="material-symbols-outlined text-[18px]">close</span>
        </button>
      </div>
    </div>

    <!-- Filter Chips Bar (Sticky Toolbar) -->
    <div class="px-3.5 sm:px-5 py-2.5 bg-[#0f141d] border-b border-[#222f42] overflow-x-auto no-scrollbar flex items-center gap-1.5 shrink-0" id="journal-modal-filters">
      <button class="modal-filter-btn active px-2.5 py-1 rounded-lg bg-amber-500/20 text-amber-300 border border-amber-500/40 text-xs font-bold transition-all cursor-pointer shrink-0" data-filter="all">Todos</button>
      <button class="modal-filter-btn px-2.5 py-1 rounded-lg bg-[#18202e] text-[#94a3b8] border border-[#222f42] hover:text-[#f1f5f9] text-xs transition-all cursor-pointer shrink-0" data-filter="#Combate">#Combate</button>
      <button class="modal-filter-btn px-2.5 py-1 rounded-lg bg-[#18202e] text-[#94a3b8] border border-[#222f42] hover:text-[#f1f5f9] text-xs transition-all cursor-pointer shrink-0" data-filter="#Tirada">#Tirada</button>
      <button class="modal-filter-btn px-2.5 py-1 rounded-lg bg-[#18202e] text-[#94a3b8] border border-[#222f42] hover:text-[#f1f5f9] text-xs transition-all cursor-pointer shrink-0" data-filter="#Botín">#Botín</button>
      <button class="modal-filter-btn px-2.5 py-1 rounded-lg bg-[#18202e] text-[#94a3b8] border border-[#222f42] hover:text-[#f1f5f9] text-xs transition-all cursor-pointer shrink-0" data-filter="#Descanso">#Descanso</button>
      <button class="modal-filter-btn px-2.5 py-1 rounded-lg bg-[#18202e] text-[#94a3b8] border border-[#222f42] hover:text-[#f1f5f9] text-xs transition-all cursor-pointer shrink-0" data-filter="#Magia">#Magia</button>
      <button class="modal-filter-btn px-2.5 py-1 rounded-lg bg-[#18202e] text-[#94a3b8] border border-[#222f42] hover:text-[#f1f5f9] text-xs transition-all cursor-pointer shrink-0" data-filter="#Hito">#Hito</button>
      <button class="modal-filter-btn px-2.5 py-1 rounded-lg bg-[#18202e] text-[#94a3b8] border border-[#222f42] hover:text-[#f1f5f9] text-xs transition-all cursor-pointer shrink-0" data-filter="#Privado">🔒 #Privado</button>
      <button class="modal-filter-btn px-2.5 py-1 rounded-lg bg-[#18202e] text-[#94a3b8] border border-[#222f42] hover:text-[#f1f5f9] text-xs transition-all cursor-pointer shrink-0" data-filter="#Pista">#Pista</button>
      <button class="modal-filter-btn px-2.5 py-1 rounded-lg bg-[#18202e] text-[#94a3b8] border border-[#222f42] hover:text-[#f1f5f9] text-xs transition-all cursor-pointer shrink-0" data-filter="#NPC">#NPC</button>
      <button class="modal-filter-btn px-2.5 py-1 rounded-lg bg-[#18202e] text-[#94a3b8] border border-[#222f42] hover:text-[#f1f5f9] text-xs transition-all cursor-pointer shrink-0" data-filter="#Configuración">#Configuración</button>
    </div>

    <!-- Scrollable Body with Collapsible New Entry Form and Feed -->
    <div class="flex-1 min-h-0 overflow-y-auto p-3.5 sm:p-5 space-y-4 overscroll-contain" id="journal-modal-scroll-area">
      <!-- NEW LOG ENTRY FORM -->
      <form class="p-4 rounded-xl bg-[#18202e] border border-[#222f42] shadow-sm space-y-3 transition-all duration-200" id="journal-modal-form">
        <div class="flex flex-wrap items-center justify-between gap-2">
          <span class="text-xs font-headline font-bold text-amber-400 uppercase tracking-wider flex items-center gap-1.5">
            <span class="material-symbols-outlined text-[16px]">edit_note</span>
            <span>Añadir Registro a la Bitácora</span>
          </span>

          <div class="flex items-center gap-1 flex-wrap" id="journal-modal-quick-tags">
            <button type="button" class="modal-tag-insert-btn text-[10px] font-bold px-2 py-0.5 rounded bg-[#10141d] border border-amber-500/30 text-amber-300 hover:bg-amber-500 hover:text-[#0a0d12] transition-colors cursor-pointer" data-tag="#Hito">⭐ #Hito</button>
            <button type="button" class="modal-tag-insert-btn text-[10px] font-bold px-2 py-0.5 rounded bg-[#10141d] border border-amber-500/30 text-amber-300 hover:bg-amber-500 hover:text-[#0a0d12] transition-colors cursor-pointer" data-tag="#Combate">#Combate</button>
            <button type="button" class="modal-tag-insert-btn text-[10px] font-bold px-2 py-0.5 rounded bg-[#10141d] border border-amber-500/30 text-amber-300 hover:bg-amber-500 hover:text-[#0a0d12] transition-colors cursor-pointer" data-tag="#Botín">#Botín</button>
            <button type="button" class="modal-tag-insert-btn text-[10px] font-bold px-2 py-0.5 rounded bg-[#10141d] border border-amber-500/30 text-amber-300 hover:bg-amber-500 hover:text-[#0a0d12] transition-colors cursor-pointer" data-tag="#Pista">#Pista</button>
            <button type="button" class="modal-tag-insert-btn text-[10px] font-bold px-2 py-0.5 rounded bg-[#10141d] border border-amber-500/30 text-amber-300 hover:bg-amber-500 hover:text-[#0a0d12] transition-colors cursor-pointer" data-tag="#NPC">#NPC</button>
          </div>
        </div>

        <input
          type="text"
          id="journal-modal-title-input"
          placeholder="Título o asunto del registro (ej: Descubrimiento en la cripta)"
          class="w-full text-xs font-body p-2.5 rounded-lg bg-[#10141d] border border-[#222f42] text-[#f1f5f9] placeholder:text-[#64748b] focus:outline-none focus:border-amber-500/60 focus:ring-1 focus:ring-amber-500/40"
        />

        <textarea
          id="journal-modal-text-input"
          rows="2"
          placeholder="Detalles de la sesión, notas de combate, diálogos clave, rumores..."
          class="w-full text-xs font-body p-3 rounded-lg bg-[#10141d] border border-[#222f42] text-[#f1f5f9] placeholder:text-[#64748b] focus:outline-none focus:border-amber-500/60 focus:ring-1 focus:ring-amber-500/40 resize-none"
        ></textarea>

        <div class="flex items-center justify-between gap-3 pt-1 flex-wrap">
          <div class="flex items-center gap-3 flex-wrap">
            <label class="flex items-center gap-1.5 cursor-pointer text-xs text-[#cbd5e1] hover:text-[#f1f5f9]">
              <input type="checkbox" id="journal-modal-private-check" class="rounded bg-[#10141d] border-[#222f42] text-amber-500 focus:ring-amber-500/40 cursor-pointer" />
              <span class="flex items-center gap-1 font-bold text-amber-400">
                <span>🔒</span>
                <span>Nota de Jugador (solo vos, ni el DM)</span>
              </span>
            </label>

            <label class="flex items-center gap-1.5 cursor-pointer text-xs text-[#94a3b8] hover:text-[#f1f5f9]">
              <input type="checkbox" id="journal-modal-secret-check" class="rounded bg-[#10141d] border-[#222f42] text-purple-500 focus:ring-purple-500/40 cursor-pointer" />
              <span class="flex items-center gap-1 font-bold text-purple-300">
                <span>📨</span>
                <span>Para el DM (solo vos y el DM)</span>
              </span>
            </label>
          </div>

          <button
            type="submit"
            class="px-4 py-2 rounded-lg bg-gradient-to-r from-amber-600 to-amber-500 text-[#0a0d12] text-xs font-bold shadow-[0_0_12px_rgba(245,158,11,0.3)] hover:brightness-110 active:scale-95 transition-all flex items-center gap-1.5 cursor-pointer ml-auto"
          >
            <span class="material-symbols-outlined text-[16px]">send</span>
            <span>Guardar Entrada</span>
          </button>
        </div>
      </form>

      <!-- CHRONOLOGICAL FEED OF ALL JOURNAL ENTRIES (Masonry layout to avoid vertical stretching) -->
      <div class="masonry-layout-2" id="journal-modal-cards-feed">
        <!-- Populated via JavaScript -->
      </div>
    </div>
  </div>
</div>

<script>
  import { journalStore, getEntryVisibility, canUserDeleteEntry } from '../../scripts/state/journalStore';
  import { characterStore } from '../../scripts/state/characterStore';
  import { campaignStore } from '../../scripts/state/campaignStore';
  import { userStore } from '../../scripts/state/userStore';
  import { openModal, closeModal } from '../../scripts/animations/modalAnimations';
  import { attachSwipeToDelete } from '../../scripts/ui/swipeToDelete';

  const modal = document.getElementById('journal-modal');
  const backdrop = document.getElementById('journal-modal-backdrop');
  const closeBtn = document.getElementById('journal-modal-close-btn');
  const toggleFormBtn = document.getElementById('journal-modal-toggle-form-btn');
  const form = document.getElementById('journal-modal-form') as HTMLFormElement;
  const titleInput = document.getElementById('journal-modal-title-input') as HTMLInputElement;
  const textInput = document.getElementById('journal-modal-text-input') as HTMLTextAreaElement;
  const privateCheck = document.getElementById('journal-modal-private-check') as HTMLInputElement;
  const secretCheck = document.getElementById('journal-modal-secret-check') as HTMLInputElement;
  // Las dos opciones son excluyentes.
  privateCheck?.addEventListener('change', () => { if (privateCheck.checked && secretCheck) secretCheck.checked = false; });
  secretCheck?.addEventListener('change', () => { if (secretCheck.checked && privateCheck) privateCheck.checked = false; });
  const feedContainer = document.getElementById('journal-modal-cards-feed');
  const countBadge = document.getElementById('journal-modal-count-badge');
  const toggleIcon = document.getElementById('journal-modal-toggle-icon');
  const toggleLabel = document.getElementById('journal-modal-toggle-label');

  let activeFilter = 'all';
  let isFormVisible = true;

  function renderFeed() {
    if (!feedContainer) return;
    feedContainer.innerHTML = '';

    const activeCampId = campaignStore.getActiveCampaignId();
    const isDm = activeCampId ? campaignStore.isCurrentUserDm(activeCampId) : false;
    const currentChar = characterStore.get();
    const currentUser = userStore.getCurrentUser();
    // El DM ve todas las entradas cargadas (incluyendo notas DM y mensajes to_dm)
    // El jugador ve notas del grupo + sus notas privadas + sus mensajes al DM
    const entries = isDm
      ? journalStore.getEntries(undefined, currentUser?.id, true)
      : journalStore.getEntries(currentChar?.id, currentUser?.id, false);

    if (countBadge) {
      countBadge.textContent = `${entries.length} notas`;
    }

    const filtered = activeFilter === 'all'
      ? entries
      : entries.filter(e => e.tags.some(t => t.toLowerCase() === activeFilter.toLowerCase()) || (activeFilter === '#Privado' && getEntryVisibility(e) === 'player'));

    if (filtered.length === 0) {
      feedContainer.innerHTML = `
        <div class="[column-span:_all] w-full py-10 text-center text-xs text-[#64748b] bg-[#10141d]/50 rounded-xl border border-[#222f42]/40 p-6">
          <span class="material-symbols-outlined text-[32px] text-[#475569] mb-2 block">menu_book</span>
          No hay notas registradas con el filtro <strong>${activeFilter}</strong>.
        </div>
      `;
      return;
    }

    filtered.forEach((entry) => {
      const wrapper = document.createElement('div');
      wrapper.className = 'masonry-item relative rounded-xl overflow-hidden select-none bg-[#10141d] border border-[#222f42]';

      // Background trash revealed on mobile swipe
      const swipeBg = document.createElement('div');
      swipeBg.className = 'swipe-delete-bg absolute inset-0 bg-gradient-to-l from-rose-600/60 via-rose-600/30 to-rose-950/20 flex items-center justify-end px-4 gap-1.5 text-rose-300 font-bold text-xs pointer-events-none opacity-0';
      swipeBg.innerHTML = `
        <span class="material-symbols-outlined text-[18px]">delete</span>
        <span class="text-[11px]">Eliminar</span>
      `;
      wrapper.appendChild(swipeBg);

      const isHito = entry.tags?.includes('#Hito');
      const isPrivate = getEntryVisibility(entry) === 'player';
      const isForDm = getEntryVisibility(entry) === 'to_dm';
      const card = document.createElement('div');
      card.className = `relative p-3.5 sm:p-4 rounded-xl bg-[#18202e] border ${
        isHito
          ? 'border-amber-500/50 shadow-[0_0_15px_rgba(245,158,11,0.15)] bg-gradient-to-br from-[#1d2738] to-[#18202e]'
          : isPrivate
          ? 'border-amber-400/50 bg-[#192230]'
          : isForDm || entry.isSecret
          ? 'border-purple-500/40'
          : 'border-[#222f42]/70'
      } hover:border-amber-500/60 transition-all flex flex-col justify-between gap-2.5 text-xs shadow-xs cursor-grab active:cursor-grabbing`;

      const tagsHtml = entry.tags.map(t => {
        let colorClass = 'bg-amber-500/20 text-amber-300 border-amber-500/30';
        if (t === '#Hito') colorClass = 'bg-amber-500/30 text-amber-200 border-amber-400 font-bold shadow-[0_0_8px_rgba(245,158,11,0.3)]';
        if (t === '#Combate') colorClass = 'bg-rose-500/20 text-rose-300 border-rose-500/30';
        if (t === '#Botín') colorClass = 'bg-emerald-500/20 text-emerald-300 border-emerald-500/30';
        if (t === '#NPC') colorClass = 'bg-sky-500/20 text-sky-300 border-sky-500/30';
        if (t === '#Tirada') colorClass = 'bg-fuchsia-500/20 text-fuchsia-300 border-fuchsia-500/30';
        if (t === '#Descanso') colorClass = 'bg-teal-500/20 text-teal-300 border-teal-500/30';
        if (t === '#Magia') colorClass = 'bg-indigo-500/20 text-indigo-300 border-indigo-500/30';
        if (t === '#Configuración') colorClass = 'bg-slate-500/20 text-slate-300 border-slate-500/30';
        if (t === '#Privado') colorClass = 'bg-amber-500/30 text-amber-300 border-amber-400 font-bold';
        return `<span class="px-2 py-0.5 rounded text-[10px] font-bold uppercase border ${colorClass}">${t}</span>`;
      }).join(' ');

      let diceBoxHtml = '';
      if (entry.diceRoll?.formula && entry.diceRoll?.result !== undefined) {
        diceBoxHtml = `
          <div class="p-2 rounded-lg bg-[#10141d] border border-amber-500/30 flex items-center justify-between text-xs my-1">
            <span class="text-[#94a3b8]">${entry.diceRoll.formula}</span>
            <span class="font-headline font-bold text-amber-400 text-sm">Resultado: ${entry.diceRoll.result}</span>
          </div>
        `;
      } else {
        const milestoneBanner = entry.milestone?.bannerText || (entry.diceRoll as any)?.bannerText;
        if (milestoneBanner) {
          diceBoxHtml = `
            <div class="p-2 rounded-lg bg-amber-500/15 border border-amber-500/40 font-headline font-bold text-amber-300 text-xs my-1 flex items-center gap-1.5">
              <span class="text-amber-400 text-sm">⭐</span>
              <span>${milestoneBanner}</span>
            </div>
          `;
        }
      }

      const canDelete = canUserDeleteEntry(entry, currentUser.id, isDm);

      card.innerHTML = `
        <div>
          <div class="flex items-center justify-between gap-2 mb-1.5">
            <div class="flex items-center gap-1.5 flex-wrap">
              ${tagsHtml}
              ${isPrivate ? '<span class="px-1.5 py-0.2 rounded bg-amber-500/20 text-amber-300 text-[9px] font-bold uppercase border border-amber-500/40 flex items-center gap-0.5">🔒 Solo Tú</span>' : ''}
              ${isForDm ? '<span class="px-1.5 py-0.2 rounded bg-purple-500/20 text-purple-300 text-[9px] font-bold uppercase border border-purple-500/30 flex items-center gap-0.5">📨 Para el DM</span>' : ''}
              ${entry.isSecret ? `<span class="px-1.5 py-0.2 rounded bg-purple-500/20 text-purple-300 text-[9px] font-bold uppercase border border-purple-500/30">${entry.authorName === 'Dungeon Master' || !entry.characterId ? 'Secreto DM' : 'Tirada Secreta'}</span>` : ''}
            </div>
            <span class="text-[10px] text-[#64748b] shrink-0">${entry.timeAgoText || 'Sesión ' + entry.sessionNumber}</span>
          </div>

          <h4 class="font-headline font-bold text-[#f1f5f9] text-sm mb-1">${entry.title}</h4>
          <p class="text-[#cbd5e1] text-xs leading-relaxed whitespace-pre-line">${entry.content}</p>
          ${diceBoxHtml}
        </div>

        <div class="flex items-center justify-between pt-2 border-t border-[#222f42]/60 text-[10px] text-[#64748b]">
          <span>Sesión ${entry.sessionNumber}</span>
          ${canDelete ? `
            <button class="delete-entry-btn text-[#94a3b8] hover:text-rose-400 transition-colors cursor-pointer flex items-center gap-1" data-id="${entry.id}">
              <span class="material-symbols-outlined text-[13px]">delete</span>
              <span>Eliminar</span>
            </button>
          ` : ''}
        </div>
      `;

      if (canDelete) {
        const triggerJournalDelete = () => {
          window.dispatchEvent(new CustomEvent('open-delete-modal', {
            detail: {
              type: 'journal',
              id: entry.id,
              name: entry.title,
              category: `Sesión ${entry.sessionNumber}`,
              icon: 'edit_note',
              quantity: 1,
              title: '¿Eliminar entrada de bitácora?',
              subtitle: 'Confirmación de diario',
              onConfirm: () => {
                journalStore.deleteEntry(entry.id);
              }
            }
          }));
        };

        // Attach mobile swipe-to-delete gesture
        attachSwipeToDelete({
          card,
          container: wrapper,
          threshold: 60,
          onTrigger: triggerJournalDelete
        });

        card.querySelector('.delete-entry-btn')?.addEventListener('click', (e) => {
          e.stopPropagation();
          triggerJournalDelete();
        });
      }

      wrapper.appendChild(card);
      feedContainer.appendChild(wrapper);
    });
  }

  function handleOpen() {
    if (modal && backdrop) {
      renderFeed();
      openModal(modal, backdrop);
    }
  }

  function handleClose() {
    if (modal && backdrop) {
      closeModal(modal, backdrop);
    }
  }

  // Listeners for Opening/Closing
  window.addEventListener('open-journal-modal', handleOpen);
  closeBtn?.addEventListener('click', handleClose);
  backdrop?.addEventListener('click', handleClose);

  // Close on ESC key
  window.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && modal && !modal.classList.contains('hidden')) {
      handleClose();
    }
  });

  // Toggle creation form
  toggleFormBtn?.addEventListener('click', () => {
    isFormVisible = !isFormVisible;
    if (form) {
      if (isFormVisible) {
        form.classList.remove('hidden');
        if (toggleIcon) toggleIcon.textContent = 'remove';
        if (toggleLabel) toggleLabel.textContent = 'Ocultar';
      } else {
        form.classList.add('hidden');
        if (toggleIcon) toggleIcon.textContent = 'add';
        if (toggleLabel) toggleLabel.textContent = 'Nueva Nota';
      }
    }
  });

  // Filter Buttons
  document.querySelectorAll('#journal-modal-filters .modal-filter-btn').forEach((btn) => {
    btn.addEventListener('click', () => {
      document.querySelectorAll('#journal-modal-filters .modal-filter-btn').forEach(b => {
        b.className = 'modal-filter-btn px-2.5 py-1 rounded-lg bg-[#18202e] text-[#94a3b8] border border-[#222f42] hover:text-[#f1f5f9] text-xs transition-all cursor-pointer shrink-0';
      });
      btn.className = 'modal-filter-btn active px-2.5 py-1 rounded-lg bg-amber-500/20 text-amber-300 border border-amber-500/40 text-xs font-bold transition-all cursor-pointer shrink-0';
      activeFilter = btn.getAttribute('data-filter') || 'all';
      renderFeed();
    });
  });

  // Hashtag quick insert into text
  document.querySelectorAll('#journal-modal-quick-tags .modal-tag-insert-btn').forEach((btn) => {
    btn.addEventListener('click', () => {
      const tag = btn.getAttribute('data-tag') || '';
      if (textInput && !textInput.value.includes(tag)) {
        textInput.value = `${tag} ${textInput.value}`.trim();
        textInput.focus();
      }
    });
  });

  // Form submit
  form?.addEventListener('submit', (e) => {
    e.preventDefault();
    const content = textInput?.value.trim();
    if (!content) return;

    const title = titleInput?.value.trim() || 'Apunte de Sesión';
    // "Nota de jugador" gana si se marcan las dos: es la opción más restrictiva.
    const isPrivate = privateCheck?.checked || false;
    const isForDm = !isPrivate && (secretCheck?.checked || false);
    const currentChar = characterStore.get();

    // Detect hashtags
    const foundTags = content.match(/#[a-zA-ZáéíóúÁÉÍÓÚñÑ]+/g) || ['#Pista'];
    if (isPrivate && !foundTags.includes('#Privado')) {
      foundTags.unshift('#Privado');
    }

    const activeCampId = campaignStore.getActiveCampaignId();
    const currentUser = userStore.getCurrentUser();

    journalStore.addEntry({
      sessionNumber: currentChar?.sessionContext?.sessionNumber || 15,
      title,
      content,
      tags: Array.from(new Set(foundTags)),
      isPlayerOnly: isPrivate || undefined,
      isForDm: isForDm || undefined,
      characterId: currentChar?.id,
      campaignId: activeCampId || currentChar?.campaignId || undefined,
      authorUid: currentUser?.id || undefined,
      authorName: currentChar?.name || currentUser?.name || 'Aventurero'
    });

    if (titleInput) titleInput.value = '';
    if (textInput) textInput.value = '';
    if (secretCheck) secretCheck.checked = false;
    if (privateCheck) privateCheck.checked = false;

    renderFeed();
  });

