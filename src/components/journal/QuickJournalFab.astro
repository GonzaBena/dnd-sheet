---
// src/components/journal/QuickJournalFab.astro
---

<!-- Floating Action Buttons Dock (Índice de Secciones + Bitácora) Bottom-Right -->
<div class="fixed bottom-6 right-6 z-40 flex items-center gap-2.5 select-none" id="journal-fab-root">
  <!-- Botón 1: Índice de Secciones -->
  <button
    id="sections-index-fab-btn"
    class="w-12 h-12 rounded-full bg-[#121721]/90 backdrop-blur-md text-amber-400 border-2 border-amber-500/50 shadow-[0_0_20px_rgba(245,158,11,0.3)] hover:border-amber-400 hover:bg-[#18202e] hover:scale-110 active:scale-95 transition-all flex items-center justify-center group cursor-pointer relative"
    title="Índice de Secciones (Ir directo a una sección)"
    aria-label="Abrir índice de secciones"
    type="button"
  >
    <span class="material-symbols-outlined text-[24px] group-hover:rotate-6 transition-transform">menu_book</span>
  </button>

  <!-- Botón 2: Bitácora de Sesión -->
  <button
    id="journal-fab-btn"
    class="w-14 h-14 rounded-full bg-gradient-to-tr from-amber-600 via-amber-500 to-amber-400 text-[#0a0d12] flex items-center justify-center shadow-[0_0_25px_rgba(245,158,11,0.6)] border-2 border-amber-300/80 hover:scale-110 active:scale-95 transition-all group cursor-pointer relative"
    title="Abrir Bitácora de Sesión"
    aria-label="Abrir Bitácora de Sesión"
    type="button"
  >
    <span class="material-symbols-outlined text-[28px] font-bold group-hover:rotate-12 transition-transform duration-300">history_edu</span>
    <span class="absolute -top-1 -right-1 w-4 h-4 rounded-full bg-rose-500 border-2 border-[#0a0d12] flex items-center justify-center text-[9px] font-bold text-white shadow-sm">+</span>
  </button>

  <!-- Índice Popup Popover -->
  <div
    id="sections-index-popup"
    class="hidden absolute bottom-16 right-0 w-72 sm:w-80 rounded-2xl bg-[#121721]/95 backdrop-blur-xl border border-amber-500/40 shadow-[0_20px_50px_rgba(0,0,0,0.9)] p-3.5 space-y-3 z-50 animate-fade-in"
  >
    <!-- Header del Índice -->
    <div class="flex items-center justify-between pb-2 border-b border-[#222f42]">
      <div class="flex items-center gap-2">
        <div class="w-7 h-7 rounded-lg bg-amber-500/20 text-amber-400 flex items-center justify-center border border-amber-500/30">
          <span class="material-symbols-outlined text-[17px]">menu_book</span>
        </div>
        <div>
          <h4 class="font-headline font-bold text-xs text-[#f1f5f9]">Índice de Secciones</h4>
          <span class="text-[9px] text-[#94a3b8]">Saltar directamente a cualquier módulo</span>
        </div>
      </div>
      <button
        type="button"
        id="sections-index-close-btn"
        class="w-6 h-6 rounded-md bg-[#18202e] border border-[#222f42] hover:border-rose-500/50 text-[#94a3b8] hover:text-rose-400 flex items-center justify-center text-xs transition-colors cursor-pointer"
        aria-label="Cerrar índice"
      >
        <span class="material-symbols-outlined text-[15px]">close</span>
      </button>
    </div>

    <!-- Quick Global Actions (Expandir / Colapsar Todo) -->
    <div id="sections-index-global-actions" class="grid grid-cols-2 gap-1.5 font-label text-[10px]">
      <button
        type="button"
        id="btn-index-expand-all"
        class="px-2 py-1.5 rounded-lg bg-[#18202e] border border-[#222f42] hover:border-amber-500/40 text-[#cbd5e1] hover:text-amber-300 flex items-center justify-center gap-1 transition-colors cursor-pointer"
        title="Expandir todas las secciones"
      >
        <span class="material-symbols-outlined text-[14px]">unfold_more</span>
        <span>Expandir Todo</span>
      </button>
      <button
        type="button"
        id="btn-index-collapse-all"
        class="px-2 py-1.5 rounded-lg bg-[#18202e] border border-[#222f42] hover:border-amber-500/40 text-[#cbd5e1] hover:text-amber-300 flex items-center justify-center gap-1 transition-colors cursor-pointer"
        title="Colapsar todas las secciones"
      >
        <span class="material-symbols-outlined text-[14px]">unfold_less</span>
        <span>Colapsar Todo</span>
      </button>
    </div>

    <!-- Listado Dinámico de Secciones para Navegación -->
    <div class="space-y-1 max-h-72 overflow-y-auto custom-scrollbar font-label" id="sections-index-list">
      <!-- Generado vía JavaScript -->
    </div>
  </div>
</div>

<script>
  import { openModal } from '../../scripts/animations/modalAnimations';
  import { characterStore } from '../../scripts/state/characterStore';
  import { SECTIONS_META, jumpToSection } from '../../scripts/ui/sectionOrganizer';

  const journalFabBtn = document.getElementById('journal-fab-btn');
  const indexFabBtn = document.getElementById('sections-index-fab-btn');
  const indexPopup = document.getElementById('sections-index-popup');
  const indexCloseBtn = document.getElementById('sections-index-close-btn');
  const indexList = document.getElementById('sections-index-list');
  const expandAllBtn = document.getElementById('btn-index-expand-all');
  const collapseAllBtn = document.getElementById('btn-index-collapse-all');

  // 1. Bitácora FAB action
  journalFabBtn?.addEventListener('click', () => {
    window.dispatchEvent(new CustomEvent('open-journal-modal'));
    const modal = document.getElementById('journal-modal');
    const backdrop = document.getElementById('journal-modal-backdrop');
    if (modal && backdrop && modal.classList.contains('hidden')) {
      openModal(modal, backdrop);
    }
  });

  // 2. Índice FAB action (Toggle popup)
  indexFabBtn?.addEventListener('click', (e) => {
    e.stopPropagation();
    if (!indexPopup) return;
    const isHidden = indexPopup.classList.contains('hidden');
    if (isHidden) {
      renderIndexSections();
      indexPopup.classList.remove('hidden');
    } else {
      indexPopup.classList.add('hidden');
    }
  });

  indexCloseBtn?.addEventListener('click', (e) => {
    e.stopPropagation();
    indexPopup?.classList.add('hidden');
  });

  // Cerrar al hacer clic fuera
  document.addEventListener('click', (e) => {
    const target = e.target as HTMLElement;
    if (indexPopup && !indexPopup.classList.contains('hidden')) {
      if (!indexPopup.contains(target) && !indexFabBtn?.contains(target)) {
        indexPopup.classList.add('hidden');
      }
    }
  });

  // 3. Renderizar las secciones activas en el índice
  function renderIndexSections() {
    if (!indexList) return;
    indexList.innerHTML = '';

    const globalActions = document.getElementById('sections-index-global-actions');
    const isPartyView = Boolean(document.getElementById('party-view-root'));

    if (isPartyView) {
      if (globalActions) globalActions.classList.add('hidden');

      const partySections = [
        {
          id: 'party-map',
          name: 'Mapa Táctico',
          icon: 'map',
          target: document.getElementById('party-player-map-stage') || document.getElementById('party-dm-map-stage')
        },
        {
          id: 'party-combat',
          name: 'Iniciativa y Combate',
          icon: 'bolt',
          target: document.getElementById('party-player-tactical-view') || document.getElementById('party-dm-cockpit')
        },
        {
          id: 'party-roster',
          name: 'Grupo de Aventureros',
          icon: 'groups',
          target: document.getElementById('party-characters-list')
        },
        {
          id: 'party-journal',
          name: 'Crónica de la Partida',
          icon: 'auto_stories',
          target: document.getElementById('party-journal-feed')
        }
      ];

      partySections.forEach(sec => {
        if (!sec.target) return;
        const btn = document.createElement('button');
        btn.type = 'button';
        btn.className = 'w-full px-2.5 py-2 rounded-xl bg-[#18202e]/80 hover:bg-[#18202e] border border-[#222f42] hover:border-amber-500/50 text-left transition-all flex items-center justify-between group cursor-pointer active:scale-98';
        btn.innerHTML = `
          <div class="flex items-center gap-2 min-w-0">
            <span class="material-symbols-outlined text-[17px] text-amber-500 group-hover:scale-110 transition-transform">${sec.icon}</span>
            <span class="text-xs font-headline font-bold text-[#f1f5f9] group-hover:text-amber-300 truncate">${sec.name}</span>
          </div>
          <span class="material-symbols-outlined text-[15px] text-[#64748b] group-hover:text-amber-400 group-hover:translate-x-0.5 transition-all">arrow_forward</span>
        `;
        btn.addEventListener('click', (e) => {
          e.stopPropagation();
          sec.target?.scrollIntoView({ behavior: 'smooth', block: 'center' });
          sec.target?.classList.add('ring-2', 'ring-amber-400/80', 'transition-all');
          setTimeout(() => {
            sec.target?.classList.remove('ring-2', 'ring-amber-400/80');
          }, 1500);
          indexPopup?.classList.add('hidden');
        });
        indexList.appendChild(btn);
      });
      return;
    }

    if (globalActions) globalActions.classList.remove('hidden');

    const char = characterStore.get();
    const order = char.layoutConfig?.sectionOrder || {
      col1: ['abilities', 'saves', 'skills', 'features'],
      col2: ['weapons', 'wildshape', 'currency', 'backpack', 'spells']
    };

    // Orden unificado según la disposición actual
    const allOrdered = [...order.col1, ...order.col2];

    allOrdered.forEach((secId) => {
      const meta = SECTIONS_META[secId];
      if (!meta) return;

      const isCollapsed = characterStore.isSectionCollapsed(secId);

      const btn = document.createElement('button');
      btn.type = 'button';
      btn.className = 'w-full px-2.5 py-2 rounded-xl bg-[#18202e]/80 hover:bg-[#18202e] border border-[#222f42] hover:border-amber-500/50 text-left transition-all flex items-center justify-between group cursor-pointer active:scale-98';
      btn.setAttribute('data-target-sec', secId);

      btn.innerHTML = `
        <div class="flex items-center gap-2 min-w-0">
          <span class="material-symbols-outlined text-[17px] text-amber-500 group-hover:scale-110 transition-transform">${meta.icon}</span>
          <span class="text-xs font-headline font-bold text-[#f1f5f9] group-hover:text-amber-300 truncate">${meta.name}</span>
        </div>
        <div class="flex items-center gap-1.5 shrink-0 ml-2">
          ${isCollapsed ? '<span class="text-[9px] px-1.5 py-0.2 rounded bg-[#10141d] text-[#64748b] border border-[#222f42]">Colapsada</span>' : ''}
          <span class="material-symbols-outlined text-[15px] text-[#64748b] group-hover:text-amber-400 group-hover:translate-x-0.5 transition-all">arrow_forward</span>
        </div>
      `;

      btn.addEventListener('click', (e) => {
        e.stopPropagation();
        jumpToSection(secId);
        indexPopup?.classList.add('hidden');
      });

      indexList.appendChild(btn);
    });
  }

  // 4. Acciones de Expandir Todo / Colapsar Todo
  expandAllBtn?.addEventListener('click', (e) => {
    e.stopPropagation();
    characterStore.setAllSectionsCollapsed(false);
    renderIndexSections();
  });

  collapseAllBtn?.addEventListener('click', (e) => {
    e.stopPropagation();
    characterStore.setAllSectionsCollapsed(true);
    renderIndexSections();
  });
</script>
