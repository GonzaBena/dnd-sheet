---
// src/components/journal/JournalSection.astro
---

<section class="w-full rounded-xl bg-[#121721] border border-[#222f42] p-5 lg:p-8 shadow-sm" id="journal-feed-section">
  <!-- Journal Header with Filters & Status -->
  <div class="flex flex-wrap items-center justify-between gap-4 mb-6 pb-4 border-b border-[#222f42]">
    <div class="flex items-center gap-3">
      <div class="w-10 h-10 rounded-xl bg-amber-500/10 border border-amber-500/30 flex items-center justify-center text-amber-400">
        <span class="material-symbols-outlined text-[24px]">history_edu</span>
      </div>
      <div>
        <h3 class="text-lg font-headline font-bold text-[#f1f5f9]">Bitácora de Sesión</h3>
        <span class="text-xs text-[#94a3b8] font-label">Crónicas, pistas, botín y tiradas registradas</span>
      </div>
    </div>

    <!-- Category Filter Chips -->
    <div class="flex items-center gap-1.5 flex-wrap text-xs font-label" id="journal-filter-pills">
      <button class="filter-btn active px-2.5 py-1 rounded-lg bg-amber-500/20 text-amber-300 border border-amber-500/40 font-bold transition-all cursor-pointer" data-filter="all">Todos</button>
      <button class="filter-btn px-2.5 py-1 rounded-lg bg-[#18202e] text-[#94a3b8] border border-[#222f42] hover:text-[#f1f5f9] transition-all cursor-pointer" data-filter="#Combate">#Combate</button>
      <button class="filter-btn px-2.5 py-1 rounded-lg bg-[#18202e] text-[#94a3b8] border border-[#222f42] hover:text-[#f1f5f9] transition-all cursor-pointer" data-filter="#Tirada">#Tirada</button>
      <button class="filter-btn px-2.5 py-1 rounded-lg bg-[#18202e] text-[#94a3b8] border border-[#222f42] hover:text-[#f1f5f9] transition-all cursor-pointer" data-filter="#Botín">#Botín</button>
      <button class="filter-btn px-2.5 py-1 rounded-lg bg-[#18202e] text-[#94a3b8] border border-[#222f42] hover:text-[#f1f5f9] transition-all cursor-pointer" data-filter="#Descanso">#Descanso</button>
      <button class="filter-btn px-2.5 py-1 rounded-lg bg-[#18202e] text-[#94a3b8] border border-[#222f42] hover:text-[#f1f5f9] transition-all cursor-pointer" data-filter="#Magia">#Magia</button>
      <button class="filter-btn px-2.5 py-1 rounded-lg bg-[#18202e] text-[#94a3b8] border border-[#222f42] hover:text-[#f1f5f9] transition-all cursor-pointer" data-filter="#Configuración">#Configuración</button>
      <button class="filter-btn px-2.5 py-1 rounded-lg bg-[#18202e] text-[#94a3b8] border border-[#222f42] hover:text-[#f1f5f9] transition-all cursor-pointer" data-filter="#Hito">#Hito</button>
      <button class="filter-btn px-2.5 py-1 rounded-lg bg-[#18202e] text-[#94a3b8] border border-[#222f42] hover:text-[#f1f5f9] transition-all cursor-pointer" data-filter="#Privado">🔒 #Privado</button>
      <button class="filter-btn px-2.5 py-1 rounded-lg bg-[#18202e] text-[#94a3b8] border border-[#222f42] hover:text-[#f1f5f9] transition-all cursor-pointer" data-filter="#Pista">#Pista</button>
      <button class="filter-btn px-2.5 py-1 rounded-lg bg-[#18202e] text-[#94a3b8] border border-[#222f42] hover:text-[#f1f5f9] transition-all cursor-pointer" data-filter="#NPC">#NPC</button>
    </div>
  </div>

  <!-- NEW LOG ENTRY FORM (Wide Layout) -->
  <form class="p-4 sm:p-5 rounded-xl bg-[#18202e] border border-[#222f42] mb-6 shadow-sm space-y-3" id="new-entry-form">
    <div class="flex flex-wrap items-center justify-between gap-2">
      <span class="text-xs font-headline font-bold text-amber-400 uppercase tracking-wider flex items-center gap-1">
        <span class="material-symbols-outlined text-[16px]">edit_note</span>
        <span>Añadir Registro a la Bitácora</span>
      </span>
      <div class="flex items-center gap-1 flex-wrap" id="form-quick-tags">
        <button type="button" class="tag-insert-btn text-[10px] font-bold px-2 py-0.5 rounded bg-[#10141d] border border-amber-500/30 text-amber-300 hover:bg-amber-500 hover:text-[#0a0d12] transition-colors cursor-pointer" data-tag="#Hito">⭐ #Hito</button>
        <button type="button" class="tag-insert-btn text-[10px] font-bold px-2 py-0.5 rounded bg-[#10141d] border border-amber-500/30 text-amber-300 hover:bg-amber-500 hover:text-[#0a0d12] transition-colors cursor-pointer" data-tag="#Combate">#Combate</button>
        <button type="button" class="tag-insert-btn text-[10px] font-bold px-2 py-0.5 rounded bg-[#10141d] border border-amber-500/30 text-amber-300 hover:bg-amber-500 hover:text-[#0a0d12] transition-colors cursor-pointer" data-tag="#Botín">#Botín</button>
        <button type="button" class="tag-insert-btn text-[10px] font-bold px-2 py-0.5 rounded bg-[#10141d] border border-amber-500/30 text-amber-300 hover:bg-amber-500 hover:text-[#0a0d12] transition-colors cursor-pointer" data-tag="#Pista">#Pista</button>
        <button type="button" class="tag-insert-btn text-[10px] font-bold px-2 py-0.5 rounded bg-[#10141d] border border-amber-500/30 text-amber-300 hover:bg-amber-500 hover:text-[#0a0d12] transition-colors cursor-pointer" data-tag="#NPC">#NPC</button>
      </div>
    </div>

    <input
      type="text"
      id="entry-title-input"
      placeholder="Título o asunto del registro (ej: Descubrimiento en la cripta)"
      class="w-full text-xs font-body p-2.5 rounded-lg bg-[#10141d] border border-[#222f42] text-[#f1f5f9] placeholder:text-[#64748b] focus:outline-none focus:border-amber-500/60 focus:ring-1 focus:ring-amber-500/40"
    />

    <textarea
      id="entry-text-input"
      rows="2"
      placeholder="Detalles de la sesión, notas de combate, diálogos clave, rumores..."
      class="w-full text-xs font-body p-3 rounded-lg bg-[#10141d] border border-[#222f42] text-[#f1f5f9] placeholder:text-[#64748b] focus:outline-none focus:border-amber-500/60 focus:ring-1 focus:ring-amber-500/40 resize-none"
    ></textarea>

    <div class="flex items-center justify-between gap-3 pt-1 flex-wrap">
      <div class="flex items-center gap-3 flex-wrap">
        <label class="flex items-center gap-1.5 cursor-pointer text-xs text-[#cbd5e1] hover:text-[#f1f5f9]">
          <input type="checkbox" id="entry-private-check" class="rounded bg-[#10141d] border-[#222f42] text-amber-500 focus:ring-amber-500/40" />
          <span class="flex items-center gap-1 font-bold text-amber-400">
            <span>🔒</span>
            <span>Nota Privada (Solo mi personaje)</span>
          </span>
        </label>

        <label class="flex items-center gap-1.5 cursor-pointer text-xs text-[#94a3b8] hover:text-[#f1f5f9]">
          <input type="checkbox" id="entry-secret-check" class="rounded bg-[#10141d] border-[#222f42] text-amber-500 focus:ring-amber-500/40" />
          <span>Secreto DM</span>
        </label>
      </div>

      <button
        type="submit"
        class="px-4 py-2 rounded-lg bg-gradient-to-r from-amber-600 to-amber-500 text-[#0a0d12] text-xs font-bold shadow-[0_0_12px_rgba(245,158,11,0.3)] hover:brightness-110 active:scale-95 transition-all flex items-center gap-1.5 cursor-pointer"
      >
        <span class="material-symbols-outlined text-[16px]">send</span>
        <span>Guardar Entrada</span>
      </button>
    </div>
  </form>

  <!-- CHRONOLOGICAL FEED OF SESSION LOGS (2-COLUMN GRID) -->
  <div class="grid grid-cols-1 md:grid-cols-2 gap-4" id="journal-cards-feed">
    <!-- Populated by JavaScript -->
  </div>
</section>

<script>
  import { journalStore } from '../../scripts/state/journalStore';
  import { characterStore } from '../../scripts/state/characterStore';
  import { attachSwipeToDelete } from '../../scripts/ui/swipeToDelete';

  const feedContainer = document.getElementById('journal-cards-feed');
  const form = document.getElementById('new-entry-form') as HTMLFormElement;
  const titleInput = document.getElementById('entry-title-input') as HTMLInputElement;
  const textInput = document.getElementById('entry-text-input') as HTMLTextAreaElement;
  const secretCheck = document.getElementById('entry-secret-check') as HTMLInputElement;
  const privateCheck = document.getElementById('entry-private-check') as HTMLInputElement;
  let activeFilter = 'all';

  function renderFeed() {
    if (!feedContainer) return;
    feedContainer.innerHTML = '';

    const currentChar = characterStore.get();
    const entries = journalStore.getEntries(currentChar.id);
    const filtered = activeFilter === 'all'
      ? entries
      : entries.filter(e => e.tags.some(t => t.toLowerCase() === activeFilter.toLowerCase()) || (activeFilter === '#Privado' && e.isPrivate));

    if (filtered.length === 0) {
      feedContainer.innerHTML = `
        <div class="col-span-full py-8 text-center text-xs text-[#64748b]">
          No hay entradas registradas con el filtro <strong>${activeFilter}</strong>.
        </div>
      `;
      return;
    }

    filtered.forEach((entry) => {
      const wrapper = document.createElement('div');
      wrapper.className = 'relative rounded-xl overflow-hidden select-none bg-[#10141d] border border-[#222f42]';

      // Background trash revealed on swipe
      const swipeBg = document.createElement('div');
      swipeBg.className = 'swipe-delete-bg absolute inset-0 bg-gradient-to-l from-rose-600/60 via-rose-600/30 to-rose-950/20 flex items-center justify-end px-4 gap-1.5 text-rose-300 font-bold text-xs pointer-events-none opacity-0';
      swipeBg.innerHTML = `
        <span class="material-symbols-outlined text-[18px]">delete</span>
        <span class="text-[11px]">Eliminar</span>
      `;
      wrapper.appendChild(swipeBg);

      const isHito = entry.tags?.includes('#Hito');
      const isPrivate = entry.isPrivate;
      const card = document.createElement('div');
      card.className = `relative p-4 rounded-xl bg-[#18202e] border ${isHito ? 'border-amber-500/50 shadow-[0_0_15px_rgba(245,158,11,0.15)] bg-gradient-to-br from-[#1d2738] to-[#18202e]' : isPrivate ? 'border-amber-400/50 bg-[#192230]' : entry.isSecret ? 'border-purple-500/40' : 'border-[#222f42]/60'} hover:border-amber-500/60 transition-all flex flex-col justify-between gap-3 text-xs shadow-xs cursor-grab active:cursor-grabbing`;

      const tagsHtml = entry.tags.map(t => {
        let colorClass = 'bg-amber-500/20 text-amber-300 border-amber-500/30';
        if (t === '#Hito') colorClass = 'bg-amber-500/30 text-amber-200 border-amber-400 font-bold shadow-[0_0_8px_rgba(245,158,11,0.3)]';
        if (t === '#Combate') colorClass = 'bg-rose-500/20 text-rose-300 border-rose-500/30';
        if (t === '#Botín') colorClass = 'bg-emerald-500/20 text-emerald-300 border-emerald-500/30';
        if (t === '#NPC') colorClass = 'bg-sky-500/20 text-sky-300 border-sky-500/30';
        if (t === '#Tirada') colorClass = 'bg-fuchsia-500/20 text-fuchsia-300 border-fuchsia-500/30';
        if (t === '#Descanso') colorClass = 'bg-teal-500/20 text-teal-300 border-teal-500/30';
        if (t === '#Magia') colorClass = 'bg-indigo-500/20 text-indigo-300 border-indigo-500/30';
        if (t === '#Configuración') colorClass = 'bg-slate-500/20 text-slate-300 border-slate-500/30';
        if (t === '#Privado') colorClass = 'bg-amber-500/30 text-amber-300 border-amber-400 font-bold';
        return `<span class="px-2 py-0.5 rounded text-[10px] font-bold uppercase border ${colorClass}">${t}</span>`;
      }).join(' ');

      let diceBoxHtml = '';
      if (entry.diceRoll) {
        diceBoxHtml = `
          <div class="p-2 rounded-lg bg-[#10141d] border border-amber-500/30 flex items-center justify-between text-xs my-1">
            <span class="text-[#94a3b8]">${entry.diceRoll.formula}</span>
            <span class="font-headline font-bold text-amber-400 text-sm">Resultado: ${entry.diceRoll.result}</span>
          </div>
        `;
      }

      card.innerHTML = `
        <div>
          <div class="flex items-center justify-between gap-2 mb-2">
            <div class="flex items-center gap-1.5 flex-wrap">
              ${tagsHtml}
              ${entry.isPrivate ? '<span class="px-1.5 py-0.2 rounded bg-amber-500/20 text-amber-300 text-[9px] font-bold uppercase border border-amber-500/40 flex items-center gap-0.5">🔒 Solo Tú</span>' : ''}
              ${entry.isSecret ? `<span class="px-1.5 py-0.2 rounded bg-purple-500/20 text-purple-300 text-[9px] font-bold uppercase border border-purple-500/30">${entry.authorName === 'Dungeon Master' || !entry.characterId ? 'Secreto DM' : 'Tirada Secreta'}</span>` : ''}
            </div>
            <span class="text-[10px] text-[#64748b] shrink-0">${entry.timeAgoText || 'Sesión ' + entry.sessionNumber}</span>
          </div>

          <h4 class="font-headline font-bold text-[#f1f5f9] text-sm mb-1">${entry.title}</h4>
          <p class="text-[#cbd5e1] text-xs leading-relaxed">${entry.content}</p>
          ${diceBoxHtml}
        </div>

        <div class="flex items-center justify-between pt-2 border-t border-[#222f42]/60 text-[10px] text-[#64748b]">
          <span>Sesión ${entry.sessionNumber}</span>
          <button class="delete-entry-btn text-[#94a3b8] hover:text-rose-400 transition-colors cursor-pointer flex items-center gap-1" data-id="${entry.id}">
            <span class="material-symbols-outlined text-[13px]">delete</span>
            <span>Eliminar</span>
          </button>
        </div>
      `;

      const triggerJournalDelete = () => {
        window.dispatchEvent(new CustomEvent('open-delete-modal', {
          detail: {
            type: 'journal',
            id: entry.id,
            name: entry.title,
            category: `Sesión ${entry.sessionNumber}`,
            icon: 'edit_note',
            quantity: 1,
            title: '¿Eliminar entrada de bitácora?',
            subtitle: 'Confirmación de diario',
            onConfirm: () => {
              journalStore.deleteEntry(entry.id);
            }
          }
        }));
      };

      // Attach mobile swipe-to-delete gesture
      attachSwipeToDelete({
        card,
        container: wrapper,
        threshold: 60,
        onTrigger: triggerJournalDelete
      });

      card.querySelector('.delete-entry-btn')?.addEventListener('click', (e) => {
        e.stopPropagation();
        triggerJournalDelete();
      });

      wrapper.appendChild(card);
      feedContainer.appendChild(wrapper);
    });
  }

  // Filter Buttons
  document.querySelectorAll('#journal-filter-pills .filter-btn').forEach((btn) => {
    btn.addEventListener('click', () => {
      document.querySelectorAll('#journal-filter-pills .filter-btn').forEach(b => {
        b.className = 'filter-btn px-3 py-1 rounded-lg bg-[#18202e] text-[#94a3b8] border border-[#222f42] hover:text-[#f1f5f9] transition-all cursor-pointer';
      });
      btn.className = 'filter-btn active px-3 py-1 rounded-lg bg-amber-500/20 text-amber-300 border border-amber-500/40 font-bold transition-all cursor-pointer';
      activeFilter = btn.getAttribute('data-filter') || 'all';
      renderFeed();
    });
  });

  // Hashtag quick insert into text
  document.querySelectorAll('#form-quick-tags .tag-insert-btn').forEach((btn) => {
    btn.addEventListener('click', () => {
      const tag = btn.getAttribute('data-tag') || '';
      if (!textInput.value.includes(tag)) {
        textInput.value = `${tag} ${textInput.value}`.trim();
        textInput.focus();
      }
    });
  });

  // Form submit
  form?.addEventListener('submit', (e) => {
    e.preventDefault();
    const content = textInput.value.trim();
    if (!content) return;

    const title = titleInput.value.trim() || 'Apunte de Sesión';
    const isSecret = secretCheck?.checked || false;
    const isPrivate = privateCheck?.checked || false;
    const currentChar = characterStore.get();

    // Detect hashtags
    const foundTags = content.match(/#[a-zA-ZáéíóúÁÉÍÓÚñÑ]+/g) || ['#Pista'];
    if (isPrivate && !foundTags.includes('#Privado')) {
      foundTags.unshift('#Privado');
    }

    journalStore.addEntry({
      sessionNumber: currentChar?.sessionContext?.sessionNumber || 15,
      title,
      content,
      tags: Array.from(new Set(foundTags)),
      isSecret,
      isPrivate,
      characterId: currentChar.id,
      authorName: currentChar.name
    });

    titleInput.value = '';
    textInput.value = '';
    if (secretCheck) secretCheck.checked = false;
    if (privateCheck) privateCheck.checked = false;
  });

  renderFeed();

  window.addEventListener('journal-updated', () => {
    renderFeed();
  });

  window.addEventListener('character-updated', () => {
    renderFeed();
  });
</script>
