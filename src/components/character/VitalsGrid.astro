---
// src/components/character/VitalsGrid.astro
import CompatWarnings from './CompatWarnings.astro';
---

<div class="xl:col-span-8 flex flex-col gap-2.5 w-full">
  <!-- FILA 1: [ Vida (Puntos de Golpe) | Monedas ] -->
  <div class="grid grid-cols-1 lg:grid-cols-12 gap-2.5 w-full">
    <!-- Hit Points Panel (7 cols on lg) -->
    <div class="lg:col-span-7 rounded-xl bg-[#18202e] border border-[#222f42] p-3 sm:p-3.5 shadow-sm flex flex-col justify-between gap-2.5">
      <div class="flex flex-wrap items-center justify-between gap-2">
        <div class="flex items-center gap-2">
          <span class="material-symbols-outlined text-rose-500 text-[20px] drop-shadow-[0_0_6px_rgba(239,68,68,0.6)]">favorite</span>
          <div>
            <span class="text-[11px] font-bold uppercase tracking-wider text-[#94a3b8] block leading-none">Puntos de Golpe</span>
            <span id="hp-percentage-label" class="text-[10px] font-label font-semibold text-amber-400">87% Salud</span>
          </div>
        </div>

        <div class="flex items-center gap-2 ml-auto">
          <!-- Direct editable HP values -->
          <div class="text-right flex items-baseline gap-1 cursor-pointer hover:opacity-80 transition-opacity" id="hp-clickable-area" title="Haz clic para modificar tus PG manualmente">
            <span id="current-hp-num" class="text-xl sm:text-2xl font-headline font-bold text-[#f1f5f9]">42</span>
            <span class="text-xs font-label text-[#64748b]">/ <span id="max-hp-num">48</span> PG</span>
            <span id="temp-hp-badge" class="text-[10px] font-bold text-amber-300 bg-amber-500/20 border border-amber-500/40 px-1.5 py-0.5 rounded shadow-[0_0_8px_rgba(245,158,11,0.2)]">+5 Temp</span>
          </div>

          <!-- Quick heal/damage controls -->
          <div class="flex items-center gap-1 pl-2 border-l border-[#222f42]">
            <button id="hp-sub-5" class="w-6 h-6 sm:w-7 sm:h-7 rounded-lg bg-[#121721] border border-[#222f42] hover:border-rose-500/50 flex items-center justify-center text-[11px] font-bold text-rose-400 active:scale-90 transition-all cursor-pointer" title="Recibir 5 de daño">-5</button>
            <button id="hp-sub-1" class="w-6 h-6 sm:w-7 sm:h-7 rounded-lg bg-[#121721] border border-[#222f42] hover:border-rose-500/50 flex items-center justify-center text-[11px] font-bold text-rose-400 active:scale-90 transition-all cursor-pointer" title="Recibir 1 de daño">-1</button>
            <button id="hp-add-1" class="w-6 h-6 sm:w-7 sm:h-7 rounded-lg bg-[#121721] border border-[#222f42] hover:border-amber-500/50 flex items-center justify-center text-[11px] font-bold text-amber-400 active:scale-90 transition-all cursor-pointer" title="Curar 1 PG">+1</button>
            <button id="hp-add-5" class="w-6 h-6 sm:w-7 sm:h-7 rounded-lg bg-[#121721] border border-[#222f42] hover:border-amber-500/50 flex items-center justify-center text-[11px] font-bold text-amber-400 active:scale-90 transition-all cursor-pointer" title="Curar 5 PG">+5</button>
          </div>
        </div>
      </div>

      <!-- Health Progress Meter -->
      <div class="w-full bg-[#0a0d12] h-2.5 rounded-full overflow-hidden flex border border-[#222f42]">
        <div id="hp-progress-bar" class="bg-gradient-to-r from-rose-600 via-amber-600 to-amber-500 h-full transition-all duration-300 rounded-l-full shadow-[0_0_10px_rgba(245,158,11,0.5)]" style="width: 87.5%"></div>
        <div id="hp-temp-bar" class="bg-amber-400/80 h-full transition-all duration-300 rounded-r-full" style="width: 10.4%"></div>
      </div>
    </div>

    <!-- Monedero Compacto (5 cols on lg) -->
    <div
      id="section-currency"
      data-section-id="currency"
      class="lg:col-span-5 rounded-xl bg-[#18202e] border border-[#222f42] p-3 sm:p-3.5 shadow-sm flex flex-col justify-between gap-2"
    >
      <div class="flex items-center justify-between">
        <div class="flex items-center gap-1.5">
          <span class="material-symbols-outlined text-amber-500 text-[16px]">savings</span>
          <span class="text-[11px] font-bold uppercase tracking-wider text-[#94a3b8]">Monedas</span>
        </div>
        <button
          type="button"
          id="currency-edit-btn"
          class="text-[10px] text-amber-400 hover:text-amber-300 font-bold bg-amber-500/10 hover:bg-amber-500/20 px-2 py-0.5 rounded border border-amber-500/30 cursor-pointer transition-colors"
          title="Abrir gestor de monedas"
        >
          Editar
        </button>
      </div>

      <div
        class="grid grid-cols-5 gap-1.5 text-center font-label cursor-pointer"
        id="currency-display-grid"
        title="Haz clic para abrir el gestor de monedas"
      >
        <div class="py-1 px-1 rounded-lg bg-[#121721] border border-[#222f42] hover:border-amber-500/40 transition-colors">
          <span class="text-[9px] text-[#94a3b8] block leading-tight">PC</span>
          <span id="coin-cp" class="text-xs sm:text-sm font-headline font-bold text-amber-600">42</span>
        </div>
        <div class="py-1 px-1 rounded-lg bg-[#121721] border border-[#222f42] hover:border-amber-500/40 transition-colors">
          <span class="text-[9px] text-[#94a3b8] block leading-tight">PP</span>
          <span id="coin-sp" class="text-xs sm:text-sm font-headline font-bold text-slate-300">18</span>
        </div>
        <div class="py-1 px-1 rounded-lg bg-[#121721] border border-[#222f42] hover:border-amber-500/40 transition-colors">
          <span class="text-[9px] text-[#94a3b8] block leading-tight">PE</span>
          <span id="coin-ep" class="text-xs sm:text-sm font-headline font-bold text-cyan-400">5</span>
        </div>
        <div class="py-1 px-1 rounded-lg bg-amber-500/10 border border-amber-500/40 hover:border-amber-500 transition-colors">
          <span class="text-[9px] text-amber-400 font-bold block leading-tight">PO</span>
          <span id="coin-gp" class="text-xs sm:text-sm font-headline font-bold text-amber-400">135</span>
        </div>
        <div class="py-1 px-1 rounded-lg bg-[#121721] border border-[#222f42] hover:border-amber-500/40 transition-colors">
          <span class="text-[9px] text-[#94a3b8] block leading-tight">PPT</span>
          <span id="coin-pp" class="text-xs sm:text-sm font-headline font-bold text-purple-300">2</span>
        </div>
      </div>
    </div>
  </div>

  <!-- FILA 2: [ CA | Iniciativa | Sintonización ] -->
  <div class="grid grid-cols-2 lg:grid-cols-12 gap-2.5 w-full">
    <!-- Armor Class (3 cols on lg, 1 col on mobile) -->
    <div id="vitals-ac-card" role="button" tabindex="0" title="Ver desglose de la CA" class="col-span-1 lg:col-span-3 rounded-xl bg-[#18202e] border border-[#222f42] p-2.5 sm:p-3 flex items-center gap-2.5 shadow-sm hover:border-amber-500/40 transition-colors cursor-pointer">
      <div class="w-9 h-9 rounded-lg bg-amber-500/10 border border-amber-500/30 flex items-center justify-center shrink-0">
        <span class="material-symbols-outlined text-amber-400 text-[20px]">shield</span>
      </div>
      <div class="min-w-0 flex-1">
        <div class="flex items-baseline gap-1.5">
          <span id="vitals-ac-num" class="text-xl font-headline font-bold text-[#f1f5f9] leading-none">16</span>
          <span class="text-[10px] uppercase tracking-wider font-label font-bold text-[#94a3b8]">CA</span>
        </div>
        <span id="vitals-ac-note" class="text-[10px] text-amber-400/90 font-label block truncate mt-0.5">Cuero tach. + Escudo</span>
      </div>
    </div>

    <!-- Initiative (3 cols on lg, 1 col on mobile) -->
    <div
      class="col-span-1 lg:col-span-3 rounded-xl bg-[#18202e] border border-[#222f42] p-2.5 sm:p-3 flex items-center gap-2.5 shadow-sm hover:border-amber-500/40 transition-colors cursor-pointer group"
      id="vitals-init-card"
      title="Haz clic para tirar Iniciativa"
    >
      <div class="w-9 h-9 rounded-lg bg-amber-500/10 border border-amber-500/30 flex items-center justify-center shrink-0 group-hover:bg-amber-500/20 transition-colors">
        <span class="material-symbols-outlined text-amber-500 text-[20px]">bolt</span>
      </div>
      <div class="min-w-0 flex-1">
        <div class="flex items-baseline gap-1.5">
          <span id="vitals-init-num" class="text-xl font-headline font-bold text-amber-400 leading-none group-hover:scale-105 transition-transform">+3</span>
          <span class="text-[10px] uppercase tracking-wider font-label font-bold text-[#94a3b8]">Iniciativa</span>
        </div>
        <span class="text-[10px] text-[#64748b] font-label block truncate mt-0.5">Toca para tirar d20</span>
      </div>
    </div>

    <!-- Attunement / Sintonización (6 cols on lg, full width 2 cols on mobile so names are legible) -->
    <div class="col-span-2 lg:col-span-6 rounded-xl bg-[#18202e] border border-[#222f42] p-2.5 sm:p-3 flex flex-col justify-between gap-1.5 shadow-sm hover:border-amber-500/40 transition-colors">
      <div class="flex items-center justify-between gap-2">
        <div class="flex items-center gap-1.5">
          <span class="material-symbols-outlined text-amber-500 text-[15px]">stars</span>
          <span class="text-[10px] font-bold uppercase tracking-wider text-[#94a3b8]">Sintonizados</span>
          <span class="text-[9px] text-amber-400 font-bold bg-amber-500/10 px-1.5 py-0.2 rounded border border-amber-500/30" id="attuned-limit-badge">0 / 3</span>
        </div>
        <button
          type="button"
          id="attuned-config-btn"
          class="text-[10px] text-amber-400 hover:text-amber-300 font-bold bg-amber-500/10 hover:bg-amber-500/20 px-2 py-0.2 rounded border border-amber-500/30 flex items-center gap-1 cursor-pointer transition-colors"
          title="Configurar objetos mágicos sintonizados"
        >
          <span class="material-symbols-outlined text-[12px]">tune</span>
          <span>Configurar</span>
        </button>
      </div>

      <div
        class="grid grid-cols-1 sm:grid-cols-3 gap-1.5 text-[11px] font-label cursor-pointer"
        id="attuned-items-container"
        title="Haz clic para gestionar objetos sintonizados"
      >
        <!-- Populated by JS -->
      </div>
    </div>
  </div>

  <!-- Avisos de competencia y requisitos del equipo (Spec 08, Fase C) -->
  <CompatWarnings />

  <!-- FILA 3: [ Velocidad | Dados de Golpe y Descansos ] -->
  <div class="grid grid-cols-2 gap-2.5 w-full">
    <!-- Speed -->
    <div class="rounded-xl bg-[#18202e] border border-[#222f42] p-2.5 sm:p-3 flex items-center gap-2.5 shadow-sm hover:border-amber-500/40 transition-colors">
      <div class="w-9 h-9 rounded-lg bg-[#121721] border border-[#222f42] flex items-center justify-center shrink-0">
        <span class="material-symbols-outlined text-[#94a3b8] text-[20px]">directions_run</span>
      </div>
      <div class="min-w-0 flex-1">
        <div class="flex items-baseline gap-1">
          <span class="text-xl font-headline font-bold text-[#f1f5f9] leading-none" id="vitals-speed-num">30</span>
          <span class="text-[11px] font-normal text-[#94a3b8]">ft</span>
          <span class="text-[10px] uppercase tracking-wider font-label font-bold text-[#94a3b8] ml-1 hidden xs:inline">Velocidad</span>
        </div>
        <span id="vitals-speed-note" class="text-[10px] text-[#64748b] font-label block truncate mt-0.5">6 casillas</span>
      </div>
    </div>

    <!-- Hit Dice & Rest Mechanics -->
    <div class="rounded-xl bg-[#18202e] border border-[#222f42] p-2.5 sm:p-3 flex flex-wrap items-center justify-between gap-2 shadow-sm hover:border-amber-500/40 transition-colors">
      <div class="flex items-center gap-2 min-w-0">
        <div class="w-9 h-9 rounded-lg bg-amber-500/10 border border-amber-500/30 flex items-center justify-center shrink-0 hidden sm:flex">
          <span class="material-symbols-outlined text-[18px] text-amber-500">sports_kabaddi</span>
        </div>
        <div>
          <span class="text-[10px] font-bold uppercase tracking-wider text-[#94a3b8] block leading-none">Dados Golpe</span>
          <div class="flex items-baseline gap-1 mt-0.5">
            <span id="vitals-hitdice-display" class="text-base sm:text-lg font-headline font-bold text-[#f1f5f9] leading-none">5 / 5</span>
            <span id="vitals-hitdice-type" class="text-[11px] font-label text-amber-400 font-semibold">d10</span>
          </div>
        </div>
      </div>

      <div class="flex items-center gap-1 ml-auto">
        <button id="rest-short-btn" class="px-2 py-1 rounded-lg bg-[#121721] border border-[#222f42] hover:bg-[#222f42] text-[10px] font-bold text-[#cbd5e1] transition-colors cursor-pointer" title="Descanso Corto (gastar 1 Dado de Golpe)">Corto</button>
        <button id="rest-long-btn" class="px-2 py-1 rounded-lg bg-amber-500/20 border border-amber-500/40 hover:bg-amber-500/30 text-[10px] font-bold text-amber-300 transition-colors cursor-pointer" title="Descanso Largo (recuperar PG y recursos)">Largo</button>
      </div>
    </div>
  </div>
</div>

<script>
  import { showAlert, showConfirm, showForm } from '../../scripts/ui/notify';
  import { characterStore } from '../../scripts/state/characterStore';
  import { animateHpBar } from '../../scripts/animations/hpAnimations';
  import { openModal } from '../../scripts/animations/modalAnimations';
  import { MAX_ATTUNED } from '../../scripts/dnd/equipment';
  import { computeAc, getArmorClass } from '../../scripts/dnd/ac';

  const acCard = document.getElementById('vitals-ac-card');
  const openAcBreakdown = () => window.dispatchEvent(new CustomEvent('open-ac-breakdown-modal'));
  acCard?.addEventListener('click', openAcBreakdown);
  acCard?.addEventListener('keydown', (e) => { if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); openAcBreakdown(); } });

  const barEl = document.getElementById('hp-progress-bar');
  const tempBarEl = document.getElementById('hp-temp-bar');
  const numEl = document.getElementById('current-hp-num');
  const maxEl = document.getElementById('max-hp-num');
  const tempBadgeEl = document.getElementById('temp-hp-badge');
  const pctLabel = document.getElementById('hp-percentage-label');

  const attunedContainer = document.getElementById('attuned-items-container');
  const attunedBadge = document.getElementById('attuned-limit-badge');
  const attunedBtn = document.getElementById('attuned-config-btn');

  function updateHpUi(char: any) {
    if (!barEl || !numEl || !maxEl || !pctLabel) return;
    const current = char.hp.current;
    const max = char.hp.max;
    const temp = char.hp.temp || 0;

    numEl.textContent = String(current);
    maxEl.textContent = String(max);

    if (tempBadgeEl) {
      if (temp > 0) {
        tempBadgeEl.textContent = `+${temp} Temp`;
        tempBadgeEl.style.display = 'inline-block';
      } else {
        tempBadgeEl.style.display = 'none';
      }
    }

    const pct = Math.max(0, Math.min(100, Math.round((current / max) * 100)));
    pctLabel.textContent = `${pct}% Salud`;
    barEl.style.width = `${pct}%`;

    if (tempBarEl) {
      const tempPct = Math.min(100 - pct, Math.round((temp / max) * 100));
      tempBarEl.style.width = `${tempPct}%`;
    }
  }

  function renderCoins(char: any) {
    if (!char?.currency) return;
    const cp = document.getElementById('coin-cp');
    const sp = document.getElementById('coin-sp');
    const ep = document.getElementById('coin-ep');
    const gp = document.getElementById('coin-gp');
    const pp = document.getElementById('coin-pp');
    if (cp) cp.textContent = String(char.currency.cp);
    if (sp) sp.textContent = String(char.currency.sp);
    if (ep) ep.textContent = String(char.currency.ep);
    if (gp) gp.textContent = String(char.currency.gp);
    if (pp) pp.textContent = String(char.currency.pp);
  }

  function renderAttuned(char: any) {
    if (!attunedContainer) return;
    attunedContainer.replaceChildren();

    const items = (char?.inventory || []).filter((it: any) => it.attuned);
    if (attunedBadge) attunedBadge.textContent = `${items.length} / ${MAX_ATTUNED}`;

    for (let i = 0; i < MAX_ATTUNED; i++) {
      const item = items[i];
      const el = document.createElement('div');
      el.className = `py-1 px-2 rounded-lg bg-[#121721] border ${item ? 'border-amber-500/30 hover:border-amber-500/60' : 'border-dashed border-[#222f42] opacity-60'} flex items-center gap-1.5 text-[10px] transition-colors min-w-0`;

      const icon = document.createElement('span');
      icon.className = `material-symbols-outlined text-[13px] shrink-0 ${item ? 'text-amber-400' : 'text-[#64748b]'}`;
      icon.textContent = item ? (item.icon || 'stars') : 'lock_open';

      const name = document.createElement('span');
      name.className = `truncate ${item ? 'text-[#f1f5f9] font-medium' : 'text-[#64748b] italic'}`;
      name.textContent = item ? item.name : `Ranura ${i + 1}`;

      el.append(icon, name);
      attunedContainer.appendChild(el);
    }
  }

  function triggerCurrencyModal() {
    window.dispatchEvent(new CustomEvent('open-currency-modal'));
    const modal = document.getElementById('edit-currency-modal');
    const backdrop = document.getElementById('modal-backdrop');
    if (modal && backdrop) openModal(modal, backdrop);
  }

  const openAttunedModal = () => {
    window.dispatchEvent(new CustomEvent('open-attuned-modal'));
  };

  document.getElementById('currency-edit-btn')?.addEventListener('click', triggerCurrencyModal);
  document.getElementById('currency-display-grid')?.addEventListener('click', triggerCurrencyModal);
  attunedBtn?.addEventListener('click', openAttunedModal);
  attunedContainer?.addEventListener('click', openAttunedModal);

  // Quick modify buttons with smooth Anime.js
  document.getElementById('hp-sub-5')?.addEventListener('click', () => {
    const old = characterStore.get().hp.current;
    const res = characterStore.modifyHp(-5);
    if (barEl && numEl) animateHpBar(barEl, numEl, old, res.current, res.max);
  });
  document.getElementById('hp-sub-1')?.addEventListener('click', () => {
    const old = characterStore.get().hp.current;
    const res = characterStore.modifyHp(-1);
    if (barEl && numEl) animateHpBar(barEl, numEl, old, res.current, res.max);
  });
  document.getElementById('hp-add-1')?.addEventListener('click', () => {
    const old = characterStore.get().hp.current;
    const res = characterStore.modifyHp(1);
    if (barEl && numEl) animateHpBar(barEl, numEl, old, res.current, res.max);
  });
  document.getElementById('hp-add-5')?.addEventListener('click', () => {
    const old = characterStore.get().hp.current;
    const res = characterStore.modifyHp(5);
    if (barEl && numEl) animateHpBar(barEl, numEl, old, res.current, res.max);
  });

  // Manual HP edit
  document.getElementById('hp-clickable-area')?.addEventListener('click', async () => {
    const char = characterStore.get();
    const values = await showForm([
      { name: 'cur', label: 'Actuales', type: 'number', value: char.hp.current, min: 0 },
      { name: 'max', label: 'Máximos', type: 'number', value: char.hp.max, min: 1 },
      { name: 'temp', label: 'Temporales', type: 'number', value: char.hp.temp, min: 0 },
    ], { title: 'Puntos de Golpe', confirmText: 'Guardar' });
    if (values) {
      characterStore.setHp(Number(values.cur) || 0, Number(values.max) || char.hp.max, Number(values.temp) || 0);
    }
  });

  // Initiative click to roll
  document.getElementById('vitals-init-card')?.addEventListener('click', () => {
    window.dispatchEvent(new CustomEvent('open-dice-roller', {
      detail: {
        die: 20,
        count: 1,
        modifier: characterStore.get().initiativeBonus,
        label: 'Tirada de Iniciativa',
        tag: '#Combate'
      }
    }));
  });

  // Short and Long rest triggers
  document.getElementById('rest-short-btn')?.addEventListener('click', () => {
    const char = characterStore.get();
    if (char.hitDice.remaining <= 0) {
      showAlert('No te quedan Dados de Golpe disponibles para gastar. Necesitas un Descanso Largo.', { kind: 'warning' });
      return;
    }
    const res = characterStore.shortRest(1);
    showAlert(`¡Descanso Corto completado! Has gastado 1 Dado de Golpe y recuperado +${res.healed} PG.`, { kind: 'success', title: 'Descanso corto' });
  });

  document.getElementById('rest-long-btn')?.addEventListener('click', async () => {
    if (await showConfirm('Restaura todos tus PG al 100%, los espacios de conjuro y recupera dados de golpe.', { title: '¿Completar Descanso Largo?', confirmText: 'Descansar' })) {
      characterStore.longRest();
      showAlert(`¡Descanso Largo completado! Tus PG están al máximo (${characterStore.get().hp.max}/${characterStore.get().hp.max}) y tus recursos al 100%.`, { kind: 'success', title: 'Descanso largo' });
    }
  });

  function renderVitals(char: any) {
    if (!char) return;
    updateHpUi(char);
    renderCoins(char);
    renderAttuned(char);

    const acEl = document.getElementById('vitals-ac-num');
    const acNoteEl = document.getElementById('vitals-ac-note');
    const initEl = document.getElementById('vitals-init-num');
    const speedEl = document.getElementById('vitals-speed-num');
    const hdDispEl = document.getElementById('vitals-hitdice-display');
    const hdTypeEl = document.getElementById('vitals-hitdice-type');

    if (acEl) acEl.textContent = String(getArmorClass(char));
    // FD-9: la nota es libre; si está vacía se muestra la fórmula con la que se calculó.
    if (acNoteEl) acNoteEl.textContent = char.armorNote || (char.wildShape?.activeForm ? 'Forma salvaje' : computeAc(char).formula);
    if (initEl) initEl.textContent = `${char.initiativeBonus >= 0 ? '+' : ''}${char.initiativeBonus}`;
    if (speedEl) speedEl.textContent = String(char.speedFt);
    if (hdDispEl) hdDispEl.textContent = `${char.hitDice.remaining} / ${char.hitDice.total}`;
    if (hdTypeEl) hdTypeEl.textContent = char.hitDice.die;
  }

  // Hydrate immediately
  renderVitals(characterStore.get());

  // Sync with store updates
  window.addEventListener('character-updated', ((e: CustomEvent) => {
    renderVitals(e.detail.character);
  }) as EventListener);
</script>
