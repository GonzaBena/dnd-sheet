---
// src/components/character/SkillsList.astro
---

<div class="rounded-xl bg-[#121721] border border-[#222f42] p-4 shadow-sm">
  <div class="flex items-center justify-between mb-3">
    <h3 class="text-xs font-headline font-bold text-[#f1f5f9] uppercase tracking-wider flex items-center gap-1.5">
      <span class="material-symbols-outlined text-amber-500 text-[16px]">verified</span>
      <span>Habilidades Calculadas</span>
    </h3>
    
    <div class="flex items-center gap-2">
      <button
        type="button"
        id="open-skills-edit-btn"
        class="text-[10px] text-amber-400 hover:text-amber-300 font-bold bg-amber-500/10 hover:bg-amber-500/20 px-2.5 py-1 rounded-lg border border-amber-500/30 flex items-center gap-1 cursor-pointer transition-colors"
        title="Configurar competencias, pericias y bonos mágicos de habilidades"
      >
        <span class="material-symbols-outlined text-[13px]">tune</span>
        <span>Configurar</span>
      </button>
    </div>
  </div>

  <div class="space-y-1.5" id="skills-list-container">
    <!-- Populated and reactively refreshed via JavaScript -->
  </div>
</div>

<script>
  import { characterStore } from '../../scripts/state/characterStore';
  import { openModal } from '../../scripts/animations/modalAnimations';

  const listContainer = document.getElementById('skills-list-container');
  const configBtn = document.getElementById('open-skills-edit-btn');

  configBtn?.addEventListener('click', () => {
    window.dispatchEvent(new CustomEvent('open-skills-modal'));
    const modal = document.getElementById('edit-skills-modal');
    const backdrop = document.getElementById('modal-backdrop');
    if (modal && backdrop) openModal(modal, backdrop);
  });

  function renderSkills(char: any) {
    if (!listContainer) return;
    listContainer.innerHTML = '';

    char.skills.forEach((skill: any) => {
      const val = skill.value ?? 0;
      const modStr = val >= 0 ? `+${val}` : `${val}`;

      let badgeHtml = '';
      if (skill.expertise) {
        badgeHtml = `<span class="px-1.5 py-0.2 rounded bg-amber-500/20 text-amber-300 text-[9px] font-bold uppercase border border-amber-500/40">Pericia x2</span>`;
      } else if (skill.proficient) {
        badgeHtml = `<span class="px-1.5 py-0.2 rounded bg-[#10141d] text-emerald-400 text-[9px] font-semibold border border-emerald-500/30">Competente</span>`;
      }

      let bonusBadge = '';
      if (skill.customBonus && skill.customBonus !== 0) {
        bonusBadge = `<span class="px-1 py-0.2 rounded bg-cyan-500/20 text-cyan-300 text-[9px] font-mono border border-cyan-500/30" title="Bonificación de objeto o dote">${skill.customBonus >= 0 ? '+' : ''}${skill.customBonus} obj</span>`;
      }

      const row = document.createElement('div');
      row.className = 'p-2 rounded-lg bg-[#18202e] border border-[#222f42] hover:border-amber-500/40 flex items-center justify-between cursor-pointer active:scale-98 transition-all group';
      row.title = `Tirar prueba de ${skill.name} (${modStr}) • Clic derecho o Shift+Clic para Tirada Secreta`;
      row.innerHTML = `
        <div class="flex items-center gap-2">
          <span class="text-[10px] uppercase font-bold text-[#64748b] w-6">${skill.stat}</span>
          <span class="text-xs font-medium text-[#f1f5f9] group-hover:text-amber-300 transition-colors">${skill.name}</span>
          ${badgeHtml}
          ${bonusBadge}
        </div>
        <div class="flex items-center gap-2">
          <span class="font-headline font-bold text-sm ${skill.expertise ? 'text-amber-400' : 'text-[#f1f5f9]'}">${modStr}</span>
          <span class="material-symbols-outlined text-[14px] text-[#64748b] group-hover:text-amber-400 transition-colors">casino</span>
        </div>
      `;

      const triggerSkillRoll = (isSecret = false) => {
        window.dispatchEvent(new CustomEvent('open-dice-roller', {
          detail: {
            die: 20,
            count: 1,
            modifier: val,
            label: isSecret ? `Prueba Secreta de ${skill.name}` : `Prueba de ${skill.name}`,
            tag: isSecret ? '#Privado' : '#Tirada',
            isSecret
          }
        }));
      };

      row.addEventListener('click', (e) => {
        triggerSkillRoll(Boolean(e.shiftKey || e.altKey));
      });

      row.addEventListener('contextmenu', (e) => {
        e.preventDefault();
        triggerSkillRoll(true);
      });

      listContainer.appendChild(row);
    });
  }

  // Initial render
  renderSkills(characterStore.get());

  // Listen to updates
  window.addEventListener('character-updated', ((e: CustomEvent) => {
    renderSkills(e.detail.character);
  }) as EventListener);
</script>
