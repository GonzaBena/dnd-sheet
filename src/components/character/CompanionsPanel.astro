---
// src/components/character/CompanionsPanel.astro
// Panel de Compañeros, Monturas e Invocaciones del Personaje (Spec 13, H6 · RF-353).
---

<section
  id="companions-panel"
  class="rounded-xl bg-[#18202e]/70 border border-[#222f42] p-4 flex flex-col justify-between"
  aria-label="Compañeros e Invocaciones"
>
  <div class="flex items-center justify-between mb-3 border-b border-[#222f42] pb-2.5">
    <div class="flex items-center gap-2">
      <span class="material-symbols-outlined text-amber-500 text-[18px]">pets</span>
      <h3 class="text-xs font-headline font-bold text-[#f1f5f9] uppercase tracking-wider">
        Compañeros e Invocaciones
      </h3>
      <span id="companions-count" class="text-[10px] font-mono text-[#94a3b8] bg-[#10141d] px-2 py-0.5 rounded-full border border-[#222f42]">
        0
      </span>
    </div>
    <button
      type="button"
      id="btn-add-companion"
      class="inline-flex items-center gap-1 px-2.5 py-1 rounded-lg bg-amber-500/20 hover:bg-amber-500/30 text-amber-300 border border-amber-500/40 text-[11px] font-bold transition-all cursor-pointer active:scale-95 shadow-xs"
      title="Añadir familiar, montura o criatura invocada"
    >
      <span class="material-symbols-outlined text-[14px]">add</span>
      <span>Añadir</span>
    </button>
  </div>

  <!-- Contenedor de Tarjetas de Compañeros -->
  <div id="companions-list" class="space-y-3">
    <!-- Generado dinámicamente -->
  </div>
</section>

<!-- Modal de Añadir / Editar Compañero -->
<div
  id="companion-edit-modal"
  class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/80 backdrop-blur-xs hidden"
  role="dialog"
  aria-modal="true"
  aria-labelledby="companion-modal-title"
>
  <div class="w-full max-w-md rounded-2xl bg-[#141a24] border border-[#222f42] shadow-2xl p-5 space-y-4 text-left animate-in fade-in zoom-in-95 duration-150">
    <div class="flex items-center justify-between border-b border-[#222f42] pb-3">
      <div class="flex items-center gap-2">
        <span class="material-symbols-outlined text-amber-400 text-xl">pets</span>
        <h3 id="companion-modal-title" class="text-sm font-bold text-[#f1f5f9]">
          Nuevo Compañero o Invocación
        </h3>
      </div>
      <button
        type="button"
        id="companion-modal-close"
        class="w-7 h-7 rounded-lg bg-[#18202e] border border-[#222f42] text-[#94a3b8] hover:text-[#f1f5f9] flex items-center justify-center text-xs cursor-pointer"
      >
        ✕
      </button>
    </div>

    <form id="companion-form" class="space-y-3 text-xs">
      <input type="hidden" id="comp-form-id" value="" />

      <!-- Nombre -->
      <div>
        <label class="block text-[11px] font-bold text-[#cbd5e1] mb-1">Nombre</label>
        <input
          type="text"
          id="comp-form-name"
          required
          placeholder="ej. Archimedes, Corcel Celestial, Lobo Espiritual"
          class="w-full px-3 py-2 rounded-lg bg-[#10141d] border border-[#222f42] text-[#f1f5f9] placeholder-[#64748b] focus:border-amber-500 focus:outline-hidden"
        />
      </div>

      <!-- Tipo y Tamaño -->
      <div class="grid grid-cols-2 gap-3">
        <div>
          <label class="block text-[11px] font-bold text-[#cbd5e1] mb-1">Tipo de Criatura</label>
          <select
            id="comp-form-type"
            class="w-full px-2.5 py-2 rounded-lg bg-[#10141d] border border-[#222f42] text-[#f1f5f9] focus:border-amber-500 focus:outline-hidden cursor-pointer"
          >
            <option value="familiar">Familiar</option>
            <option value="mount">Montura</option>
            <option value="companion">Compañero Animal</option>
            <option value="summon">Invocación / Espíritu</option>
            <option value="sidekick">Acompañante</option>
          </select>
        </div>
        <div>
          <label class="block text-[11px] font-bold text-[#cbd5e1] mb-1">Tamaño en Grilla</label>
          <select
            id="comp-form-size"
            class="w-full px-2.5 py-2 rounded-lg bg-[#10141d] border border-[#222f42] text-[#f1f5f9] focus:border-amber-500 focus:outline-hidden cursor-pointer"
          >
            <option value="1">1x1 (Mediano / Pequeño)</option>
            <option value="2">2x2 (Grande / Caballo)</option>
            <option value="3">3x3 (Enorme)</option>
            <option value="4">4x4 (Gigantesco)</option>
          </select>
        </div>
      </div>

      <!-- PG, CA y Velocidad -->
      <div class="grid grid-cols-3 gap-3">
        <div>
          <label class="block text-[11px] font-bold text-[#cbd5e1] mb-1">PG Máximos</label>
          <input
            type="number"
            id="comp-form-hp-max"
            min="1"
            value="10"
            required
            class="w-full px-3 py-2 rounded-lg bg-[#10141d] border border-[#222f42] text-[#f1f5f9] font-mono focus:border-amber-500 focus:outline-hidden"
          />
        </div>
        <div>
          <label class="block text-[11px] font-bold text-[#cbd5e1] mb-1">CA</label>
          <input
            type="number"
            id="comp-form-ac"
            min="1"
            placeholder="11"
            class="w-full px-3 py-2 rounded-lg bg-[#10141d] border border-[#222f42] text-[#f1f5f9] font-mono focus:border-amber-500 focus:outline-hidden"
          />
        </div>
        <div>
          <label class="block text-[11px] font-bold text-[#cbd5e1] mb-1">Velocidad (ft)</label>
          <input
            type="number"
            id="comp-form-speed"
            min="0"
            step="5"
            placeholder="30"
            class="w-full px-3 py-2 rounded-lg bg-[#10141d] border border-[#222f42] text-[#f1f5f9] font-mono focus:border-amber-500 focus:outline-hidden"
          />
        </div>
      </div>

      <!-- Notas o habilidades -->
      <div>
        <label class="block text-[11px] font-bold text-[#cbd5e1] mb-1">Notas, Habilidades o Ataques</label>
        <textarea
          id="comp-form-notes"
          rows="2"
          placeholder="ej. Vuelo 60 ft, ventaja en Percepción, ataque +4 (1d6+2)"
          class="w-full px-3 py-2 rounded-lg bg-[#10141d] border border-[#222f42] text-[#f1f5f9] placeholder-[#64748b] focus:border-amber-500 focus:outline-hidden resize-none"
        ></textarea>
      </div>

      <div class="pt-3 border-t border-[#222f42] flex items-center justify-between">
        <button
          type="button"
          id="comp-form-delete-btn"
          class="hidden px-3 py-1.5 rounded-lg bg-rose-500/15 hover:bg-rose-500/25 text-rose-300 border border-rose-500/30 font-bold transition-all cursor-pointer"
        >
          Eliminar
        </button>
        <div class="flex items-center gap-2 ml-auto">
          <button
            type="button"
            id="comp-form-cancel-btn"
            class="px-3 py-1.5 rounded-lg bg-[#18202e] hover:bg-[#222f42] text-[#94a3b8] hover:text-[#f1f5f9] font-bold transition-all cursor-pointer"
          >
            Cancelar
          </button>
          <button
            type="submit"
            class="px-4 py-1.5 rounded-lg bg-amber-500 hover:bg-amber-400 text-[#0f141c] font-bold transition-all cursor-pointer shadow-md"
          >
            Guardar
          </button>
        </div>
      </div>
    </form>
  </div>
</div>

<script>
  import { characterStore } from '../../scripts/state/characterStore.ts';
  import { campaignStore } from '../../scripts/state/campaignStore.ts';
  import { userStore } from '../../scripts/state/userStore.ts';
  import { addToken, listMaps } from '../../scripts/data/mapService.ts';
  import { buildCompanionToken, newTokenId } from '../../scripts/vtt/tokens.ts';
  import { showAlert } from '../../scripts/ui/notify.ts';
  import type { CharacterCompanion, CompanionType } from '../../scripts/models/character.ts';

  const panel = document.getElementById('companions-panel');
  const listEl = document.getElementById('companions-list');
  const countEl = document.getElementById('companions-count');
  const addBtn = document.getElementById('btn-add-companion');

  // Modal elements
  const modal = document.getElementById('companion-edit-modal');
  const modalClose = document.getElementById('companion-modal-close');
  const modalTitle = document.getElementById('companion-modal-title');
  const form = document.getElementById('companion-form') as HTMLFormElement | null;
  const formId = document.getElementById('comp-form-id') as HTMLInputElement | null;
  const formName = document.getElementById('comp-form-name') as HTMLInputElement | null;
  const formType = document.getElementById('comp-form-type') as HTMLSelectElement | null;
  const formSize = document.getElementById('comp-form-size') as HTMLSelectElement | null;
  const formHpMax = document.getElementById('comp-form-hp-max') as HTMLInputElement | null;
  const formAc = document.getElementById('comp-form-ac') as HTMLInputElement | null;
  const formSpeed = document.getElementById('comp-form-speed') as HTMLInputElement | null;
  const formNotes = document.getElementById('comp-form-notes') as HTMLTextAreaElement | null;
  const deleteBtn = document.getElementById('comp-form-delete-btn');
  const cancelBtn = document.getElementById('comp-form-cancel-btn');

  const TYPE_LABELS: Record<CompanionType, { label: string; icon: string; color: string }> = {
    familiar: { label: 'Familiar', icon: 'visibility', color: 'text-indigo-400 bg-indigo-500/15 border-indigo-500/30' },
    mount: { label: 'Montura', icon: 'cruelty_free', color: 'text-amber-400 bg-amber-500/15 border-amber-500/30' },
    companion: { label: 'Compañero Animal', icon: 'pets', color: 'text-emerald-400 bg-emerald-500/15 border-emerald-500/30' },
    summon: { label: 'Invocación', icon: 'auto_awesome', color: 'text-cyan-400 bg-cyan-500/15 border-cyan-500/30' },
    sidekick: { label: 'Acompañante', icon: 'shield_person', color: 'text-purple-400 bg-purple-500/15 border-purple-500/30' },
  };

  const SIZE_LABELS: Record<number, string> = {
    1: 'Mediano (1x1)',
    2: 'Grande (2x2)',
    3: 'Enorme (3x3)',
    4: 'Gigantesco (4x4)',
  };

  function openModal(companion?: CharacterCompanion) {
    if (!modal) return;
    if (companion) {
      if (modalTitle) modalTitle.textContent = `Editar ${companion.name}`;
      if (formId) formId.value = companion.id;
      if (formName) formName.value = companion.name;
      if (formType) formType.value = companion.type;
      if (formSize) formSize.value = String(companion.size || 1);
      if (formHpMax) formHpMax.value = String(companion.hp?.max || 10);
      if (formAc) formAc.value = companion.armorClass ? String(companion.armorClass) : '';
      if (formSpeed) formSpeed.value = companion.speedFt ? String(companion.speedFt) : '';
      if (formNotes) formNotes.value = companion.notes || '';
      if (deleteBtn) deleteBtn.classList.remove('hidden');
    } else {
      if (modalTitle) modalTitle.textContent = 'Nuevo Compañero o Invocación';
      if (formId) formId.value = '';
      if (formName) formName.value = '';
      if (formType) formType.value = 'familiar';
      if (formSize) formSize.value = '1';
      if (formHpMax) formHpMax.value = '10';
      if (formAc) formAc.value = '11';
      if (formSpeed) formSpeed.value = '30';
      if (formNotes) formNotes.value = '';
      if (deleteBtn) deleteBtn.classList.add('hidden');
    }
    modal.classList.remove('hidden');
  }

  function closeModal() {
    if (modal) modal.classList.add('hidden');
  }

  addBtn?.addEventListener('click', () => openModal());
  modalClose?.addEventListener('click', closeModal);
  cancelBtn?.addEventListener('click', closeModal);

  deleteBtn?.addEventListener('click', () => {
    const id = formId?.value;
    if (id && confirm('¿Eliminar este compañero o invocación?')) {
      characterStore.removeCompanion(id);
      closeModal();
    }
  });

  form?.addEventListener('submit', (e) => {
    e.preventDefault();
    const id = formId?.value;
    const name = formName?.value.trim() || 'Compañero';
    const type = (formType?.value || 'familiar') as CompanionType;
    const size = parseInt(formSize?.value || '1', 10) as 1 | 2 | 3 | 4;
    const maxHp = parseInt(formHpMax?.value || '10', 10);
    const armorClass = formAc?.value ? parseInt(formAc.value, 10) : undefined;
    const speedFt = formSpeed?.value ? parseInt(formSpeed.value, 10) : undefined;
    const notes = formNotes?.value.trim() || undefined;

    if (id) {
      characterStore.updateCompanion(id, {
        name,
        type,
        size,
        hp: { current: maxHp, max: maxHp },
        armorClass,
        speedFt,
        notes,
      });
    } else {
      characterStore.addCompanion({
        name,
        type,
        size,
        hp: { current: maxHp, max: maxHp },
        armorClass,
        speedFt,
        notes,
      });
    }
    closeModal();
  });

  function renderCompanions() {
    if (!listEl) return;
    const companions = characterStore.getCompanions();

    if (countEl) {
      countEl.textContent = String(companions.length);
    }

    listEl.innerHTML = '';

    if (companions.length === 0) {
      listEl.innerHTML = `
        <div class="p-4 rounded-xl bg-[#10141d]/70 border border-dashed border-[#222f42] text-center text-xs text-[#64748b] italic">
          No tienes compañeros, monturas ni criaturas invocadas. Haz clic en "Añadir" para registrar una.
        </div>
      `;
      return;
    }

    companions.forEach((comp) => {
      const typeInfo = TYPE_LABELS[comp.type] || TYPE_LABELS.companion;
      const sizeStr = SIZE_LABELS[comp.size] || SIZE_LABELS[1];
      const curHp = comp.hp?.current ?? comp.hp?.max ?? 1;
      const maxHp = comp.hp?.max ?? 1;
      const hpPct = Math.max(0, Math.min(100, Math.round((curHp / maxHp) * 100)));

      const card = document.createElement('div');
      card.className = 'p-3 rounded-xl bg-[#10141d] border border-[#222f42] hover:border-slate-600 transition-all space-y-2.5';
      card.innerHTML = `
        <div class="flex items-start justify-between gap-2">
          <div class="min-w-0">
            <div class="flex items-center gap-1.5 flex-wrap">
              <span class="text-xs font-bold text-[#f1f5f9] truncate">${comp.name}</span>
              <span class="px-1.5 py-0.5 rounded text-[9px] font-bold border flex items-center gap-1 ${typeInfo.color}">
                <span class="material-symbols-outlined text-[11px]">${typeInfo.icon}</span>
                <span>${typeInfo.label}</span>
              </span>
              <span class="px-1.5 py-0.5 rounded text-[9px] font-mono text-[#94a3b8] bg-[#18202e] border border-[#222f42]">
                ${sizeStr}
              </span>
            </div>
          </div>
          <button
            type="button"
            class="comp-edit-btn text-[#94a3b8] hover:text-[#f1f5f9] p-1 rounded hover:bg-[#18202e] transition-colors cursor-pointer"
            title="Editar compañero"
          >
            <span class="material-symbols-outlined text-[15px]">edit</span>
          </button>
        </div>

        <!-- Barra y Controles Rápidos de PG -->
        <div class="space-y-1">
          <div class="flex items-center justify-between text-[11px] font-mono">
            <span class="text-[#94a3b8] font-bold">Puntos de Golpe</span>
            <div class="flex items-center gap-1 font-bold">
              <span class="${curHp <= maxHp / 2 ? 'text-rose-400' : 'text-emerald-400'}">${curHp}</span>
              <span class="text-[#64748b]">/</span>
              <span class="text-[#cbd5e1]">${maxHp}</span>
            </div>
          </div>
          <div class="h-2 rounded-full bg-[#18202e] overflow-hidden border border-[#222f42]/80">
            <div
              class="h-full transition-all duration-300 ${
                hpPct <= 25 ? 'bg-rose-500' : hpPct <= 50 ? 'bg-amber-500' : 'bg-emerald-500'
              }"
              style="width: ${hpPct}%"
            ></div>
          </div>
          <div class="flex items-center justify-between pt-1">
            <div class="flex items-center gap-1">
              <button type="button" class="comp-hp-sub-btn px-2 py-0.5 rounded bg-[#18202e] hover:bg-rose-500/20 text-rose-300 text-xs font-mono font-bold border border-[#222f42] cursor-pointer flex items-center justify-center" title="Dañar compañero">
                <span class="material-symbols-outlined text-[13px]">remove</span>
              </button>
              <button type="button" class="comp-hp-add-btn px-2 py-0.5 rounded bg-[#18202e] hover:bg-emerald-500/20 text-emerald-300 text-xs font-mono font-bold border border-[#222f42] cursor-pointer flex items-center justify-center" title="Curar compañero">
                <span class="material-symbols-outlined text-[13px]">add</span>
              </button>
            </div>
            <div class="flex items-center gap-2 text-[10px] text-[#94a3b8] font-mono">
              ${comp.armorClass ? `<span>CA: <strong class="text-amber-300">${comp.armorClass}</strong></span>` : ''}
              ${comp.speedFt ? `<span>Vel: <strong class="text-slate-300">${comp.speedFt} ft</strong></span>` : ''}
            </div>
          </div>
        </div>

        ${
          comp.notes
            ? `<p class="text-[11px] text-[#94a3b8] bg-[#141a24] p-2 rounded-lg border border-[#222f42]/60 italic font-sans">${comp.notes}</p>`
            : ''
        }

        <!-- Despliegue en Mapa -->
        <div class="pt-2 border-t border-[#222f42]/60 flex items-center justify-between text-[11px]">
          <div class="flex items-center gap-1.5">
            <span class="material-symbols-outlined text-[15px] ${isDeployed ? 'text-emerald-400' : 'text-[#64748b]'}">
              ${isDeployed ? 'check_circle' : 'location_off'}
            </span>
            <span class="text-[10px] ${isDeployed ? 'text-emerald-300 font-bold' : 'text-[#94a3b8]'}">
              ${isDeployed ? 'En mapa activo' : 'Fuera del mapa'}
            </span>
          </div>
          <button
            type="button"
            class="comp-map-btn inline-flex items-center gap-1 px-2.5 py-1 rounded-lg text-[10px] font-bold ${
              isDeployed
                ? 'bg-[#18202e] hover:bg-[#222f42] text-[#cbd5e1] border border-[#222f42]'
                : 'bg-amber-500/15 hover:bg-amber-500/25 text-amber-300 border border-amber-500/30 active:scale-95'
            } transition-all cursor-pointer"
          >
            <span class="material-symbols-outlined text-[13px]">${isDeployed ? 'my_location' : 'add_location_alt'}</span>
            <span>${isDeployed ? 'Centrar' : 'Desplegar en mapa'}</span>
          </button>
        </div>
      `;

      // Eventos de edición y PG
      card.querySelector('.comp-edit-btn')?.addEventListener('click', () => openModal(comp));
      card.querySelector('.comp-hp-sub-btn')?.addEventListener('click', () => {
        const valStr = prompt(`¿Cuántos puntos de daño recibe ${comp.name}?`);
        if (!valStr) return;
        const amount = parseInt(valStr.trim(), 10);
        if (!isNaN(amount) && amount > 0) {
          characterStore.updateCompanion(comp.id, { hp: { current: Math.max(0, curHp - amount), max: maxHp } });
        }
      });
      card.querySelector('.comp-hp-add-btn')?.addEventListener('click', () => {
        const valStr = prompt(`¿Cuántos puntos se cura ${comp.name}?`);
        if (!valStr) return;
        const amount = parseInt(valStr.trim(), 10);
        if (!isNaN(amount) && amount > 0) {
          characterStore.updateCompanion(comp.id, { hp: { current: Math.min(maxHp, curHp + amount), max: maxHp } });
        }
      });

      card.querySelector('.comp-map-btn')?.addEventListener('click', async () => {
        const curCid = campaignStore.getActiveCampaignId();
        const curCamp = curCid ? campaignStore.getCampaign(curCid) : null;
        const activeMapId = curCamp?.activeMapId;
        const char = characterStore.get();
        const currentUser = userStore.getCurrentUser();

        if (isDeployed) {
          window.dispatchEvent(new CustomEvent('map-center-token', { detail: { tid: comp.tokenId } }));
          return;
        }

        if (!curCid || !activeMapId) {
          showAlert('No hay un mapa táctico activo en la campaña para colocar la miniatura. Pide al DM que active un mapa.', { title: 'Sin Mapa Activo' });
          return;
        }

        const isDm = Boolean(curCamp && (curCamp.dmId === currentUser?.id || campaignStore.isCurrentUserDm(curCid)));
        const isLocal = !campaignStore.isCloudMode();

        if (isDm || isLocal) {
          try {
            const token = buildCompanionToken(
              comp,
              { id: char.id, name: char.name },
              char.userId || currentUser?.id || '',
              { x: 200, y: 200 }
            );
            const tid = newTokenId();
            await addToken(curCid, activeMapId, token, tid);
            characterStore.linkCompanionToken(comp.id, tid);
            renderCompanions();
            showAlert(`Miniatura de "${comp.name}" desplegada con éxito en el mapa táctico.`, { title: 'Miniatura Desplegada' });
          } catch (err: any) {
            console.error('[CompanionsPanel] Error desplegando miniatura:', err);
            showAlert(err?.message || 'Error al desplegar en el mapa.', { title: 'Error' });
          }
        } else {
          showAlert(
            `"${comp.name}" está registrado en tu ficha. En partidas online sincronizadas, el DM coloca la miniatura inicial desde su Grimorio (Gestor de Miniaturas). En cuanto la coloque, ¡podrás moverla en vivo por el mapa!`,
            { title: 'Despliegue por el DM' }
          );
        }
      });

      listEl.appendChild(card);
    });
  }

  // Escuchar cambios de la ficha
  window.addEventListener('character-updated', renderCompanions);
  window.addEventListener('character-loaded', renderCompanions);
  renderCompanions();
</script>
