---
// src/components/character/ResourcesSection.astro
// UI compacta de Bendiciones, Cargas y Recursos (Spec 07, Fase E: FE-8).
---

<section id="resources-section" class="rounded-xl bg-[#18202e]/70 border border-[#222f42] p-3 flex flex-col justify-between" aria-label="Bendiciones y Recursos">
  <div class="flex items-center justify-between mb-1.5">
    <h3 class="text-[10px] font-headline font-bold text-[#94a3b8] uppercase tracking-wider flex items-center gap-1">
      <span class="material-symbols-outlined text-amber-500 text-[14px]">flare</span>
      <span>Bendiciones y Recursos</span>
    </h3>
    <button
      type="button"
      id="resource-new-btn"
      class="text-[10px] text-amber-400 hover:text-amber-300 font-bold bg-amber-500/10 hover:bg-amber-500/20 px-2 py-0.5 rounded-lg border border-amber-500/30 cursor-pointer transition-colors"
    >
      + Añadir
    </button>
  </div>
  <div id="resources-list" class="grid grid-cols-1 sm:grid-cols-2 gap-2.5"></div>
</section>

<script>
  import { characterStore } from '../../scripts/state/characterStore';
  import { remaining } from '../../scripts/dnd/resources';
  import { showForm, showConfirm } from '../../scripts/ui/notify';
  import type { Resource } from '../../scripts/models/resource';

  const list = document.getElementById('resources-list');

  function btn(label: string, title: string, onClick: () => void, extra = ''): HTMLButtonElement {
    const b = document.createElement('button');
    b.type = 'button';
    b.title = title;
    b.setAttribute('aria-label', title);
    b.textContent = label;
    b.className = `w-6 h-6 rounded-lg bg-[#10141d] border border-[#222f42] hover:border-amber-500/40 text-[#cbd5e1] hover:text-[#f1f5f9] text-xs font-bold leading-none cursor-pointer flex items-center justify-center active:scale-95 transition-all ${extra}`;
    b.addEventListener('click', onClick);
    return b;
  }

  function render(char: { resources?: Resource[] }) {
    if (!list) return;
    // La Forma Salvaje tiene su propio panel.
    const resources = (char.resources ?? []).filter((r) => r.source !== 'wildShape');
    list.replaceChildren();
    if (!resources.length) {
      const empty = document.createElement('p');
      empty.className = 'text-[11px] text-[#64748b] italic py-0.5 col-span-full';
      empty.textContent = 'Sin bendiciones ni cargas. Usa "+ Añadir" para crear una.';
      list.appendChild(empty);
      return;
    }
    for (const r of resources) {
      const row = document.createElement('div');
      row.className = 'flex items-center justify-between gap-2.5 px-3 py-2 rounded-xl bg-[#121721] border border-[#222f42] text-xs hover:border-amber-500/30 transition-colors';

      const leftCol = document.createElement('div');
      leftCol.className = 'flex items-center gap-2 min-w-0 flex-1';

      const name = document.createElement('span');
      name.className = 'truncate font-bold text-[#f1f5f9]';
      name.textContent = r.name;
      leftCol.appendChild(name);

      if (Array.isArray(r.values) && r.values.length > 0) {
        const valuesWrap = document.createElement('div');
        valuesWrap.className = 'flex items-center gap-1.5 shrink-0';
        for (let i = 0; i < r.values.length; i++) {
          const val = r.values[i];
          const chip = document.createElement('button');
          chip.type = 'button';
          chip.className = 'px-2 py-0.5 rounded-lg bg-purple-500/25 text-purple-200 border border-purple-500/40 font-mono font-bold text-[10px] hover:bg-purple-500/40 cursor-pointer active:scale-95 transition-all shadow-xs';
          chip.textContent = `[${val}]`;
          chip.title = `Clic para gastar el dado guardado [${val}]`;
          chip.addEventListener('click', async () => {
            if (await showConfirm(`¿Gastar el dado guardado [${val}] de "${r.name}" para sustituir una tirada?`, { title: 'Usar Dado Guardado', confirmText: 'Usar dado' })) {
              characterStore.consumePortentDie(r.id, { index: i });
            }
          });
          valuesWrap.appendChild(chip);
        }
        leftCol.appendChild(valuesWrap);
      }

      const rightControls = document.createElement('div');
      rightControls.className = 'flex items-center gap-1.5 shrink-0 ml-auto';

      const count = document.createElement('span');
      count.className = 'font-mono text-[11px] font-bold text-amber-300 px-2 py-0.5 rounded-md bg-[#10141d] border border-[#222f42] shrink-0';
      count.textContent = `${remaining(r)}/${r.max}`;
      count.title = `Quedan ${remaining(r)} de ${r.max} (usados: ${r.used})`;

      rightControls.append(
        count,
        btn('−', 'Gastar 1', () => characterStore.spendResource(r.id, 1)),
        btn('+', 'Recuperar 1', () => characterStore.recoverResource(r.id, 1)),
        btn('×', 'Borrar bendición o recurso', async () => {
          if (await showConfirm(`¿Borrar "${r.name}"?`, { danger: true, confirmText: 'Borrar' })) {
            characterStore.removeResource(r.id);
          }
        }, 'hover:text-rose-400 hover:border-rose-500/40')
      );

      row.append(leftCol, rightControls);
      list.appendChild(row);
    }
  }

  document.getElementById('resource-new-btn')?.addEventListener('click', async () => {
    const values = await showForm(
      [
        { name: 'name', label: 'Nombre (Bendición, Don o Recurso)', type: 'text', required: true, placeholder: 'Bendición del Alba / Portento' },
        { name: 'max', label: 'Usos o Cargas Máximas', type: 'number', value: '1', min: 1, required: true },
        {
          name: 'rechargeOn',
          label: 'Se reinicia con',
          type: 'select',
          value: 'longRest',
          options: [
            { value: 'longRest', label: 'Descanso largo' },
            { value: 'shortRest', label: 'Descanso corto' },
            { value: 'turn', label: 'Cada turno' },
            { value: 'manual', label: 'Manual' },
          ],
        },
        {
          name: 'dieType',
          label: 'Dados Guardados (Opcional, ej. Portento)',
          type: 'select',
          value: 'none',
          options: [
            { value: 'none', label: 'Ninguno (contador estándar)' },
            { value: 'd20', label: 'd20 (Portento de Adivinación)' },
            { value: 'd12', label: 'd12' },
            { value: 'd10', label: 'd10' },
            { value: 'd8', label: 'd8' },
            { value: 'd6', label: 'd6' },
          ],
        },
      ],
      { title: 'Nueva Bendición o Recurso', confirmText: 'Crear' }
    );
    if (!values) return;
    const name = values.name.trim();
    const max = parseInt(values.max, 10);
    if (!name || !(max > 0)) return;
    const dieType = values.dieType && values.dieType !== 'none' ? values.dieType : undefined;
    characterStore.addResource({
      name,
      max,
      rechargeOn: values.rechargeOn as Resource['rechargeOn'],
      dieType,
    });
  });

  render(characterStore.get());
  window.addEventListener('character-updated', ((e: CustomEvent) => render(e.detail.character)) as EventListener);
</script>
