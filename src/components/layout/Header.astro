---
import AlertPrefsMenu from './AlertPrefsMenu.astro';
---

<header class="fixed top-0 w-full z-40 bg-[#0a0d12]/95 backdrop-blur-xl border-b border-[#222f42] shadow-[0_4px_25px_rgba(0,0,0,0.6)]">
  <div class="max-w-7xl mx-auto px-3 sm:px-6 lg:px-8 py-2 flex items-center justify-between gap-2">
    <!-- Brand / Title (Icon-only on mobile/tablet to leave full room for the single-row HUD) -->
    <a href="/" data-app-title-link class="relative z-10 touch-manipulation min-h-[38px] flex items-center gap-2.5 shrink-0 hover:opacity-90 transition-opacity" title="Ir a Gestión de Campañas">
      <div class="w-8 h-8 rounded-lg bg-gradient-to-br from-amber-500 to-amber-700 flex items-center justify-center shadow-[0_0_12px_rgba(245,158,11,0.5)] border border-amber-400/40 shrink-0">
        <span class="material-symbols-outlined text-[#0a0d12] text-xl font-bold">auto_stories</span>
      </div>
      <div class="hidden xl:flex flex-col">
        <span class="text-sm font-headline font-bold text-[#f1f5f9] leading-tight tracking-tight">Crónicas del Aventurero</span>
        <span id="header-app-subtitle" class="text-[10px] font-label text-amber-500 uppercase tracking-wider font-semibold">Grimorio de Campaña</span>
      </div>
    </a>

    <!-- Center HUD Row: [<Nombre • PG • CA>] + [Encapsulated 6 Dice Bar] -->
    <div class="flex flex-wrap items-center justify-center gap-1.5 sm:gap-2 min-w-0 flex-1 mx-auto">
      <!-- Cápsula 1: <Nombre • PG • CA> -->
      <div
        id="header-hud-pill"
        class="flex items-center justify-center gap-1.5 sm:gap-2.5 px-2.5 sm:px-3 py-1 rounded-xl bg-[#121721] border border-[#222f42] text-[11px] sm:text-xs font-label max-w-full shadow-inner shrink-0"
      >
        <!-- Nombre del personaje (o DM) -->
        <a
          href="/campaigns"
          id="header-char-name-link"
          class="font-headline font-bold text-[#f1f5f9] hover:text-amber-300 truncate max-w-[100px] sm:max-w-[160px] transition-colors flex items-center gap-1"
          title="Ir a la hoja del personaje"
        >
          <span id="header-char-name">Atlas</span>
        </a>

        <span id="header-hud-sep-1" class="text-[#475569] font-bold">•</span>

        <!-- Puntos de Golpe (Interactivo) -->
        <button
          type="button"
          id="header-hp-btn"
          class="flex items-center gap-1 text-rose-300 hover:text-rose-200 font-bold transition-colors cursor-pointer shrink-0"
          title="Haz clic para modificar Puntos de Golpe rápidamente"
        >
          <span class="material-symbols-outlined text-[13px] text-rose-500">favorite</span>
          <span id="header-char-hp" class="font-headline text-[#f1f5f9]">42/48</span>
          <span class="text-[10px] text-[#94a3b8] hidden xs:inline">PG</span>
          <span id="header-char-temp-hp" class="hidden px-1 py-0.2 rounded bg-amber-500/20 border border-amber-500/40 text-[9px] text-amber-300 font-bold">+5</span>
        </button>

        <span id="header-hud-sep-2" class="text-[#475569] font-bold">•</span>

        <!-- Clase de Armadura -->
        <div
          id="header-ac-chip"
          class="flex items-center gap-1 text-amber-300 font-bold shrink-0"
          title="Clase de Armadura (CA)"
        >
          <span class="material-symbols-outlined text-[13px] text-amber-400">shield</span>
          <span class="text-[10px] text-[#94a3b8] uppercase">CA</span>
          <span id="header-char-ac" class="font-headline text-[#f1f5f9]">16</span>
        </div>

        <!-- Chip modo DM (oculto en modo jugador) -->
        <span id="header-char-chip" class="hidden items-center gap-1 text-[#94a3b8]">
          <span class="font-semibold text-amber-400" id="header-char-level">Nvl. 5</span>
          <span class="text-[#cbd5e1]" id="header-char-class">Explorador</span>
        </span>
        <span class="sr-only" id="header-campaign-name"></span>
      </div>

      <!-- Cápsula 2 (a la derecha del nombre/PG/CA): Barra de 6 dados encapsulada con borde ligero -->
      <div
        id="header-dice-row"
        class="flex items-center justify-center gap-1 px-1.5 py-0.5 rounded-xl bg-[#121721] border border-amber-500/25 shadow-inner shrink-0"
        aria-label="Barra rápida de dados"
      >
        <!-- Toggle tirada secreta -->
        <button
          type="button"
          id="header-secret-dice-toggle"
          aria-pressed="false"
          class="px-1.5 py-0.5 rounded-lg bg-[#18202e] border border-[#222f42] hover:border-purple-500/50 text-[#94a3b8] hover:text-purple-300 text-[10px] font-bold flex items-center gap-0.5 transition-all cursor-pointer active:scale-95"
          title="Alternar modo Tirada Secreta (🔒 privada para ti y el DM)"
        >
          <span class="material-symbols-outlined text-[12px]" id="header-secret-dice-icon">lock_open</span>
          <span class="hidden md:inline text-[9px] uppercase tracking-wider" id="header-secret-dice-label">Pública</span>
        </button>

        <div class="h-3.5 w-px bg-[#222f42] mx-0.5"></div>

        <button type="button" class="header-quick-die-btn px-1.5 sm:px-2 py-0.5 rounded-lg bg-[#18202e]/80 hover:bg-amber-500/20 border border-transparent hover:border-amber-400/50 text-[#cbd5e1] hover:text-amber-300 text-[10px] sm:text-[11px] font-headline font-bold active:scale-95 transition-all cursor-pointer" data-die="4" title="Lanzar d4">d4</button>
        <button type="button" class="header-quick-die-btn px-1.5 sm:px-2 py-0.5 rounded-lg bg-[#18202e]/80 hover:bg-amber-500/20 border border-transparent hover:border-amber-400/50 text-[#cbd5e1] hover:text-amber-300 text-[10px] sm:text-[11px] font-headline font-bold active:scale-95 transition-all cursor-pointer" data-die="6" title="Lanzar d6">d6</button>
        <button type="button" class="header-quick-die-btn px-1.5 sm:px-2 py-0.5 rounded-lg bg-[#18202e]/80 hover:bg-amber-500/20 border border-transparent hover:border-amber-400/50 text-[#cbd5e1] hover:text-amber-300 text-[10px] sm:text-[11px] font-headline font-bold active:scale-95 transition-all cursor-pointer" data-die="8" title="Lanzar d8">d8</button>
        <button type="button" class="header-quick-die-btn px-1.5 sm:px-2 py-0.5 rounded-lg bg-[#18202e]/80 hover:bg-amber-500/20 border border-transparent hover:border-amber-400/50 text-[#cbd5e1] hover:text-amber-300 text-[10px] sm:text-[11px] font-headline font-bold active:scale-95 transition-all cursor-pointer" data-die="10" title="Lanzar d10 (o abre el modal para 2d10 / d100)">d10</button>
        <button type="button" class="header-quick-die-btn px-1.5 sm:px-2 py-0.5 rounded-lg bg-[#18202e]/80 hover:bg-amber-500/20 border border-transparent hover:border-amber-400/50 text-[#cbd5e1] hover:text-amber-300 text-[10px] sm:text-[11px] font-headline font-bold active:scale-95 transition-all cursor-pointer" data-die="12" title="Lanzar d12">d12</button>
        <button type="button" class="header-quick-die-btn px-1.5 sm:px-2 py-0.5 rounded-lg bg-amber-500/15 hover:bg-amber-500/25 border border-amber-500/40 hover:border-amber-400 text-amber-300 text-[10px] sm:text-[11px] font-headline font-bold active:scale-95 transition-all cursor-pointer shadow-xs" data-die="20" title="Lanzar d20">d20</button>
      </div>
    </div>

    <!-- Right Quick Utilities & Actions -->
    <div class="flex items-center gap-1.5 sm:gap-2 shrink-0">
        <!-- Botón de Combate VTT (/partida) — Visible SOLO si hay campaña disponible -->
        <a
          href="/partida"
          id="header-combat-vtt-btn"
          class="hidden w-8 h-8 rounded-full bg-[#18202e] border border-amber-500/40 hover:border-amber-400 hover:bg-amber-500/15 items-center justify-center transition-all text-amber-400 hover:text-amber-300 active:scale-95 shadow-[0_0_10px_rgba(245,158,11,0.2)] cursor-pointer"
          title="Ir al combate y mesa táctica (/partida)"
          aria-label="Ir a la mesa de combate"
        >
          <span class="material-symbols-outlined text-[17px]" id="header-combat-vtt-icon">swords</span>
        </a>

        <!-- Notifications Trigger -->
        <div class="relative">
          <button
            id="header-alerts-btn"
            class="w-8 h-8 rounded-full bg-[#18202e] border border-[#222f42] flex items-center justify-center hover:border-amber-500/50 transition-all text-[#94a3b8] hover:text-amber-400 cursor-pointer"
            title="Preferencias de notificaciones"
            type="button"
          >
            <span class="material-symbols-outlined text-[18px]">notifications</span>
          </button>

          <AlertPrefsMenu />
        </div>

        <!-- Profile & Settings Dropdown Menu Trigger -->
        <div class="relative">
          <button
            id="header-profile-btn"
            class="w-8 h-8 rounded-full bg-gradient-to-br from-amber-500 to-amber-600 border border-amber-400/50 flex items-center justify-center shadow-[0_0_12px_rgba(245,158,11,0.4)] hover:brightness-110 active:scale-95 transition-all cursor-pointer"
            title="Opciones del personaje y campaña"
            type="button"
          >
            <span class="material-symbols-outlined text-[#0a0d12] text-[18px] font-bold">manage_accounts</span>
          </button>

          <!-- Dropdown Menu -->
          <div
            id="header-profile-menu"
            class="hidden absolute right-0 mt-2 w-56 rounded-xl bg-[#121721] border border-[#222f42] shadow-[0_10px_30px_rgba(0,0,0,0.8)] py-1.5 z-50 text-xs font-medium backdrop-blur-md"
          >
            <a
              href="/"
              class="w-full text-left px-3.5 py-2 text-[#e2e8f0] hover:bg-[#18202e] hover:text-amber-400 flex items-center gap-2.5 transition-colors font-medium"
            >
              <span class="material-symbols-outlined text-[16px] text-amber-500">castle</span>
              <span>Gestión de Campañas</span>
            </a>

            <button
              id="menu-roster-btn"
              class="w-full text-left px-3.5 py-2 text-[#e2e8f0] hover:bg-[#18202e] hover:text-amber-400 flex items-center gap-2.5 transition-colors"
            >
              <span class="material-symbols-outlined text-[16px] text-amber-400">groups</span>
              <span>Ver Aventureros de la Campaña</span>
            </button>

            <button
              id="menu-clone-btn"
              class="w-full text-left px-3.5 py-2 text-[#e2e8f0] hover:bg-[#18202e] hover:text-amber-400 flex items-center gap-2.5 transition-colors"
            >
              <span class="material-symbols-outlined text-[16px] text-amber-400">content_copy</span>
              <span>Copiar / Clonar Personaje</span>
            </button>

            <button
              id="menu-secret-dice-btn"
              class="w-full text-left px-3.5 py-2 text-[#e2e8f0] hover:bg-[#18202e] hover:text-purple-400 flex items-center gap-2.5 transition-colors cursor-pointer"
            >
              <span class="material-symbols-outlined text-[16px] text-purple-400">visibility_off</span>
              <span>Hacer Tirada Secreta</span>
            </button>

            <button
              id="menu-compendium-btn"
              class="w-full text-left px-3.5 py-2 text-[#e2e8f0] hover:bg-[#18202e] hover:text-amber-400 flex items-center gap-2.5 transition-colors cursor-pointer"
            >
              <span class="material-symbols-outlined text-[16px] text-amber-400">menu_book</span>
              <span>Compendio SRD 5e</span>
            </button>

            <button
              id="menu-rest-btn"
              class="w-full text-left px-3.5 py-2 text-[#e2e8f0] hover:bg-[#18202e] hover:text-amber-400 flex items-center gap-2.5 transition-colors cursor-pointer"
            >
              <span class="material-symbols-outlined text-[16px] text-amber-500">bedtime</span>
              <span>Tomar Descanso (Corto / Largo)</span>
            </button>

            <div class="h-px bg-[#222f42] my-1"></div>

            <button
              id="menu-edit-char-btn"
              class="w-full text-left px-3.5 py-2 text-[#e2e8f0] hover:bg-[#18202e] hover:text-amber-400 flex items-center gap-2.5 transition-colors"
            >
              <span class="material-symbols-outlined text-[16px] text-amber-500">edit</span>
              <span>Editar Personaje & Atributos</span>
            </button>

            <button
              id="menu-panels-btn"
              class="w-full text-left px-3.5 py-2 text-[#e2e8f0] hover:bg-[#18202e] hover:text-amber-400 flex items-center gap-2.5 transition-colors"
            >
              <span class="material-symbols-outlined text-[16px] text-emerald-400">tune</span>
              <span>Personalizar Pestañas (Clase)</span>
            </button>
            
            <button
              id="menu-signout-btn"
              class="hidden w-full text-left px-3.5 py-2 text-[#e2e8f0] hover:bg-[#18202e] hover:text-rose-400 flex items-center justify-between gap-2 transition-colors"
            >
              <div class="flex items-center gap-2.5 min-w-0">
                <span class="material-symbols-outlined text-[16px] text-cyan-400">logout</span>
                <span class="truncate">Cerrar sesión <span id="menu-signout-name" class="text-[#64748b]"></span></span>
              </div>
              <span id="header-sync-dot" class="w-2 h-2 rounded-full bg-emerald-400 shrink-0" title="Sincronizado en la nube"></span>
            </button>

            <button
              id="menu-export-btn"
              class="w-full text-left px-3.5 py-2 text-[#e2e8f0] hover:bg-[#18202e] hover:text-amber-400 flex items-center gap-2.5 transition-colors"
            >
              <span class="material-symbols-outlined text-[16px] text-emerald-400">file_download</span>
              <span>Exportar Copia (JSON)</span>
            </button>

            <button
              id="menu-import-btn"
              class="w-full text-left px-3.5 py-2 text-[#e2e8f0] hover:bg-[#18202e] hover:text-amber-400 flex items-center gap-2.5 transition-colors"
            >
              <span class="material-symbols-outlined text-[16px] text-sky-400">file_upload</span>
              <span>Importar Personaje</span>
            </button>
            <input type="file" id="import-file-input" accept=".json" class="hidden" />

            <div class="h-px bg-[#222f42] my-1"></div>

            <button
              id="menu-reset-btn"
              class="w-full text-left px-3.5 py-2 text-rose-400 hover:bg-rose-950/30 hover:text-rose-300 flex items-center gap-2.5 transition-colors"
            >
              <span class="material-symbols-outlined text-[16px]">delete_sweep</span>
              <span>Borrar Todo / Reiniciar</span>
            </button>
          </div>
        </div>
      </div>
  </div>
</header>

<script>
  import { showAlert, showForm } from '../../scripts/ui/notify';
  import { characterStore } from '../../scripts/state/characterStore';
  import { campaignStore } from '../../scripts/state/campaignStore';
  import { openModal } from '../../scripts/animations/modalAnimations';
  import { userStore } from '../../scripts/state/userStore';
  import { cloudSession } from '../../scripts/data/cloudSync';

  // Título: en la página de campañas ("/") el enlace sube al inicio suavemente.
  document.querySelectorAll<HTMLAnchorElement>('[data-app-title-link]').forEach(link => {
    link.addEventListener('click', (e) => {
      if (window.location.pathname === '/' ) {
        e.preventDefault();
        window.scrollTo({ top: 0, behavior: 'smooth' });
      }
    });
  });

  // Clicking character name on /campaigns scrolls to top; on /partida navigates to /campaigns
  const charNameLink = document.getElementById('header-char-name-link') as HTMLAnchorElement | null;
  charNameLink?.addEventListener('click', (e) => {
    if (window.location.pathname.startsWith('/campaigns')) {
      e.preventDefault();
      window.scrollTo({ top: 0, behavior: 'smooth' });
    }
  });

  // Direct HP edit from Header HUD
  document.getElementById('header-hp-btn')?.addEventListener('click', async () => {
    const char = characterStore.get();
    if (!char) return;
    const values = await showForm([
      { name: 'cur', label: 'Actuales', type: 'number', value: char.hp.current, min: 0 },
      { name: 'max', label: 'Máximos', type: 'number', value: char.hp.max, min: 1 },
      { name: 'temp', label: 'Temporales', type: 'number', value: char.hp.temp, min: 0 },
    ], { title: `Puntos de Golpe (${char.name})`, confirmText: 'Guardar' });
    if (values) {
      characterStore.setHp(Number(values.cur) || 0, Number(values.max) || char.hp.max, Number(values.temp) || 0);
    }
  });

  // Quick Dice Bar in Header (d4, d6, d8, d10, d12, d20) + Secret Roll Toggle
  let headerSecretRollActive = false;
  const secretToggleBtn = document.getElementById('header-secret-dice-toggle');
  const secretToggleIcon = document.getElementById('header-secret-dice-icon');
  const secretToggleLabel = document.getElementById('header-secret-dice-label');

  function updateHeaderSecretUi() {
    if (!secretToggleBtn || !secretToggleIcon) return;
    secretToggleBtn.setAttribute('aria-pressed', String(headerSecretRollActive));
    if (headerSecretRollActive) {
      secretToggleBtn.className = 'px-1.5 py-0.5 rounded-lg bg-purple-500/20 border border-purple-500/50 text-purple-300 text-[10px] font-bold flex items-center gap-0.5 transition-all cursor-pointer active:scale-95 shadow-[0_0_8px_rgba(168,85,247,0.3)]';
      secretToggleIcon.textContent = 'lock';
      if (secretToggleLabel) secretToggleLabel.textContent = 'Secreta';
    } else {
      secretToggleBtn.className = 'px-1.5 py-0.5 rounded-lg bg-[#18202e] border border-[#222f42] hover:border-purple-500/50 text-[#94a3b8] hover:text-purple-300 text-[10px] font-bold flex items-center gap-0.5 transition-all cursor-pointer active:scale-95';
      secretToggleIcon.textContent = 'lock_open';
      if (secretToggleLabel) secretToggleLabel.textContent = 'Pública';
    }
  }

  secretToggleBtn?.addEventListener('click', (e) => {
    e.stopPropagation();
    headerSecretRollActive = !headerSecretRollActive;
    updateHeaderSecretUi();
  });

  document.querySelectorAll<HTMLButtonElement>('.header-quick-die-btn').forEach((btn) => {
    btn.addEventListener('click', () => {
      const sides = Number(btn.getAttribute('data-die')) || 20;
      const char = characterStore.get();
      const activeCampId = campaignStore.getActiveCampaignId();
      const isDm = campaignStore.isCurrentUserDm(activeCampId || undefined);
      const urlMode = new URLSearchParams(window.location.search).get('mode');
      const isDmMode = isDm && urlMode !== 'player';
      const authorName = isDmMode ? 'Dungeon Master' : (char?.name || 'Aventurero');
      const formula = `1d${sides}`;

      window.dispatchEvent(new CustomEvent('open-dice-roller', {
        detail: {
          die: sides,
          count: 1,
          modifier: 0,
          label: headerSecretRollActive
            ? `Tirada Secreta de ${authorName} (${formula})`
            : `Tirada de ${authorName} (${formula})`,
          tag: headerSecretRollActive ? '#Privado' : '#Tirada',
          isSecret: headerSecretRollActive,
          isDmRoll: isDmMode,
          characterId: isDmMode ? undefined : char?.id,
          characterName: authorName,
          authorName,
          campaignId: char?.campaignId || activeCampId,
          autoroll: true
        }
      }));
    });
  });

  // Toggle Alert Menu & Profile Menu
  const alertBtn = document.getElementById('header-alerts-btn');
  const alertMenu = document.getElementById('alert-prefs-menu');
  const profileBtn = document.getElementById('header-profile-btn');
  const profileMenu = document.getElementById('header-profile-menu');

  alertBtn?.addEventListener('click', (e) => {
    e.stopPropagation();
    profileMenu?.classList.add('hidden');
    alertMenu?.classList.toggle('hidden');
  });

  profileBtn?.addEventListener('click', (e) => {
    e.stopPropagation();
    alertMenu?.classList.add('hidden');
    profileMenu?.classList.toggle('hidden');
  });

  document.addEventListener('click', () => {
    profileMenu?.classList.add('hidden');
    alertMenu?.classList.add('hidden');
  });

  // Open Dice Modal (Secret from menu)
  const triggerSecretDiceModal = () => {
    window.dispatchEvent(new CustomEvent('open-dice-roller', {
      detail: {
        die: 20,
        count: 1,
        modifier: 0,
        label: 'Tirada Secreta',
        tag: '#Privado',
        isSecret: true,
        autoroll: false
      }
    }));
  };

  document.getElementById('menu-secret-dice-btn')?.addEventListener('click', () => {
    profileMenu?.classList.add('hidden');
    triggerSecretDiceModal();
  });

  document.getElementById('menu-compendium-btn')?.addEventListener('click', () => {
    profileMenu?.classList.add('hidden');
    window.dispatchEvent(new CustomEvent('open-compendium-modal'));
  });

  document.getElementById('menu-rest-btn')?.addEventListener('click', () => {
    profileMenu?.classList.add('hidden');
    const restModal = document.getElementById('rest-modal');
    const backdrop = document.getElementById('modal-backdrop');
    if (restModal && backdrop) openModal(restModal, backdrop);
  });

  // Open Roster modal trigger
  document.getElementById('menu-roster-btn')?.addEventListener('click', () => {
    profileMenu?.classList.add('hidden');
    const activeCampId = campaignStore.getActiveCampaignId();
    if (activeCampId) {
      window.dispatchEvent(new CustomEvent('open-campaign-roster', { detail: { campaignId: activeCampId } }));
    }
  });

  // Open Clone modal trigger
  document.getElementById('menu-clone-btn')?.addEventListener('click', () => {
    profileMenu?.classList.add('hidden');
    window.dispatchEvent(new CustomEvent('open-clone-character-modal', {
      detail: { sourceCharacterId: characterStore.get().id }
    }));
  });

  // Edit character modal trigger
  document.getElementById('menu-edit-char-btn')?.addEventListener('click', () => {
    profileMenu?.classList.add('hidden');
    const editModal = document.getElementById('edit-character-modal');
    const backdrop = document.getElementById('modal-backdrop');
    if (editModal && backdrop) openModal(editModal, backdrop);
  });

  // Sesión en la nube: solo con Firebase configurado
  const signOutBtn = document.getElementById('menu-signout-btn');
  const renderSessionItem = () => {
    const active = userStore.isCloudMode();
    signOutBtn?.classList.toggle('hidden', !active);
    signOutBtn?.classList.toggle('flex', active);
    const nameEl = document.getElementById('menu-signout-name');
    if (nameEl) nameEl.textContent = active ? `(${userStore.getCurrentUser().name})` : '';
  };
  renderSessionItem();
  window.addEventListener('current-user-changed', renderSessionItem);
  signOutBtn?.addEventListener('click', () => {
    profileMenu?.classList.add('hidden');
    cloudSession.signOut();
  });

  // Reset confirmation trigger
  document.getElementById('menu-reset-btn')?.addEventListener('click', () => {
    profileMenu?.classList.add('hidden');
    const resetModal = document.getElementById('reset-confirm-modal');
    const backdrop = document.getElementById('modal-backdrop');
    if (resetModal && backdrop) openModal(resetModal, backdrop);
  });

  // Export JSON
  document.getElementById('menu-export-btn')?.addEventListener('click', () => {
    profileMenu?.classList.add('hidden');
    const jsonStr = characterStore.exportJson();
    const blob = new Blob([jsonStr], { type: 'application/json' });
    const url = URL.createObjectURL(blob);
    const a = document.createElement('a');
    a.href = url;
    a.download = `${characterStore.get().name.toLowerCase().replace(/\s+/g, '_')}_dnd5e.json`;
    a.click();
    URL.revokeObjectURL(url);
  });

  // Import JSON
  const importInput = document.getElementById('import-file-input') as HTMLInputElement;
  document.getElementById('menu-import-btn')?.addEventListener('click', () => {
    profileMenu?.classList.add('hidden');
    importInput?.click();
  });

  importInput?.addEventListener('change', () => {
    const file = importInput.files?.[0];
    if (file) {
      const reader = new FileReader();
      reader.onload = (event) => {
        const text = event.target?.result as string;
        const previousId = characterStore.get().id;
        if (characterStore.importJson(text)) {
          const imported = characterStore.get();
          if (imported.id !== previousId) {
            const url = new URL(window.location.href);
            if (url.searchParams.has('character') || url.pathname.startsWith('/campaigns')) {
              url.searchParams.set('character', imported.id);
              url.searchParams.delete('campaign');
              history.replaceState(null, '', url);
            }
          }
          showAlert('¡Personaje importado exitosamente!', { kind: 'success' });
        } else {
          showAlert('Error al importar el archivo JSON.', { kind: 'error' });
        }
      };
      reader.readAsText(file);
    }
  });

  // Panels config modal trigger
  document.getElementById('menu-panels-btn')?.addEventListener('click', () => {
    profileMenu?.classList.add('hidden');
    const panelsModal = document.getElementById('configure-panels-modal');
    const backdrop = document.getElementById('modal-backdrop');
    if (panelsModal && backdrop) openModal(panelsModal, backdrop);
  });

  function renderHeader(char: any) {
    const campEl = document.getElementById('header-campaign-name');
    const appSubtitle = document.getElementById('header-app-subtitle');
    const charChip = document.getElementById('header-char-chip');
    const nameEl = document.getElementById('header-char-name');
    const hpBtn = document.getElementById('header-hp-btn');
    const hpEl = document.getElementById('header-char-hp');
    const tempHpEl = document.getElementById('header-char-temp-hp');
    const acChip = document.getElementById('header-ac-chip');
    const acEl = document.getElementById('header-char-ac');
    const sep1 = document.getElementById('header-hud-sep-1');
    const sep2 = document.getElementById('header-hud-sep-2');
    const combatBtn = document.getElementById('header-combat-vtt-btn') as HTMLAnchorElement | null;
    const combatIcon = document.getElementById('header-combat-vtt-icon');

    const activeCamp = campaignStore.getActiveCampaign();
    const activeCampId = activeCamp?.id || char?.campaignId || campaignStore.getActiveCampaignId();
    const isDm = campaignStore.isCurrentUserDm(activeCampId || undefined);
    const urlMode = typeof window !== 'undefined' ? new URLSearchParams(window.location.search).get('mode') : null;
    const myCharInCamp = activeCampId ? campaignStore.getMyCharacterForCampaign(activeCampId) : null;
    const isDmMode = isDm && (!myCharInCamp || urlMode !== 'player');

    if (campEl) {
      campEl.textContent = activeCamp ? activeCamp.name : (char?.sessionContext?.campaignName || 'Sin Campaña');
    }

    // Botón de combate al lado de la campanita: solo visible si hay campaña disponible
    if (combatBtn) {
      if (activeCampId) {
        combatBtn.classList.remove('hidden');
        combatBtn.classList.add('flex');
        const onPartidaPage = typeof window !== 'undefined' && window.location.pathname.startsWith('/partida');
        if (onPartidaPage) {
          combatBtn.href = isDmMode
            ? `/campaigns?campaign=${encodeURIComponent(activeCampId)}&mode=dm`
            : `/campaigns?campaign=${encodeURIComponent(activeCampId)}${char?.id ? `&character=${encodeURIComponent(char.id)}` : ''}`;
          combatBtn.title = isDmMode ? 'Volver al Grimorio del Control' : `Volver a la hoja de ${char?.name || 'Personaje'}`;
          if (combatIcon) combatIcon.textContent = isDmMode ? 'crown' : 'badge';
        } else {
          combatBtn.href = `/partida?id=${encodeURIComponent(activeCampId)}`;
          combatBtn.title = 'Ir al combate y mesa táctica (/partida)';
          if (combatIcon) combatIcon.textContent = 'swords';
        }
      } else {
        combatBtn.classList.add('hidden');
        combatBtn.classList.remove('flex');
      }
    }

    const editCharBtn = document.getElementById('menu-edit-char-btn');
    const cloneBtn = document.getElementById('menu-clone-btn');
    const panelsBtn = document.getElementById('menu-panels-btn');
    const restBtn = document.getElementById('menu-rest-btn');

    if (isDmMode) {
      if (appSubtitle) appSubtitle.textContent = 'Grimorio del Control';
      if (nameEl) nameEl.textContent = activeCamp ? activeCamp.name : 'Dungeon Master';
      if (charNameLink && activeCampId) {
        charNameLink.href = `/campaigns?campaign=${encodeURIComponent(activeCampId)}&mode=dm`;
      }
      hpBtn?.classList.add('hidden');
      acChip?.classList.add('hidden');
      sep2?.classList.add('hidden');
      sep1?.classList.remove('hidden');
      if (charChip) {
        charChip.classList.remove('hidden');
        charChip.classList.add('flex');
        charChip.innerHTML = '<span class="font-bold text-amber-400 flex items-center gap-1"><span>👑</span><span>DM</span></span>';
      }
      if (!myCharInCamp) {
        editCharBtn?.classList.add('hidden');
        cloneBtn?.classList.add('hidden');
        panelsBtn?.classList.add('hidden');
        restBtn?.classList.add('hidden');
      } else {
        editCharBtn?.classList.remove('hidden');
        cloneBtn?.classList.remove('hidden');
        panelsBtn?.classList.remove('hidden');
        restBtn?.classList.remove('hidden');
      }
    } else {
      if (appSubtitle) appSubtitle.textContent = 'Grimorio de Campaña';
      hpBtn?.classList.remove('hidden');
      acChip?.classList.remove('hidden');
      sep1?.classList.remove('hidden');
      sep2?.classList.remove('hidden');
      charChip?.classList.add('hidden');
      charChip?.classList.remove('flex');

      if (char) {
        if (nameEl) nameEl.textContent = char.name;
        if (charNameLink) {
          charNameLink.href = activeCampId
            ? `/campaigns?campaign=${encodeURIComponent(activeCampId)}&character=${encodeURIComponent(char.id)}`
            : `/campaigns?character=${encodeURIComponent(char.id)}`;
        }
        if (hpEl && char.hp) {
          hpEl.textContent = `${char.hp.current}/${char.hp.max}`;
        }
        if (tempHpEl) {
          const temp = char.hp?.temp || 0;
          if (temp > 0) {
            tempHpEl.textContent = `+${temp}`;
            tempHpEl.classList.remove('hidden');
          } else {
            tempHpEl.classList.add('hidden');
          }
        }
        if (acEl) {
          acEl.textContent = String(char.armorClass ?? 10);
        }
      }

      editCharBtn?.classList.remove('hidden');
      cloneBtn?.classList.remove('hidden');
      panelsBtn?.classList.remove('hidden');
      restBtn?.classList.remove('hidden');
    }
  }

  // Hydrate immediately
  renderHeader(characterStore.get());

  // Listen for character updates to sync header chips
  window.addEventListener('character-updated', ((e: CustomEvent) => {
    renderHeader(e.detail.character);
  }) as EventListener);

  // Listen for user changes to dynamically update DM controls
  window.addEventListener('current-user-changed', () => {
    renderHeader(characterStore.get());
  });

  window.addEventListener('campaigns-updated', () => {
    renderHeader(characterStore.get());
  });

  window.addEventListener('active-campaign-changed', () => {
    renderHeader(characterStore.get());
  });

  // Estado de conexión con Firestore (offline / online)
  const syncDot = () => {
    const dot = document.getElementById('header-sync-dot');
    if (!dot) return;
    dot.className = navigator.onLine
      ? 'w-2 h-2 rounded-full bg-emerald-400 shrink-0'
      : 'w-2 h-2 rounded-full bg-amber-400 animate-pulse shrink-0';
    dot.title = navigator.onLine ? 'Sincronizado en la nube' : 'Sin conexión: los cambios se suben al reconectar';
  };
  syncDot();
  window.addEventListener('online', syncDot);
  window.addEventListener('offline', syncDot);
</script>
