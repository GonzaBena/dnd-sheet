---
// src/components/layout/SessionBanner.astro
// Tira compacta de contexto de campaña (1 línea)
---

<section
  id="session-banner-root"
  class="relative mb-3 rounded-xl bg-[#121721]/90 border border-[#222f42] px-3.5 py-2 shadow-sm overflow-hidden"
>
  <div class="relative z-10 flex flex-wrap items-center justify-between gap-2 text-xs font-label">
    <!-- Lado izquierdo: Campaña y Sesión (clicable para editar) -->
    <div
      class="flex items-center gap-2 cursor-pointer group min-w-0"
      id="open-campaign-edit-trigger"
      title="Haz clic para editar el nombre de la campaña, sesión, clima y ubicación"
    >
      <span class="w-6 h-6 rounded-lg bg-amber-500/15 border border-amber-500/40 text-amber-400 flex items-center justify-center shrink-0">
        <span class="material-symbols-outlined text-[15px]">castle</span>
      </span>
      <h2
        id="banner-campaign-title"
        class="text-xs sm:text-sm font-headline font-bold text-[#f1f5f9] group-hover:text-amber-300 transition-colors truncate"
      >
        Aventura Independiente • Sesión 1
      </h2>
      <span class="material-symbols-outlined text-[13px] text-amber-500/60 group-hover:text-amber-400 transition-colors shrink-0">edit</span>
    </div>

    <!-- Lado derecho: Píldoras de contexto (Clima, Ubicación, Miembros, Hito) -->
    <div class="flex flex-wrap items-center gap-1.5 min-w-0">
      <div
        class="flex items-center gap-1 px-2 py-0.5 rounded-lg bg-[#10141d] border border-[#222f42] text-[#94a3b8] hover:border-amber-500/40 cursor-pointer transition-colors"
        id="banner-weather-chip"
        title="Haz clic para editar clima"
      >
        <span class="material-symbols-outlined text-[13px] text-amber-500">wb_twilight</span>
        <span id="banner-weather-text" class="text-[#cbd5e1] text-[10px] sm:text-[11px] truncate max-w-[140px] sm:max-w-none">Niebla Espesa</span>
      </div>

      <div
        class="flex items-center gap-1 px-2 py-0.5 rounded-lg bg-[#10141d] border border-[#222f42] text-[#94a3b8] hover:border-amber-500/40 cursor-pointer transition-colors"
        id="banner-location-chip"
        title="Haz clic para editar ubicación"
      >
        <span class="material-symbols-outlined text-[13px] text-rose-400">map</span>
        <span id="banner-location-text" class="text-[#cbd5e1] text-[10px] sm:text-[11px] truncate max-w-[140px] sm:max-w-none">Tierras Salvajes</span>
      </div>

      <!-- Ver Miembros de la Campaña -->
      <button
        type="button"
        id="banner-roster-btn"
        class="flex items-center gap-1 px-2 py-0.5 rounded-lg bg-[#18202e] border border-amber-500/30 hover:border-amber-400 text-amber-300 font-bold active:scale-95 transition-all cursor-pointer text-[10px] sm:text-[11px]"
        title="Ver aventureros y miembros de la campaña"
      >
        <span class="material-symbols-outlined text-[13px]">groups</span>
        <span>Grupo</span>
      </button>

      <!-- Milestone Celebration Button -->
      <button
        type="button"
        id="open-milestone-btn"
        class="flex items-center gap-1 px-2 py-0.5 rounded-lg bg-amber-500/15 border border-amber-500/40 text-amber-300 hover:text-amber-100 hover:border-amber-400 font-bold active:scale-95 transition-all cursor-pointer text-[10px] sm:text-[11px]"
        title="Celebrar un logro o hito épico en la campaña"
      >
        <span class="material-symbols-outlined text-[13px] text-amber-400">military_tech</span>
        <span class="hidden sm:inline">Hito</span>
      </button>
    </div>
  </div>
</section>

<script>
  import { characterStore } from '../../scripts/state/characterStore';
  import { campaignStore } from '../../scripts/state/campaignStore';

  const openCampModal = () => {
    window.dispatchEvent(new CustomEvent('open-campaign-modal'));
  };
  document.getElementById('open-campaign-edit-trigger')?.addEventListener('click', openCampModal);
  document.getElementById('banner-weather-chip')?.addEventListener('click', openCampModal);
  document.getElementById('banner-location-chip')?.addEventListener('click', openCampModal);

  document.getElementById('open-milestone-btn')?.addEventListener('click', (e) => {
    e.stopPropagation();
    window.dispatchEvent(new CustomEvent('open-new-milestone-modal'));
  });

  document.getElementById('banner-roster-btn')?.addEventListener('click', () => {
    const char = characterStore.get();
    const cid = char?.campaignId || campaignStore.getActiveCampaignId();
    if (cid) {
      window.dispatchEvent(new CustomEvent('open-campaign-roster', { detail: { campaignId: cid } }));
    }
  });

  function renderBanner(char: any) {
    const title = document.getElementById('banner-campaign-title');
    const weather = document.getElementById('banner-weather-text');
    const loc = document.getElementById('banner-location-text');
    const rosterBtn = document.getElementById('banner-roster-btn');
    const milestoneBtn = document.getElementById('open-milestone-btn');

    const cid = char?.campaignId || campaignStore.getActiveCampaignId();
    if (rosterBtn) {
      rosterBtn.classList.toggle('hidden', !cid);
    }

    if (milestoneBtn) {
      const isDm = cid ? campaignStore.isCurrentUserDm(cid) : true;
      milestoneBtn.classList.toggle('hidden', Boolean(cid && !isDm));
    }

    if (!char) return;

    if (title && char.sessionContext) {
      title.textContent = `${char.sessionContext.campaignName} • Sesión ${char.sessionContext.sessionNumber}`;
    }
    if (weather && char.sessionContext) {
      weather.textContent = char.sessionContext.weather;
    }
    if (loc && char.sessionContext) {
      loc.textContent = char.sessionContext.location;
    }
  }

  renderBanner(characterStore.get());

  window.addEventListener('character-updated', ((e: CustomEvent) => {
    renderBanner(e.detail.character);
  }) as EventListener);
  window.addEventListener('active-campaign-changed', () => {
    renderBanner(characterStore.get());
  });
</script>
