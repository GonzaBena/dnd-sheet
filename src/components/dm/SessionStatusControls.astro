---
// src/components/dm/SessionStatusControls.astro
// Controles de estado de la sesión para el Dungeon Master (Iniciar, Pausar, Terminar, Reabrir).
---

<div class="session-status-controls flex items-center gap-1.5 flex-wrap">
  <!-- Botón Iniciar (visible en paused) -->
  <button
    type="button"
    class="status-btn-start hidden items-center gap-1.5 px-3 py-1.5 rounded-xl bg-emerald-600/20 border border-emerald-500/40 hover:bg-emerald-600/30 text-emerald-300 font-bold text-xs transition-all active:scale-95 cursor-pointer shadow-xs"
    title="Iniciar la partida: permite tiradas, movimiento de tokens y combate en vivo"
  >
    <span class="material-symbols-outlined text-[16px] text-emerald-400">play_arrow</span>
    <span>Iniciar Partida</span>
  </button>

  <!-- Botón Pausar (visible en active) -->
  <button
    type="button"
    class="status-btn-pause hidden items-center gap-1.5 px-3 py-1.5 rounded-xl bg-amber-600/20 border border-amber-500/40 hover:bg-amber-600/30 text-amber-300 font-bold text-xs transition-all active:scale-95 cursor-pointer shadow-xs"
    title="Pausar la partida: bloquea acciones de juego mientras el DM prepara contenido"
  >
    <span class="material-symbols-outlined text-[16px] text-amber-400">pause</span>
    <span>Pausar</span>
  </button>

  <!-- Botón Terminar (visible en active y paused) -->
  <button
    type="button"
    class="status-btn-end hidden items-center gap-1.5 px-3 py-1.5 rounded-xl bg-rose-600/15 border border-rose-500/30 hover:bg-rose-600/25 text-rose-300 font-bold text-xs transition-all active:scale-95 cursor-pointer shadow-xs"
    title="Terminar la partida: la deja en solo lectura"
  >
    <span class="material-symbols-outlined text-[16px] text-rose-400">stop</span>
    <span>Terminar</span>
  </button>

  <!-- Botón Reabrir (visible en ended) -->
  <button
    type="button"
    class="status-btn-reopen hidden items-center gap-1.5 px-3 py-1.5 rounded-xl bg-sky-600/20 border border-sky-500/40 hover:bg-sky-600/30 text-sky-300 font-bold text-xs transition-all active:scale-95 cursor-pointer shadow-xs"
    title="Reabrir la partida (vuelve al estado pausado)"
  >
    <span class="material-symbols-outlined text-[16px] text-sky-400">restart_alt</span>
    <span>Reabrir Partida</span>
  </button>
</div>

<script>
  import { campaignStore } from '../../scripts/state/campaignStore.ts';
  import { normalizeStatus, canTransition } from '../../scripts/vtt/sessionStatus.ts';
  import { setSessionStatus } from '../../scripts/data/sessionStatusService.ts';
  import { showConfirm, showAlert } from '../../scripts/ui/notify.ts';

  // La campaña de la URL manda sobre la "activa" (que puede tardar en sincronizarse).
  function resolveCampaignId(): string | null {
    const params = new URLSearchParams(window.location.search);
    return params.get('campaign') || params.get('id') || campaignStore.getActiveCampaignId();
  }

  function updateAllStatusButtons() {
    const cid = resolveCampaignId();
    const camp = cid ? campaignStore.getCampaign(cid) : null;
    const isDm = cid ? campaignStore.isCurrentUserDm(cid) : false;

    const starts = document.querySelectorAll<HTMLElement>('.status-btn-start');
    const pauses = document.querySelectorAll<HTMLElement>('.status-btn-pause');
    const ends = document.querySelectorAll<HTMLElement>('.status-btn-end');
    const reopens = document.querySelectorAll<HTMLElement>('.status-btn-reopen');

    if (!camp || !isDm) {
      [...starts, ...pauses, ...ends, ...reopens].forEach(el => {
        el.classList.add('hidden');
        el.classList.remove('flex');
      });
      return;
    }

    const s = normalizeStatus(camp.status);

    const toggle = (els: NodeListOf<HTMLElement>, show: boolean) => {
      els.forEach(el => {
        if (show) {
          el.classList.remove('hidden');
          el.classList.add('flex');
        } else {
          el.classList.add('hidden');
          el.classList.remove('flex');
        }
      });
    };

    toggle(starts, canTransition(s, 'active'));
    toggle(pauses, canTransition(s, 'paused') && s !== 'ended');
    toggle(ends, canTransition(s, 'ended'));
    toggle(reopens, s === 'ended' && canTransition(s, 'paused'));

    // Actualizar badges de estado en el panel DM si existen
    const badges = document.querySelectorAll<HTMLElement>('#dm-campaign-status-badge, #grimoire-status-badge');
    badges.forEach(b => {
      if (s === 'active') {
        b.className = 'px-2 py-0.5 rounded-full bg-emerald-500/20 border border-emerald-500/30 text-emerald-400 text-[10px] font-bold flex items-center gap-1';
        b.innerHTML = '<span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse"></span><span>En Vivo</span>';
      } else if (s === 'paused') {
        b.className = 'px-2 py-0.5 rounded-full bg-amber-500/20 border border-amber-500/30 text-amber-300 text-[10px] font-bold flex items-center gap-1';
        b.innerHTML = '<span class="w-1.5 h-1.5 rounded-full bg-amber-400"></span><span>Pausada</span>';
      } else {
        b.className = 'px-2 py-0.5 rounded-full bg-rose-500/20 border border-rose-500/30 text-rose-300 text-[10px] font-bold flex items-center gap-1';
        b.innerHTML = '<span class="w-1.5 h-1.5 rounded-full bg-rose-400"></span><span>Terminada</span>';
      }
    });
  }

  async function handleTransition(nextStatus: 'active' | 'paused' | 'ended') {
    const cid = resolveCampaignId();
    if (!cid || !campaignStore.getCampaign(cid)) {
      showAlert('La campaña todavía se está cargando. Probá de nuevo en unos segundos.', { kind: 'error' });
      return;
    }

    if (nextStatus === 'ended') {
      const confirmed = await showConfirm(
        'Terminar la partida la deja en solo lectura. No se borra nada.',
        {
          title: '¿Terminar la partida?',
          confirmText: 'Terminar',
          cancelText: 'Cancelar',
          danger: true,
        }
      );
      if (!confirmed) return;
    }

    try {
      await setSessionStatus(cid, nextStatus);
      updateAllStatusButtons();
    } catch (err: any) {
      console.error('[SessionStatusControls] Error:', err);
      showAlert(err?.message || 'No se pudo actualizar el estado de la sesión.', { kind: 'error' });
    }
  }

  // Delegación de eventos para todos los botones de status en la página
  document.addEventListener('click', (e) => {
    const target = e.target as HTMLElement;
    const btn = target.closest<HTMLElement>('.status-btn-start, .status-btn-pause, .status-btn-end, .status-btn-reopen');
    if (!btn) return;

    e.preventDefault();
    e.stopPropagation();

    if (btn.classList.contains('status-btn-start')) {
      handleTransition('active');
    } else if (btn.classList.contains('status-btn-pause')) {
      handleTransition('paused');
    } else if (btn.classList.contains('status-btn-end')) {
      handleTransition('ended');
    } else if (btn.classList.contains('status-btn-reopen')) {
      handleTransition('paused');
    }
  });

  window.addEventListener('session-status-changed', updateAllStatusButtons);
  window.addEventListener('active-campaign-changed', updateAllStatusButtons);
  window.addEventListener('campaigns-updated', updateAllStatusButtons);
  updateAllStatusButtons();
</script>
