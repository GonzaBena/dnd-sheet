---
// src/components/dm/DmControlGrimoire.astro
import SessionStatusControls from './SessionStatusControls.astro';
import CombatTracker from './CombatTracker.astro';
import MapStage from '../map/MapStage.astro';
import MapManager from './MapManager.astro';
import TokenEditor from './TokenEditor.astro';
import DmNotes from './DmNotes.astro';
import PresenceTracker from '../party/PresenceTracker.astro';
---

<div id="dm-control-root" class="space-y-6">
  <!-- [titulo, titulo, dados] -->
  <section class="relative rounded-2xl bg-gradient-to-r from-[#121721] via-[#161e2c] to-[#121721] border border-amber-500/40 p-5 lg:p-7 shadow-[0_10px_40px_rgba(0,0,0,0.6)] overflow-hidden">
    <div class="absolute -right-20 -bottom-20 w-80 h-80 rounded-full bg-amber-500/10 blur-3xl pointer-events-none"></div>
    <div class="absolute top-0 right-1/3 w-64 h-64 rounded-full bg-rose-600/5 blur-3xl pointer-events-none"></div>

    <div class="relative z-10 grid grid-cols-1 xl:grid-cols-12 gap-5 items-center">
      <!-- LADO IZQUIERDO: [titulo, titulo] (7 cols) -->
      <div class="xl:col-span-7 space-y-3 min-w-0">
        <div class="flex items-center gap-4 min-w-0">
          <div class="w-14 h-14 rounded-2xl bg-gradient-to-br from-amber-500 to-amber-700 text-[#0a0d12] flex items-center justify-center font-bold shadow-[0_0_20px_rgba(245,158,11,0.5)] border border-amber-400/60 shrink-0">
            <span class="material-symbols-outlined text-[32px]">shield_with_heart</span>
          </div>
          <div class="min-w-0 space-y-1">
            <div class="flex items-center gap-2 flex-wrap">
              <span class="px-2.5 py-0.5 rounded-full bg-amber-500/20 text-amber-300 border border-amber-500/40 text-[10px] font-bold uppercase tracking-wider flex items-center gap-1 shadow-xs">
                <span>👑</span>
                <span>Grimorio del Control</span>
              </span>
              <span id="grimoire-status-badge" class="px-2 py-0.5 rounded-full bg-emerald-500/20 border border-emerald-500/30 text-emerald-400 text-[10px] font-bold flex items-center gap-1">
                <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse"></span>
                <span>Mesa en Vivo</span>
              </span>
            </div>
            <h1 id="grimoire-campaign-title" class="text-2xl sm:text-3xl font-headline font-bold text-[#f1f5f9] tracking-tight truncate">
              Descenso al Averno
            </h1>
            <p id="grimoire-campaign-subtitle" class="text-xs sm:text-sm text-[#94a3b8] leading-relaxed truncate">
              Planos Infernales • Primer Círculo • Sesión 8 en Curso
            </p>
          </div>
        </div>

        <!-- Quick Session Context Badges -->
        <div class="flex flex-wrap items-center gap-2 font-label text-xs pt-1">
          <div class="flex items-center gap-1.5 px-2.5 py-1.5 rounded-xl bg-[#10141d] border border-[#222f42] text-[#94a3b8] shadow-xs">
            <span class="material-symbols-outlined text-[15px] text-amber-500">wb_twilight</span>
            <span id="grimoire-weather-text" class="text-[#cbd5e1] text-[11px]">Clima: -</span>
          </div>
          <div class="flex items-center gap-1.5 px-2.5 py-1.5 rounded-xl bg-[#10141d] border border-[#222f42] text-[#94a3b8] shadow-xs">
            <span class="material-symbols-outlined text-[15px] text-rose-400">map</span>
            <span id="grimoire-location-text" class="text-[#cbd5e1] text-[11px]">Lugar: -</span>
          </div>
          <button
            type="button"
            id="grimoire-edit-session-btn"
            class="flex items-center gap-1 px-2.5 py-1.5 rounded-xl bg-[#18202e] border border-amber-500/30 hover:border-amber-500 text-amber-300 font-bold transition-all active:scale-95 cursor-pointer shadow-xs text-[11px]"
            title="Editar detalles y contexto de la sesión"
          >
            <span class="material-symbols-outlined text-[15px]">edit</span>
            <span>Editar Sesión</span>
          </button>
          <SessionStatusControls />
        </div>
      </div>

      <!-- LADO DERECHO: [dados] (5 cols) -->
      <div class="xl:col-span-5 rounded-xl bg-[#10141d]/90 border border-[#222f42] p-3.5 space-y-2.5 font-label text-xs backdrop-blur-sm shadow-md">
        <!-- Quick Dice Bar -->
        <div class="space-y-1.5">
          <div class="flex items-center justify-between">
            <span class="text-[11px] font-bold uppercase text-amber-400 tracking-wider flex items-center gap-1">
              <span class="material-symbols-outlined text-[15px]">casino</span>
              <span>Dados DM</span>
            </span>
            <label class="flex items-center gap-1.5 cursor-pointer text-[#94a3b8] hover:text-[#f1f5f9] select-none text-[10px]">
              <input type="checkbox" id="grimoire-secret-dice-check" class="rounded bg-[#18202e] border-[#222f42] text-amber-500 focus:ring-amber-500/40" />
              <span class="flex items-center gap-1">
                <span>🔒</span>
                <span>Tirada Oculta</span>
              </span>
            </label>
          </div>
          <div class="flex items-center gap-1 flex-wrap">
            <button type="button" class="grimoire-dice-btn px-2.5 py-1 rounded-lg bg-[#18202e] border border-amber-500/40 text-amber-300 font-bold hover:bg-amber-500/20 active:scale-95 transition-all cursor-pointer shadow-xs text-xs" data-dice="1d20">d20</button>
            <button type="button" class="grimoire-dice-btn px-2 py-1 rounded-lg bg-[#18202e] border border-[#222f42] hover:border-amber-400/60 text-[#cbd5e1] font-bold active:scale-95 transition-all cursor-pointer text-xs" data-dice="1d100">d100</button>
            <button type="button" class="grimoire-dice-btn px-2 py-1 rounded-lg bg-[#18202e] border border-[#222f42] hover:border-amber-400/60 text-[#cbd5e1] font-bold active:scale-95 transition-all cursor-pointer text-xs" data-dice="2d6">2d6</button>
            <button type="button" class="grimoire-dice-btn px-2 py-1 rounded-lg bg-[#18202e] border border-[#222f42] hover:border-amber-400/60 text-[#cbd5e1] font-bold active:scale-95 transition-all cursor-pointer text-xs" data-dice="1d12">1d12</button>
            <button type="button" class="grimoire-dice-btn px-2 py-1 rounded-lg bg-[#18202e] border border-[#222f42] hover:border-amber-400/60 text-[#cbd5e1] font-bold active:scale-95 transition-all cursor-pointer text-xs" data-dice="1d10">1d10</button>
            <button type="button" class="grimoire-dice-btn px-2 py-1 rounded-lg bg-[#18202e] border border-[#222f42] hover:border-amber-400/60 text-[#cbd5e1] font-bold active:scale-95 transition-all cursor-pointer text-xs" data-dice="1d8">1d8</button>
            <button type="button" class="grimoire-dice-btn px-2 py-1 rounded-lg bg-[#18202e] border border-[#222f42] hover:border-amber-400/60 text-[#cbd5e1] font-bold active:scale-95 transition-all cursor-pointer text-xs" data-dice="1d6">1d6</button>
            <button type="button" class="grimoire-dice-btn px-2 py-1 rounded-lg bg-[#18202e] border border-[#222f42] hover:border-amber-400/60 text-[#cbd5e1] font-bold active:scale-95 transition-all cursor-pointer text-xs" data-dice="1d4">1d4</button>
          </div>
        </div>

        <!-- Epic Milestones & Resting Actions -->
        <div class="flex items-center gap-1.5 pt-1.5 border-t border-[#222f42]/60 flex-wrap">
          <button
            type="button"
            id="grimoire-short-rest-btn"
            class="flex items-center gap-1 px-2.5 py-1 rounded-lg bg-[#18202e] border border-[#222f42] hover:border-amber-500/50 text-[#cbd5e1] hover:text-amber-300 font-bold active:scale-95 transition-colors cursor-pointer text-[11px]"
            title="Otorgar descanso corto a todos los aventureros (+8 PG)"
          >
            <span class="material-symbols-outlined text-[14px] text-amber-400">bedtime</span>
            <span>Descanso Corto</span>
          </button>

          <button
            type="button"
            id="grimoire-long-rest-btn"
            class="flex items-center gap-1 px-2.5 py-1 rounded-lg bg-[#18202e] border border-[#222f42] hover:border-amber-500/50 text-[#cbd5e1] hover:text-amber-300 font-bold active:scale-95 transition-colors cursor-pointer text-[11px]"
            title="Otorgar descanso largo a todo el grupo (restaura PG al máximo)"
          >
            <span class="material-symbols-outlined text-[14px] text-indigo-400">hotel</span>
            <span>Descanso Largo</span>
          </button>

          <button
            type="button"
            id="grimoire-milestone-btn"
            class="flex items-center gap-1 px-2.5 py-1 rounded-lg bg-gradient-to-r from-amber-600 via-amber-500 to-amber-600 hover:from-amber-500 hover:to-amber-400 text-[#0a0d12] font-bold shadow-[0_0_12px_rgba(245,158,11,0.3)] active:scale-95 transition-all cursor-pointer text-[11px] ml-auto"
            title="Lanzar un Hito o Logro Épico para la mesa"
          >
            <span class="material-symbols-outlined text-[14px]">celebration</span>
            <span>¡Hito!</span>
          </button>
        </div>
      </div>
    </div>
  </section>

  <!-- [mapa,mapa,combate] -->
  <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 items-start">
    <!-- COLUMNA IZQUIERDA (7 COLS LG): MAPA TÁCTICO -->
    <div class="lg:col-span-7 space-y-2">
      <div class="flex items-center justify-between">
        <div class="flex items-center gap-2">
          <span class="material-symbols-outlined text-[20px] text-amber-400">map</span>
          <h2 class="text-sm font-headline font-bold text-[#f1f5f9]">Mapa Táctico de la Mesa</h2>
        </div>
        <span class="text-[11px] text-[#94a3b8] font-label">Visor VTT interactivo</span>
      </div>
      <!-- Visor de mapa en modo DM con selector de mapa y cuadrícula -->
      <MapStage mode="dm" />

      <!-- Gestión y edición de tokens tácticos (Fase 3: T-30) -->
      <TokenEditor />
    </div>

    <!-- COLUMNA DERECHA (5 COLS LG): COMBAT TRACKER -->
    <div class="lg:col-span-5">
      <CombatTracker />
    </div>
  </div>

  <!-- [editar mapas] (FULL WIDTH) -->
  <MapManager />

  <!-- [presencia de la mesa] (RF-42): sin sección propia, marca las cards de aventureros -->
  <PresenceTracker />

  <!-- [notas privadas del DM] (RF-40) -->
  <DmNotes />

  <!-- SECTION 1: AVENTUREROS EN LA MESA (LOS PERSONAJES) -->
  <section class="space-y-4">
    <div class="flex items-center justify-between gap-3">
      <div class="flex items-center gap-2">
        <span class="material-symbols-outlined text-[22px] text-amber-400">groups</span>
        <div>
          <h2 class="text-base font-headline font-bold text-[#f1f5f9]">Aventureros en la Mesa de Juego</h2>
          <span class="text-xs text-[#94a3b8]">Supervisión y control táctico de PG, armadura e inspiración en tiempo real</span>
        </div>
      </div>
      <span id="grimoire-roster-count" class="px-3 py-1 rounded-full bg-amber-500/15 border border-amber-500/30 text-amber-300 text-xs font-bold font-label">
        3 Aventureros
      </span>
    </div>

    <!-- Live Characters Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5" id="grimoire-players-grid">
      <!-- Populated via JavaScript -->
    </div>
  </section>

  <!-- SECTION 2: BITÁCORA DE CAMPAÑA (LA BITÁCORA DEL DM) -->
  <section class="w-full rounded-2xl bg-[#121721] border border-[#222f42] p-5 lg:p-8 shadow-sm space-y-6">
    <!-- Header with Filters & Status -->
    <div class="flex flex-wrap items-center justify-between gap-4 pb-4 border-b border-[#222f42]">
      <div class="flex items-center gap-3">
        <div class="w-10 h-10 rounded-xl bg-amber-500/15 border border-amber-500/30 flex items-center justify-center text-amber-400 shadow-xs">
          <span class="material-symbols-outlined text-[24px]">history_edu</span>
        </div>
        <div>
          <h3 class="text-lg font-headline font-bold text-[#f1f5f9]">Bitácora de la Campaña</h3>
          <span class="text-xs text-[#94a3b8] font-label">Crónicas, tiradas públicas y notas secretas exclusivas del Dungeon Master</span>
        </div>
      </div>

      <!-- Category Filter Chips -->
      <div class="flex items-center gap-1.5 flex-wrap text-xs font-label" id="grimoire-journal-filters">
        <button type="button" class="grimoire-filter-btn active px-2.5 py-1 rounded-lg bg-amber-500/20 text-amber-300 border border-amber-500/40 font-bold transition-all cursor-pointer" data-filter="all">Todos</button>
        <button type="button" class="grimoire-filter-btn px-2.5 py-1 rounded-lg bg-[#18202e] text-[#94a3b8] border border-[#222f42] hover:text-[#f1f5f9] transition-all cursor-pointer" data-filter="#Combate">#Combate</button>
        <button type="button" class="grimoire-filter-btn px-2.5 py-1 rounded-lg bg-[#18202e] text-[#94a3b8] border border-[#222f42] hover:text-[#f1f5f9] transition-all cursor-pointer" data-filter="#Hito">⭐ #Hito</button>
        <button type="button" class="grimoire-filter-btn px-2.5 py-1 rounded-lg bg-[#18202e] text-[#94a3b8] border border-[#222f42] hover:text-[#f1f5f9] transition-all cursor-pointer" data-filter="#Tirada">#Tirada</button>
        <button type="button" class="grimoire-filter-btn px-2.5 py-1 rounded-lg bg-[#18202e] text-[#94a3b8] border border-[#222f42] hover:text-[#f1f5f9] transition-all cursor-pointer" data-filter="#Botín">#Botín</button>
        <button type="button" class="grimoire-filter-btn px-2.5 py-1 rounded-lg bg-[#18202e] text-[#94a3b8] border border-[#222f42] hover:text-[#f1f5f9] transition-all cursor-pointer" data-filter="#Descanso">#Descanso</button>
        <button type="button" class="grimoire-filter-btn px-2.5 py-1 rounded-lg bg-[#18202e] text-amber-400 border border-amber-500/30 hover:bg-amber-500/10 transition-all cursor-pointer" data-filter="#Privado">🔒 #Solo DM</button>
      </div>
    </div>

    <!-- NEW LOG ENTRY FORM FOR DM -->
    <form class="p-4 sm:p-5 rounded-xl bg-[#18202e] border border-[#222f42] shadow-sm space-y-3" id="grimoire-entry-form">
      <div class="flex flex-wrap items-center justify-between gap-2">
        <span class="text-xs font-headline font-bold text-amber-400 uppercase tracking-wider flex items-center gap-1">
          <span class="material-symbols-outlined text-[16px]">edit_note</span>
          <span>Añadir Registro a la Crónica</span>
        </span>
        <div class="flex items-center gap-1 flex-wrap" id="grimoire-quick-tags">
          <button type="button" class="grimoire-tag-btn text-[10px] font-bold px-2 py-0.5 rounded bg-[#10141d] border border-amber-500/30 text-amber-300 hover:bg-amber-500 hover:text-[#0a0d12] transition-colors cursor-pointer" data-tag="#Combate">#Combate</button>
          <button type="button" class="grimoire-tag-btn text-[10px] font-bold px-2 py-0.5 rounded bg-[#10141d] border border-amber-500/30 text-amber-300 hover:bg-amber-500 hover:text-[#0a0d12] transition-colors cursor-pointer" data-tag="#Hito">⭐ #Hito</button>
          <button type="button" class="grimoire-tag-btn text-[10px] font-bold px-2 py-0.5 rounded bg-[#10141d] border border-amber-500/30 text-amber-300 hover:bg-amber-500 hover:text-[#0a0d12] transition-colors cursor-pointer" data-tag="#Pista">#Pista</button>
          <button type="button" class="grimoire-tag-btn text-[10px] font-bold px-2 py-0.5 rounded bg-[#10141d] border border-amber-500/30 text-amber-300 hover:bg-amber-500 hover:text-[#0a0d12] transition-colors cursor-pointer" data-tag="#Botín">#Botín</button>
          <button type="button" class="grimoire-tag-btn text-[10px] font-bold px-2 py-0.5 rounded bg-[#10141d] border border-amber-500/30 text-amber-300 hover:bg-amber-500 hover:text-[#0a0d12] transition-colors cursor-pointer" data-tag="#NPC">#NPC</button>
        </div>
      </div>

      <input
        type="text"
        id="grimoire-entry-title"
        placeholder="Título del suceso o crónica (ej: Aparición del Comandante Infernal)"
        class="w-full text-xs font-body p-2.5 rounded-lg bg-[#10141d] border border-[#222f42] text-[#f1f5f9] placeholder:text-[#64748b] focus:outline-none focus:border-amber-500/60 focus:ring-1 focus:ring-amber-500/40"
      />

      <textarea
        id="grimoire-entry-desc"
        rows="2"
        placeholder="Detalles del encuentro, notas de ambientación, pistas reveladas a los jugadores..."
        class="w-full text-xs font-body p-3 rounded-lg bg-[#10141d] border border-[#222f42] text-[#f1f5f9] placeholder:text-[#64748b] focus:outline-none focus:border-amber-500/60 focus:ring-1 focus:ring-amber-500/40 resize-none"
      ></textarea>

      <div class="flex items-center justify-between gap-3 pt-1 flex-wrap">
        <label class="flex items-center gap-1.5 cursor-pointer text-xs text-[#cbd5e1] hover:text-[#f1f5f9] bg-[#10141d] px-3 py-1.5 rounded-lg border border-[#222f42]">
          <input type="checkbox" id="grimoire-entry-private" class="rounded bg-[#18202e] border-[#222f42] text-amber-500 focus:ring-amber-500/40" />
          <span class="flex items-center gap-1 font-bold text-amber-400">
            <span>🔒</span>
            <span>Nota Secreta (Solo visible para el DM)</span>
          </span>
        </label>

        <button
          type="submit"
          class="px-5 py-2 rounded-lg bg-gradient-to-r from-amber-600 to-amber-500 text-[#0a0d12] text-xs font-bold shadow-[0_0_12px_rgba(245,158,11,0.3)] hover:brightness-110 active:scale-95 transition-all flex items-center gap-1.5 cursor-pointer"
        >
          <span class="material-symbols-outlined text-[16px]">send</span>
          <span>Publicar en Bitácora</span>
        </button>
      </div>
    </form>

    <!-- Chronological Journal Feed (Standard 2-col Grid, no masonry) -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-4" id="grimoire-journal-feed">
      <!-- Populated via JavaScript -->
    </div>
  </section>
</div>

<script>
  import { showAlert, showConfirm, showForm } from '../../scripts/ui/notify';
  import { campaignStore } from '../../scripts/state/campaignStore';
  import { characterStore } from '../../scripts/state/characterStore';
  import { journalStore, getEntryVisibility } from '../../scripts/state/journalStore';
  import { userStore } from '../../scripts/state/userStore';
  import { congratulationBanner } from '../../scripts/ui/congratulationBanner';
  import { canPerform, normalizeStatus } from '../../scripts/vtt/sessionStatus.ts';

  /** Valida que se pueda actuar como DM y avisa en vez de fallar en silencio. */
  function guardDmPlay(camp: any): boolean {
    if (!camp) {
      showAlert('La campaña todavía se está cargando. Probá de nuevo en unos segundos.', { kind: 'error' });
      return false;
    }
    if (!canPerform('dmPlay', 'dm', camp.status)) {
      showAlert('La partida no está en curso. Iniciá o reanudá la sesión para usar esta acción.', { kind: 'info' });
      return false;
    }
    return true;
  }

  const campaignTitleEl = document.getElementById('grimoire-campaign-title');
  const campaignSubEl = document.getElementById('grimoire-campaign-subtitle');
  const weatherEl = document.getElementById('grimoire-weather-text');
  const locationEl = document.getElementById('grimoire-location-text');
  const rosterCountEl = document.getElementById('grimoire-roster-count');
  const playersGrid = document.getElementById('grimoire-players-grid');
  const journalFeed = document.getElementById('grimoire-journal-feed');
  const secretDiceCheck = document.getElementById('grimoire-secret-dice-check') as HTMLInputElement;

  let activeFilter = 'all';

  export function renderGrimoire() {
    const activeCampId = campaignStore.getActiveCampaignId();
    if (!activeCampId) return;
    const camp = campaignStore.getCampaign(activeCampId);
    if (!camp) return;

    // 1. Update Header Information
    if (campaignTitleEl) campaignTitleEl.textContent = camp.name;
    if (campaignSubEl) campaignSubEl.textContent = `${camp.setting} • Sesión ${camp.sessionNumber} en Curso`;
    if (weatherEl) weatherEl.textContent = `Clima: ${camp.weather}`;
    if (locationEl) locationEl.textContent = `Lugar: ${camp.location}`;

    // 2. Render Roster Cards
    const chars = campaignStore.getCharactersForCampaign(camp.id);
    if (rosterCountEl) rosterCountEl.textContent = `${chars.length} Aventurero${chars.length === 1 ? '' : 's'}`;

    if (playersGrid) {
      playersGrid.innerHTML = '';
      if (chars.length === 0) {
        playersGrid.innerHTML = `
          <div class="col-span-full w-full py-10 px-6 text-center text-xs text-[#64748b] bg-[#121721] rounded-2xl border border-[#222f42] space-y-2 shadow-sm">
            <span class="material-symbols-outlined text-[36px] text-amber-500/50 block mb-1">group_off</span>
            <p class="font-headline font-bold text-sm text-[#f1f5f9]">No hay aventureros asignados a esta campaña actualmente</p>
            <p class="text-xs text-[#94a3b8] max-w-md mx-auto leading-relaxed">
              Como Dungeon Master, verás aquí las tarjetas tácticas de tus jugadores en tiempo real en cuanto se unan a la campaña o agregues personajes.
            </p>
          </div>
        `;
      } else {
        chars.forEach(char => {
          const card = document.createElement('div');
          const hpPercent = Math.max(0, Math.min(100, Math.round((char.hp.current / char.hp.max) * 100)));
          let hpColor = 'bg-emerald-500';
          let statusText = 'Saludable';
          let statusColor = 'text-emerald-400 bg-emerald-500/10 border-emerald-500/30';

          if (char.hp.current <= 0) {
            hpColor = 'bg-rose-700';
            statusText = 'Inconsciente';
            statusColor = 'text-rose-400 bg-rose-500/10 border-rose-500/30';
          } else if (hpPercent <= 25) {
            hpColor = 'bg-rose-500';
            statusText = 'Crítico';
            statusColor = 'text-rose-400 bg-rose-500/10 border-rose-500/30';
          } else if (hpPercent <= 50) {
            hpColor = 'bg-amber-500';
            statusText = 'Herido';
            statusColor = 'text-amber-300 bg-amber-500/10 border-amber-500/30';
          }

          card.className = 'p-4 sm:p-5 rounded-2xl bg-[#121721] border border-[#222f42] hover:border-amber-500/50 shadow-[0_4px_20px_rgba(0,0,0,0.5)] transition-all flex flex-col justify-between gap-4 font-label text-xs';
          if (char.userId) card.dataset.presenceUid = char.userId;

          const passivePerception = 10 + (char.stats?.wis?.modifier || 2) + (char.proficiencyBonus || 3);

          card.innerHTML = `
            <div>
              <!-- Top Row: Avatar, Identity and Status -->
              <div class="flex items-center justify-between gap-3 mb-3">
                <div class="flex items-center gap-3 min-w-0">
                  <div class="relative w-12 h-12 rounded-xl overflow-hidden shrink-0 border border-amber-500/40 shadow-md bg-[#10141d]">
                    <img src="${char.avatarUrl || '/characters/ch-1.avif'}" alt="${char.name}" class="w-full h-full object-cover" onerror="this.onerror=null;this.src='/characters/ch-1.avif';" />
                  </div>
                  <div class="min-w-0">
                    <h4 class="font-headline font-bold text-sm text-[#f1f5f9] truncate">${char.name}</h4>
                    <div class="text-[11px] text-[#94a3b8] truncate">
                      <span class="text-[#cbd5e1] font-semibold">${char.race}</span> •
                      <span class="text-amber-400 font-bold">${char.className} Nvl. ${char.level}</span>
                    </div>
                    <span class="text-[10px] text-[#64748b]">Jugador: <strong class="text-[#cbd5e1]">${char.playerName || 'Jugador'}</strong></span>
                  </div>
                </div>

                <span class="px-2 py-0.5 rounded-full border text-[9px] font-bold uppercase tracking-wider shrink-0 ${statusColor}">
                  ${statusText}
                </span>
              </div>

              <!-- Health Bar & Quick Adjustment Controls -->
              <div class="p-3 rounded-xl bg-[#18202e] border border-[#222f42] space-y-2 mb-3">
                <div class="flex items-center justify-between">
                  <span class="text-[10px] uppercase font-bold text-[#94a3b8]">Puntos de Golpe</span>
                  <span class="font-headline font-bold text-xs text-[#f1f5f9]">
                    ${char.hp.current} / ${char.hp.max} PG ${char.hp.temp ? `<span class="text-amber-400">(+${char.hp.temp})</span>` : ''}
                  </span>
                </div>
                <div class="w-full h-2.5 rounded-full bg-[#10141d] overflow-hidden">
                  <div class="h-full ${hpColor} transition-all duration-300" style="width: ${hpPercent}%"></div>
                </div>
                <div class="flex items-center justify-between pt-1">
                  <div class="flex items-center gap-1">
                    <button type="button" class="hp-btn px-2 py-0.5 rounded-md bg-rose-950/60 hover:bg-rose-900 border border-rose-800/80 text-rose-300 font-bold text-[10px] active:scale-95 transition-all cursor-pointer" data-id="${char.id}" data-delta="-5">-5</button>
                    <button type="button" class="hp-btn px-2 py-0.5 rounded-md bg-rose-950/60 hover:bg-rose-900 border border-rose-800/80 text-rose-300 font-bold text-[10px] active:scale-95 transition-all cursor-pointer" data-id="${char.id}" data-delta="-1">-1</button>
                  </div>
                  <div class="flex items-center gap-1">
                    <button type="button" class="hp-btn px-2 py-0.5 rounded-md bg-emerald-950/60 hover:bg-emerald-900 border border-emerald-800/80 text-emerald-300 font-bold text-[10px] active:scale-95 transition-all cursor-pointer" data-id="${char.id}" data-delta="1">+1</button>
                    <button type="button" class="hp-btn px-2 py-0.5 rounded-md bg-emerald-950/60 hover:bg-emerald-900 border border-emerald-800/80 text-emerald-300 font-bold text-[10px] active:scale-95 transition-all cursor-pointer" data-id="${char.id}" data-delta="5">+5</button>
                  </div>
                </div>
              </div>

              <!-- Tactical Combat Chips -->
              <div class="grid grid-cols-3 gap-2 text-center text-[10px]">
                <div class="p-1.5 rounded-xl bg-[#10141d] border border-[#222f42]">
                  <span class="text-[#64748b] block font-semibold">CA</span>
                  <strong class="text-amber-400 font-headline text-xs">${char.armorClass}</strong>
                </div>
                <div class="p-1.5 rounded-xl bg-[#10141d] border border-[#222f42]">
                  <span class="text-[#64748b] block font-semibold">Percep. Pas.</span>
                  <strong class="text-[#cbd5e1] font-headline text-xs">${passivePerception}</strong>
                </div>
                <div class="p-1.5 rounded-xl bg-[#10141d] border border-[#222f42]">
                  <span class="text-[#64748b] block font-semibold">Iniciativa</span>
                  <strong class="text-emerald-400 font-headline text-xs">+${char.initiativeBonus || 3}</strong>
                </div>
              </div>
            </div>

            <!-- Footer: Inspiration Toggle -->
            <div class="pt-2 border-t border-[#222f42] flex items-center justify-between">
              <button
                type="button"
                class="inspire-btn flex items-center gap-1.5 px-3 py-1.5 rounded-xl ${char.inspiration ? 'bg-amber-500/20 text-amber-300 border border-amber-500/50 shadow-xs' : 'bg-[#18202e] text-[#94a3b8] border border-[#222f42]'} hover:text-amber-300 hover:border-amber-500/40 transition-all text-xs font-bold active:scale-95 cursor-pointer"
                data-id="${char.id}"
              >
                <span class="material-symbols-outlined text-[16px] ${char.inspiration ? 'text-amber-400' : 'text-[#64748b]'}">hotel_class</span>
                <span>${char.inspiration ? 'Inspirado ✨' : 'Dar Inspiración'}</span>
              </button>

              <span class="text-[10px] text-[#64748b]">Ficha Protegida</span>
            </div>
          `;

          // HP Adjustments
          card.querySelectorAll('.hp-btn').forEach(btn => {
            btn.addEventListener('click', () => {
              if (!guardDmPlay(camp)) return;

              const delta = parseInt(btn.getAttribute('data-delta') || '0');
              char.hp.current = Math.max(0, Math.min(char.hp.max, char.hp.current + delta));
              campaignStore.saveCharacter(char);
              renderGrimoire();
            });
          });

          // Inspiration Toggle
          card.querySelector('.inspire-btn')?.addEventListener('click', () => {
            if (!guardDmPlay(camp)) return;

            char.inspiration = !char.inspiration;
            campaignStore.saveCharacter(char);
            journalStore.log(
              `Inspiración concedida por el DM`,
              `El Dungeon Master ha ${char.inspiration ? 'otorgado Inspiración ✨' : 'retirado la Inspiración'} a "${char.name}".`,
              ['#Combate']
            );
            renderGrimoire();
          });

          playersGrid.appendChild(card);
        });
      }
    }

    // 3. Render Journal Feed
    renderJournalFeed(camp.id);

    // 4. Aplicar bloqueos según el estado de la sesión (RF-54, D7)
    applyStatusLocks();
  }

  function applyStatusLocks() {
    const cid = campaignStore.getActiveCampaignId();
    const camp = cid ? campaignStore.getCampaign(cid) : null;
    const s = camp ? normalizeStatus(camp.status) : 'paused';
    const isDm = cid ? campaignStore.isCurrentUserDm(cid) : false;
    const canPlay = isDm && canPerform('dmPlay', 'dm', s);
    const tooltip = s === 'ended' ? 'Partida terminada (solo lectura)' : 'Partida pausada';

    const setDisabled = (el: HTMLElement | null, disabled: boolean) => {
      if (!el) return;
      if (disabled) {
        el.setAttribute('disabled', 'true');
        el.setAttribute('aria-disabled', 'true');
        if (!el.hasAttribute('data-prev-title')) {
          el.setAttribute('data-prev-title', el.getAttribute('title') || '');
        }
        el.setAttribute('title', tooltip);
        el.classList.add('opacity-50', 'cursor-not-allowed');
      } else {
        el.removeAttribute('disabled');
        el.removeAttribute('aria-disabled');
        const prev = el.getAttribute('data-prev-title');
        if (prev !== null) el.setAttribute('title', prev);
        el.classList.remove('opacity-50', 'cursor-not-allowed');
      }
    };

    // Dados DM
    document.querySelectorAll<HTMLElement>('.grimoire-dice-btn').forEach(btn => setDisabled(btn, !canPlay));
    // Hitos y descansos
    setDisabled(document.getElementById('grimoire-milestone-btn'), !canPlay);
    setDisabled(document.getElementById('grimoire-short-rest-btn'), !canPlay);
    setDisabled(document.getElementById('grimoire-long-rest-btn'), !canPlay);
    // PG e inspiración en tarjetas de aventureros
    document.querySelectorAll<HTMLElement>('.hp-btn').forEach(btn => setDisabled(btn, !canPlay));
    document.querySelectorAll<HTMLElement>('.inspire-btn').forEach(btn => setDisabled(btn, !canPlay));
    // Formulario de bitácora
    document.querySelectorAll<HTMLElement>('#grimoire-entry-form input, #grimoire-entry-form textarea, #grimoire-entry-form button').forEach(el => setDisabled(el, !canPlay));
  }

  function renderJournalFeed(campaignId: string) {
    if (!journalFeed) return;
    const entries = journalStore.getEntries(undefined, undefined, true); // gets all entries for DM
    journalFeed.innerHTML = '';

    const filtered = entries.filter(e => {
      if (activeFilter === 'all') return true;
      if (activeFilter === '#Privado') return ['dm', 'to_dm'].includes(getEntryVisibility(e));
      return e.tags?.includes(activeFilter);
    });

    if (filtered.length === 0) {
      journalFeed.innerHTML = `
        <div class="col-span-full w-full py-8 text-center text-xs text-[#64748b]">
          No hay entradas en la bitácora que coincidan con el filtro actual.
        </div>
      `;
      return;
    }

    filtered.slice(0, 30).forEach(entry => {
      const card = document.createElement('div');
      const isPrivate = getEntryVisibility(entry) === 'dm';
      const isForDm = getEntryVisibility(entry) === 'to_dm';

      card.className = `p-4 rounded-xl ${isPrivate || isForDm ? 'bg-[#181a28] border-purple-500/40 ring-1 ring-purple-500/20' : 'bg-[#18202e] border-[#222f42]'} border shadow-xs space-y-2 text-xs font-body`;

      const tagsHtml = (entry.tags || []).map(t => {
        let tagColor = 'bg-[#10141d] text-[#94a3b8] border-[#222f42]';
        if (t === '#Hito') tagColor = 'bg-amber-500/20 text-amber-300 border-amber-500/40 font-bold';
        if (t === '#Combate') tagColor = 'bg-rose-500/20 text-rose-300 border-rose-500/40';
        if (t === '#Tirada') tagColor = 'bg-indigo-500/20 text-indigo-300 border-indigo-500/40';
        if (t === '#Privado') tagColor = 'bg-purple-500/20 text-purple-300 border-purple-500/40 font-bold';
        return `<span class="px-2 py-0.5 rounded text-[10px] border ${tagColor}">${t}</span>`;
      }).join(' ');

      let extraHtml = '';
      if (entry.diceRoll?.formula && entry.diceRoll?.result !== undefined) {
        extraHtml = `
          <div class="p-2 rounded bg-[#10141d] border border-amber-500/30 flex items-center justify-between text-xs my-1">
            <span class="text-[#94a3b8]">${entry.diceRoll.formula}</span>
            <span class="font-headline font-bold text-amber-400 text-xs">Resultado: ${entry.diceRoll.result}</span>
          </div>
        `;
      } else {
        const milestoneBanner = entry.milestone?.bannerText || (entry.diceRoll as any)?.bannerText;
        if (milestoneBanner) {
          extraHtml = `
            <div class="p-1.5 rounded bg-amber-500/15 border border-amber-500/30 text-amber-300 font-bold text-xs my-1 flex items-center gap-1.5">
              <span>⭐</span>
              <span>${milestoneBanner}</span>
            </div>
          `;
        }
      }

      card.innerHTML = `
        <div class="flex items-center justify-between gap-2">
          <div class="flex items-center gap-1.5 flex-wrap">
            <h5 class="font-headline font-bold text-sm text-[#f1f5f9]">${entry.title}</h5>
            ${isPrivate ? '<span class="px-1.5 py-0.2 rounded bg-purple-500/30 text-purple-200 text-[9px] font-bold uppercase border border-purple-400/40">🔒 Solo DM</span>' : ''}
            ${isForDm ? `<span class="px-1.5 py-0.2 rounded bg-purple-500/30 text-purple-200 text-[9px] font-bold uppercase border border-purple-400/40">📨 De ${entry.authorName || 'un jugador'}</span>` : ''}
          </div>
          <div class="flex items-center gap-1.5 shrink-0">
            <span class="text-[10px] text-[#64748b] font-label">${entry.timestamp ? new Date(entry.timestamp).toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' }) : ''}</span>
            <button
              type="button"
              class="grimoire-delete-note-btn w-6 h-6 rounded-md bg-[#10141d] border border-[#222f42] hover:border-rose-500/50 text-[#94a3b8] hover:text-rose-400 flex items-center justify-center transition-colors cursor-pointer"
              data-id="${entry.id}"
              title="Eliminar esta nota de la bitácora"
              aria-label="Eliminar nota"
            >
              <span class="material-symbols-outlined text-[14px]">delete</span>
            </button>
          </div>
        </div>
        <p class="text-[#cbd5e1] text-xs leading-relaxed whitespace-pre-wrap">${entry.content}</p>
        ${extraHtml}
        <div class="flex items-center justify-between gap-2 pt-1 border-t border-[#222f42]/60 font-label text-[10px]">
          <span class="text-[#64748b]">Autor: <strong class="text-[#94a3b8]">${entry.authorName || 'Dungeon Master'}</strong></span>
          <div class="flex items-center gap-1">${tagsHtml}</div>
        </div>
      `;

      card.querySelector('.grimoire-delete-note-btn')?.addEventListener('click', async (e) => {
        e.stopPropagation();
        if (await showConfirm(`¿Deseas eliminar la nota "${entry.title}" de la bitácora?`, {
          title: 'Eliminar nota de bitácora',
          confirmText: 'Eliminar'
        })) {
          journalStore.deleteEntry(entry.id);
          renderJournalFeed(campaignId);
        }
      });

      journalFeed.appendChild(card);
    });
  }

  // Quick dice rollers listener: launches DiceRollerModal with reel animation
  document.querySelectorAll('.grimoire-dice-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      const activeCampId = campaignStore.getActiveCampaignId();
      const camp = activeCampId ? campaignStore.getCampaign(activeCampId) : null;
      if (!guardDmPlay(camp)) return;

      const formula = btn.getAttribute('data-dice') || '1d20';
      const isSecret = secretDiceCheck?.checked || false;
      const sides = parseInt(formula.replace(/\D/g, '')) || 20;
      const count = parseInt(formula) || 1;

      window.dispatchEvent(new CustomEvent('open-dice-roller', {
        detail: {
          die: sides,
          count: count,
          modifier: 0,
          label: isSecret ? `Tirada Secreta de DM (${formula})` : `Tirada de DM (${formula})`,
          tag: isSecret ? '#Privado' : '#Tirada',
          isDmRoll: true,
          isSecret: isSecret,
          autoroll: true
        }
      }));
    });
  });

  // Milestone Celebration Button
  document.getElementById('grimoire-milestone-btn')?.addEventListener('click', async () => {
    const activeCampId = campaignStore.getActiveCampaignId();
    const camp = activeCampId ? campaignStore.getCampaign(activeCampId) : null;
    if (!guardDmPlay(camp)) return;

    const values = await showForm([
      { name: 'title', label: 'Título del hito', value: '¡Hazaña Heroica de la Mesa!', required: true },
      { name: 'banner', label: 'Texto del banderín', value: '¡VICTORIA ÉPICA!', hint: 'Se muestra en mayúsculas sobre el título.' },
      { name: 'desc', label: 'Descripción del logro', type: 'textarea', value: 'El grupo ha triunfado ante el peligro y grabado su nombre en las crónicas.' },
    ], { title: 'Celebrar un hito', message: 'Se le muestra a toda la mesa en vivo.', confirmText: 'Celebrar' });
    if (!values) return;
    const title = values.title.trim();
    const banner = values.banner.trim() || '¡FELICIDADES!';
    const desc = values.desc.trim() || '¡Logro conseguido!';

    if (activeCampId) {
      campaignStore.sendDmEvent(activeCampId, {
        campaignId: activeCampId,
        type: 'milestone',
        dmName: camp.dmName || 'Dungeon Master',
        payload: {
          milestone: { bannerText: banner, title, description: desc }
        }
      });
    }

    journalStore.log(
      `⭐ Hito Épico: ${title}`,
      desc,
      ['#Hito'],
      undefined,
      { bannerText: banner }
    );

    renderGrimoire();
  });

  // Short Rest Group
  document.getElementById('grimoire-short-rest-btn')?.addEventListener('click', async () => {
    const activeCampId = campaignStore.getActiveCampaignId();
    if (!activeCampId) return;
    const camp = campaignStore.getCampaign(activeCampId);
    if (!guardDmPlay(camp)) return;
    if (await showConfirm('Cada personaje de la campaña recupera +8 PG.', { title: '¿Descanso Corto para todo el grupo?', confirmText: 'Aplicar' })) {
      const chars = campaignStore.getCharactersForCampaign(activeCampId);
      chars.forEach(c => {
        c.hp.current = Math.min(c.hp.max, c.hp.current + 8);
        campaignStore.saveCharacter(c);
      });
      journalStore.log(
        'Descanso Corto de Grupo',
        'El Dungeon Master decretó un descanso corto para todos los aventureros (+8 PG recuperados).',
        ['#Descanso']
      );
      renderGrimoire();
      showAlert('¡Descanso corto aplicado a todos los aventureros!', { kind: 'success', title: 'Descanso corto' });
    }
  });

  // Long Rest Group
  document.getElementById('grimoire-long-rest-btn')?.addEventListener('click', async () => {
    const activeCampId = campaignStore.getActiveCampaignId();
    if (!activeCampId) return;
    const camp = campaignStore.getCampaign(activeCampId);
    if (!guardDmPlay(camp)) return;
    if (await showConfirm('Todos los personajes recuperan sus PG al máximo.', { title: '¿Descanso Largo para toda la mesa?', confirmText: 'Aplicar' })) {
      const chars = campaignStore.getCharactersForCampaign(activeCampId);
      chars.forEach(c => {
        c.hp.current = c.hp.max;
        if (c.hp.temp) c.hp.temp = 0;
        campaignStore.saveCharacter(c);
      });
      journalStore.log(
        'Descanso Largo de Grupo',
        'El Dungeon Master concedió un descanso largo completo. Todos los aventureros han restablecido sus Puntos de Golpe al máximo.',
        ['#Descanso']
      );
      renderGrimoire();
      showAlert('¡Descanso largo completado! Todos los aventureros tienen la salud restaurada.', { kind: 'success', title: 'Descanso largo' });
    }
  });

  // Quick Session Edit
  document.getElementById('grimoire-edit-session-btn')?.addEventListener('click', async () => {
    const activeCampId = campaignStore.getActiveCampaignId();
    if (!activeCampId) return;
    const camp = campaignStore.getCampaign(activeCampId);
    if (!camp) return;

    const values = await showForm([
      { name: 'location', label: 'Ubicación', value: camp.location },
      { name: 'weather', label: 'Clima y atmósfera', value: camp.weather },
      { name: 'session', label: 'Número de sesión', type: 'number', value: camp.sessionNumber, min: 1 },
    ], { title: 'Editar sesión', confirmText: 'Guardar' });
    if (!values) return;
    const newLoc = values.location.trim() || camp.location;
    const newWeather = values.weather.trim() || camp.weather;
    const newSession = values.session.trim() || String(camp.sessionNumber);

    campaignStore.updateCampaign(camp.id, {
      location: newLoc,
      weather: newWeather,
      sessionNumber: parseInt(newSession) || camp.sessionNumber
    });

    renderGrimoire();
  });

  // Journal Filters
  document.querySelectorAll('.grimoire-filter-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      document.querySelectorAll('.grimoire-filter-btn').forEach(b => {
        b.classList.remove('active', 'bg-amber-500/20', 'text-amber-300', 'border-amber-500/40', 'font-bold');
        b.classList.add('bg-[#18202e]', 'text-[#94a3b8]', 'border-[#222f42]');
      });
      btn.classList.add('active', 'bg-amber-500/20', 'text-amber-300', 'border-amber-500/40', 'font-bold');
      btn.classList.remove('bg-[#18202e]', 'text-[#94a3b8]', 'border-[#222f42]');
      activeFilter = btn.getAttribute('data-filter') || 'all';
      const activeCampId = campaignStore.getActiveCampaignId();
      if (activeCampId) renderJournalFeed(activeCampId);
    });
  });

  // Quick Tags Insertion
  document.querySelectorAll('.grimoire-tag-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      const tag = btn.getAttribute('data-tag') || '';
      const input = document.getElementById('grimoire-entry-desc') as HTMLTextAreaElement;
      if (input && tag) {
        input.value = `${input.value.trim()} ${tag} `.trimStart();
        input.focus();
      }
    });
  });

  // New Journal Entry Submit
  document.getElementById('grimoire-entry-form')?.addEventListener('submit', (e) => {
    e.preventDefault();
    const activeCampId = campaignStore.getActiveCampaignId();
    const camp = activeCampId ? campaignStore.getCampaign(activeCampId) : null;
    if (!guardDmPlay(camp)) return;

    const titleInput = document.getElementById('grimoire-entry-title') as HTMLInputElement;
    const descInput = document.getElementById('grimoire-entry-desc') as HTMLTextAreaElement;
    const privateCheck = document.getElementById('grimoire-entry-private') as HTMLInputElement;

    const title = titleInput?.value.trim() || 'Nota del Dungeon Master';
    const content = descInput?.value.trim();
    const isPrivate = privateCheck?.checked || false;

    if (!content) return;

    // Detect tags in content
    const detectedTags = content.match(/#[A-Za-z0-9_ÁÉÍÓÚáéíóúñÑ]+/g) || [];
    if (isPrivate && !detectedTags.includes('#Privado')) {
      detectedTags.push('#Privado');
    }
    if (detectedTags.length === 0) {
      detectedTags.push('#Mundo');
    }

    journalStore.log(title, content, detectedTags, undefined, {
      visibility: isPrivate ? 'dm' : 'party',
      authorName: 'Dungeon Master'
    });

    if (titleInput) titleInput.value = '';
    if (descInput) descInput.value = '';
    if (privateCheck) privateCheck.checked = false;

    if (activeCampId) renderJournalFeed(activeCampId);
  });

  // Listeners
  window.addEventListener('dm-grimoire-refresh', () => renderGrimoire());
  window.addEventListener('campaigns-updated', () => renderGrimoire());
  window.addEventListener('all-characters-updated', () => renderGrimoire());
  window.addEventListener('session-status-changed', () => {
    renderGrimoire();
    applyStatusLocks();
  });
  window.addEventListener('active-campaign-changed', () => {
    renderGrimoire();
    applyStatusLocks();
  });
  window.addEventListener('journal-updated', () => {
    const activeCampId = campaignStore.getActiveCampaignId();
    if (activeCampId) renderJournalFeed(activeCampId);
  });
  applyStatusLocks();
</script>
