rules_version = '2';

// Permisos de la app. Espejan las reglas de negocio de src/scripts/state/campaignStore.ts:
// - El DM y el creador gestionan la campaña; el borrado sigue la regla de canUserDeleteCampaign.
// - Cada jugador edita solo su ficha; el DM puede ajustar PG/inspiración y desvincular fichas.
// - Diario: 'party' lo ve la mesa, 'dm' solo el DM, 'player' solo su autor (ni el DM),
//   'to_dm' (mensaje al DM) su autor y el DM.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function uid() { return request.auth.uid; }

    function campaignPath(id) { return /databases/$(database)/documents/campaigns/$(id); }
    function campaign(id) { return get(campaignPath(id)).data; }
    function campaignExists(id) { return exists(campaignPath(id)); }
    function isMember(id) { return campaignExists(id) && uid() in campaign(id).memberUserIds; }
    function isDm(id) { return campaignExists(id) && campaign(id).dmId == uid(); }
    function isCreator(id) { return campaignExists(id) && campaign(id).creatorId == uid(); }

    function sessionStatus(id) { return campaign(id).get('status', 'paused'); }
    function isActive(id) { return sessionStatus(id) == 'active'; }
    function isPreparable(id) { return sessionStatus(id) in ['active', 'paused']; }

    function changedKeys() { return request.resource.data.diff(resource.data).affectedKeys(); }

    // ---------------------------------------------------------------- usuarios
    match /users/{userId} {
      // Perfil público: nombre y avatar de los compañeros de mesa.
      allow read: if signedIn();
      allow create, update: if signedIn() && uid() == userId
        && request.resource.data.keys().hasOnly(['name', 'avatarUrl', 'createdAt', 'migratedAt'])
        && request.resource.data.name is string
        && request.resource.data.name.size() <= 80;

      // Diario de personajes sin campaña: solo su dueño.
      match /notes/{noteId} {
        allow read, delete: if signedIn() && uid() == userId;
        allow create, update: if signedIn() && uid() == userId
          && request.resource.data.authorUid == uid();
      }
    }

    // ---------------------------------------------------------------- invitaciones
    match /invites/{code} {
      // Conocer el código es la credencial: se puede leer por id, pero no listar.
      allow get: if signedIn();
      allow list: if false;
      // Se crea junto con la campaña (mismo batch), por eso se mira el estado posterior.
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['campaignId', 'createdBy', 'createdAt'])
        && request.resource.data.createdBy == uid()
        && getAfter(campaignPath(request.resource.data.campaignId)).data.dmId == uid()
        && getAfter(campaignPath(request.resource.data.campaignId)).data.inviteCode == code;
      allow update: if false;
      allow delete: if signedIn() && (isDm(resource.data.campaignId) || isCreator(resource.data.campaignId));
    }

    // ---------------------------------------------------------------- campañas
    match /campaigns/{campaignId} {
      allow read: if signedIn() && uid() in resource.data.memberUserIds;

      allow create: if signedIn()
        && request.resource.data.creatorId == uid()
        && request.resource.data.dmId == uid()
        && request.resource.data.memberUserIds == [uid()]
        && (!('status' in request.resource.data) || request.resource.data.status == 'paused');

      // DM o creador: editan la campaña.
      // - Si la partida terminó, solo se puede reabrir (status: 'paused').
      // - El estado resultante debe ser válido ('active' | 'paused' | 'ended').
      // - El creador no cambia y el DM tiene que ser miembro.
      allow update: if signedIn()
        && (uid() == resource.data.dmId || uid() == resource.data.creatorId)
        && request.resource.data.creatorId == resource.data.creatorId
        && request.resource.data.dmId in request.resource.data.memberUserIds
        && request.resource.data.get('status', 'paused') in ['active', 'paused', 'ended']
        && (
          !(resource.data.get('status', 'paused') in ['ended', 'completed'])
          || (changedKeys().hasOnly(['status', 'statusChangedAt']) && request.resource.data.status == 'paused')
        );

      // DECISION (F0B-3): unirse, abandonar y desvincular fichas no se bloquean por estado (gestión de membresía).
      // Unirse con código: solo se agrega a sí mismo y el código tiene que ser de esta campaña.
      allow update: if signedIn()
        && !(uid() in resource.data.memberUserIds)
        && changedKeys().hasOnly(['memberUserIds', 'joinedWith'])
        && request.resource.data.memberUserIds.toSet() == resource.data.memberUserIds.toSet().union([uid()].toSet())
        && request.resource.data.joinedWith == resource.data.inviteCode
        && get(/databases/$(database)/documents/invites/$(request.resource.data.joinedWith)).data.campaignId == campaignId;

      // Abandonar: solo se quita a sí mismo, sin tocar nada más.
      allow update: if signedIn()
        && uid() in resource.data.memberUserIds
        && changedKeys().hasOnly(['memberUserIds'])
        && request.resource.data.memberUserIds.toSet() == resource.data.memberUserIds.toSet().difference([uid()].toSet());

      // Borrar: si el creador sigue en la mesa, solo él; si se fue, el DM.
      // El último miembro también puede cerrarla al irse.
      allow delete: if signedIn() && (
        (resource.data.creatorId in resource.data.memberUserIds && uid() == resource.data.creatorId)
        || (!(resource.data.creatorId in resource.data.memberUserIds) && uid() == resource.data.dmId)
        || resource.data.memberUserIds == [uid()]
      );

      // -------------------------------------------------------------- diario
      match /journal/{entryId} {
        function canSee(entry) {
          return (entry.visibility == 'party' && isMember(campaignId))
            || (entry.visibility == 'dm' && isDm(campaignId))
            || (entry.visibility == 'player' && entry.authorUid == uid())
            || (entry.visibility == 'to_dm' && (entry.authorUid == uid() || isDm(campaignId)));
        }
        function validVisibility(entry) {
          return entry.visibility in ['party', 'dm', 'player', 'to_dm']
            && (entry.visibility != 'dm' || isDm(campaignId));
        }

        allow read: if signedIn() && canSee(resource.data);

        // Crear entradas de bitácora requiere canPlay() (partida active), con excepción
        // para eventos de sistema del DM (p.ej. cambio de estado, F0B-2).
        allow create: if signedIn() && isMember(campaignId)
          && request.resource.data.authorUid == uid()
          && request.resource.data.campaignId == campaignId
          && validVisibility(request.resource.data)
          && (
            canPlay()
            || (isDm(campaignId) && request.resource.data.get('systemEvent', '') == 'status' && request.resource.data.visibility == 'party')
          );

        allow update: if signedIn() && isMember(campaignId) && canPlay()
          && resource.data.authorUid == uid()
          && request.resource.data.authorUid == uid()
          && validVisibility(request.resource.data);

        // El DM puede moderar entradas de la mesa, las suyas y los mensajes que recibe,
        // pero nunca las notas privadas de un jugador.
        allow delete: if signedIn() && (canPlay() || (isDm(campaignId) && canPrepare())) && (
          resource.data.authorUid == uid()
          || (isDm(campaignId) && resource.data.visibility != 'player')
        );
      }

      // -------------------------------------------------------------- eventos del DM
      match /dm_events/{eventId} {
        allow read: if signedIn() && isMember(campaignId);
        allow create: if signedIn() && isDm(campaignId) && canPlay()
          && request.resource.data.campaignId == campaignId
          && request.resource.data.timestamp is number;
        allow update, delete: if false;
      }

      // ============================================================== VTT (mesa virtual)
      // Gating por estado de la partida (active | paused | ended).
      // - canPlay: acciones de juego (mover tokens, combate, bitácora). Solo con la partida 'active'.
      // - canPrepare: preparar contenido (mapas, tokens, notas). Todo menos 'ended'.
      function canPlay() { return isActive(campaignId); }
      function canPrepare() { return isPreparable(campaignId); }

      // Límites (F0-3). La validación profunda de cada token no se puede iterar en las reglas:
      // DECISION: se valida el token tocado por un jugador (vía lastMove) y se confía en el DM
      // para el resto del documento.
      function validMap(d) {
        return d.name is string && d.name.size() <= 80
          && d.imageUrl is string && d.imageUrl.size() <= 2048
          && d.imageUrl.matches('^https://.*')
          && d.grid is map && d.grid.size is number && d.grid.size >= 8 && d.grid.size <= 512
          && d.tokens is map && d.tokens.size() <= 200
          && (!('fogRevealed' in d) || (d.fogRevealed is list && d.fogRevealed.size() <= 500));
      }

      // -------------------------------------------------------------- mapas
      match /maps/{mapId} {
        allow read: if signedIn() && isMember(campaignId);

        // DM o creador: crea, edita y borra todo.
        allow create: if signedIn() && (isDm(campaignId) || isCreator(campaignId)) && canPrepare()
          && validMap(request.resource.data);
        // DECISION (F0B-4): en paused el DM puede preparar niebla pero no mover tokens (lastMove).
        allow update: if signedIn() && (isDm(campaignId) || isCreator(campaignId)) && canPrepare()
          && validMap(request.resource.data)
          && (isActive(campaignId) || !changedKeys().hasAny(['lastMove']));
        allow delete: if signedIn() && (isDm(campaignId) || isCreator(campaignId)) && canPrepare();

        // Movimiento de token en vivo:
        // - Jugador: solo x/y de un token propio.
        // - DM o Creador: x/y de cualquier token (propios, de jugadores o enemigos/PNJs).
        // DECISION (F0-1, F3-2): el cliente escribe lastMove = { tokenId, by, at } junto con la posición y la
        // regla valida contra lastMove.tokenId: tiene que ser el único token tocado.
        allow update: if signedIn() && isMember(campaignId) && canPlay()
          && changedKeys().hasOnly(['tokens', 'lastMove', 'updatedAt'])
          && request.resource.data.lastMove.by == uid()
          && request.resource.data.lastMove.tokenId is string
          && request.resource.data.tokens.diff(resource.data.tokens).affectedKeys()
               .hasOnly([request.resource.data.lastMove.tokenId])
          && (isDm(campaignId) || isCreator(campaignId) || resource.data.tokens[request.resource.data.lastMove.tokenId].ownerUid == uid())
          && request.resource.data.tokens[request.resource.data.lastMove.tokenId]
               .diff(resource.data.tokens[request.resource.data.lastMove.tokenId]).affectedKeys().hasOnly(['x', 'y'])
          && request.resource.data.tokens[request.resource.data.lastMove.tokenId].x is number
          && request.resource.data.tokens[request.resource.data.lastMove.tokenId].y is number;

        // Tokens ocultos y demás datos que los jugadores no ven.
        match /private/{docId} {
          allow read: if signedIn() && isDm(campaignId);
          allow write: if signedIn() && isDm(campaignId) && canPrepare();
        }
      }

      // -------------------------------------------------------------- combate
      match /combat/{docId} {
        allow read: if signedIn() && isMember(campaignId);
        allow create, update: if signedIn() && isDm(campaignId) && canPlay()
          && docId == 'current'
          && request.resource.data.combatants is list
          && request.resource.data.combatants.size() <= 50;
        allow delete: if signedIn() && isDm(campaignId) && canPlay();
      }

      // -------------------------------------------------------------- handouts (RF-41)
      // DECISION (F5-13): el DM prepara borradores con sentAt == null; los jugadores no los leen hasta que se envían.
      // Preparar (crear/editar borrador, borrar) requiere canPrepare(); enviar (poner o cambiar sentAt) requiere canPlay().
      function validHandout(d) {
        return d.kind in ['image', 'text']
          && d.title is string && d.title.size() > 0 && d.title.size() <= 120
          && (!('body' in d) || (d.body is string && d.body.size() <= 5000))
          && (!('imageUrl' in d) || (d.imageUrl is string && d.imageUrl.size() <= 2048 && d.imageUrl.matches('^https://.*')))
          && (d.kind != 'image' || 'imageUrl' in d)
          && 'sentAt' in d && (d.sentAt == null || d.sentAt is number)
          && d.createdAt is number;
      }
      match /handouts/{handoutId} {
        allow read: if signedIn() && (isDm(campaignId) || (isMember(campaignId) && resource.data.sentAt != null));
        allow create: if signedIn() && isDm(campaignId) && validHandout(request.resource.data)
          && (request.resource.data.sentAt == null ? canPrepare() : canPlay());
        allow update: if signedIn() && isDm(campaignId) && validHandout(request.resource.data)
          && request.resource.data.createdAt == resource.data.createdAt
          && (request.resource.data.sentAt == resource.data.sentAt ? canPrepare() : canPlay());
        allow delete: if signedIn() && isDm(campaignId) && canPrepare();
      }

      // -------------------------------------------------------------- notas privadas del DM
      match /notes/{noteId} {
        // Se leen también con la partida terminada (solo lectura).
        allow read: if signedIn() && isDm(campaignId);
        allow create, update: if signedIn() && isDm(campaignId) && canPrepare()
          && request.resource.data.title is string && request.resource.data.title.size() <= 120
          && request.resource.data.body is string && request.resource.data.body.size() <= 20000;
        allow delete: if signedIn() && isDm(campaignId) && canPrepare();
      }
    }

    // ---------------------------------------------------------------- personajes
    match /characters/{characterId} {
      function attachable(data) {
        return data.campaignId == null || isMember(data.campaignId);
      }

      allow read: if signedIn() && (
        resource.data.userId == uid()
        || (resource.data.campaignId != null && isMember(resource.data.campaignId))
      );

      allow create: if signedIn()
        && request.resource.data.userId == uid()
        && attachable(request.resource.data);

      // Dueño: edita su ficha (no la puede regalar a otro usuario).
      allow update: if signedIn()
        && resource.data.userId == uid()
        && request.resource.data.userId == uid()
        && attachable(request.resource.data);

      // DM de la campaña: PG e inspiración en vivo (descansos, daño, recompensas). Solo con la partida active.
      allow update: if signedIn()
        && resource.data.campaignId != null
        && isDm(resource.data.campaignId)
        && isActive(resource.data.campaignId)
        && request.resource.data.campaignId == resource.data.campaignId
        && changedKeys().hasOnly(['hp', 'inspiration', 'updatedAt']);

      // DM o creador: desvincular la ficha al quitar a un jugador o cerrar la campaña.
      allow update: if signedIn()
        && resource.data.campaignId != null
        && (isDm(resource.data.campaignId) || isCreator(resource.data.campaignId))
        && request.resource.data.campaignId == null
        && changedKeys().hasOnly(['campaignId', 'sessionContext', 'updatedAt']);

      allow delete: if signedIn() && resource.data.userId == uid();
    }
  }
}
