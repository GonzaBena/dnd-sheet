# Puerto del servidor (leído por process.env.PORT en astro.config.mjs)
# Usado automáticamente por plataformas como Render, Railway, Heroku, Cloud Run, CapRover, etc.
PORT=4321

# Credenciales Públicas de Firebase Firestore
# Al utilizar el prefijo PUBLIC_, Astro las empaqueta en la aplicación de forma que ningún
# jugador o usuario tenga que ingresarlas a mano. Todos los usuarios compartirán este proyecto.
PUBLIC_FIREBASE_PROJECT_ID=tu-proyecto-firebase
PUBLIC_FIREBASE_API_KEY=AIzaSyTuClavePublicaWebAqui
