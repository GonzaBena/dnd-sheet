# Puerto del servidor (leído por process.env.PORT en astro.config.mjs)
# Usado automáticamente por plataformas como Render, Railway, Heroku, Cloud Run, CapRover, etc.
PORT=4321

# Credenciales públicas de Firebase (Consola > Configuración del proyecto > Tus apps > Web).
# Con el prefijo PUBLIC_ Astro las incluye en el bundle: no son secretas, la seguridad la dan
# Firebase Auth + firestore.rules. Si se dejan vacías la app funciona en modo local (localStorage).
PUBLIC_FIREBASE_PROJECT_ID=tu-proyecto-firebase
PUBLIC_FIREBASE_API_KEY=AIzaSyTuClavePublicaWebAqui
PUBLIC_FIREBASE_AUTH_DOMAIN=tu-proyecto-firebase.firebaseapp.com
PUBLIC_FIREBASE_APP_ID=1:000000000000:web:0000000000000000000000
# Realtime Database (Consola > Realtime Database > Crear base de datos; copiar la URL de arriba).
# Se usa para los tokens en vivo y la presencia del VTT. Si se deja vacía, el SDK usa
# https://<projectId>-default-rtdb.firebaseio.com. Con emuladores alcanza con:
# PUBLIC_FIREBASE_DATABASE_URL=http://127.0.0.1:9000?ns=demo-dnd-sheet-default-rtdb
PUBLIC_FIREBASE_DATABASE_URL=https://tu-proyecto-firebase-default-rtdb.firebaseio.com

# Desarrollo con Firebase Emulator Suite (pnpm emulators). Con emuladores alcanza con
# PUBLIC_FIREBASE_PROJECT_ID=demo-dnd-sheet y cualquier PUBLIC_FIREBASE_API_KEY no vacía.
PUBLIC_USE_EMULATORS=false
# PUBLIC_EMULATOR_HOST=127.0.0.1
