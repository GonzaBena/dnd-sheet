{
  "name": "dnd-sheet",
  "type": "module",
  "version": "1.0.0",
  "scripts": {
    "dev": "astro dev --host",
    "build": "astro build",
    "cache:srd": "node scripts/generate-srd-cache.mjs",
    "preview": "astro preview",
    "start": "node server.js",
    "test": "node --test tests/*.test.mjs",
    "test:rules": "firebase emulators:exec --only firestore,database --project demo-dnd-sheet \"node --test --test-concurrency=1 tests/rules/*.test.mjs\"",
    "emulators": "firebase emulators:start --only auth,firestore,database --project demo-dnd-sheet",
    "simulate": "node scripts/simulate-players.mjs",
    "deploy:rules": "firebase deploy --only firestore:rules,firestore:indexes,database"
  },
  "engines": {
    "node": ">=18.17.1"
  },
  "packageManager": "pnpm@8.9.2",
  "dependencies": {
    "@astrojs/tailwind": "^6.0.2",
    "animejs": "^3.2.2",
    "astro": "^7.3.3",
    "firebase": "^10.14.1",
    "konva": "^10.9.1",
    "tailwindcss": "^3.4.17"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^3",
    "@types/animejs": "^3.1.12",
    "firebase-tools": "^15.35.0",
    "typescript": "^7.0.2"
  }
}
