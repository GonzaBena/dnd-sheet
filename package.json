{
  "name": "dnd-sheet",
  "type": "module",
  "version": "1.0.0",
  "scripts": {
    "dev": "node scripts/build-premades.mjs && astro dev --host",
    "build": "node scripts/build-premades.mjs && astro build",
    "premades": "node scripts/build-premades.mjs",
    "cache:srd": "node scripts/generate-srd-cache.mjs",
    "preview": "astro preview",
    "start": "node server.js",
    "test": "node --test tests/*.test.mjs",
    "test:rules": "firebase emulators:exec --only firestore,database --project demo-dnd-sheet \"node --test --test-concurrency=1 tests/rules/*.test.mjs\"",
    "test:e2e": "node --test tests/e2e/e2e_suites.test.mjs",
    "test:e2e:cloud": "E2E_CLOUD=1 node --test tests/e2e/e2e_suites.test.mjs",
    "build:e2e-cloud": "node scripts/build-premades.mjs && PUBLIC_FIREBASE_PROJECT_ID=demo-dnd-sheet PUBLIC_FIREBASE_API_KEY=fake-api-key PUBLIC_FIREBASE_AUTH_DOMAIN=demo-dnd-sheet.firebaseapp.com PUBLIC_FIREBASE_APP_ID=demo-app PUBLIC_FIREBASE_DATABASE_URL='http://127.0.0.1:9000?ns=demo-dnd-sheet' PUBLIC_USE_EMULATORS=true PUBLIC_EMULATOR_HOST=127.0.0.1 PUBLIC_POSTHOG_KEY= PUBLIC_POSTHOG_HOST= astro build --outDir dist-e2e-cloud",
    "emulators": "firebase emulators:start --only auth,firestore,database --project demo-dnd-sheet",
    "simulate": "node scripts/simulate-players.mjs",
    "deploy:rules": "firebase deploy --only firestore:rules,firestore:indexes,database"
  },
  "engines": {
    "node": ">=18.17.1"
  },
  "packageManager": "pnpm@8.9.2",
  "dependencies": {
    "@astrojs/tailwind": "^6.0.2",
    "animejs": "^3.2.2",
    "astro": "^7.3.3",
    "firebase": "^10.14.1",
    "konva": "^10.9.1",
    "smol-toml": "^1.9.1",
    "tailwindcss": "^3.4.17"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^3",
    "@types/animejs": "^3.1.12",
    "firebase-tools": "^15.35.0",
    "typescript": "^7.0.2"
  },
  "pnpm": {
    "overrides": {
      "undici@<6.29.1": "^6.29.1",
      "@grpc/grpc-js@<1.13.6": "^1.14.7",
      "uuid@<11.1.1": "^11.1.1",
      "glob@<14.0.2": "^14.0.2",
      "minimatch@>=9 <11.0.1": "^11.0.1",
      "@opentelemetry/core@<2.8.0": "^2.8.0",
      "websocket-driver@<0.8.0": "^0.8.0"
    }
  },
  "overrides": {
    "undici@<6.29.1": "^6.29.1",
    "@grpc/grpc-js@<1.13.6": "^1.14.7",
    "uuid@<11.1.1": "^11.1.1",
    "glob@<14.0.2": "^14.0.2",
    "minimatch@>=9 <11.0.1": "^11.0.1",
    "@opentelemetry/core@<2.8.0": "^2.8.0",
    "websocket-driver@<0.8.0": "^0.8.0"
  }
}
